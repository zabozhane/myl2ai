--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/GatekeeperTravel.kt
@@ -0,0 +1,67 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.extensions.findClosestGatekeeper
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.offlinelife.OfflineFarmManager
+import dev.l2j.autobots.population.RouteSafety
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.data.cache.HtmCache
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+import java.util.Calendar
+
+/** A world teleport entry is not a service offered by the player's gatekeeper. */
+internal object GatekeeperTravel {
+    data class Offer(val gatekeeper: Npc,val id: Int,val exit: TeleportLocation,val price: Int)
+
+    fun menuIds(npc: Npc): Set<Int> {
+        val menu=listOf("data/html/teleporter/${npc.npcId}.htm", "data/html/teleporter/${npc.npcId}-1.htm")
+                .mapNotNull { HtmCache.getInstance().getHtm(it) }.joinToString(" ")
+        return Regex("""_goto\s+(\d+)""").findAll(menu).map { it.groupValues[1].toInt() }.toSet()
+    }
+
+    /** Mirrors Gatekeeper's current server-time weekend discount; the core still performs the payment. */
+    fun price(exit: TeleportLocation): Int {
+        val cal=Calendar.getInstance()
+        val weekend=cal.get(Calendar.DAY_OF_WEEK) in listOf(Calendar.SATURDAY,Calendar.SUNDAY)
+        return if(!exit.isNoble && weekend && cal.get(Calendar.HOUR_OF_DAY) in 20..23) exit.price/2 else exit.price
+    }
+
+    fun offers(player: Player): List<Offer> {
+        val npc=player.findClosestGatekeeper() ?: return emptyList()
+        if(!npc.isVisible || distance(player,npc)>8000 || NpcTravel.plan(player,npc,maxDistance=8000)==null) return emptyList()
+        return menuIds(npc).mapNotNull { id ->
+            TeleportLocationData.getInstance().getTeleportLocation(id)?.let { Offer(npc,id,it,price(it)) }
+        }.filter { !it.exit.isNoble && it.price<=Errands.spendable(player) &&
+                RouteSafety.safeDestination(player,it.exit) && RouteSafety.safeSegment(player,it.exit,it.exit) }
+    }
+
+    fun toward(player: Player,target: Location,minSaved: Double=2000.0): Offer? = offers(player)
+            .filter { distance(player.location(),target)-distance(it.exit,target)>minSaved }
+            .minByOrNull { distance(it.exit,target)+it.price/10.0 }
+
+    suspend fun travel(player: Player,offer: Offer): Boolean {
+        val npc=offer.gatekeeper
+        if(!npc.isVisible || offer.id !in menuIds(npc) || offer.exit.isNoble ||
+                price(offer.exit)>Errands.spendable(player)) return false
+        if(!NpcTravel.reach(player,npc,8000) || player.isDead ||
+                player !is Autobot && !OfflineFarmManager.isActive(player)) return false
+        // Balance, fare and menu can change during the walk. No manual charge or direct teleport.
+        if(offer.id !in menuIds(npc) || price(offer.exit)>Errands.spendable(player)) return false
+        val before=player.adena
+        player.target=npc
+        try {
+            npc.onBypassFeedback(player,"goto ${offer.id}")
+            if(player.isTeleporting) player.onTeleported()
+            val arrived=distance(player.location(),offer.exit)<=200
+            EconomyLog.note(player,"gatekeeper ${npc.name} menu=${offer.id} result=${if(arrived) "arrived" else "refused"} paid=${before-player.adena}")
+            return arrived
+        } finally {
+            if(player.target===npc) player.target=null
+        }
+    }
+}
