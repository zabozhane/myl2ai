diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/StoreAudit.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/StoreAudit.kt
new file mode 100644
index 0000000..c4c9e28
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/StoreAudit.kt
@@ -0,0 +1,48 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.population.economy.craft.CraftBook
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/** Potential online bot buyers, not promised sales; human demand is deliberately not guessed. */
+internal object StoreAudit {
+    private val attempts=ConcurrentHashMap<String,AtomicInteger>()
+    fun attempt(reason: String) { attempts.computeIfAbsent(reason){AtomicInteger()}.incrementAndGet() }
+
+    /** Each sell listing has one reason, tested in order: need -> nearby -> price -> money. */
+    fun diagnose(bots: Collection<Autobot>,owners: Collection<Player>): Map<String,Int> {
+        val needs=bots.associateWith { StoreKeeper.shoppingNeeds(it) }
+        val result=linkedMapOf("noNeed" to 0,"elsewhere" to 0,"price" to 0,"budget" to 0,"potential" to 0)
+        for(owner in owners.filter { it.storeType==StoreType.SELL }) for(item in owner.sellList.items) {
+            val buyers=needs.filter { (bot,wants) -> bot.objectId!=owner.objectId && (wants[item.item.itemId]?:0)>0 }.keys
+            val nearby=buyers.filter { distance(it,owner)<=Market.STORE_RADIUS }
+            val priced=nearby.filter { buyer ->
+                val limit=dev.l2j.autobots.population.economy.craft.Sourcing.storeLimit(buyer,item.item.itemId,StoreKeeper.buyLimit(buyer,item.item.itemId))
+                item.price<=limit || (owner is Autobot && item.price<limit*MarketHaggle.REACH)
+            }
+            val reason=when {
+                buyers.isEmpty() -> "noNeed"
+                nearby.isEmpty() -> "elsewhere"
+                priced.isEmpty() -> "price"
+                priced.none { Errands.spendable(it)>=item.price } -> "budget"
+                else -> "potential"
+            }
+            result[reason]=result.getValue(reason)+1
+        }
+        return result
+    }
+
+    fun summary() {
+        val online=World.getInstance().players.filter { it.isOnline && !it.isDead }
+        val bots=online.filterIsInstance<Autobot>().filter { it.life!=null }
+        val reasons=diagnose(bots,online).entries.joinToString(" "){ "${it.key}=${it.value}" }
+        val tries=listOf("NoOffer","Price","Budget","Route","Haggle","Rejected","Bought")
+                .joinToString(" "){ "attempt$it=${attempts[it]?.getAndSet(0)?:0}" }
+        println("Autobots store audit: botBuyers=${bots.size} crafters=${bots.count { CraftBook.isCrafter(it) }} $reasons $tries")
+    }
+}
