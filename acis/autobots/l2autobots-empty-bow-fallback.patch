+    /** Keep shooting when this bow's arrows run out, using only another stocked, owned bow. */
+    fun useStockedBow(bot: Player) {
+        if(bot.isCastingNow || bot.isAttackingNow || bot.isTeleporting) return
+        val current=bot.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND) ?: return
+        if(current.itemType!=WeaponType.BOW || count(bot,ARROWS.getValue(current.item.crystalType))>0) return
+        val allowed=gradeFor(bot.level).id
+        val replacement=bot.inventory.items.filter { item ->
+            !item.isEquipped && item.isEquipable && item.isWeapon && item.itemType==WeaponType.BOW &&
+                    !item.isQuestItem && !item.isHeroItem && !item.isShadowItem &&
+                    item.item.crystalType.id<=allowed && item.item.bodyPart==current.item.bodyPart &&
+                    item.weaponItem.isMagical==current.weaponItem.isMagical &&
+                    count(bot,ARROWS.getValue(item.item.crystalType))>0
+        }.maxByOrNull { dev.l2j.autobots.offlinelife.OfflineEquipment.score(bot,it) } ?: return
+        equip(bot,replacement)
+        if(replacement.isEquipped) EconomyLog.log(bot,Deal.Equip,
+                "bow fallback: no arrows for ${current.itemName}; using owned ${replacement.itemName}")
+    }
+
     fun count(bot: Player, itemId: Int): Int = bot.inventory.getItemByItemId(itemId)?.count ?: 0
 
