+package dev.l2j.autobots.offlinelife
+
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Chat command `.autolife`: the connected owner hands the character to the same life it lives after a logout
+ * (hunting spots, town errands, gear, lessons, profession) and watches it in the client. Any move, click,
+ * attack or skill by hand gives control back; logging out keeps the life going offline.
+ */
+internal object AutoLifeCommandHandler {
+
+    const val COMMAND = ".autolife"
+
+    /** Chat commands; true when the line was a command and must not reach the chat. */
+    fun onChat(player: Player, text: String): Boolean {
+        val command = text.trim().lowercase()
+        if (command != COMMAND && !command.startsWith("$COMMAND ")) return false
+        val on = OfflineFarmManager.isOnlineLife(player)
+        when (command.removePrefix(COMMAND).trim()) {
+            "" -> if (on) stop(player) else start(player)
+            "on" -> if (on) player.sendMessage("Auto life: already ON.") else start(player)
+            "off" -> if (on) stop(player) else player.sendMessage("Auto life: already OFF.")
+            else -> player.sendMessage("Auto life: $COMMAND toggles, $COMMAND on|off.")
+        }
+        return true
+    }
+
+    private fun start(player: Player) {
+        val refused = OfflineFarmManager.startOnlineLife(player)
+        if (refused == null)
+            player.sendMessage("Auto life: ON — the character plays on its own: hunting spots, town errands, gear, " +
+                    "skills and profession. Move, click or attack yourself to take control back; log out and it goes on offline.")
+        else
+            player.sendMessage("Auto life: can't start ($refused).")
+    }
+
+    private fun stop(player: Player) {
+        OfflineFarmManager.stopOnlineLife(player, "owner_command")
+        player.sendMessage("Auto life: OFF — the character is yours.")
+    }
+}
