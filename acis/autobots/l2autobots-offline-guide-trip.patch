+    /** The defence a guide piece would add over what is worn in its slot, or null when it does not fit this character. */
+    fun guideGain(player: Player,itemId: Int): Double? {
+        val candidate=ItemInstance(0,itemId)
+        if(!eligible(player,candidate) || !fits(player,candidate)) return null
+        val worn=player.inventory.getPaperdollItem(slot(player,candidate))
+        if(worn!=null && (worn.enchantLevel>0 || worn.isAugmented)) return null
+        if(player.inventory.getItemByItemId(itemId)!=null) return null
+        return (score(player,candidate)-(worn?.let { score(player,it) } ?: 0.0)).takeIf { it>=MIN_ARMOR_GAIN }
+    }
