+    private enum class GuideTripResult { Bought, Saving, None }
+
+    private suspend fun buyGuidePieceElsewhere(player: Player,budget: Int,guide: Set<Int>): GuideTripResult {
+        if(guide.isEmpty()) return GuideTripResult.None
+        val service=dev.l2j.autobots.population.economy.GatekeeperTravel
+        val trips=service.offers(player).flatMap { offer ->
+            guide.mapNotNull { id ->
+                val gain=OfflineEquipment.guideGain(player,id) ?: return@mapNotNull null
+                val (shop,product)=Market.findProductAt(id,offer.exit) ?: return@mapNotNull null
+                if(Market.findProduct(player,id)!=null) return@mapNotNull null
+                GuideTrip(offer,shop,product,Market.priceWithTax(shop,product),gain)
+            }
+        }
+        val trip=trips.filter { it.total<=budget }.maxWithOrNull(compareBy<GuideTrip> { it.gain }.thenByDescending { it.total })
+        if(trip==null) {
+            trips.minByOrNull { it.total }?.let { println("Offline gear: ${player.name} id=${player.objectId} waits guide=${it.product.item.name}" +
+                    " town=${it.offer.exit.x},${it.offer.exit.y} price=${it.price} fare=${it.offer.price} total=${it.total} budget=$budget reason=money") }
+            return if(trips.isEmpty()) GuideTripResult.None else GuideTripResult.Saving
+        }
+        println("Offline gear: ${player.name} id=${player.objectId} rides for guide=${trip.product.item.name} gain=${"%.1f".format(trip.gain)}" +
+                " town=${trip.offer.exit.x},${trip.offer.exit.y} price=${trip.price} fare=${trip.offer.price} budget=$budget")
+        val reserved=player.adena-budget
+        if(!service.travel(player,trip.offer) || !OfflineFarmManager.isActive(player) || player.isDead) return GuideTripResult.None
+        if(!approach(player,trip.shop.merchant)) return GuideTripResult.None
+        if(trip.price>(player.adena-reserved+2*trip.offer.price).coerceAtLeast(0)) return GuideTripResult.None
+        if(!Market.buyFromNpc(player,trip.shop,trip.product,1)) return GuideTripResult.None
+        OfflineEquipment.equip(player)
+        return GuideTripResult.Bought
+    }
