+    private suspend fun buyGuidePieceElsewhere(player: Player,budget: Int,guide: Set<Int>): GuideTripResult {
+        if(guide.isEmpty()) return GuideTripResult.None
+        val service=dev.l2j.autobots.population.economy.GatekeeperTravel
+        val gains=guide.mapNotNull { id -> OfflineEquipment.guideGain(player,id)?.let { id to it } }
+                .filter { (id,_) -> Market.findProduct(player,id)==null }
+        if(gains.isEmpty()) return GuideTripResult.None
+        fun sellersAt(rides: List<dev.l2j.autobots.population.economy.GatekeeperTravel.Offer>) = gains.mapNotNull { (id,gain) ->
+            val (shop,product)=Market.findProductAt(id,rides.last().exit) ?: return@mapNotNull null
+            GuideTrip(rides,shop,product,Market.priceWithTax(shop,product),gain)
+        }
+        val first=service.offers(player)
+        val direct=first.flatMap { sellersAt(listOf(it)) }
+        val trips=direct.ifEmpty {
+            first.sortedBy { it.price }.take(MAX_FIRST_RIDES).flatMap { ride ->
