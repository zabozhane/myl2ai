+    /**
+     * One gem of Q408: Rosella gives a [token] for the [npcId], who trades it for a [charm] (by event or on talk);
+     * with the charm, [count] [trophy] from [monster] buy the [gem].
+     */
+    private fun PathQuestBuilder.gem(gem: Int, rosella: Int, rosellaEvent: String, token: Int, npcId: Int, npcEvent: String?,
+                                     charm: Int, trophy: Int, count: Int, monster: Int) {
+        rule({ !it.has(gem) && it.has(token) }, if (npcEvent != null) talk(npcId, npcEvent) else talk(npcId))
+        rule({ !it.has(gem) && it.has(charm) && it.count(trophy) < count }, hunt(monster))
+        rule({ !it.has(gem) && it.has(charm) }, talk(npcId))
+        rule({ !it.has(gem) }, talk(rosella, rosellaEvent))
+    }
