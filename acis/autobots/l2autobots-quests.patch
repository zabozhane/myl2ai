+    /** One of Sir Klaus Vasper's errands: a mark from [npcId], [count] trophies from [monsters], a coin back. */
+    private class Errand(val npcId: Int, val event: String, val mark: Int, val trophy: Int, val count: Int, val coin: Int, val monsters: IntArray)
+
+    /**
+     * Q402: three coins of lords out of six errands, one errand at a time, the easier hunting grounds first.
+     * Klaus takes three coins as well as six.
+     */
+    private fun humanKnight() = path("Q402_PathToAHumanKnight", HUMAN_FIGHTER, KNIGHT, mark = 1161, masterEvent = "HK") {
+        val errands = listOf(
+                Errand(30332, "30332-02.htm", 1168, 1169, 10, 1162, intArrayOf(20775)),
+                Errand(30379, "30379-02.htm", 1172, 1173, 20, 1164, intArrayOf(20038, 20043, 20050)),
+                Errand(30037, "30037-02.htm", 1174, 1175, 20, 1165, intArrayOf(20030, 20027, 20024)),
+                Errand(30289, "30289-03.htm", 1170, 1171, 12, 1163, intArrayOf(27024)),
+                Errand(30039, "30039-02.htm", 1176, 1177, 20, 1166, intArrayOf(20103, 20106, 20108)),
+                Errand(30031, "30031-02.htm", 1178, 1179, 10, 1167, intArrayOf(20404)))
+        val coins = { view: QuestView -> errands.count { view.has(it.coin) } }
+
+        start(30417, "30417-05.htm", "30417-08.htm")
+        rule({ coins(it) >= 3 }, talk(30417, "30417-13.htm"))
+        for (errand in errands) {
+            rule({ it.has(errand.mark) && it.count(errand.trophy) < errand.count }, hunt(*errand.monsters))
+            rule({ it.has(errand.mark) }, talk(errand.npcId))
+        }
+        for (errand in errands) {
+            rule({ !it.has(errand.coin) }, talk(errand.npcId, errand.event))
+        }
+    }
