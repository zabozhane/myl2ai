@@ -0,0 +1,76 @@
+package dev.l2j.autobots.population.quests
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.sql.SpawnTable
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.spawn.L2Spawn
+import net.sf.l2j.gameserver.scripting.QuestState
+import net.sf.l2j.gameserver.data.xml.ScriptData
+
+/** Where quest NPCs and monsters are: the server's spawn list, plus a world scan for monsters a quest spawned itself. */
+internal object QuestWorld {
+    // The spawn is kept rather than its NPC: the NPC object is replaced when it respawns.
+    private class SpawnPoint(val location: Location, val spawn: L2Spawn)
+
+    private val spawnsByNpcId: Map<Int, List<SpawnPoint>> by lazy {
+        SpawnTable.getInstance().spawns
+                .mapNotNull { spawn ->
+                    val loc = spawn.loc ?: spawn.npc?.position ?: return@mapNotNull null
+                    spawn.template.npcId to SpawnPoint(Location(loc.x, loc.y, loc.z), spawn)
+                }
+                .groupBy({ it.first }, { it.second })
+    }
+
+    /** The closest spawned NPC of [npcIds] that is in the world. */
+    fun closestNpc(bot: Player, npcIds: Collection<Int>): Npc? = npcIds.asSequence()
+            .flatMap { spawnsByNpcId[it].orEmpty().asSequence() }
+            .mapNotNull { it.spawn.npc?.takeIf { npc -> npc.isVisible && !npc.isDead } }
+            .minByOrNull { distance(bot.location(), it.location()) }
+
+    /** Where [monsterIds] spawn, closest first. */
+    fun spawnPoints(bot: Player, monsterIds: Set<Int>): List<Location> = monsterIds
+            .flatMap { id -> spawnsByNpcId[id].orEmpty().map { it.location } }
+            .sortedBy { distance(bot.location(), it) }
+
+    fun hasSpawns(monsterIds: Set<Int>) = monsterIds.any { spawnsByNpcId[it].orEmpty().isNotEmpty() }
+
+    /** Living monsters of [monsterIds] anywhere in the world: those a quest spawns are in no spawn list. */
+    fun liveMonsters(monsterIds: Set<Int>): List<Monster> = World.getInstance().objects
+            .filterIsInstance<Monster>()
+            .filter { !it.isDead && it.npcId in monsterIds }
+
+    /**
+     * Restores the bot's quest journal like EnterWorld does for a player: bots never pass through EnterWorld, and their
+     * rows in character_quests are kept between sessions like a player's.
+     */
+    fun loadQuestStates(bot: Player) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("SELECT name,var,value FROM character_quests WHERE charId=?").use { ps ->
+                    ps.setInt(1, bot.objectId)
+                    val rows = mutableListOf<Triple<String, String, String>>()
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) rows += Triple(rs.getString("name"), rs.getString("var"), rs.getString("value"))
+                    }
+                    // States first, so a variable never arrives before the state it belongs to.
+                    for ((name, variable, value) in rows.sortedByDescending { it.second == "<state>" }) {
+                        val quest = ScriptData.getInstance().getQuest(name) ?: continue
+                        if (variable == "<state>") {
+                            if (bot.getQuestState(name) == null) QuestState(bot, quest, value.toByte())
+                        } else {
+                            bot.getQuestState(name)?.setInternal(variable, value)
+                        }
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots quests: couldn't load quests of ${bot.name}: $e")
+        }
+    }
+}
