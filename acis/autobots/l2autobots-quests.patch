+    private const val HUB_SCENT = 1279
+
+    fun forBaseClass(classId: ClassId): List<PathQuest> = all.filter { it.from == classId }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt b/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt
new file mode 100644
index 0000000..caf9104
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt
@@ -0,0 +1,367 @@
+package dev.l2j.autobots.population.quests
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.TravelByGatekeeperSequence
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.extensions.pickWeighted
+import dev.l2j.autobots.population.economy.GoToTownSequence
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getBehaviorByClassId
+import dev.l2j.autobots.utils.getSupportedClasses
+import dev.l2j.autobots.utils.supportedCombatPrefs
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.item.kind.Item
+import net.sf.l2j.gameserver.model.itemcontainer.Inventory
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * A population bot's quest play. For now the first profession: from level 19 the bot takes the Path quest of the
+ * branch it chose, plays it step by step through the script (dialogs as bypasses, kills through onKill), and at 20
+ * with the mark goes to a guild master of its race, who changes the class. Nothing is given by this module.
+ */
+internal class QuestRunner(private val bot: Autobot) {
+
+    private var loaded = false
+    private var chosen: PathQuest? = null
+
+    // Progress watch: a quest that does not move for a long time is put aside for a while, like a player who gives up
+    // for the evening.
+    private var lastSignature = -1L
+    private var lastProgressAt = System.currentTimeMillis()
+    private var pausedUntil = 0L
+    private var travelFailures = 0
+    private var lastFailure = ""
+    // After a failed teleport (no adena, no gatekeeper) or escape (no scroll) the bot walks for a while, like a
+    // player who can't pay.
+    private var walkOnlyUntil = 0L
+
+    // Hunting for the quest.
+    private var huntSpot: Location? = null
+    private val emptySpots = mutableMapOf<Location, Long>()
+    private var idleTicks = 0
+    private var liveScanAt = 0L
+    private var liveTarget: Location? = null
+
+    // The bot's own weapon while it holds a quest weapon (or none).
+    private var ownWeaponObjectId = 0
+
+    /** True while the bot works on a quest; it then owns the tick. */
+    var isActive = false
+        private set
+
+    /** @return true when the quest took care of this tick. */
+    suspend fun onUpdate(): Boolean {
+        val busy = AutobotData.settings.questsEnabled && update()
+        if (!busy) relax()
+        isActive = busy
+        QuestLog.setActive(bot, busy)
+        return busy
+    }
+
+    fun onLogout() {
+        relax()
+        QuestLog.setActive(bot, false)
+    }
+
+    private suspend fun update(): Boolean {
+        if (bot.classId.level() != 0 || bot.level < START_LEVEL) return false
+        if (System.currentTimeMillis() < pausedUntil) return false
+        if (!loaded) {
+            QuestWorld.loadQuestStates(bot)
+            loaded = true
+        }
+
+        val path = currentPath() ?: return false
+        val view = QuestView(bot, bot.getQuestState(path.questName))
+        if (view.has(path.mark)) {
+            if (bot.level < CLASS_CHANGE_LEVEL) return false
+            relax()
+            watchProgress(path, view)
+            changeClass(path)
+            return true
+        }
+
+        watchProgress(path, view)
+        if (System.currentTimeMillis() < pausedUntil) return false
+
+        val action = if (!view.started) Talk(path.startNpc, path.startEvents) else path.rules.firstOrNull { it.applies(view) }?.action
+        if (action == null) {
+            giveUp(path, "no step for cond ${view.cond}")
+            return false
+        }
+        execute(path, action)
+        return true
+    }
+
+    /** The Path quest under way, else the one for the branch the bot wants (weighted like the free change was). */
+    private fun currentPath(): PathQuest? {
+        val paths = PathQuests.forBaseClass(bot.classId).filter { it.to in getSupportedClasses }
+        if (paths.isEmpty()) return null
+        paths.firstOrNull { bot.getQuestState(it.questName)?.isStarted == true || QuestView(bot, null).has(it.mark) }?.let { return it }
+        chosen?.takeIf { it in paths }?.let { return it }
+        val target = pickWeighted(paths.map { it.to }) ?: return null
+        return paths.first { it.to == target }.also { chosen = it }
+    }
+
+    private suspend fun execute(path: PathQuest, action: QuestAction) {
+        when (action) {
+            is Talk -> {
+                holdWeapon(null)
+                bot.questTargets = null
+                talk(path, action)
+            }
+            is Hunt -> hunt(path, action)
+        }
+    }
+
+    private suspend fun talk(path: PathQuest, talk: Talk) {
+        val npc = QuestWorld.closestNpc(bot, listOf(talk.npcId)) ?: return giveUp(path, "npc ${talk.npcId} is not in the world")
+        if (!reach(npc)) return
+
+        val before = describe(path)
+        bot.target = npc
+        delay(Rnd.get(1500, 4000).toLong())
+        npc.onBypassFeedback(bot, "Quest ${path.questName}")
+        for (event in talk.events) {
+            delay(Rnd.get(1500, 4000).toLong())
+            bot.processQuestEvent(path.questName, event)
+        }
+        bot.target = null
+        // A talk may have spawned the monsters to hunt next.
+        liveScanAt = 0
+        val after = describe(path)
+        if (after != before) QuestLog.log(bot, QuestEvent.Step, "${path.questName}: talked to ${npc.name}, $after")
+        if (before == "not taken" && after != before) QuestLog.log(bot, QuestEvent.Started, "${path.questName} taken from ${npc.name}")
+    }
+
+    private suspend fun hunt(path: PathQuest, hunt: Hunt) {
+        holdWeapon(hunt.weapon)
+        bot.questTargets = hunt.monsterIds
+
+        val near = bot.getKnownTypeInRadius(Monster::class.java, NEAR_RADIUS).any { !it.isDead && it.npcId in hunt.monsterIds }
+        if (near || bot.target != null) {
+            idleTicks = 0
+            bot.combatBehavior.onUpdate()
+            return
+        }
+
+        val spot = nextHuntSpot(hunt) ?: liveMonster(hunt)
+        if (spot == null) {
+            if (hunt.orElse != null) execute(path, hunt.orElse) else giveUp(path, "no ${hunt.monsterIds} to hunt")
+            return
+        }
+        if (distance(bot.location(), spot) > SPOT_RADIUS) {
+            travelTo(spot, SPOT_RADIUS)
+            return
+        }
+
+        // At the spot with nothing in sight: wait for a respawn a little, then try another spawn point.
+        bot.combatBehavior.onUpdate()
+        if (bot.target == null && !bot.isMoving && !bot.isSitting && ++idleTicks >= MAX_IDLE_TICKS) {
+            idleTicks = 0
+            emptySpots[spot] = System.currentTimeMillis()
+            huntSpot = null
+            liveTarget = null
+        }
+    }
+
+    private fun nextHuntSpot(hunt: Hunt): Location? {
+        huntSpot?.let { return it }
+        val now = System.currentTimeMillis()
+        emptySpots.entries.removeIf { now - it.value > EMPTY_SPOT_MS }
+        val points = QuestWorld.spawnPoints(bot, hunt.monsterIds)
+        if (points.isEmpty()) return null
+        // All spawn points were empty a moment ago: start over from the closest one.
+        val next = points.firstOrNull { it !in emptySpots } ?: points.first().also { emptySpots.clear() }
+        huntSpot = next
+        return next
+    }
+
+    /** A monster the quest spawned somewhere (scanned at most every half minute: it walks the whole world). */
+    private fun liveMonster(hunt: Hunt): Location? {
+        if (QuestWorld.hasSpawns(hunt.monsterIds)) return null
+        val now = System.currentTimeMillis()
+        if (now - liveScanAt > LIVE_SCAN_MS) {
+            liveScanAt = now
+            liveTarget = QuestWorld.liveMonsters(hunt.monsterIds).minByOrNull { distance(bot, it) }?.location()
+        }
+        return liveTarget
+    }
+
+    /** Hands the guild master the mark; the FirstClassChange script checks race, class and level and changes the class. */
+    private suspend fun changeClass(path: PathQuest) {
+        val masters = PathQuests.guildMasters[path.from] ?: return
+        val master = QuestWorld.closestNpc(bot, masters) ?: return giveUp(path, "no guild master in the world")
+        if (!reach(master)) return
+
+        bot.target = master
+        delay(Rnd.get(1500, 4000).toLong())
+        master.onBypassFeedback(bot, "Quest $CLASS_CHANGE_SCRIPT")
+        delay(Rnd.get(2000, 5000).toLong())
+        bot.processQuestEvent(CLASS_CHANGE_SCRIPT, path.masterEvent)
+
+        if (bot.classId != path.to) return giveUp(path, "${master.name} did not change the class")
+        bot.rewardSkills()
+        val attackPlayerType = bot.combatBehavior.combatPreferences.attackPlayerType
+        supportedCombatPrefs[bot.classId]?.let { bot.combatBehavior = getBehaviorByClassId(bot.classId, bot, it.invoke()) }
+        bot.combatBehavior.combatPreferences.attackPlayerType = attackPlayerType
+        chosen = null
+        QuestLog.log(bot, QuestEvent.ClassChanged, "became ${bot.classId} at ${master.name}")
+    }
+
+    /** Walks (or takes a gatekeeper) to an NPC until it can talk. @return true once in talking range. */
+    private suspend fun reach(npc: Npc): Boolean {
+        if (distance(bot, npc) <= Npc.INTERACTION_DISTANCE) return true
+        travelTo(npc.location(), Npc.INTERACTION_DISTANCE - 50)
+        return distance(bot, npc) <= Npc.INTERACTION_DISTANCE
+    }
+
+    private suspend fun travelTo(destination: Location, radius: Int) {
+        if (bot.isSitting) {
+            bot.standUp()
+            return
+        }
+        val far = distance(bot.location(), destination) > MIN_WALK_SAVED_BY_TELEPORT && System.currentTimeMillis() >= walkOnlyUntil
+        val inTown = bot.isInsideZone(ZoneId.TOWN)
+        val exit = if (far && inTown) gatekeeperExitFor(destination) else null
+        when {
+            exit != null -> TravelByGatekeeperSequence(bot, exit) { failed("no teleport to ${exit.x},${exit.y} (adena ${bot.adena})", walk = true) }.execute()
+            // Far from town and from the target: back to town first, then the gatekeeper.
+            far && !inTown && gatekeeperExitFor(destination) != null && distance(bot.location(), destination) > FAR_FROM_TOWN ->
+                GoToTownSequence(bot) { failed("couldn't get back to town", walk = true) }.execute()
+            else -> WalkToSequence(bot, destination, radius) {
+                failed("stuck walking to ${destination.x},${destination.y} from ${bot.x},${bot.y}", walk = false)
+            }.execute()
+        }
+    }
+
+    private fun failed(reason: String, walk: Boolean) {
+        travelFailures++
+        lastFailure = reason
+        if (walk) walkOnlyUntil = System.currentTimeMillis() + WALK_ONLY_MS
+    }
+
+    private fun gatekeeperExitFor(destination: Location): TeleportLocation? {
+        val exit = TeleportLocationData.getInstance().allTeleportLocations
+                .filter { !it.isNoble }
+                .minByOrNull { distance(it, destination) } ?: return null
+        val walkSaved = distance(bot.location(), destination) - distance(exit, destination)
+        return if (walkSaved > MIN_WALK_SAVED_BY_TELEPORT) exit else null
+    }
+
+    /**
+     * Holds [weapon] (an item id, 0 for bare hands) while a quest counts only such kills; null gives the bot its own
+     * weapon back.
+     */
+    private fun holdWeapon(weapon: Int?) {
+        val held = bot.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)
+        if (weapon == null) {
+            if (ownWeaponObjectId == 0) return
+            val own = bot.inventory.getItemByObjectId(ownWeaponObjectId)
+            ownWeaponObjectId = 0
+            if (own != null && !own.isEquipped) bot.useEquippableItem(own, true)
+            return
+        }
+        if (held?.itemId == weapon || (weapon == 0 && held == null)) return
+        if (held != null && ownWeaponObjectId == 0 && held.item.type2 != Item.TYPE2_QUEST) ownWeaponObjectId = held.objectId
+        if (weapon == 0) {
+            if (held != null) bot.useEquippableItem(held, true)
+        } else {
+            bot.inventory.getItemByItemId(weapon)?.let { bot.useEquippableItem(it, true) }
+        }
+    }
+
+    /** Back to normal hunting: own weapon, any monster. */
+    private fun relax() {
+        bot.questTargets = null
+        holdWeapon(null)
+        huntSpot = null
+        liveTarget = null
+    }
+
+    private fun watchProgress(path: PathQuest, view: QuestView) {
+        val questItems = bot.inventory.items.filter { it.item.type2 == Item.TYPE2_QUEST }.sumOf { it.count.toLong() }
+        val signature = (if (view.started) 1L shl 40 else 0L) + (view.cond.toLong() shl 24) + questItems + bot.classId.id * 7919L
+        val now = System.currentTimeMillis()
+        if (signature != lastSignature) {
+            lastSignature = signature
+            lastProgressAt = now
+            travelFailures = 0
+            return
+        }
+        if (now - lastProgressAt > STUCK_MS || travelFailures > MAX_TRAVEL_FAILURES) {
+            giveUp(path, if (travelFailures > MAX_TRAVEL_FAILURES) "can't get where the quest leads ($lastFailure)" else "no progress for ${STUCK_MS / 60_000} minutes")
+        }
+    }
+
+    private fun giveUp(path: PathQuest, reason: String) {
+        pausedUntil = System.currentTimeMillis() + PAUSE_MS
+        lastProgressAt = pausedUntil
+        travelFailures = 0
+        relax()
+        QuestLog.log(bot, QuestEvent.Stuck, "${path.questName} put aside (${describe(path)}): $reason")
+    }
+
+    private fun describe(path: PathQuest): String {
+        val state = bot.getQuestState(path.questName)
+        return when {
+            QuestView(bot, null).has(path.mark) -> "mark in the bag"
+            state == null || !state.isStarted -> "not taken"
+            else -> "cond ${state.getInt("cond")}"
+        }
+    }
+
+    companion object {
+        // The Path quests refuse players below 19.
+        private const val START_LEVEL = 19
+        private const val CLASS_CHANGE_LEVEL = 20
+        private const val CLASS_CHANGE_SCRIPT = "FirstClassChange"
+        private const val NEAR_RADIUS = 1200
+        private const val SPOT_RADIUS = 1200
+        private const val MIN_WALK_SAVED_BY_TELEPORT = 12000
+        private const val FAR_FROM_TOWN = 20000
+        // About 30 seconds at the default think interval.
+        private const val MAX_IDLE_TICKS = 90
+        private const val EMPTY_SPOT_MS = 10 * 60 * 1000L
+        private const val LIVE_SCAN_MS = 30 * 1000L
+        private const val STUCK_MS = 60 * 60 * 1000L
+        private const val PAUSE_MS = 3 * 60 * 60 * 1000L
+        private const val MAX_TRAVEL_FAILURES = 8
+        private const val WALK_ONLY_MS = 10 * 60 * 1000L
+    }
+}
+
+internal enum class QuestEvent { Started, Step, ClassChanged, Stuck }
+
+/** Quest events by kind for the periodic summary, and the bots busy with a quest right now. */
+internal object QuestLog {
+    private val counts = ConcurrentHashMap<QuestEvent, AtomicInteger>()
+    private val active = ConcurrentHashMap.newKeySet<Int>()
+
+    fun log(bot: Player, event: QuestEvent, message: String) {
+        counts.computeIfAbsent(event) { AtomicInteger() }.incrementAndGet()
+        if (AutobotData.settings.questLog) println("Autobots quests: ${bot.name} (lv ${bot.level} ${bot.classId}): $message")
+    }
+
+    fun setActive(bot: Player, isActive: Boolean) {
+        if (isActive) active.add(bot.objectId) else active.remove(bot.objectId)
+    }
+
+    fun summary(bots: Collection<Autobot>) {
+        val events = QuestEvent.values().joinToString(" ") { "${it.name}=${counts[it]?.getAndSet(0) ?: 0}" }
+        // Bots past 20 still without a profession: those that haven't finished their Path quest yet.
+        val waiting = bots.count { it.level >= 20 && it.classId.level() == 0 }
+        println("Autobots quest summary: $events questing=${active.count { id -> bots.any { it.objectId == id } }} noProfessionAt20=$waiting")
+    }
+}
