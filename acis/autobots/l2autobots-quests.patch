+        gem(MAGICAL_POWERS_RUBY, rosella, "30414-07.htm", ROSELLA_LETTER, 30157, "30157-02.htm", CHARM_OF_GRAIN, RED_DOWN, 5, 20466)
+        gem(PURE_AQUAMARINE, rosella, "30414-14.htm", APPETIZING_APPLE, 30371, "30371-02.htm", SAP_OF_THE_MOTHER_TREE, GOLD_LEAVES, 5, 20019)
+        gem(NOBILITY_AMETHYST, rosella, "30414-18.htm", IMMORTAL_LOVE, 30423, null, LUCKY_POTPOURRI, AMETHYST, 2, 20047)
+    }
