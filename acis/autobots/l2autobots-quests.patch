+    private fun PathQuestBuilder.seed(seed: Int, npcId: Int, event: String?, token: Int, trophy: Int, count: Int, vararg monsters: Int) {
+        rule({ !it.has(seed) && it.has(token) && it.count(trophy) < count }, hunt(*monsters))
+        rule({ !it.has(seed) && it.has(token) }, talk(npcId))
+        rule({ !it.has(seed) }, if (event != null) talk(npcId, event) else talk(npcId))
+    }
