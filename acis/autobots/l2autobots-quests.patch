@@ -0,0 +1,78 @@
+package dev.l2j.autobots.population.quests
+
+import net.sf.l2j.gameserver.enums.actors.ClassId
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.scripting.QuestState
+
+/**
+ * What a bot does next in a quest. The quest script itself decides what that achieves: a talk is the same bypass a
+ * client sends, a kill goes through the script's own onKill.
+ */
+internal sealed class QuestAction
+
+/** Walk up to an NPC, open its quest dialog and click [events] in order, like a player reading the window. */
+internal class Talk(val npcId: Int, val events: List<String>) : QuestAction()
+
+/**
+ * Hunt [monsterIds] until a rule further up applies. [weapon] is held while hunting (0 for bare hands) when the script
+ * only counts kills made with it; [orElse] runs when none of those monsters can be found (one the quest spawns).
+ */
+internal class Hunt(val monsterIds: Set<Int>, val weapon: Int?, val orElse: QuestAction?) : QuestAction()
+
+/** What the bot knows about its quest when it decides the next step: the journal step and its own bag. */
+internal class QuestView(val player: Player, val state: QuestState?) {
+    val started get() = state?.isStarted == true
+    val cond get() = state?.getInt("cond") ?: 0
+
+    fun count(itemId: Int): Int {
+        val items = player.inventory.getItemsByItemId(itemId)
+        if (items.isEmpty()) return 0
+        return if (items[0].isStackable) items[0].count else items.size
+    }
+
+    fun has(vararg itemIds: Int) = itemIds.all { count(it) > 0 }
+}
+
+internal class QuestRule(val applies: (QuestView) -> Boolean, val action: QuestAction)
+
+/**
+ * A first profession quest ("Path to ..."): taken from [startNpc] with [startEvents], played by the first matching
+ * rule, and handed in for [mark]. With the mark, a guild master of the bot's race changes the class through the
+ * FirstClassChange script with [masterEvent].
+ */
+internal class PathQuest(
+        val questName: String,
+        val from: ClassId,
+        val to: ClassId,
+        val mark: Int,
+        val masterEvent: String,
+        val startNpc: Int,
+        val startEvents: List<String>,
+        val rules: List<QuestRule>)
+
+internal class PathQuestBuilder(private val questName: String, private val from: ClassId, private val to: ClassId,
+                                private val mark: Int, private val masterEvent: String) {
+    private var startNpc = 0
+    private var startEvents = emptyList<String>()
+    private val rules = mutableListOf<QuestRule>()
+
+    fun start(npcId: Int, vararg events: String) {
+        startNpc = npcId
+        startEvents = events.toList()
+    }
+
+    fun cond(cond: Int, action: QuestAction) = rule({ it.cond == cond }, action)
+
+    fun rule(applies: (QuestView) -> Boolean, action: QuestAction) {
+        rules += QuestRule(applies, action)
+    }
+
+    fun talk(npcId: Int, vararg events: String) = Talk(npcId, events.toList())
+
+    fun hunt(vararg monsterIds: Int, weapon: Int? = null, orElse: QuestAction? = null) = Hunt(monsterIds.toSet(), weapon, orElse)
+
+    fun build() = PathQuest(questName, from, to, mark, masterEvent, startNpc, startEvents, rules.toList())
+}
+
+internal fun path(questName: String, from: ClassId, to: ClassId, mark: Int, masterEvent: String, body: PathQuestBuilder.() -> Unit): PathQuest =
+        PathQuestBuilder(questName, from, to, mark, masterEvent).apply(body).build()
