@@ -0,0 +1,38 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.autofarm.AutofarmManager
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Chat command `.offlinefarm`: whether the character keeps auto hunting after its owner logs out.
+ * The flag lives in the auto hunt settings (character_autofarm_settings) and survives relogins.
+ */
+internal object OfflineFarmCommandHandler {
+
+    const val COMMAND = ".offlinefarm"
+
+    /** Chat commands; true when the line was a command and must not reach the chat. */
+    fun onChat(player: Player, text: String): Boolean {
+        val command = text.trim().lowercase()
+        if (command != COMMAND && !command.startsWith("$COMMAND ")) return false
+
+        val settings = AutofarmManager.getSettings(player)
+        when (command.removePrefix(COMMAND).trim()) {
+            "" -> {
+                settings.offlineEnabled = !settings.offlineEnabled
+                AutofarmManager.onSettingsChanged(player)
+                player.sendMessage("Offline farm: " + (if (settings.offlineEnabled)
+                    "ON — the character keeps auto hunting where it stands when you log out."
+                else
+                    "OFF."))
+            }
+            "on", "off" -> {
+                settings.offlineEnabled = command.removePrefix(COMMAND).trim() == "on"
+                AutofarmManager.onSettingsChanged(player)
+                player.sendMessage("Offline farm: " + (if (settings.offlineEnabled) "ON." else "OFF."))
+            }
+            else -> player.sendMessage("Offline farm: $COMMAND toggles, $COMMAND on|off. The hunt starts where you log out; in a town the character just idles online.")
+        }
+        return true
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineFarmManager.kt b/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineFarmManager.kt
