+++ b/src/main/kotlin/dev/l2j/autobots/population/notice/PlayerNotice.kt
@@ -0,0 +1,376 @@
+package dev.l2j.autobots.population.notice
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.GroupChat
+import dev.l2j.autobots.population.group.GroupFinder
+import dev.l2j.autobots.population.group.PartySize
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.population.group.Role
+import dev.l2j.autobots.population.group.Sociability
+import dev.l2j.autobots.population.llm.Attention.isLiveAudience
+import dev.l2j.autobots.population.llm.BotTalk
+import dev.l2j.autobots.population.llm.Llm
+import dev.l2j.autobots.population.llm.LlmMessage
+import dev.l2j.autobots.population.llm.Persona
+import dev.l2j.autobots.population.trade.PlayerTrade
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.enums.skills.L2EffectType
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.player.BlockList
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Bots notice a real player around them and come up to them first, the way people on a live server do: a party leader
+ * with room or a bot looking for a group asks them along, a bot asks a buffer for a buff, a bot in town offers a spare
+ * item that fits them and haggles over it, a bot that just met them says hi. Each approach is one whisper or line
+ * from one bot; what follows (the party window, the trade window, a buff) goes through the same code a player's own
+ * request would. Spec: `docs/player-notice.md`.
+ */
+internal object PlayerNotice {
+    enum class Kind { Party, Buff, Trade, Greet }
+
+    private const val PAIR_COOLDOWN_MS = 30 * 60_000L
+    private const val GREET_COOLDOWN_MS = 6 * 3_600_000L
+    private const val REBUFFED_MS = 2 * 3_600_000L
+    private const val JUST_MET_MS = 45_000L
+    private const val OPEN_MS = 3 * 60_000L
+    private const val BUFF_WAIT_MS = 2 * 60_000L
+    private const val LOOKER_LEVEL_GAP = 5
+    private const val GREET_ACQUAINTED = 10
+    private const val CANNED_EVERY_MS = 20_000L
+
+    private val YES = Regex("^\\s*(\\+|да\\b|ага|угу|го\\b|гоу|давай|ок\\b|окей|ok\\b|okay|yes|yep|ye\\b|sure|конечно|можно|беру|бери|надо|нужно|нужен|нужна|хочу|кидай|кинь|инвайт|инв\\b|inv\\b|invite|щас|сейчас|sec\\b)", RegexOption.IGNORE_CASE)
+    private val NO = Regex("(^\\s*(нет|неа|не\\b|no\\b|nope|nah|-\\s*$)|не надо|не нужно|не хочу|не сейчас|не буду|отстань|отвали|потом|no thanks|not now|go away)", RegexOption.IGNORE_CASE)
+    private val HELLO = Regex("(привет|прив\\b|здравств|здаров|хай\\b|ку\\b|qq\\b|\\bhi\\b|hello|hey\\b|yo\\b)", RegexOption.IGNORE_CASE)
+
+    /** A question a bot asked a player and waits an answer to: the party it offers or the buff it asked for. */
+    private class Open(val kind: Kind, val expires: Long)
+
+    private val settings get() = AutobotData.settings
+    private val enabled get() = settings.playerNoticeEnabled
+
+    private val lastApproach = ConcurrentHashMap<Int, Long>()
+    private val approaches = ConcurrentHashMap<Int, ArrayDeque<Long>>()
+    private val pairDone = ConcurrentHashMap<String, Long>()
+    private val rebuffed = ConcurrentHashMap<Long, Long>()
+    private val open = ConcurrentHashMap<Long, Open>()
+    private val nearSince = ConcurrentHashMap<Long, Long>()
+    private val lastCanned = ConcurrentHashMap<Long, Long>()
+
+    private val counts = ConcurrentHashMap<String, AtomicInteger>()
+    private fun count(what: String) = counts.computeIfAbsent(what) { AtomicInteger() }.incrementAndGet()
+
+    private fun pair(bot: Player, player: Player): Long = (bot.objectId.toLong() shl 32) or (player.objectId.toLong() and 0xffffffffL)
+
+    fun log(text: String) {
+        if (settings.playerNoticeLog) println("Autobots notice: $text")
+    }
+
+    /** The player's language as bots know it; Russian until they wrote something. */
+    private fun russian(player: Player) = GroupChat.knownRussian(player) ?: true
+
+    // ---- The tick ----
+
+    /** Every population tick (15 s): each player at the keyboard may be approached by one bot around. */
+    fun tick() {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        open.entries.removeIf { it.value.expires < now }
+        rebuffed.entries.removeIf { it.value < now }
+        if (pairDone.size > 5000) pairDone.entries.removeIf { now - it.value > GREET_COOLDOWN_MS }
+        val players = World.getInstance().players.filter { it.isLiveAudience() }
+        val seen = HashSet<Long>()
+        for (player in players) {
+            try {
+                val bots = player.getKnownTypeInRadius(Autobot::class.java, settings.playerNoticeRange).filter { free(it, player) }
+                bots.forEach { seen += pair(it, player).also { key -> nearSince.putIfAbsent(key, now) } }
+                if (!playerFree(player) || !allowed(player, now)) continue
+                approach(player, bots, now)
+            } catch (e: Exception) {
+                e.printStackTrace()
+            }
+        }
+        nearSince.keys.retainAll(seen)
+    }
+
+    private fun playerFree(player: Player) = !player.isDead && !player.isInStoreMode && player.activeTradeList == null &&
+            !player.isInCombat && !player.isProcessingRequest && !player.isProcessingTransaction
+
+    /**
+     * Busy bots don't look around: fighting, in a trade, on a trip or a quest walk, being someone's puppet. A bot behind
+     * its store still sees who passes by: it may say hi or point at its goods, see [tryKind].
+     */
+    private fun free(bot: Autobot, player: Player) = bot.life != null && !bot.isDead && !bot.isInCombat &&
+            bot.activeSequence == null && bot.controller == null && bot.activeTradeList == null && !bot.isProcessingRequest &&
+            !bot.isProcessingTransaction && bot.karma == 0 && !BlockList.isBlocked(player, bot)
+
+    /** At most one approach per player every `playerNoticeEverySeconds` and `playerNoticePerHour` an hour. */
+    private fun allowed(player: Player, now: Long): Boolean {
+        if (now - (lastApproach[player.objectId] ?: 0L) < settings.playerNoticeEverySeconds * 1000L) return false
+        val times = approaches.getOrPut(player.objectId) { ArrayDeque() }
+        synchronized(times) {
+            while (times.isNotEmpty() && now - times.first() > 3_600_000L) times.removeFirst()
+            return times.size < settings.playerNoticePerHour
+        }
+    }
+
+    private fun approached(player: Player, now: Long) {
+        lastApproach[player.objectId] = now
+        val times = approaches.getOrPut(player.objectId) { ArrayDeque() }
+        synchronized(times) { times.addLast(now) }
+    }
+
+    private fun mood(bot: Autobot) = Rnd.get(100) < when (Sociability.of(bot)) {
+        Sociability.Loner -> 20
+        Sociability.Regular -> 50
+        Sociability.TeamPlayer -> 80
+    }
+
+    private fun done(bot: Autobot, player: Player, kind: Kind, now: Long) {
+        pairDone["${bot.objectId}:${player.objectId}:$kind"] = now
+    }
+
+    private fun cooled(bot: Autobot, player: Player, kind: Kind, now: Long): Boolean =
+            now - (pairDone["${bot.objectId}:${player.objectId}:$kind"] ?: 0L) >= if (kind == Kind.Greet) GREET_COOLDOWN_MS else PAIR_COOLDOWN_MS
+
+    private fun approach(player: Player, bots: List<Autobot>, now: Long) {
+        for (bot in bots.shuffled()) {
+            val key = pair(bot, player)
+            if (rebuffed.containsKey(key) || open.containsKey(key)) continue
+            if (Relations.affinity(bot, player) < Relations.AVOID || !mood(bot)) continue
+            val kind = Kind.values().firstOrNull { cooled(bot, player, it, now) && tryKind(it, bot, player, now) } ?: continue
+            done(bot, player, kind, now)
+            // A bot that already wrote to the player doesn't say hi to them afterwards.
+            done(bot, player, Kind.Greet, now)
+            approached(player, now)
+            count(kind.name)
+            return
+        }
+    }
+
+    private fun tryKind(kind: Kind, bot: Autobot, player: Player, now: Long): Boolean = when (kind) {
+        Kind.Party -> !bot.isInStoreMode && offerParty(bot, player, now)
+        Kind.Buff -> !bot.isInStoreMode && askBuff(bot, player, now)
+        Kind.Trade -> (if (bot.isInStoreMode) storeAd(bot, player) else if (bot.isInsideZone(ZoneId.TOWN)) PlayerTrade.offerTo(bot, player, russian(player)) else null)
+                ?.also { whisper(bot, player, Kind.Trade, it) } != null
+        Kind.Greet -> greet(bot, player, now)
+    }
+
+    /** A bot selling in a store calls a passer-by over to the piece that fits them best, the way sellers in town do. */
+    private fun storeAd(bot: Autobot, player: Player): String? {
+        if (bot.storeType != net.sf.l2j.gameserver.enums.actors.StoreType.SELL && bot.storeType != net.sf.l2j.gameserver.enums.actors.StoreType.PACKAGE_SELL) return null
+        val grade = dev.l2j.autobots.population.economy.Gear.gradeFor(player.level)
+        val item = bot.sellList.items.filter { it.item.crystalType == grade && (it.item is net.sf.l2j.gameserver.model.item.kind.Weapon || it.item is net.sf.l2j.gameserver.model.item.kind.Armor) || it.price.toLong() * it.count >= 20_000 }
+                .maxByOrNull { it.price.toLong() * it.count } ?: return null
+        val price = dev.l2j.autobots.population.economy.MarketHaggle.short(item.price)
+        val name = item.item.name + if (item.enchant > 0) " +${item.enchant}" else ""
+        return if (russian(player)) listOf("загляни в лавку, есть $name за $price", "$name за $price в лавке, глянь", "эй, $name не нужен? в лавке за $price").random()
+        else listOf("check my shop, $name for $price", "wts $name $price, in my store").random()
+    }
+
+    // ---- Party ----
+
+    private fun offerParty(bot: Autobot, player: Player, now: Long): Boolean {
+        if (player.isInParty || player.karma > 0) return false
+        val ru = russian(player)
+        val party = bot.party
+        if (party != null) {
+            // A leader with room whose party the player fits, the same judgement as for a player asking to join.
+            if (party.leader !== bot || party.membersCount >= (PartySize.target(party) + 2).coerceAtMost(PartySize.MAX)) return false
+            if (GroupFinder.judge(party, player) != null || GroupFinder.wasOffered(bot, player)) return false
+            val levels = "${party.members.minOf { it.level }}-${party.members.maxOf { it.level }}"
+            val place = GroupFinder.placeName(bot)
+            whisper(bot, player, Kind.Party, if (ru) listOf("привет, нас ${party.membersCount}, $levels ур., качаемся у $place. пойдёшь к нам?",
+                    "го к нам в пати? $levels ур., у $place", "нужен ещё человек в пати, $levels ур. пойдёшь?").random()
+                    else "hi, we are ${party.membersCount} lvl $levels near $place, want to join?")
+            GroupFinder.offered(bot, player)
+            return true
+        }
+        // A bot looking for a group asks the player it ran into.
+        if (!GroupFinder.isLooking(bot) || kotlin.math.abs(bot.level - player.level) > LOOKER_LEVEL_GAP) return false
+        open[pair(bot, player)] = Open(Kind.Party, now + OPEN_MS)
+        whisper(bot, player, Kind.Party, if (ru) listOf("го в пати? одному тяжко", "привет, пати ищешь? я тоже", "давай вместе покачаемся?").random()
+                else listOf("party? solo is hard", "hi, lf party? me too", "wanna hunt together?").random())
+        return true
+    }
+
+    /** The bot asked this player to group up: an invite from them is accepted, see PartyInvites. */
+    fun askedToJoin(bot: Autobot, player: Player): Boolean = open[pair(bot, player)]?.let { it.kind == Kind.Party && it.expires > System.currentTimeMillis() } == true
+
+    // ---- Buff ----
+
+    private fun askBuff(bot: Autobot, player: Player, now: Long): Boolean {
+        val role = Role.of(player.classId)
+        if (role != Role.Buffer && role != Role.Healer) return false
+        if (bot.party != null && bot.party === player.party) return false
+        if (bot.level > player.level + 10 || bot.isInsideZone(ZoneId.TOWN) && Rnd.get(100) < 50) return false
+        // Somebody's buffs already on it: no need to beg.
+        if (bot.allEffects.any { it.effectType == L2EffectType.BUFF && it.effector !== bot }) return false
+        val key = pair(bot, player)
+        open[key] = Open(Kind.Buff, now + BUFF_WAIT_MS)
+        val ru = russian(player)
+        whisper(bot, player, Kind.Buff, if (ru) listOf("бафни плиз)", "можешь бафнуть? спасибо заранее", "баф не кинешь?", "бб плз").random()
+                else listOf("buff pls?", "can u buff me pls", "bb pls :)").random())
+        CoScopes.generalScope.launch {
+            val until = now + BUFF_WAIT_MS
+            while (System.currentTimeMillis() < until && open[key]?.kind == Kind.Buff) {
+                delay(2000)
+                if (!bot.isOnline || !player.isOnline) return@launch
+                if (bot.allEffects.any { it.effector === player }) {
+                    open.remove(key)
+                    count("buffed")
+                    Relations.adjust(bot, player.objectId, 2, 3)
+                    delay(Rnd.get(1000L, 3000L))
+                    val thanks = if (ru) listOf("спс!", "спасибо)", "о, спс", "благодарю)").random() else listOf("ty!", "thx :)", "thanks").random()
+                    if (Rnd.get(100) < 50) bot.say(thanks) else bot.tell(player.name, thanks)
+                    log("${bot.name} got a buff from ${player.name}")
+                    return@launch
+                }
+            }
+        }
+        return true
+    }
+
+    // ---- Greeting ----
+
+    private fun greet(bot: Autobot, player: Player, now: Long): Boolean {
+        val since = nearSince[pair(bot, player)] ?: return false
+        if (now - since > JUST_MET_MS) return false
+        val affinity = Relations.affinity(bot, player)
+        val friend = affinity >= Relations.FRIEND
+        if (affinity < GREET_ACQUAINTED && Sociability.of(bot) == Sociability.Loner) return false
+        val ru = russian(player)
+        val canned = when {
+            friend -> if (ru) listOf("о, ${player.name}! привет)", "${player.name}, здарова!", "привет, ${player.name}, давно не виделись")
+                      else listOf("hey ${player.name}!", "${player.name}! long time no see")
+            affinity >= GREET_ACQUAINTED -> if (ru) listOf("привет, ${player.name}", "о, привет", "${player.name} хай") else listOf("hi ${player.name}", "oh hi")
+            else -> if (ru) listOf("привет", "всем привет", "хай", "прив)") else listOf("hi", "hey", "hello")
+        }.random()
+        val whisperIt = friend && Rnd.get(100) < 50
+        val llm = settings.llmChat && Llm.near.available
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1500L, 5000L))
+            val line = (if (llm) llmGreeting(bot, player, ru, whisperIt) else null) ?: canned
+            if (line == "-" || !bot.isOnline || !player.isOnline) return@launch
+            if (whisperIt) { bot.tell(player.name, line); BotTalk.opened(bot, player, line) } else bot.say(line)
+            log("${bot.name} -> ${player.name} greet${if (whisperIt) " (whisper)" else ""}: $line")
+        }
+        return true
+    }
+
+    private suspend fun llmGreeting(bot: Autobot, player: Player, ru: Boolean, whisper: Boolean): String? {
+        val where = if (bot.isInsideZone(ZoneId.TOWN)) "in town" else "while hunting"
+        val situation = "you just noticed ${player.name} (${player.race.name.lowercase()} ${player.template.className}, level ${player.level}) " +
+                "coming up next to you $where near ${GroupFinder.placeName(bot)}. Greet them the way a player would " +
+                (if (whisper) "in a private message" else "in general chat") + ", one short line; " +
+                "if a player like you would not greet a stranger, reply with exactly -"
+        val reply = Llm.near.chat(Persona.system(bot, player, situation) + (if (ru) " Write in Russian." else " Write in English."),
+                listOf(LlmMessage("user", "(${player.name} is next to you)")), settings.llmMaxReplyTokens, Llm.Purpose.Talk) ?: return null
+        val line = reply.text.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() }?.removePrefix("${bot.name}:")?.trim()?.trim('"', '«', '»')?.take(100)
+        return line?.ifBlank { null }
+    }
+
+    // ---- Answers ----
+
+    /**
+     * A whisper from a player to a bot that asked them something: yes or no to its party or buff, or anything about its
+     * trade offer. @return true when it was such an answer.
+     */
+    fun onWhisper(player: Player, bot: Autobot, text: String): Boolean {
+        if (!enabled || player is Autobot || bot.life == null) return false
+        val ru = GroupChat.isRussian(text)
+        GroupChat.rememberLanguage(player, ru)
+        val key = pair(bot, player)
+        if (PlayerTrade.onOfferReply(player, bot, text, ru)?.also { reply ->
+                    log("${player.name} -> ${bot.name} about the offer: '$text' -> $reply")
+                    count("trade_$reply")
+                    if (reply == "no") rebuffed[key] = System.currentTimeMillis() + REBUFFED_MS
+                } != null) return true
+        val asked = open[key]
+        val leaderOffer = GroupFinder.wasOffered(bot, player)
+        if (asked == null && !leaderOffer) return false
+        val no = NO.containsMatchIn(text)
+        val yes = !no && YES.containsMatchIn(text)
+        if (!no && !yes) return false
+        open.remove(key)
+        val kind = asked?.kind ?: Kind.Party
+        log("${player.name} -> ${bot.name} ${if (yes) "yes" else "no"} to ${kind.name.lowercase()}: '$text'")
+        count("${kind.name.lowercase()}_${if (yes) "yes" else "no"}")
+        if (no) {
+            if (leaderOffer) GroupFinder.withdrawOffer(bot)
+            rebuffed[key] = System.currentTimeMillis() + REBUFFED_MS
+            reply(bot, player, if (ru) listOf("ок", "ладно", "ну ок", "понял").random() else listOf("ok", "np", "k").random())
+            return true
+        }
+        when {
+            kind == Kind.Buff -> reply(bot, player, if (ru) listOf("спс)", "жду)", "ок, спасибо").random() else listOf("ty", "thx").random())
+            leaderOffer -> GroupFinder.considerPlayer(bot, player, ru)
+            else -> CoScopes.generalScope.launch {
+                // A bot that asked first sends the invite itself; it is the leader of the new party.
+                delay(Rnd.get(1500L, 4000L))
+                if (bot.isInParty || player.isInParty || !bot.isOnline) return@launch
+                bot.tell(player.name, GroupChat.line(GroupChat.Line.Inviting, ru))
+                delay(Rnd.get(1000L, 2500L))
+                GroupFinder.invitePlayer(bot, player)
+                log("${bot.name} invited ${player.name}")
+            }
+        }
+        return true
+    }
+
+    /**
+     * A whisper nothing else answered and no model to talk: a short line by what the bot is doing, so a player who
+     * writes to a bot is not left hanging. A loner sometimes doesn't bother.
+     */
+    fun cannedReply(player: Player, bot: Autobot, text: String) {
+        if (!enabled || player is Autobot || bot.life == null) return
+        val key = pair(bot, player)
+        val now = System.currentTimeMillis()
+        if (now - (lastCanned[key] ?: 0L) < CANNED_EVERY_MS) return
+        lastCanned[key] = now
+        if (Sociability.of(bot) == Sociability.Loner && Rnd.get(100) < 30) return
+        val ru = GroupChat.isRussian(text) || GroupChat.knownRussian(player) != false && text.none { it.isLetter() }
+        val line = when {
+            bot.isInCombat -> if (ru) listOf("щас, моба добью", "сек, бой", "погоди, дерусь").random() else listOf("sec, fighting", "brb, mob").random()
+            bot.isInStoreMode -> if (ru) listOf("я в лавке, смотри что есть", "торгую, глянь лавку").random() else listOf("in store, check it out", "trading, look at my shop").random()
+            HELLO.containsMatchIn(text) -> if (ru) listOf("привет", "прив)", "хай", "здаров").random() else listOf("hi", "hey", "hello").random()
+            else -> if (ru) listOf("?", "а?", "чего?", "не понял", "ну?").random() else listOf("?", "what?", "huh?").random()
+        }
+        reply(bot, player, line)
+        count("canned")
+        log("${bot.name} -> ${player.name} canned: $line")
+    }
+
+    private fun whisper(bot: Autobot, player: Player, kind: Kind, line: String) {
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1000L, 4000L))
+            if (!bot.isOnline || !player.isOnline) return@launch
+            bot.tell(player.name, line)
+            BotTalk.opened(bot, player, line)
+            log("${bot.name} -> ${player.name} ${kind.name.lowercase()}: $line")
+        }
+    }
+
+    private fun reply(bot: Autobot, player: Player, line: String) {
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1000L, 3000L))
+            if (bot.isOnline && player.isOnline) bot.tell(player.name, line)
+        }
+    }
+
+    /** `Autobots notice summary:` every 10 minutes: approaches by kind, answers, deals and buffs. */
+    fun summary() {
+        if (!enabled) return
+        val players = World.getInstance().players.count { it.isLiveAudience() }
+        val parts = counts.entries.sortedBy { it.key }.joinToString(" ") { "${it.key.lowercase()}=${it.value.getAndSet(0)}" }
+        println("Autobots notice summary: players=$players open=${open.size} $parts")
+    }
+
+}
