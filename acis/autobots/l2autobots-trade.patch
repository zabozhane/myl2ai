@@ -0,0 +1,516 @@
+package dev.l2j.autobots.population.trade
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.AutobotsManager
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.MarketBook
+import dev.l2j.autobots.population.economy.StoreKeeper
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Social trading (stage 2g): bots swap and sell items to each other through the trade window, lend adena and gear
+ * to people they trust and get it back, and a few of them scam. Every kept or broken word goes to the trust memory in
+ * `autobot_relations`. Deals with players are in [PlayerTrade].
+ */
+internal object SocialTrade {
+    private val settings get() = AutobotData.settings
+    val enabled get() = settings.economyEnabled && settings.socialTradeEnabled
+
+    /** Below this a bot refuses to deal with someone at all. */
+    const val NO_DEALS = -30
+    private const val TRUST_HONEST_DEAL = 3
+    private const val TRUST_RETURNED = 15
+    private const val TRUST_RETURNED_LATE = 40
+    private const val TRUST_CAUGHT = -40
+    private const val TRUST_SCAMMED = -80
+    private const val AFFINITY_SCAMMED = -40
+    private const val TOWN_RADIUS = 1500
+    private const val PARTY_REACH = 600
+    private const val HOUR = 3_600_000L
+    private const val DAY = 24 * HOUR
+    private const val ITEM_LOAN_HOURS = 2L
+    private const val PAIR_COOLDOWN_MS = 30 * 60_000L
+    private const val SCAM_COOLDOWN_MS = DAY
+    private const val REMIND_EVERY_MS = 45 * 60_000L
+    private const val OPPORTUNIST_GREED = 20_000L
+
+    private val busy: MutableSet<Int> = ConcurrentHashMap.newKeySet()
+    private val lastAsk = ConcurrentHashMap<Long, Long>()
+    private val lastScam = ConcurrentHashMap<Int, Long>()
+
+    private fun pair(a: Player, b: Player) = a.objectId.toLong() shl 32 or (b.objectId.toLong() and 0xffffffffL)
+
+    private fun cooledDown(a: Player, b: Player, ms: Long = PAIR_COOLDOWN_MS): Boolean {
+        val now = System.currentTimeMillis()
+        if (now - (lastAsk[pair(a, b)] ?: 0L) < ms) return false
+        lastAsk[pair(a, b)] = now
+        return true
+    }
+
+    fun isPopulation(player: Player?): Boolean = player is Autobot && player.life != null
+
+    fun free(bot: Player): Boolean = bot.objectId !in busy && TradeWindow.canTrade(bot) && !bot.isInCombat
+
+    /** Runs [block] with both bots marked busy, so no other deal grabs them meanwhile. */
+    suspend fun <T> dealing(vararg bots: Player, block: suspend () -> T): T? {
+        val ids = bots.map { it.objectId }
+        synchronized(busy) {
+            if (ids.any { it in busy }) return null
+            busy += ids
+        }
+        try {
+            return block()
+        } finally {
+            busy -= ids
+        }
+    }
+
+    // ---- Trust ----
+
+    fun trusts(bot: Player, other: Player): Int = Relations.trust(bot, other.objectId)
+
+    fun refusesDeals(bot: Player, other: Player): Boolean = trusts(bot, other) <= NO_DEALS
+
+    fun honestDeal(a: Player, b: Player) {
+        Relations.adjust(a, b.objectId, TRUST_HONEST_DEAL, 1)
+        Relations.adjust(b, a.objectId, TRUST_HONEST_DEAL, 1)
+    }
+
+    /**
+     * [victim] found out it was scammed: trust and liking crash, it complains to its party and in public, and the
+     * knowledge stage may spread the word.
+     */
+    fun scammed(victim: Player, scammerId: Int, scammerName: String, what: String) {
+        Relations.adjust(victim, scammerId, TRUST_SCAMMED, AFFINITY_SCAMMED)
+        TradeLog.log(victim, TradeDeal.Complaint, "was scammed by $scammerName: $what")
+        TradeEvents.scam(victim, scammerId, scammerName, what)
+        val bot = victim as? Autobot ?: return
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(2000, 6000).toLong())
+            val russian = Rnd.get(100) < 60
+            if (bot.isInParty) bot.partySay(if (russian) "осторожно с $scammerName, кинул меня на $what" else "careful with $scammerName, scammed me on $what")
+            if (Rnd.get(100) < 50) bot.shout(if (russian) listOf("$scammerName кидала! не верните ему ничего", "$scammerName кинул на $what, не ведитесь").random()
+                    else listOf("$scammerName is a scammer, took my $what", "beware $scammerName, scammer").random())
+        }
+    }
+
+    fun caught(victim: Player, scammer: Player, what: String) {
+        Relations.adjust(victim, scammer.objectId, TRUST_CAUGHT, AFFINITY_SCAMMED / 2)
+        TradeLog.log(scammer, TradeDeal.ScamFailed, "${victim.name} noticed the swap: $what")
+    }
+
+    // ---- Loans ----
+
+    /** Why a bot won't lend, in the language it was asked in. */
+    class Refusal(val kind: Kind, private val arg: String = "") {
+        fun text(russian: Boolean) = kind.text(russian).format(arg)
+        override fun toString() = kind.name
+    }
+
+    enum class Kind(private val ru: String, private val en: String) {
+        ScammedMe("ты меня уже кидал, нет", "you scammed me before, no"),
+        StillOwes("сначала верни %s", "give back %s first"),
+        Broke("сам на мели, сорри", "broke myself, sorry"),
+        TooMuch("многовато просишь", "too much, sorry"),
+        Stranger("я тебя не знаю, сорри", "I don't know you, sorry"),
+        NotNow("не, сорри, самому надо", "nah, need it myself");
+
+        fun text(russian: Boolean) = if (russian) ru else en
+    }
+
+    /**
+     * Would [lender] lend [value] worth to [borrower]? @return null for yes, or the reason to give.
+     * Friends and people who returned loans before get it; strangers don't, nor anyone who already owes.
+     */
+    fun refusalToLend(lender: Autobot, borrower: Player, value: Long, adena: Boolean): Refusal? {
+        val trust = trusts(lender, borrower)
+        val affinity = Relations.affinity(lender, borrower)
+        val owes = Loans.between(lender, borrower).firstOrNull()
+        return when {
+            trust <= NO_DEALS -> Refusal(Kind.ScammedMe)
+            owes != null -> Refusal(Kind.StillOwes, owes.name)
+            Honesty.of(lender) == Honesty.Scammer -> Refusal(Kind.Broke)
+            value > limitFor(lender, adena) -> Refusal(Kind.TooMuch)
+            !knows(lender, borrower) -> Refusal(Kind.Stranger)
+            Rnd.get(100) >= (40 + trust / 2 + affinity / 3).coerceIn(10, 95) -> Refusal(Kind.NotNow)
+            else -> null
+        }
+    }
+
+    /** Half of its adena at most; a spare piece it doesn't need, up to what it wears. */
+    private fun limitFor(lender: Player, adena: Boolean): Long =
+            if (adena) lender.adena / 2L else lender.adena + lender.inventory.items.sumOf { if (it.isEquipped) Worth.of(it.itemId, it.enchantLevel, 1) else 0L }
+
+    /** Someone a bot would lend to at all: a friend, someone trusted, a party mate it gets on with. */
+    fun knows(bot: Player, other: Player): Boolean {
+        val affinity = Relations.affinity(bot, other)
+        return affinity >= Relations.FRIEND || trusts(bot, other) >= 30 || (bot.isInParty && bot.party === other.party && affinity >= 10)
+    }
+
+    private fun lenderOf(loan: Loan): Player? = World.getInstance().getPlayer(loan.lenderId)
+
+    private fun borrowerOf(loan: Loan): Player? = World.getInstance().getPlayer(loan.borrowerId)
+
+    /** Does the borrower mean to keep it? Decided once per loan and session. */
+    fun keeps(borrower: Player, loan: Loan, lender: Player?): Boolean {
+        if (loan.kept) return true
+        if (borrower !is Autobot) return false
+        val keep = when (Honesty.of(borrower)) {
+            Honesty.Scammer -> true
+            Honesty.Opportunist -> Worth.of(loan.itemId, loan.enchant, loan.count) >= OPPORTUNIST_GREED && Relations.trust(borrower, loan.lenderId) < 20
+            Honesty.Honest -> false
+        }
+        if (keep && !loan.kept) {
+            loan.kept = true
+            TradeLog.log(borrower, TradeDeal.LoanKept, "keeps ${loan.name} borrowed from ${lender?.name ?: loan.lenderId}")
+        }
+        return keep
+    }
+
+    /** What the borrower would put in the window for [loan]: the very item, or the adena. */
+    private fun repayment(borrower: Player, loan: Loan): ItemInstance? =
+            if (loan.isAdena) borrower.inventory.adenaInstance?.takeIf { it.count >= loan.count }
+            else borrower.inventory.getItemByObjectId(loan.itemObjectId)
+
+    /** Gives back [loan] to a bot lender through the window. @return true when done. */
+    suspend fun repayBot(borrower: Autobot, loan: Loan, lender: Autobot, fast: Boolean = false): Boolean {
+        if (keeps(borrower, loan, lender)) return false
+        val item = repayment(borrower, loan) ?: return false
+        val wasWorn = item.isEquipped
+        val bodyPart = item.item.bodyPart
+        val russian = Rnd.get(100) < 60
+        if (!fast) borrower.tell(lender.name, if (russian) "держи ${loan.name}, спс что выручил" else "here is your ${loan.name}, thanks")
+        val outcome = dealing(borrower, lender) {
+            TradeWindow.exchange(borrower, lender, listOf(item to loan.count), emptyList(), listOf(Promise(loan.itemId, loan.enchant, loan.count)), fast)
+        } ?: return false
+        if (outcome != TradeWindow.Outcome.Done) return false
+        closeLoan(loan, lender, borrower)
+        if (wasWorn) wearBest(borrower, bodyPart)
+        return true
+    }
+
+    /** The lender got its loan back: in time a little more trust, late a part of what the default cost. */
+    fun closeLoan(loan: Loan, lender: Player, borrower: Player) {
+        val late = loan.state == Loan.State.Defaulted
+        Loans.setState(loan, Loan.State.Returned)
+        Relations.adjust(lender, borrower.objectId, if (late) TRUST_RETURNED_LATE else TRUST_RETURNED, if (late) -AFFINITY_SCAMMED / 2 else 5)
+        Relations.adjust(borrower, lender.objectId, 5, 3)
+        TradeLog.log(borrower, if (late) TradeDeal.LoanLate else TradeDeal.LoanReturned, "returned ${loan.name} to ${lender.name}${if (late) " late" else ""}")
+    }
+
+    /** After giving back a borrowed piece, the bot puts on the best one of its own for that slot. */
+    fun wearBest(bot: Player, bodyPart: Int) {
+        val best = bot.inventory.items.filter { !it.isEquipped && it.isEquipable && it.item.bodyPart == bodyPart && !Loans.isBorrowed(bot, it) }
+                .maxByOrNull { it.referencePrice } ?: return
+        Gear.equip(bot, best)
+    }
+
+    /** A lent piece arrived: the borrower wears it right away, that is what it asked for. */
+    private fun wearBorrowed(borrower: Player, loan: Loan) {
+        val item = borrower.inventory.getItemByObjectId(loan.itemObjectId) ?: return
+        if (item.isEquipable && !item.isEquipped) Gear.equip(borrower, item)
+    }
+
+    /** [lender] lends [item] (or [adena]) to [borrower], both bots. @return the loan when the window went through. */
+    private suspend fun lend(lender: Autobot, borrower: Autobot, item: ItemInstance?, adena: Int, due: Long): Loan? {
+        val give = item ?: lender.inventory.adenaInstance ?: return null
+        val count = if (item != null) item.count else adena
+        val itemId = give.itemId
+        val enchant = item?.enchantLevel ?: 0
+        val objectId = item?.objectId ?: 0
+        val outcome = dealing(lender, borrower) {
+            TradeWindow.exchange(lender, borrower, listOf(give to count), emptyList(), listOf(Promise(itemId, enchant, count)))
+        } ?: return null
+        if (outcome != TradeWindow.Outcome.Done) return null
+        val loan = Loans.open(lender, borrower, itemId, objectId, enchant, count, due) ?: return null
+        TradeLog.log(lender, TradeDeal.LoanGiven, "lent ${loan.name} to ${borrower.name} until ${java.time.Instant.ofEpochMilli(due)}")
+        if (!loan.isAdena) wearBorrowed(borrower, loan)
+        return loan
+    }
+
+    // ---- Town: called from the bot's town trip ----
+
+    /** First thing in town: give back what is due to a lender standing around. */
+    suspend fun repayInTown(bot: Autobot) {
+        if (!enabled) return
+        for (loan in Loans.owedBy(bot)) {
+            if (loan.isAdena && Errands.spendable(bot) < loan.count) continue
+            if (!loan.isAdena && loan.state == Loan.State.Open && loan.due > System.currentTimeMillis()) continue
+            val lender = lenderOf(loan) as? Autobot ?: continue
+            if (!isPopulation(lender) || distance(bot, lender) > TOWN_RADIUS || !free(lender)) continue
+            repayBot(bot, loan, lender)
+        }
+    }
+
+    /**
+     * Before buying gear: short of adena for the next kit piece, the bot asks a friend around for the rest, to give
+     * back in a day or two. A scammer asks too, without needing it and without any intention to give it back.
+     */
+    suspend fun borrowForGear(bot: Autobot) {
+        if (!enabled) return
+        val scammer = Honesty.of(bot) == Honesty.Scammer
+        val wish = Gear.wishes(bot).firstOrNull { Market.npcPrice(it.itemId) != null }
+        val price = wish?.let { Market.npcPrice(it.itemId) } ?: 0
+        val shortfall = price - Errands.spendable(bot)
+        val need = when {
+            wish != null && shortfall in 1..(price * 6 / 10) -> shortfall
+            scammer && Rnd.get(100) < 30 && System.currentTimeMillis() - (lastScam[bot.objectId] ?: 0L) > SCAM_COOLDOWN_MS -> Rnd.get(2, 10) * bot.level * 100
+            else -> return
+        }
+        val lender = bot.getKnownTypeInRadius(Autobot::class.java, TOWN_RADIUS)
+                .filter { isPopulation(it) && free(it) && Errands.spendable(it) >= need * 2 && knows(bot, it) }
+                .maxByOrNull { Relations.affinity(it, bot) + trusts(it, bot) } ?: return
+        if (!cooledDown(bot, lender, if (scammer) SCAM_COOLDOWN_MS else PAIR_COOLDOWN_MS)) return
+        val russian = Rnd.get(100) < 60
+        val what = wish?.template?.name ?: if (russian) "банки" else "potions"
+        bot.tell(lender.name, if (russian) "привет, одолжишь $need аден до завтра? на $what не хватает" else "hi, can you lend me $need adena till tomorrow? short for $what")
+        delay(Rnd.get(2000, 5000).toLong())
+        val refusal = refusalToLend(lender, bot, need.toLong(), adena = true)
+        if (refusal != null) {
+            lender.tell(bot.name, refusal.text(russian))
+            TradeLog.log(lender, TradeDeal.Refused, "won't lend $need adena to ${bot.name}: $refusal")
+            return
+        }
+        lender.tell(bot.name, if (russian) "ок, держи, верни потом" else "ok, here, give it back later")
+        if (scammer) lastScam[bot.objectId] = System.currentTimeMillis()
+        lend(lender, bot, null, need, System.currentTimeMillis() + Rnd.get(1, 2) * DAY)
+    }
+
+    /**
+     * Direct deals with bots around: the bot looks for what it wants in their bags (not their stores) and pays with
+     * something they want, adena making up the difference, or with adena alone. A scammer instead sells a lookalike.
+     */
+    suspend fun tradeInTown(bot: Autobot) {
+        if (!enabled) return
+        if (Honesty.of(bot) == Honesty.Scammer && sellLookalike(bot)) return
+        val wanted = Worth.wanted(bot)
+        if (wanted.isEmpty()) return
+        val grade = Gear.gradeFor(bot.level).id
+        for (seller in bot.getKnownTypeInRadius(Autobot::class.java, TOWN_RADIUS).shuffled()) {
+            if (!isPopulation(seller) || !free(seller) || refusesDeals(bot, seller) || refusesDeals(seller, bot)) continue
+            // Anything in the bag it doesn't need, not just what is worth a store slot.
+            val item = Gear.surplus(seller).firstOrNull { it.itemId in wanted && it.isTradable && it.item.crystalType.id <= grade } ?: continue
+            val count = if (item.isStackable) item.count.coerceAtMost(1000) else 1
+            val price = Worth.asking(seller, item, count)
+            // Never above what the shop or the store would take.
+            val limit = (Market.npcPrice(item.itemId)?.toLong()?.times(count) ?: (Worth.of(item.itemId, item.enchantLevel, count) * 13 / 10))
+            if (price > limit) continue
+            if (!cooledDown(bot, seller)) continue
+            buyFrom(bot, seller, item, count, price)
+            return
+        }
+    }
+
+    private suspend fun buyFrom(buyer: Autobot, seller: Autobot, item: ItemInstance, count: Int, price: Long) {
+        val russian = Rnd.get(100) < 60
+        // Pay with goods the seller wants when there are any, adena for the rest.
+        val sellerWants = Worth.wanted(seller)
+        val barter = Gear.surplus(buyer).filter { it.itemId in sellerWants && it.isTradable && it.objectId != item.objectId }
+                .firstOrNull { Worth.of(it.itemId, it.enchantLevel, it.count) <= price * 3 / 2 }
+        val barterValue = barter?.let { Worth.of(it.itemId, it.enchantLevel, it.count) } ?: 0L
+        val adena = (price - barterValue).coerceAtLeast(0).toInt()
+        if (adena > Errands.spendable(buyer)) return
+        val label = "${if (count > 1) "$count " else ""}${item.itemName}${if (item.enchantLevel > 0) " +${item.enchantLevel}" else ""}"
+        buyer.tell(seller.name, when {
+            barter != null && russian -> "меняю ${barter.itemName}${if (adena > 0) " + $adena" else ""} на $label?"
+            barter != null -> "swap my ${barter.itemName}${if (adena > 0) " + $adena" else ""} for your $label?"
+            russian -> "продашь $label за $adena?"
+            else -> "wts $label for $adena?"
+        })
+        delay(Rnd.get(2000, 5000).toLong())
+        seller.tell(buyer.name, if (russian) "давай, кидай трейд" else "ok, trade me")
+        val buyerGives = listOfNotNull(barter?.let { it to it.count }, buyer.inventory.adenaInstance?.takeIf { adena > 0 }?.let { it to adena })
+        val promise = listOf(Promise(item.itemId, item.enchantLevel, count))
+        val outcome = dealing(buyer, seller) {
+            // The seller puts its item first; the buyer reads the window before paying.
+            TradeWindow.exchange(seller, buyer, listOf(item to count), buyerGives, promise)
+        } ?: return
+        if (outcome == TradeWindow.Outcome.Done) {
+            honestDeal(buyer, seller)
+            MarketBook.recordSale(item.itemId, (price / count / Worth.enchantFactor(item.enchantLevel)).toInt(), count)
+            TradeLog.log(buyer, if (barter != null) TradeDeal.Swap else TradeDeal.Sale,
+                    "got $label from ${seller.name} for ${listOfNotNull(barter?.itemName, adena.takeIf { it > 0 }?.let { "$it adena" }).joinToString(" + ")}")
+            buyer.inventory.getItemsByItemId(item.itemId).firstOrNull { it.isEquipable && !it.isEquipped }?.let { Gear.equipUpgradesFromInventory(buyer) }
+        }
+    }
+
+    /**
+     * A scammer offers a bot around the piece it wants and puts a cheaper item of the same kind in the window.
+     * An attentive buyer reads the window and walks away; another one pays and finds out afterwards.
+     */
+    suspend fun sellLookalike(bot: Autobot): Boolean {
+        if (System.currentTimeMillis() - (lastScam[bot.objectId] ?: 0L) < SCAM_COOLDOWN_MS) return false
+        val mine = bot.inventory.items.filter { it.isTradable && !it.isEquipped && (it.isWeapon || it.isArmor) && !Loans.isBorrowed(bot, it) }
+        if (mine.isEmpty()) return false
+        for (victim in bot.getKnownTypeInRadius(Autobot::class.java, TOWN_RADIUS).shuffled()) {
+            if (!isPopulation(victim) || !free(victim) || refusesDeals(victim, bot)) continue
+            for (wish in Gear.wishes(victim)) {
+                val real = wish.template
+                val fake = mine.firstOrNull {
+                    it.itemId != wish.itemId && it.item.bodyPart == real.bodyPart && it.item.itemType == real.itemType && it.referencePrice < real.referencePrice
+                } ?: continue
+                val price = (Market.fairValue(wish.itemId) * 0.7).toInt()
+                if (price > Errands.spendable(victim) || price <= Market.npcSellPrice(fake.itemId)) continue
+                lastScam[bot.objectId] = System.currentTimeMillis()
+                val russian = Rnd.get(100) < 60
+                bot.tell(victim.name, if (russian) "есть ${real.name}, отдам за $price, дешевле чем в магазе" else "got ${real.name}, yours for $price, cheaper than shop")
+                delay(Rnd.get(2000, 5000).toLong())
+                victim.tell(bot.name, if (russian) "о, давай" else "oh, deal")
+                val outcome = dealing(bot, victim) {
+                    TradeWindow.exchange(bot, victim, listOf(fake to 1), listOf(victim.inventory.adenaInstance!! to price), listOf(Promise(wish.itemId, 0, 1)))
+                } ?: return true
+                when (outcome) {
+                    TradeWindow.Outcome.Noticed -> {
+                        caught(victim, bot, real.name)
+                        victim.tell(bot.name, if (russian) "это не ${real.name}, а ${fake.itemName}. кидала" else "that's ${fake.itemName}, not ${real.name}. scammer")
+                    }
+                    TradeWindow.Outcome.Done -> {
+                        TradeLog.log(bot, TradeDeal.Scam, "sold ${fake.itemName} as ${real.name} to ${victim.name} for $price")
+                        CoScopes.generalScope.launch {
+                            // The victim finds out when it tries the piece on.
+                            delay(Rnd.get(10_000, 60_000).toLong())
+                            scammed(victim, bot.objectId, bot.name, "${real.name} (${fake.itemName})")
+                        }
+                    }
+                    TradeWindow.Outcome.Failed -> {}
+                }
+                return true
+            }
+        }
+        return false
+    }
+
+    // ---- Periodic: loans in parties, returns, reminders, defaults ----
+
+    /** Every 30 seconds from the population tick. Deals run in their own coroutines. */
+    fun tick(online: List<Autobot>) {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        try {
+            checkDefaults(now)
+            for (loan in Loans.all()) settleOrRemind(loan, now)
+            for (party in online.filter { it.isInParty && it.party.leader === it }.map { it.party }) partyLoan(party.members)
+            for (bot in online) if (Honesty.of(bot) == Honesty.Scammer) PlayerTrade.maybeScamPlayer(bot)
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    /** A loan overdue by `loanMaxDays` is a scam in the lender's eyes; a bot lender reacts once it is online. */
+    private fun checkDefaults(now: Long) {
+        for (loan in Loans.all()) {
+            if (loan.state != Loan.State.Open || now < loan.due + settings.loanMaxDays * DAY) continue
+            // Only a bot lender online judges; a player decides for themselves.
+            val lender = lenderOf(loan) as? Autobot ?: continue
+            if (!isPopulation(lender)) continue
+            Loans.setState(loan, Loan.State.Defaulted)
+            TradeLog.log(lender, TradeDeal.Scam, "${nameOf(loan.borrowerId)} never returned ${loan.name}")
+            scammed(lender, loan.borrowerId, nameOf(loan.borrowerId), loan.name)
+        }
+    }
+
+    private fun nameOf(objectId: Int): String = World.getInstance().getPlayer(objectId)?.name
+            ?: net.sf.l2j.gameserver.data.sql.PlayerInfoTable.getInstance().getPlayerName(objectId) ?: Loans.nameOf(objectId) ?: "$objectId"
+
+    /**
+     * Both online: a due loan is given back when the two are close (a party, the same spot or town); otherwise the
+     * lender reminds and the borrower answers. Players are handled by [PlayerTrade].
+     */
+    private fun settleOrRemind(loan: Loan, now: Long) {
+        val borrower = borrowerOf(loan) ?: return
+        val lender = lenderOf(loan) ?: return
+        if (!isPopulation(borrower)) return PlayerTrade.remindPlayer(loan, lender, borrower, now)
+        borrower as Autobot
+        if (!isPopulation(lender)) return PlayerTrade.repayPlayer(loan, borrower, lender, now)
+        lender as Autobot
+        val due = loan.due <= now || loan.state == Loan.State.Defaulted
+        val canPay = !loan.isAdena || Errands.spendable(borrower) >= loan.count
+        if ((due || loan.isAdena) && canPay && distance(borrower, lender) <= PARTY_REACH && free(borrower) && free(lender)
+                && !keeps(borrower, loan, lender)) {
+            CoScopes.generalScope.launch { repayBot(borrower, loan, lender) }
+            return
+        }
+        if (due && now - loan.lastReminder > REMIND_EVERY_MS) {
+            loan.lastReminder = now
+            val russian = Rnd.get(100) < 60
+            lender.tell(borrower.name, if (russian) "напоминаю про ${loan.name}, верни как будешь рядом" else "remember my ${loan.name}? give it back when you're around")
+            CoScopes.generalScope.launch {
+                delay(Rnd.get(3000, 10000).toLong())
+                val answer = when {
+                    keeps(borrower, loan, lender) && Rnd.get(100) < 50 -> return@launch
+                    keeps(borrower, loan, lender) -> if (russian) "какой долг? ничего не брал" else "what loan? never took anything"
+                    else -> if (russian) "да, помню, верну как увидимся" else "yes, will give it back when we meet"
+                }
+                borrower.tell(lender.name, answer)
+            }
+        }
+    }
+
+    /**
+     * In a party at rest, a member short of gear asks another for a spare piece that would help it now, until the end
+     * of the session.
+     */
+    private fun partyLoan(members: List<Player>) {
+        val bots = members.filterIsInstance<Autobot>().filter { isPopulation(it) }
+        if (bots.size < 2 || bots.any { it.isInCombat } || Rnd.get(100) >= 20) return
+        for (borrower in bots.shuffled()) {
+            if (!free(borrower)) continue
+            for (lender in bots) {
+                if (lender === borrower || !free(lender) || distance(borrower, lender) > PARTY_REACH) continue
+                val spare = Gear.surplus(lender).firstOrNull { isUpgradeFor(borrower, it) } ?: continue
+                if (!cooledDown(borrower, lender)) continue
+                CoScopes.generalScope.launch { askForItem(borrower, lender, spare) }
+                return
+            }
+        }
+    }
+
+    private fun isUpgradeFor(bot: Player, item: ItemInstance): Boolean = item.isTradable && item.isEquipable && (item.isWeapon || item.isArmor) &&
+            item.item.crystalType.id <= Gear.gradeFor(bot.level).id && (Gear.wishes(bot).any { it.itemId == item.itemId } || Gear.isUpgrade(bot, item))
+
+    suspend fun askForItem(borrower: Autobot, lender: Autobot, item: ItemInstance) {
+        val russian = Rnd.get(100) < 60
+        borrower.partySay(if (russian) "${lender.name}, дай поносить ${item.itemName}? до конца пати, верну" else "${lender.name}, can I borrow ${item.itemName} for this party? will return")
+        delay(Rnd.get(2000, 5000).toLong())
+        val refusal = refusalToLend(lender, borrower, Worth.of(item.itemId, item.enchantLevel, 1), adena = false)
+        if (refusal != null) {
+            lender.partySay(refusal.text(russian))
+            TradeLog.log(lender, TradeDeal.Refused, "won't lend ${item.itemName} to ${borrower.name}: $refusal")
+            return
+        }
+        lender.partySay(if (russian) "держи, потом верни" else "sure, take it")
+        lend(lender, borrower, item, 0, System.currentTimeMillis() + ITEM_LOAN_HOURS * HOUR)
+    }
+
+    /**
+     * Right before a bot logs out: borrowed gear goes back to a lender close by, and a lender takes its things back from
+     * a borrower close by. Quick, like a player who says bye and trades before leaving.
+     */
+    suspend fun beforeLogout(bot: Autobot) {
+        if (!enabled) return
+        for (loan in Loans.owedBy(bot).filter { !it.isAdena }) {
+            val lender = lenderOf(loan) as? Autobot ?: continue
+            if (isPopulation(lender) && distance(bot, lender) <= PARTY_REACH) repayBot(bot, loan, lender, fast = true)
+        }
+        for (loan in Loans.lentBy(bot).filter { !it.isAdena }) {
+            val borrower = borrowerOf(loan) as? Autobot ?: continue
+            if (!isPopulation(borrower) || distance(bot, borrower) > PARTY_REACH) continue
+            bot.tell(borrower.name, if (Rnd.get(100) < 60) "я ухожу, верни ${loan.name}" else "logging off, need my ${loan.name} back")
+            repayBot(borrower, loan, bot, fast = true)
+        }
+    }
+}
