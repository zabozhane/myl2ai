+package dev.l2j.autobots.population.trade
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicInteger
+
+internal enum class TradeDeal { Swap, Sale, LoanGiven, LoanReturned, LoanLate, LoanKept, Scam, ScamFailed, Refused, Gift, Complaint }
+
+internal object TradeLog {
+    private val counts = ConcurrentHashMap<TradeDeal, AtomicInteger>()
+
+    fun log(bot: Player, deal: TradeDeal, message: String) {
+        counts.computeIfAbsent(deal) { AtomicInteger() }.incrementAndGet()
+        if (AutobotData.settings.tradeLog) println("Autobots trade: ${bot.name} (lv ${bot.level}): $message")
+    }
+
+    fun note(bot: Player, message: String) {
+        if (AutobotData.settings.tradeLog) println("Autobots trade: ${bot.name} (lv ${bot.level}): $message")
+    }
+
+    fun summary(online: Collection<Autobot>) {
+        val deals = TradeDeal.values().joinToString(" ") { "$it=${counts[it]?.getAndSet(0) ?: 0}" }
+        val loans = Loans.all()
+        val scammers = online.count { Honesty.of(it) == Honesty.Scammer }
+        println("Autobots trade summary: $deals openLoans=${loans.count { it.state == Loan.State.Open }} " +
+                "defaulted=${loans.count { it.state == Loan.State.Defaulted }} scammersOnline=$scammers/${online.size}")
+    }
+}
+
+/**
+ * What other stages may listen to: a character was found out as a scammer. The knowledge stage (2d) turns it into
+ * rumors; trading itself only changes the victim's own memory.
+ */
+internal object TradeEvents {
+    fun interface ScamListener {
+        fun onScam(victim: Player, scammerId: Int, scammerName: String, what: String)
+    }
+
+    val scamListeners = CopyOnWriteArrayList<ScamListener>()
+
+    fun scam(victim: Player, scammerId: Int, scammerName: String, what: String) {
+        scamListeners.forEach {
+            try {
+                it.onScam(victim, scammerId, scammerName, what)
+            } catch (e: Exception) {
+                e.printStackTrace()
+            }
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/trade/TradeWindow.kt b/src/main/kotlin/dev/l2j/autobots/population/trade/TradeWindow.kt
new file mode 100644
index 0000000..3087178
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/trade/TradeWindow.kt
@@ -0,0 +1,159 @@
+package dev.l2j.autobots.population.trade
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.extensions.moveTo
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.MarketBook
+import dev.l2j.autobots.population.economy.StoreKeeper
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.tradelist.TradeItem
+import net.sf.l2j.gameserver.network.serverpackets.TradeOtherAdd
+
+/** What one side said it would put in the window. */
+internal class Promise(val itemId: Int, val enchant: Int, val count: Int)
+
+/** Prices every deal uses: the economy's own, plus a quarter of the value per enchant level. */
+internal object Worth {
+    fun enchantFactor(enchant: Int): Double = 1 + 0.25 * enchant
+
+    /** What [count] pieces are worth on today's market (MarketBook), more for an enchanted item. */
+    fun of(itemId: Int, enchant: Int, count: Int): Long =
+            if (itemId == Loan.ADENA) count.toLong() else (MarketBook.value(itemId) * enchantFactor(enchant) * count).toLong()
+
+    /** What [bot] would ask for its own item: its store price, so a direct deal is never worse than its store. */
+    fun asking(bot: Autobot, item: ItemInstance, count: Int): Long =
+            (StoreKeeper.askingPrice(bot, item.itemId) * enchantFactor(item.enchantLevel) * count).toLong()
+
+    /** What [bot] would pay for an item: its full value when it wants it, what an NPC pays otherwise. */
+    fun receiving(itemId: Int, enchant: Int, count: Int, wanted: Set<Int>): Long = when {
+        itemId == Loan.ADENA -> count.toLong()
+        itemId in wanted -> of(itemId, enchant, count)
+        else -> (Market.npcSellPrice(itemId) * enchantFactor(enchant) * count).toLong()
+    }
+
+    /** Next kit pieces, things its stores would bid on, materials and recipes a crafter looks for. */
+    fun wanted(bot: Autobot): Set<Int> = (Gear.wishes(bot).map { it.itemId } + StoreKeeper.wanted(bot)).toSet()
+}
+
+/**
+ * The core trade window driven by code: a request and an answer, items put one by one, both confirmations. Nothing
+ * is moved by hand; the exchange is the core's `TradeList`, so a player on the other side sees the usual window.
+ */
+internal object TradeWindow {
+    private const val REACH = 140
+
+    /** Walks [bot] up to [other] if they are a little apart. @return true once they can trade. */
+    suspend fun approach(bot: Player, other: Player, maxDistance: Int = 1500): Boolean {
+        if (distance(bot, other) <= REACH) return true
+        if (distance(bot, other) > maxDistance) return false
+        if (bot.isSitting) bot.standUp()
+        repeat(15) {
+            bot.moveTo(other.x + Rnd.get(-40, 40), other.y + Rnd.get(-40, 40), other.z)
+            delay(1000)
+            if (distance(bot, other) <= REACH) return true
+        }
+        return distance(bot, other) <= Npc.INTERACTION_DISTANCE
+    }
+
+    /** What the core itself would refuse; a fight is the caller's call (a quick trade before logging out is fine). */
+    fun canTrade(bot: Player): Boolean = !bot.isDead && !bot.isInStoreMode && !bot.isProcessingTransaction && !bot.isInOlympiadMode && bot.isOnline
+
+    /** Two bots: one asks, the other answers right away (their decision is made before). */
+    fun open(a: Autobot, b: Autobot): Boolean {
+        if (!canTrade(a) || !canTrade(b)) return false
+        a.startTradeRequest(b)
+        if (b.activeRequester !== a) return false
+        b.answerTradeRequest(true)
+        return a.activeTradeList != null && b.activeTradeList != null
+    }
+
+    /** Puts [count] of [item] in the window, taking it off first if it is worn. */
+    fun put(bot: Player, item: ItemInstance, count: Int): Boolean {
+        val list = bot.activeTradeList ?: return false
+        if (item.isEquipped) {
+            bot.useEquippableItem(item, true)
+            bot.broadcastUserInfo()
+        }
+        if (bot.validateItemManipulation(item.objectId) == null) return false
+        val added = list.addItem(item.objectId, count) ?: return false
+        list.partner?.sendPacket(TradeOtherAdd(added))
+        return true
+    }
+
+    fun putAdena(bot: Player, amount: Int): Boolean {
+        val adena = bot.inventory.adenaInstance ?: return false
+        return amount in 1..adena.count && put(bot, adena, amount)
+    }
+
+    fun partnerItems(bot: Player): List<TradeItem> = bot.activeTradeList?.partner?.activeTradeList?.items ?: emptyList()
+
+    fun partnerConfirmed(bot: Player): Boolean = bot.activeTradeList?.partner?.activeTradeList?.isConfirmed == true
+
+    /**
+     * Does what the partner put match the promise? An attentive bot reads names and enchant levels; another one only
+     * glances at the icons: the same kind of item and the count.
+     */
+    fun matches(bot: Player, items: List<TradeItem>, promises: List<Promise>): Boolean = promises.all { promise ->
+        val attentive = Traits.isAttentive(bot)
+        val template = net.sf.l2j.gameserver.data.ItemTable.getInstance().getTemplate(promise.itemId) ?: return@all false
+        items.filter {
+            if (attentive || promise.itemId == Loan.ADENA) it.item.itemId == promise.itemId && it.enchant >= promise.enchant
+            else it.item.bodyPart == template.bodyPart && it.item.type2 == template.type2 && it.item.itemType == template.itemType
+        }.sumOf { it.count } >= promise.count
+    }
+
+    /** Counts of the given item ids in the inventory, to see afterwards whether the exchange happened. */
+    fun snapshot(bot: Player, itemIds: Collection<Int>): Map<Int, Long> =
+            itemIds.associateWith { id -> bot.inventory.getItemsByItemId(id).sumOf { it.count.toLong() } }
+
+    fun gained(bot: Player, before: Map<Int, Long>, expected: Map<Int, Int>): Boolean = expected.all { (id, count) ->
+        bot.inventory.getItemsByItemId(id).sumOf { it.count.toLong() } - (before[id] ?: 0) >= count
+    }
+
+    enum class Outcome { Done, Noticed, Failed }
+
+    /**
+     * A whole deal between two bots: [a] puts [aGives], [b] puts [bGives]. [b] checks [a]'s side against [bExpects]
+     * and cancels if it notices a swap; [a] trusts [b]'s side. Pauses are a player's clicks.
+     */
+    suspend fun exchange(a: Autobot, b: Autobot, aGives: List<Pair<ItemInstance, Int>>, bGives: List<Pair<ItemInstance, Int>>,
+                         bExpects: List<Promise>, fast: Boolean = false): Outcome {
+        suspend fun pause(min: Long, max: Long) = delay(if (fast) 200 else Rnd.get(min, max))
+        fun failed(step: String): Outcome {
+            TradeLog.note(a, "trade with ${b.name} failed: $step")
+            return Outcome.Failed
+        }
+        if (!approach(a, b)) return failed("too far (${distance(a, b).toInt()})")
+        if (!open(a, b)) return failed("no window (busy=${!canTrade(a)}/${!canTrade(b)})")
+        try {
+            pause(1000, 2500)
+            for ((item, count) in aGives) {
+                if (!put(a, item, count)) return failed("couldn't put ${item.itemName}").also { a.cancelActiveTrade() }
+                pause(500, 1500)
+            }
+            for ((item, count) in bGives) {
+                if (!put(b, item, count)) return failed("partner couldn't put ${item.itemName}").also { b.cancelActiveTrade() }
+                pause(500, 1500)
+            }
+            pause(1000, 3000)
+            if (!matches(b, partnerItems(b), bExpects)) {
+                b.cancelActiveTrade()
+                return Outcome.Noticed
+            }
+            val bBefore = snapshot(b, aGives.map { it.first.itemId })
+            a.activeTradeList?.confirm() ?: return failed("window closed before confirming")
+            pause(500, 2000)
+            b.activeTradeList?.confirm() ?: return failed("partner's window closed before confirming")
+            return if (gained(b, bBefore, aGives.groupBy { it.first.itemId }.mapValues { (_, v) -> v.sumOf { it.second } })) Outcome.Done
+            else failed("exchange refused by the core (weight, slots or a changed item)")
+        } finally {
+            if (a.activeTradeList != null) a.cancelActiveTrade()
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/trade/Traits.kt b/src/main/kotlin/dev/l2j/autobots/population/trade/Traits.kt
