+package dev.l2j.autobots.population.trade
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.MarketBook
+import dev.l2j.autobots.population.economy.StoreKeeper
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.tradelist.TradeItem
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Deals between a bot and a player: the player whispers what they want ("продай", "дай поносить", "поноси", "верни")
+ * and opens the trade window, or just opens it and puts something in. The bot answers like a player would, puts its
+ * side in the window and confirms only when the other side is what it agreed to. Keyword matching for now, like
+ * party chat; the LLM of stage 5 takes over the talking later.
+ */
+internal object PlayerTrade {
+    private val RETURN = Regex("(верни|отдай|где (мой|моя|мои|моё)|return|give (it )?back|give me back)", RegexOption.IGNORE_CASE)
+    private val LEND_TO_BOT = Regex("(поноси|бери на время|держи,? (потом )?верн|дам (тебе )?(в долг|взаймы|поносить)|lend you|borrow mine|keep it for)", RegexOption.IGNORE_CASE)
+    private val BORROW = Regex("(дай поносить|дашь поносить|одолжи|займи|займ[её]шь|в долг|взаймы|lend me|can i borrow|borrow)", RegexOption.IGNORE_CASE)
+    private val BUY = Regex("(прода(й|шь|[её]шь)|куплю|\\bwtb\\b|\\bwts\\b|меня(ю|ешь|емся)|обмен|есть (у тебя )?.+\\?|\\bsell\\b|\\bbuy\\b|\\bswap\\b)", RegexOption.IGNORE_CASE)
+    private val AMOUNT = Regex("(\\d+(?:[.,]\\d+)?)\\s*(кк|kk|к|k)?", RegexOption.IGNORE_CASE)
+    private val DURATION = Regex("(\\d+)\\s*(мин|min|час|ч\\b|h\\b|hour|дн|день|дня|day|d\\b)", RegexOption.IGNORE_CASE)
+    private val WEAPON = Regex("(оруж|пуш|пух|меч|лук|посох|кинж|weapon|sword|bow|staff|dagger|blade)", RegexOption.IGNORE_CASE)
+    private val ARMOR = Regex("(брон|сет|шмот|armor|armour)", RegexOption.IGNORE_CASE)
+    private val RUSSIAN = Regex("[а-яА-ЯёЁ]")
+    private val STOP_WORDS = setOf("the", "and", "for", "есть", "дай", "продай")
+
+    private const val PENDING_MS = 3 * 60_000L
+    private const val SESSION_MS = 90_000L
+    private const val HOUR = 3_600_000L
+    private const val PLAYER_ITEM_LOAN_HOURS = 1L
+    private const val PLAYER_ADENA_LOAN_HOURS = 24L
+    private const val SCAM_CHANCE_PER_TICK = 15
+    private const val SCAM_COOLDOWN_MS = 24 * HOUR
+    private const val REMIND_EVERY_MS = 30 * 60_000L
+
+    private sealed class Pending(val botId: Int, val expires: Long = System.currentTimeMillis() + PENDING_MS) {
+        class Sell(botId: Int, val item: ItemInstance, val count: Int, val price: Long, val claimedEnchant: Int) : Pending(botId)
+        class LendToPlayer(botId: Int, val item: ItemInstance?, val adena: Int, val due: Long) : Pending(botId)
+        class LendToBot(botId: Int, val due: Long) : Pending(botId)
+        class Return(botId: Int) : Pending(botId)
+    }
+
+    private val pending = ConcurrentHashMap<Int, Pending>()
+    private val language = ConcurrentHashMap<Int, Boolean>()
+    private val lastScam = ConcurrentHashMap<Int, Long>()
+
+    private fun russian(player: Player) = language[player.objectId] ?: true
+
+    private fun say(bot: Autobot, player: Player, ru: String, en: String) {
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1000, 3000).toLong())
+            bot.tell(player.name, if (russian(player)) ru else en)
+        }
+    }
+
+    // ---- Whispers ----
+
+    /** A whisper from a player to a population bot. @return true if it was about trading. */
+    fun onWhisper(player: Player, bot: Autobot, text: String): Boolean {
+        // A bot behind a store haggles over its store (economy); the trade window is for bots out of a store.
+        if (!SocialTrade.enabled || !SocialTrade.isPopulation(bot) || player is Autobot || bot.isInStoreMode) return false
+        language[player.objectId] = RUSSIAN.containsMatchIn(text)
+        when {
+            RETURN.containsMatchIn(text) -> onReturnAsked(player, bot)
+            LEND_TO_BOT.containsMatchIn(text) -> onLendOffered(player, bot, text)
+            BORROW.containsMatchIn(text) -> onBorrowAsked(player, bot, text)
+            BUY.containsMatchIn(text) -> onBuyAsked(player, bot, text)
+            else -> return false
+        }
+        return true
+    }
+
+    private fun onReturnAsked(player: Player, bot: Autobot) {
+        val owed = Loans.between(player, bot)
+        if (owed.isEmpty()) return say(bot, player, "я тебе ничего не должен", "I don't owe you anything")
+        if (owed.any { SocialTrade.keeps(bot, it, player) }) {
+            if (Rnd.get(100) < 50) say(bot, player, "какой долг? ничего не брал", "what loan? never took anything")
+            return
+        }
+        pending[player.objectId] = Pending.Return(bot.objectId)
+        say(bot, player, "ок, кидай трейд, верну ${owed.joinToString { it.name }}", "ok, trade me, I'll give back ${owed.joinToString { it.name }}")
+    }
+
+    private fun onLendOffered(player: Player, bot: Autobot, text: String) {
+        if (SocialTrade.refusesDeals(bot, player)) return say(bot, player, "от тебя ничего не возьму", "I won't take anything from you")
+        val due = System.currentTimeMillis() + duration(text, PLAYER_ITEM_LOAN_HOURS * HOUR)
+        pending[player.objectId] = Pending.LendToBot(bot.objectId, due)
+        say(bot, player, "о, спс! кидай трейд, верну", "oh thanks! trade me, I'll give it back")
+    }
+
+    private fun onBorrowAsked(player: Player, bot: Autobot, text: String) {
+        val amount = amount(text)
+        val item = if (amount == null) findItem(text, Gear.surplus(bot).filter { it.isTradable && it.isEquipable }) else null
+        if (amount == null && item == null) return say(bot, player, "а что именно? у меня лишнего нет", "what exactly? nothing spare")
+        val value = amount?.toLong() ?: Worth.of(item!!.itemId, item.enchantLevel, 1)
+        if (amount != null && amount > Errands.spendable(bot)) return say(bot, player, "столько нет", "don't have that much")
+        val refusal = SocialTrade.refusalToLend(bot, player, value, adena = amount != null)
+        if (refusal != null) {
+            TradeLog.log(bot, TradeDeal.Refused, "won't lend ${amount ?: item!!.itemName} to ${player.name}: $refusal")
+            return say(bot, player, refusal.text(true), refusal.text(false))
+        }
+        val due = System.currentTimeMillis() + duration(text, (if (amount != null) PLAYER_ADENA_LOAN_HOURS else PLAYER_ITEM_LOAN_HOURS) * HOUR)
+        pending[player.objectId] = Pending.LendToPlayer(bot.objectId, item, amount ?: 0, due)
+        val what = amount?.let { "$it аден" } ?: item!!.itemName
+        say(bot, player, "ок, дам $what, кидай трейд. верни вовремя", "ok, I'll lend you ${amount?.let { "$it adena" } ?: item!!.itemName}, trade me. return it in time")
+    }
+
+    private fun onBuyAsked(player: Player, bot: Autobot, text: String) {
+        if (SocialTrade.refusesDeals(bot, player)) return say(bot, player, "с тобой не торгую", "not trading with you")
+        val goods = Gear.surplus(bot).filter { it.isTradable }
+        val item = findItem(text, goods) ?: return say(bot, player, "такого нет, сорри", "don't have it, sorry")
+        val count = if (item.isStackable) (amount(text) ?: item.count).coerceIn(1, item.count) else 1
+        val price = (Worth.asking(bot, item, count) * trustFactor(bot, player)).toLong().coerceAtLeast(1)
+        pending[player.objectId] = Pending.Sell(bot.objectId, item, count, price, item.enchantLevel)
+        val label = "${if (count > 1) "$count " else ""}${item.itemName}${if (item.enchantLevel > 0) " +${item.enchantLevel}" else ""}"
+        say(bot, player, "$label за $price аден, кидай трейд", "$label for $price adena, trade me")
+    }
+
+    /** Friends get a discount, people who let the bot down pay more. */
+    private fun trustFactor(bot: Player, player: Player): Double {
+        val trust = SocialTrade.trusts(bot, player)
+        return when {
+            Relations.affinity(bot, player) >= Relations.FRIEND || trust >= 30 -> 0.9
+            trust < 0 -> 1.2
+            else -> 1.0
+        }
+    }
+
+    private fun amount(text: String): Int? {
+        if (!Regex("(адена|адены|аден|adena|\\d\\s*(к|k|кк|kk)\\b|\\d{3,})", RegexOption.IGNORE_CASE).containsMatchIn(text)) return null
+        val match = AMOUNT.find(text) ?: return null
+        val number = match.groupValues[1].replace(',', '.').toDoubleOrNull() ?: return null
+        val multiplier = when (match.groupValues[2].lowercase()) {
+            "к", "k" -> 1_000.0
+            "кк", "kk" -> 1_000_000.0
+            else -> 1.0
+        }
+        return (number * multiplier).toLong().coerceIn(1, Int.MAX_VALUE.toLong()).toInt()
+    }
+
+    private fun duration(text: String, default: Long): Long {
+        val match = DURATION.find(text) ?: return default
+        val number = match.groupValues[1].toLongOrNull() ?: return default
+        val unit = match.groupValues[2].lowercase()
+        val ms = when {
+            unit.startsWith("мин") || unit.startsWith("min") -> 60_000L
+            unit.startsWith("д") || unit.startsWith("d") -> 24 * HOUR
+            else -> HOUR
+        }
+        return (number * ms).coerceIn(10 * 60_000L, 7 * 24 * HOUR)
+    }
+
+    /** An item named in free text: by the words of its name, or the best spare weapon or armor when only that is said. */
+    private fun findItem(text: String, items: List<ItemInstance>): ItemInstance? {
+        val lower = text.lowercase()
+        val byName = items.map { item ->
+            item to item.itemName.lowercase().split(Regex("[^a-zа-я0-9]+")).count { it.length >= 3 && it !in STOP_WORDS && lower.contains(it) }
+        }.filter { it.second > 0 }.maxWithOrNull(compareBy<Pair<ItemInstance, Int>> { it.second }.thenBy { it.first.referencePrice })?.first
+        if (byName != null) return byName
+        if (WEAPON.containsMatchIn(text)) return items.filter { it.isWeapon }.maxByOrNull { it.referencePrice }
+        if (ARMOR.containsMatchIn(text)) return items.filter { it.isArmor }.maxByOrNull { it.referencePrice }
+        return null
+    }
+
+    // ---- The trade window ----
+
+    /** Called when a player asks a population bot to trade (the request packet). */
+    fun onTradeRequest(player: Player, bot: Autobot) {
+        if (!SocialTrade.enabled || !SocialTrade.isPopulation(bot) || player is Autobot) return
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1000, 3000).toLong())
+            if (bot.activeRequester !== player) return@launch
+            when {
+                SocialTrade.refusesDeals(bot, player) -> {
+                    bot.answerTradeRequest(false)
+                    TradeLog.log(bot, TradeDeal.Refused, "won't trade with ${player.name}")
+                    say(bot, player, "с тобой не торгую, ты меня кинул", "not trading with you, you scammed me")
+                }
+                bot.isDead || bot.isInCombat || bot.isInStoreMode || !SocialTrade.free(bot) -> bot.answerTradeRequest(false)
+                else -> {
+                    bot.answerTradeRequest(true)
+                    if (bot.activeTradeList != null) SocialTrade.dealing(bot) { session(bot, player) }
+                }
+            }
+        }
+    }
+
+    /** The bot asks the player for a trade and runs the session once the player accepts. */
+    private suspend fun requestTrade(bot: Autobot, player: Player) {
+        if (!TradeWindow.approach(bot, player)) return
+        if (!SocialTrade.free(bot) || player.isProcessingTransaction) return
+        SocialTrade.dealing(bot) {
+            bot.startTradeRequest(player)
+            repeat(20) {
+                delay(1000)
+                if (bot.activeTradeList != null) return@dealing session(bot, player)
+            }
+        }
+    }
+
+    /**
+     * One trade window with a player, from start to end. What the bot puts and when it confirms depends on what
+     * was agreed in whispers; with nothing agreed, the bot gives back what it owes, takes back what it lent, or
+     * offers adena for things it wants.
+     */
+    private suspend fun session(bot: Autobot, player: Player) {
+        val agreed = pending[player.objectId]?.takeIf { it.botId == bot.objectId && it.expires > System.currentTimeMillis() }
+        pending.remove(player.objectId)
+        val owed = Loans.between(player, bot).filter { !SocialTrade.keeps(bot, it, player) }
+        val lent = Loans.between(bot, player)
+        val start = System.currentTimeMillis()
+
+        var gives = emptyList<Pair<ItemInstance, Int>>()
+        var ready: (List<TradeItem>) -> Boolean = { true }
+        var done: (List<TradeItem>) -> Unit = {}
+        var offeredFor: List<TradeItem>? = null
+
+        when {
+            agreed is Pending.Sell -> {
+                gives = listOf(agreed.item to agreed.count)
+                ready = { items -> value(bot, items) >= agreed.price }
+                done = { items ->
+                    if (agreed.claimedEnchant > agreed.item.enchantLevel) TradeLog.log(bot, TradeDeal.Scam,
+                            "sold ${agreed.item.itemName} +${agreed.item.enchantLevel} as +${agreed.claimedEnchant} to ${player.name} for ${value(bot, items)}")
+                    else {
+                        SocialTrade.honestDeal(bot, player)
+                        MarketBook.recordSale(agreed.item.itemId, (agreed.price / agreed.count / Worth.enchantFactor(agreed.item.enchantLevel)).toInt(), agreed.count)
+                        TradeLog.log(bot, TradeDeal.Sale, "sold ${agreed.count} ${agreed.item.itemName} to ${player.name} for ${value(bot, items)}")
+                    }
+                }
+            }
+            owed.isNotEmpty() && (agreed == null || agreed is Pending.Return) -> {
+                gives = owed.mapNotNull { loan -> repayment(bot, loan)?.let { it to loan.count } }
+                val wornParts = gives.filter { it.first.isEquipped }.map { it.first.item.bodyPart }
+                done = {
+                    owed.forEach { SocialTrade.closeLoan(it, player, bot) }
+                    wornParts.forEach { SocialTrade.wearBest(bot, it) }
+                }
+            }
+            agreed is Pending.LendToPlayer -> {
+                val give = agreed.item ?: bot.inventory.adenaInstance
+                gives = listOfNotNull(give?.let { it to (if (agreed.item != null) it.count else agreed.adena) })
+                done = {
+                    val loan = Loans.open(bot, player, give!!.itemId, agreed.item?.objectId ?: 0, agreed.item?.enchantLevel ?: 0,
+                            if (agreed.item != null) give.count else agreed.adena, agreed.due)
+                    if (loan != null) TradeLog.log(bot, TradeDeal.LoanGiven, "lent ${loan.name} to ${player.name}")
+                }
+            }
+            lent.isNotEmpty() && agreed == null -> {
+                ready = { items -> lent.any { loan -> covers(items, loan) } }
+                done = { items -> lent.filter { covers(items, it) }.forEach { SocialTrade.closeLoan(it, bot, player) } }
+            }
+            agreed is Pending.LendToBot -> {
+                ready = { items -> items.isNotEmpty() }
+                done = { items ->
+                    for (item in items) {
+                        val loan = Loans.open(player, bot, item.item.itemId, if (item.item.isStackable) 0 else item.objectId, item.enchant, item.count, agreed.due)
+                        if (loan != null) TradeLog.log(bot, TradeDeal.LoanGiven, "borrowed ${loan.name} from ${player.name}")
+                    }
+                    bot.inventory.items.filter { Loans.isBorrowed(bot, it) && !it.isEquipped && it.isEquipable }.forEach { Gear.equip(bot, it) }
+                }
+            }
+            else -> {
+                // Nothing agreed: the bot looks at what the player puts and offers adena for what it wants.
+                ready = { items -> offeredFor != null && items.size == offeredFor!!.size }
+                done = { items ->
+                    if (offeredFor.isNullOrEmpty()) {
+                        Relations.adjust(bot, player.objectId, 3, 5)
+                        TradeLog.log(bot, TradeDeal.Gift, "got ${items.joinToString { "${it.count} ${it.item.name}" }} from ${player.name}")
+                    } else {
+                        SocialTrade.honestDeal(bot, player)
+                        TradeLog.log(bot, TradeDeal.Sale, "bought ${items.joinToString { "${it.count} ${it.item.name}" }} from ${player.name}")
+                    }
+                }
+            }
+        }
+
+        delay(Rnd.get(1000, 2000).toLong())
+        for ((item, count) in gives) {
+            if (!TradeWindow.put(bot, item, count)) {
+                bot.cancelActiveTrade()
+                return
+            }
+            delay(Rnd.get(500, 1200).toLong())
+        }
+        val givenBefore = TradeWindow.snapshot(bot, gives.map { it.first.itemId })
+        val givenCounts = gives.groupBy { it.first.itemId }.mapValues { (_, v) -> v.sumOf { it.second } }
+        var receivedBefore = emptyMap<Int, Long>()
+        var confirmedWith: List<TradeItem>? = null
+        var asked = false
+        var lastSize = -1
+        var stableSince = System.currentTimeMillis()
+
+        while (bot.activeTradeList != null && System.currentTimeMillis() - start < SESSION_MS) {
+            delay(1000)
+            val items = TradeWindow.partnerItems(bot).toList()
+            if (items.size != lastSize) {
+                lastSize = items.size
+                stableSince = System.currentTimeMillis()
+            }
+            if (!asked && items.isEmpty() && gives.isEmpty() && System.currentTimeMillis() - start > 8000) {
+                asked = true
+                say(bot, player, "?", "?")
+            }
+            // Nothing agreed: once the player's side stays the same for a few seconds, the bot names its price once.
+            if (agreed == null && owed.isEmpty() && lent.isEmpty() && offeredFor == null && items.isNotEmpty() &&
+                    System.currentTimeMillis() - stableSince > 3000) {
+                offeredFor = items
+                val bid = bid(bot, items)
+                if (bid > 0 && TradeWindow.putAdena(bot, bid)) say(bot, player, "даю $bid", "I'll give $bid")
+                else if (bid <= 0) say(bot, player, "мне это не нужно", "I don't need that")
+                else {
+                    bot.cancelActiveTrade()
+                    return
+                }
+            }
+            if (confirmedWith == null && (gives.isNotEmpty() || items.isNotEmpty()) && ready(items)) {
+                // A bot that doesn't need the things (bid 0) never confirms them as a purchase; a gift needs the player first.
+                if (agreed == null && owed.isEmpty() && lent.isEmpty() && bid(bot, items) <= 0 && !TradeWindow.partnerConfirmed(bot)) continue
+                confirmedWith = items
+                receivedBefore = TradeWindow.snapshot(bot, items.map { it.item.itemId })
+                delay(Rnd.get(1000, 2500).toLong())
+                bot.activeTradeList?.confirm()
+            }
+        }
+        if (bot.activeTradeList != null) {
+            bot.cancelActiveTrade()
+            if (agreed is Pending.Sell && agreed.claimedEnchant > agreed.item.enchantLevel) TradeLog.log(bot, TradeDeal.ScamFailed, "${player.name} didn't buy the fake +${agreed.claimedEnchant}")
+            say(bot, player, "долго, давай потом", "too slow, later")
+            return
+        }
+        val received = confirmedWith ?: return
+        // The window closed after the bot confirmed: it went through if the bot's side left or the player's side arrived.
+        val went = if (gives.isNotEmpty()) givenCounts.all { (id, count) ->
+            (givenBefore[id] ?: 0) - bot.inventory.getItemsByItemId(id).sumOf { it.count.toLong() } >= count
+        } else TradeWindow.gained(bot, receivedBefore, received.groupBy { it.item.itemId }.mapValues { (_, v) -> v.sumOf { it.count } })
+        if (went) done(received)
+    }
+
+    private fun repayment(bot: Player, loan: Loan): ItemInstance? =
+            if (loan.isAdena) bot.inventory.adenaInstance?.takeIf { it.count >= loan.count } else bot.inventory.getItemByObjectId(loan.itemObjectId)
+
+    private fun covers(items: List<TradeItem>, loan: Loan): Boolean =
+            items.filter { it.item.itemId == loan.itemId && it.enchant >= loan.enchant }.sumOf { it.count } >= loan.count
+
+    /** The player's side as the bot sees it: adena at face value, items at what they are worth to the bot. */
+    private fun value(bot: Autobot, items: List<TradeItem>): Long {
+        val wanted = Worth.wanted(bot)
+        return items.sumOf { Worth.receiving(it.item.itemId, it.enchant, it.count, wanted) }
+    }
+
+    /** What the bot pays for things it wants: its store bid, within what it can spend. Things it doesn't want: nothing. */
+    private fun bid(bot: Autobot, items: List<TradeItem>): Int {
+        val wanted = Worth.wanted(bot)
+        val total = items.filter { it.item.itemId in wanted }.sumOf { StoreKeeper.bidPrice(bot, it.item.itemId).toLong() * it.count }
+        return total.coerceAtMost(Errands.spendable(bot).toLong()).toInt()
+    }
+
+    // ---- Periodic, from SocialTrade.tick ----
+
+    /** A bot owes a player: honest, it gives it back when due and the player is around, or asks where they are. */
+    fun repayPlayer(loan: Loan, bot: Autobot, player: Player, now: Long) {
+        if (loan.due > now && loan.state == Loan.State.Open) return
+        if (SocialTrade.keeps(bot, loan, player) || repayment(bot, loan) == null) return
+        if (distance(bot, player) <= 1500 && SocialTrade.free(bot) && !player.isProcessingTransaction) {
+            if (now - loan.lastReminder < 2 * 60_000L) return
+            loan.lastReminder = now
+            say(bot, player, "верну ${loan.name}, прими трейд", "giving back ${loan.name}, accept the trade")
+            CoScopes.generalScope.launch { requestTrade(bot, player) }
+        } else if (now - loan.lastReminder > REMIND_EVERY_MS) {
+            loan.lastReminder = now
+            say(bot, player, "хочу вернуть ${loan.name}, ты где? кинь трейд как будешь рядом", "want to give back ${loan.name}, where are you? trade me when near")
+            pending[player.objectId] = Pending.Return(bot.objectId)
+        }
+    }
+
+    /** A player owes a bot: after the due time the bot reminds them now and then. */
+    fun remindPlayer(loan: Loan, lender: Player, player: Player, now: Long) {
+        val bot = lender as? Autobot ?: return
+        if (!SocialTrade.isPopulation(bot) || loan.due > now || now - loan.lastReminder < REMIND_EVERY_MS) return
+        loan.lastReminder = now
+        say(bot, player, "верни ${loan.name}, срок вышел", "your time is up, give back my ${loan.name}")
+    }
+
+    /**
+     * A scammer in town with a player around offers a "cheap enchanted" piece that is +0 in the window. The player
+     * has to read the window to see it.
+     */
+    fun maybeScamPlayer(bot: Autobot) {
+        val now = System.currentTimeMillis()
+        if (!bot.isInsideZone(ZoneId.TOWN) || !SocialTrade.free(bot) || now - (lastScam[bot.objectId] ?: 0L) < SCAM_COOLDOWN_MS) return
+        if (Rnd.get(100) >= SCAM_CHANCE_PER_TICK) return
+        val player = bot.getKnownTypeInRadius(Player::class.java, 1000).firstOrNull { it !is Autobot && !it.isInStoreMode && pending[it.objectId] == null } ?: return
+        val item = bot.inventory.items.filter { it.isTradable && !it.isEquipped && (it.isWeapon || it.isArmor) && it.enchantLevel == 0 &&
+                !Loans.isBorrowed(bot, it) && Market.fairValue(it.itemId) >= 1000 }.maxByOrNull { it.referencePrice } ?: return
+        lastScam[bot.objectId] = now
+        val claimed = Rnd.get(3, 5)
+        val price = (Market.fairValue(item.itemId) * Worth.enchantFactor(claimed) * 0.6).toLong()
+        pending[player.objectId] = Pending.Sell(bot.objectId, item, 1, price, claimed)
+        TradeLog.note(bot, "offers ${item.itemName} as +$claimed to ${player.name} for $price")
+        say(bot, player, "продаю ${item.itemName} +$claimed за $price, срочно надо адены. кидай трейд", "selling ${item.itemName} +$claimed for $price, need adena fast. trade me")
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/trade/SocialTrade.kt b/src/main/kotlin/dev/l2j/autobots/population/trade/SocialTrade.kt
