@@ -0,0 +1,33 @@
+package dev.l2j.autobots.population.trade
+
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.gameserver.model.actor.Player
+
+/** How a bot keeps its word, a trait of the object id like its temper or chronotype. */
+internal enum class Honesty {
+    /** Gives back what it borrowed and puts in the window what it promised. */
+    Honest,
+    /** Keeps a valuable loan from someone it barely trusts. */
+    Opportunist,
+    /** Borrows to keep, sells lookalikes, asks for adena it never returns. */
+    Scammer;
+
+    companion object {
+        fun of(bot: Player): Honesty {
+            val roll = Math.floorMod(bot.objectId * 193 + 71, 100)
+            val settings = AutobotData.settings
+            return when {
+                roll < settings.scammerPercent -> Scammer
+                roll < settings.scammerPercent + settings.opportunistPercent -> Opportunist
+                else -> Honest
+            }
+        }
+    }
+}
+
+internal object Traits {
+    private const val ATTENTIVE_PERCENT = 70
+
+    /** An attentive bot reads the trade window before it confirms; the others glance at the icon and the count. */
+    fun isAttentive(bot: Player): Boolean = Math.floorMod(bot.objectId * 37 + 11, 100) < ATTENTIVE_PERCENT
+}
