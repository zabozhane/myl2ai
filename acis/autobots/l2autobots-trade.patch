+CREATE TABLE IF NOT EXISTS autobot_loans (
+  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
+  `lender_id` INT UNSIGNED NOT NULL,
+  `borrower_id` INT UNSIGNED NOT NULL,
+  `item_id` INT UNSIGNED NOT NULL,
+  `item_object_id` INT UNSIGNED NOT NULL DEFAULT 0,
+  `enchant` SMALLINT NOT NULL DEFAULT 0,
+  `count` INT UNSIGNED NOT NULL DEFAULT 1,
+  `created` BIGINT UNSIGNED NOT NULL DEFAULT 0,
+  `due` BIGINT UNSIGNED NOT NULL DEFAULT 0,
+  `state` TINYINT UNSIGNED NOT NULL DEFAULT 0,
+  PRIMARY KEY (`id`),
+  KEY `lender` (`lender_id`),
+  KEY `borrower` (`borrower_id`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
