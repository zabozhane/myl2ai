diff --git a/src/main/kotlin/dev/l2j/autobots/population/trade/Loans.kt b/src/main/kotlin/dev/l2j/autobots/population/trade/Loans.kt
new file mode 100644
index 0000000..bd4125d
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/trade/Loans.kt
@@ -0,0 +1,141 @@
+package dev.l2j.autobots.population.trade
+
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import java.sql.Statement
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * Something lent: an item (its object id, so the borrower gives back the very same one) or a sum of adena.
+ * [State.Defaulted] is the lender's view of a loan overdue by `loanMaxDays`: a scam, until it is returned after all.
+ */
+internal class Loan(val id: Int, val lenderId: Int, val borrowerId: Int, val itemId: Int, val itemObjectId: Int, val enchant: Int,
+                    val count: Int, val created: Long, val due: Long, var state: State) {
+    enum class State { Open, Returned, Defaulted }
+
+    /** When the borrower last heard about it from the lender or told the lender something; not stored. */
+    var lastReminder = 0L
+    /** The borrower decided to keep it; not stored, decided again after a restart. */
+    var kept = false
+
+    val isAdena get() = itemId == ADENA
+    val name: String get() = if (isAdena) "${count} adena" else
+        (if (enchant > 0) "+$enchant " else "") + (ItemTable.getInstance().getTemplate(itemId)?.name ?: "$itemId")
+
+    companion object {
+        const val ADENA = 57
+    }
+}
+
+/** Loans between characters, bots or players, kept in `autobot_loans`. Open and defaulted loans stay in memory. */
+internal object Loans {
+    private val active = CopyOnWriteArrayList<Loan>()
+
+    fun load() {
+        active.clear()
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("SELECT id, lender_id, borrower_id, item_id, item_object_id, enchant, count, created, due, state FROM autobot_loans WHERE state<>?").use { ps ->
+                    ps.setInt(1, Loan.State.Returned.ordinal)
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) active += Loan(rs.getInt(1), rs.getInt(2), rs.getInt(3), rs.getInt(4), rs.getInt(5), rs.getInt(6),
+                                rs.getInt(7), rs.getLong(8), rs.getLong(9), Loan.State.values()[rs.getInt(10)])
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    fun all(): List<Loan> = active
+
+    fun owedBy(borrower: Player): List<Loan> = active.filter { it.borrowerId == borrower.objectId }
+
+    fun lentBy(lender: Player): List<Loan> = active.filter { it.lenderId == lender.objectId }
+
+    fun between(lender: Player, borrower: Player): List<Loan> = active.filter { it.lenderId == lender.objectId && it.borrowerId == borrower.objectId }
+
+    fun isBorrowed(bot: Player, item: ItemInstance): Boolean = active.any { it.borrowerId == bot.objectId && it.itemObjectId == item.objectId && !it.isAdena }
+
+    /**
+     * Items the borrower must not sell, crystallize or put in a store: the borrowed ones, and for each of them the best
+     * item of the same body part it replaced, so the bot has something to wear again once it gives the loan back.
+     */
+    fun protectedObjects(bot: Player): Set<Int> {
+        val borrowed = active.filter { it.borrowerId == bot.objectId && !it.isAdena }
+        if (borrowed.isEmpty()) return emptySet()
+        val result = HashSet<Int>()
+        for (loan in borrowed) {
+            val item = bot.inventory.getItemByObjectId(loan.itemObjectId) ?: continue
+            result += item.objectId
+            bot.inventory.items.filter { it.objectId != item.objectId && it.item.bodyPart == item.item.bodyPart && it.isEquipable && !isBorrowed(bot, it) }
+                    .maxByOrNull { it.referencePrice }?.let { result += it.objectId }
+        }
+        return result
+    }
+
+    fun open(lender: Player, borrower: Player, itemId: Int, itemObjectId: Int, enchant: Int, count: Int, due: Long): Loan? {
+        val now = System.currentTimeMillis()
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("INSERT INTO autobot_loans (lender_id, borrower_id, item_id, item_object_id, enchant, count, created, due, state) VALUES (?,?,?,?,?,?,?,?,?)",
+                        Statement.RETURN_GENERATED_KEYS).use { ps ->
+                    ps.setInt(1, lender.objectId)
+                    ps.setInt(2, borrower.objectId)
+                    ps.setInt(3, itemId)
+                    ps.setInt(4, itemObjectId)
+                    ps.setInt(5, enchant)
+                    ps.setInt(6, count)
+                    ps.setLong(7, now)
+                    ps.setLong(8, due)
+                    ps.setInt(9, Loan.State.Open.ordinal)
+                    ps.executeUpdate()
+                    ps.generatedKeys.use { keys ->
+                        if (!keys.next()) return null
+                        val loan = Loan(keys.getInt(1), lender.objectId, borrower.objectId, itemId, itemObjectId, enchant, count, now, due, Loan.State.Open)
+                        active += loan
+                        return loan
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+            return null
+        }
+    }
+
+    /** The name of a character who is offline: bots are not in the player table the core keeps in memory. */
+    fun nameOf(objectId: Int): String? {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("SELECT char_name FROM autobots WHERE obj_Id=? UNION SELECT char_name FROM characters WHERE obj_Id=?").use { ps ->
+                    ps.setInt(1, objectId)
+                    ps.setInt(2, objectId)
+                    ps.executeQuery().use { rs -> return if (rs.next()) rs.getString(1) else null }
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+            return null
+        }
+    }
+
+    fun setState(loan: Loan, state: Loan.State) {
+        loan.state = state
+        if (state == Loan.State.Returned) active.remove(loan)
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("UPDATE autobot_loans SET state=? WHERE id=?").use { ps ->
+                    ps.setInt(1, state.ordinal)
+                    ps.setInt(2, loan.id)
+                    ps.executeUpdate()
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+}
