diff --git a/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt b/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt
index d0115f6..b6a74bf 100644
--- a/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt
+++ b/src/main/kotlin/dev/l2j/autobots/population/quests/QuestRunner.kt
@@ -526,7 +526,13 @@ internal class QuestRunner(private val bot: Player) {
             return
         }
         if (distance(bot.location(), spot) > SPOT_RADIUS) {
+            val failures = travelFailures
             travelTo(spot, SPOT_RADIUS)
+            // A spawn point the bot can't get to: the next one, instead of the same walk until the quest is put aside.
+            if (travelFailures > failures && huntSpot == spot) {
+                emptySpots[spot] = System.currentTimeMillis()
+                huntSpot = null
+            }
             return
         }
 
@@ -792,7 +798,18 @@ internal class QuestRunner(private val bot: Player) {
                             ?: null.also { println("Autobots quests: ${bot.name} no walk to ${npc.name} at ${goal.x},${goal.y},${goal.z}" +
                                     " from ${bot.x},${bot.y},${bot.z}: ${travel.probe(bot, bot.location(), goal, HOP_WALK)}") }
                 } else null
-                (if (route != null) walk.withNpcRoute(route) else walk).execute()
+                // A hunting spot far off gets the wider search too, one way: the walk's own planner gave up on the
+                // Execution Grounds from Giran (29k) and on the Evil Eye Lord from the Cave of Trials landing (9k).
+                val huntRoute = if (npc == null && distance(bot.location(), destination) > LONG_NPC_WALK)
+                    travel.toPoint(bot, bot.location(), destination, HOP_WALK) ?: travel.longOneWay(bot, bot.location(), destination, HOP_WALK)
+                            ?: null.also { println("Autobots quests: ${bot.name} no walk to ${destination.x},${destination.y},${destination.z}" +
+                                    " from ${bot.x},${bot.y},${bot.z}: ${travel.probe(bot, bot.location(), destination, HOP_WALK)}") }
+                else null
+                when {
+                    route != null -> walk.withNpcRoute(route)
+                    huntRoute != null -> walk.withRecoveryRoute(huntRoute)
+                    else -> walk
+                }.execute()
             }
         }
     }
