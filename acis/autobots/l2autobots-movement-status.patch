+package dev.l2j.autobots.movement
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.extensions.getActiveSequence
+
+/** Periodic coverage includes bots that never issue a walk order and would otherwise be silent. */
+internal object MovementStatus {
+    fun line(bot: Autobot): String {
+        val sequence=bot.getActiveSequence()?.javaClass?.simpleName ?: "-"
+        val chores=sequence=="TownTrip"
+        val activity=bot.life?.activity?.name ?: "unknown"
+        val traveling=!chores && (sequence!="-" || bot.isMoving && !bot.isAttackingNow)
+        return "Autobots state: ${bot.name} id=${bot.objectId} lv ${bot.level} exp ${bot.exp}" +
+                " at ${bot.x},${bot.y},${bot.z} intention=${bot.ai.desire.intention}" +
+                " target=${bot.target?.objectId ?: "-"} activity=$activity sequence=$sequence" +
+                " traveling=$traveling chores=$chores life=false autofarming=${activity=="Hunt"}" +
+                " dead=${bot.isDead} sitting=${bot.isSitting} store=${bot.isInStoreMode}" +
+                " hp=${bot.currentHp.toInt()}/${bot.maxHp} mp=${bot.currentMp.toInt()}/${bot.maxMp}"
+    }
+
+    fun sample(bots: Collection<Autobot>) {
+        for(bot in bots) runCatching { println(line(bot)) }
+                .onFailure { println("Autobots movement: ${bot.name} id=${bot.objectId} status unavailable: ${it.javaClass.simpleName}") }
+    }
+}
