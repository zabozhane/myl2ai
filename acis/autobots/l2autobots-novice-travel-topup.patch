+    private data class TopUp(val shop: Shop,val product: net.sf.l2j.gameserver.model.buylist.Product,
+                             val quantity: Int,val cost: Long)
+
+    /** Preserve the existing ten-heal travel rule by buying the missing stock, never by pretending it is carried. */
+    private fun noviceTopUpAt(player: Player,origin: Location): TopUp? {
+        val have=Healing.count(player)
+        if(player.level>=20 || have !in 3..9 || Gear.count(player,Gear.SCROLL_OF_ESCAPE)<1) return null
+        val need=10-have
+        return Gear.HEALING_POTIONS.mapNotNull { Market.findProductAt(it,origin) }
+                .filter { it.first.merchant.isVisible && (!it.second.hasLimitedStock() || it.second.count>=need) }
+                .mapNotNull { (shop,product) ->
+                    val price=Market.priceWithTax(shop,product)
+                    if(price<=0) null else TopUp(shop,product,need,price.toLong()*need)
+                }.minByOrNull { it.cost }
+    }
+
+    private fun fareBudgetAt(player: Player,origin: Location): Int {
+        val normal=Errands.travelSpendable(player)
+        val topUp=noviceTopUpAt(player,origin) ?: return normal
+        return maxOf(normal,(player.adena.toLong()-topUp.cost).coerceIn(0L,Int.MAX_VALUE.toLong()).toInt())
+    }
