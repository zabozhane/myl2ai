diff --git a/src/main/kotlin/dev/l2j/autobots/offlinelife/ProfessionGoal.kt b/src/main/kotlin/dev/l2j/autobots/offlinelife/ProfessionGoal.kt
new file mode 100644
index 0000000..8e5e383
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/offlinelife/ProfessionGoal.kt
@@ -0,0 +1,44 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.gameserver.enums.actors.ClassId
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * The profession an owner wants the character to reach (first or second), kept in the character's memo so the
+ * offline life and `.autolife` follow that branch instead of a random one. Residents have no goal.
+ */
+internal object ProfessionGoal {
+
+    private const val MEMO = "autolife_class"
+
+    fun of(player: Player): ClassId? {
+        if (player is Autobot) return null
+        val name = player.memos.getString(MEMO, null) ?: return null
+        return ClassId.VALUES.firstOrNull { it.name == name }
+    }
+
+    /** The class to aim for among [options] (the next step's targets): the goal itself or its parent on the way. */
+    fun pick(player: Player, options: Collection<ClassId>): ClassId? {
+        val goal = of(player) ?: return null
+        return options.firstOrNull { goal == it || goal.childOf(it) }
+    }
+
+    /** A class of the first or second profession that grows out of the current class; null when none matches. */
+    fun parse(player: Player, text: String): ClassId? {
+        val wanted = text.lowercase().filter { it.isLetter() }
+        return ClassId.VALUES.firstOrNull { c ->
+            (c.level() == 1 || c.level() == 2) && c.childOf(player.classId) &&
+                    (c.name.lowercase().filter { it.isLetter() } == wanted || c.toString().lowercase().filter { it.isLetter() } == wanted)
+        }
+    }
+
+    fun set(player: Player, goal: ClassId?) {
+        if (goal == null) player.memos.remove(MEMO) else player.memos.set(MEMO, goal.name)
+        player.memos.storeMe()
+    }
+
+    /** Next steps from the current class, for the help text. */
+    fun choices(player: Player): List<ClassId> =
+            ClassId.VALUES.filter { (it.level() == 1 || it.level() == 2) && it.childOf(player.classId) }
+}
