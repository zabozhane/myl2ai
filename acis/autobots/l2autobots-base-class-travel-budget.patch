diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/GatekeeperTravel.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/GatekeeperTravel.kt
index 200843d..7f05366 100644
--- a/src/main/kotlin/dev/l2j/autobots/population/economy/GatekeeperTravel.kt
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/GatekeeperTravel.kt
@@ -37,7 +37,7 @@ internal object GatekeeperTravel {
     /** Preserve the existing ten-heal travel rule by buying the missing stock, never by pretending it is carried. */
     private fun noviceTopUpAt(player: Player,origin: Location): TopUp? {
         val have=Healing.count(player)
-        if(player.level>=20 || have !in 3..9 || Gear.count(player,Gear.SCROLL_OF_ESCAPE)<1) return null
+        if(!Errands.usesNoviceTravelBudget(player) || have !in 3..9 || Gear.count(player,Gear.SCROLL_OF_ESCAPE)<1) return null
         val need=10-have
         return Gear.HEALING_POTIONS.mapNotNull { Market.findProductAt(it,origin) }
                 .filter { it.first.merchant.isVisible && (!it.second.hasLimitedStock() || it.second.count>=need) }
