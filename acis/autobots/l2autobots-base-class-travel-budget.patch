     /** Prepared novices may use cash for an actual ride: emergency supplies are already in the bag. */
-    fun travelSpendable(bot: Player): Int = if(bot.level<20 && Healing.count(bot)>=10 && Gear.count(bot,Gear.SCROLL_OF_ESCAPE)>0)
