diff --git a/src/main/kotlin/dev/l2j/autobots/population/RouteSafety.kt b/src/main/kotlin/dev/l2j/autobots/population/RouteSafety.kt
new file mode 100644
index 0000000..f4e27f0
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/RouteSafety.kt
@@ -0,0 +1,93 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.extensions.location
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.manager.ZoneManager
+import net.sf.l2j.gameserver.data.sql.SpawnTable
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.zone.type.WaterZone
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.math.*
+
+/** Route checks include hazards between safe endpoints, and floors below a novice's path. */
+internal object RouteSafety {
+    private const val CELL = 2500
+    private const val RADIUS = 900.0
+    private val waterDeaths = ConcurrentHashMap<Pair<Int, Int>, Location>()
+    private data class Threat(val loc: Location, val level: Int)
+    private val threats by lazy {
+        SpawnTable.getInstance().spawns.filter { it.template.isType("Monster") && it.template.aggroRange > 0 }
+                .mapNotNull { s -> (s.loc ?: s.npc?.position)?.let { Threat(Location(it.x,it.y,it.z),s.template.level.toInt()) } }
+                .groupBy { cell(it.loc.x,it.loc.y) }
+    }
+    private fun cell(x: Int,y: Int) = Math.floorDiv(x,CELL) to Math.floorDiv(y,CELL)
+
+    fun load() {
+        L2DatabaseFactory.getInstance().connection.use { con ->
+            con.createStatement().use { it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_water_hazards (cell_x INT NOT NULL,cell_y INT NOT NULL,x INT NOT NULL,y INT NOT NULL,z INT NOT NULL,PRIMARY KEY(cell_x,cell_y))") }
+            con.createStatement().use { st -> st.executeQuery("SELECT x,y,z FROM autobot_water_hazards").use { rs ->
+                while(rs.next()) { val p=Location(rs.getInt(1),rs.getInt(2),rs.getInt(3)); waterDeaths[cell(p.x,p.y)]=p }
+            } }
+        }
+    }
+
+    fun reportWaterDeath(at: Location) {
+        val key=cell(at.x,at.y)
+        waterDeaths[key]=Location(at.x,at.y,at.z)
+        L2DatabaseFactory.getInstance().connection.use { con ->
+            con.prepareStatement("INSERT INTO autobot_water_hazards VALUES (?,?,?,?,?) ON DUPLICATE KEY UPDATE x=VALUES(x),y=VALUES(y),z=VALUES(z)").use {
+                it.setInt(1,key.first);it.setInt(2,key.second);it.setInt(3,at.x);it.setInt(4,at.y);it.setInt(5,at.z);it.executeUpdate()
+            }
+        }
+    }
+
+    fun isWater(at: Location): Boolean = ZoneManager.getInstance().getZone(at.x,at.y,at.z,WaterZone::class.java)!=null
+
+    /** Includes underwater spawn anchors; a spawn is not proof that the shore is reachable. */
+    fun safeDestination(player: Player, at: Location): Boolean = !isWater(at) &&
+            waterDeaths.values.none { hypot((it.x-at.x).toDouble(),(it.y-at.y).toDouble()) < RADIUS }
+
+    fun safeSegment(player: Player, from: Location, to: Location): Boolean {
+        val dx=(to.x-from.x).toDouble();val dy=(to.y-from.y).toDouble()
+        val len2=dx*dx+dy*dy
+        fun crosses(at: Location): Boolean {
+            val initial=hypot((from.x-at.x).toDouble(),(from.y-at.y).toDouble())
+            val final=hypot((to.x-at.x).toDouble(),(to.y-at.y).toDouble())
+            if (initial<RADIUS && final>initial+20) return false // permit an escape from an existing hazard
+            val t=if(len2==0.0) 0.0 else (((at.x-from.x)*dx+(at.y-from.y)*dy)/len2).coerceIn(0.0,1.0)
+            return hypot(from.x+t*dx-at.x,from.y+t*dy-at.y)<RADIUS
+        }
+        for (cx in Math.floorDiv(minOf(from.x,to.x)-1000,CELL)..Math.floorDiv(maxOf(from.x,to.x)+1000,CELL))
+            for (cy in Math.floorDiv(minOf(from.y,to.y)-1000,CELL)..Math.floorDiv(maxOf(from.y,to.y)+1000,CELL)) {
+                if (threats[cx to cy].orEmpty().any { HuntingSpots.isDeadly(it.level,player.level) &&
+                            minOf(abs(it.loc.z-from.z),abs(it.loc.z-to.z))<2500 && crosses(it.loc) }) return false
+            }
+        if (waterDeaths.values.any { crosses(it) }) return false
+        // A swimmer is allowed to reach shore; dry routes must not dip into water along the way.
+        if (!isWater(from)) {
+            val steps=(sqrt(len2)/400).toInt().coerceAtLeast(1)
+            for (i in 1..steps) {
+                val x=from.x+(dx*i/steps).toInt();val y=from.y+(dy*i/steps).toInt()
+                val z=GeoEngine.getInstance().getHeight(x,y,from.z).toInt()
+                if (isWater(Location(x,y,z))) return false
+            }
+        }
+        return true
+    }
+
+    /** Last dry point first; otherwise look for an actual dry ground point around the swimmer. */
+    fun shore(player: Player, remembered: Location?): Location? {
+        if (remembered!=null && safeDestination(player,remembered)) return remembered
+        for (radius in listOf(256,512,1024,2048,4096,6000)) {
+            val dry=(0 until 16).map { i ->
+                val angle=2*Math.PI*i/16
+                val x=player.x+(cos(angle)*radius).toInt();val y=player.y+(sin(angle)*radius).toInt()
+                Location(x,y,GeoEngine.getInstance().getHeight(x,y,player.z).toInt())
+            }.filter { !isWater(it) }
+            if (dry.isNotEmpty()) return dry.minByOrNull { abs(it.z-player.z) }
+        }
+        return null
+    }
+}
