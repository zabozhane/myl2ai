+                        val id = rs.getInt(1)
+                        PlayerInfoTable.getInstance().removePlayer(id)
+                        PlayerInfoTable.getInstance().addPlayer(id, "Autobots", rs.getString(2), rs.getInt(3))
+                    }
+                } }
+                val exists = con.createStatement().use { st -> st.executeQuery("SHOW INDEX FROM autobots WHERE Key_name='autobots_unique_name'").use { it.next() } }
+                if (!exists) con.createStatement().use { it.executeUpdate("ALTER TABLE autobots ADD UNIQUE KEY autobots_unique_name(char_name)") }
+            } catch (e: Exception) {
+                con.rollback()
+                throw e
+            }
+        }
+    }
+}
