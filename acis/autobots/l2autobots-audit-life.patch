--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/PopulationIdentity.kt
@@ -0,0 +1,57 @@
+package dev.l2j.autobots.population
+
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.sql.PlayerInfoTable
+import java.util.Locale
+
+/** Startup-only repair: preserve ids, inventories and relations, rename only colliding bot names. */
+internal object PopulationIdentity {
+    fun repair() {
+        L2DatabaseFactory.getInstance().connection.use { con ->
+            con.autoCommit = false
+            try {
+                val used = mutableSetOf<String>()
+                con.createStatement().use { st -> st.executeQuery("SELECT char_name FROM characters").use { rs ->
+                    while (rs.next()) used += rs.getString(1).lowercase(Locale.ROOT)
+                } }
+                val bots = mutableListOf<Triple<Int, String, Int>>()
+                con.createStatement().use { st -> st.executeQuery("SELECT obj_Id,char_name,accesslevel FROM autobots ORDER BY level DESC,obj_Id").use { rs ->
+                    while (rs.next()) bots += Triple(rs.getInt(1), rs.getString(2), rs.getInt(3))
+                } }
+                // Reserve every original name before choosing suffixes, including names later in the list.
+                val reserved = (used + bots.map { it.second.lowercase(Locale.ROOT) }).toMutableSet()
+                for ((id, original, access) in bots) {
+                    var name = original
+                    if (!used.add(name.lowercase(Locale.ROOT))) {
+                        var suffix = id.toString(36)
+                        var n = 0
+                        do {
+                            val tail = suffix + if (n == 0) "" else (n).toString(36)
+                            name = original.take(16 - tail.length) + tail
+                            n++
+                        } while (!reserved.add(name.lowercase(Locale.ROOT)))
+                        used += name.lowercase(Locale.ROOT)
+                        con.prepareStatement("UPDATE autobots SET char_name=? WHERE obj_Id=?").use { ps ->
+                            ps.setString(1, name); ps.setInt(2, id); ps.executeUpdate()
+                        }
+                        println("Autobots identity: renamed duplicate $original id=$id to $name")
+                    }
+                }
+                con.commit()
+                // No bot has spawned yet; rebuild the shared name registry from the committed names.
+                con.createStatement().use { st -> st.executeQuery("SELECT obj_Id,char_name,accesslevel FROM autobots").use { rs ->
