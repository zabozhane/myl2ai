+    /**
+     * A hunter fell off something at [location] (the top of the fall). The straight way is how bots walk, so a spot
+     * across the ledge is a fall waiting to happen again; one fresh mark is enough to steer everyone around it.
+     */
+    fun reportFallAt(location: Location) {
+        ledges[cellKey(location.x, location.y, location.z)] = Ledge(location, System.currentTimeMillis() + LEDGE_TTL_MS)
+    }
+
+    /**
+     * True when the bot is up where the fall started, the spot is down below and the straight way there passes a
+     * ledge someone recently fell off. A bot that already fell is below the ledge and ignores it: it may hunt in
+     * the ravine it landed in.
+     */
+    private fun crossesLedge(bot: Player, spot: HuntingSpot): Boolean {
+        if (ledges.isEmpty()) return false
+        val now = System.currentTimeMillis()
+        ledges.values.removeIf { it.expiresAt < now }
+        val dx = (spot.location.x - bot.x).toDouble()
+        val dy = (spot.location.y - bot.y).toDouble()
+        val length2 = dx * dx + dy * dy
+        return ledges.values.any { ledge ->
+            if (bot.z < ledge.location.z - LEDGE_Z_TOLERANCE || spot.location.z > ledge.location.z - LEDGE_Z_TOLERANCE) return@any false
+            val t = if (length2 == 0.0) 0.0 else
+                (((ledge.location.x - bot.x) * dx + (ledge.location.y - bot.y) * dy) / length2).coerceIn(0.0, 1.0)
+            val px = bot.x + t * dx - ledge.location.x
+            val py = bot.y + t * dy - ledge.location.y
+            px * px + py * py < LEDGE_AVOID_RADIUS * LEDGE_AVOID_RADIUS
+        }
+    }
+
     fun join(spot: HuntingSpot) {
         hunters.computeIfAbsent(spot.key) { AtomicInteger() }.incrementAndGet()
     }
