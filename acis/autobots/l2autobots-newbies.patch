+    private fun isTired() = player.getHealthPercentage() < TIRED_HEALTH_PERCENT || player.getManaPercentage() < TIRED_MANA_PERCENT ||
+            player.currentHp < minOf(fightCost * FIGHT_COST_MARGIN, player.maxHp * MAX_FIGHT_COST_SHARE)
+
+    private fun trackFightCost() {
+        val fighting = hasLiveTarget() || player.isUnderAttack()
+        if (fighting && hpAtFightStart < 0) hpAtFightStart = player.currentHp
+        if (!fighting && hpAtFightStart >= 0) {
+            val cost = (hpAtFightStart - player.currentHp).coerceAtLeast(0.0)
+            // One easy kill does not make the next monster harmless: the estimate comes down only halfway.
+            fightCost = maxOf(cost, (fightCost + cost) / 2)
+            hpAtFightStart = -1.0
+        }
+    }
 
