+    fun isDeadly(monsterLevel: Int, hunterLevel: Int): Boolean = monsterLevel > hunterLevel + DANGER_LEVELS_ABOVE
+
+    /**
+     * A hunter at [spot] was killed by an aggressive monster far above it. The spawn cells can't tell everything (a
