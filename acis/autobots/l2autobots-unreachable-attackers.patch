+/**
+ * A monster that has the bot as its target but neither sees it nor can walk to it (a skeleton on the cave floor below
+ * a ledge path) is no attack: counting it froze quest walks above the Cave of Trials for the whole session.
+ */
+private fun Player.canReach(monster: Monster): Boolean {
+    if (kotlin.math.abs(monster.z - z) < 200) return true
+    val geo = net.sf.l2j.gameserver.geoengine.GeoEngine.getInstance()
+    return geo.canSeeTarget(monster, this) || geo.canMoveToTarget(monster.x, monster.y, monster.z, x, y, z)
+}
