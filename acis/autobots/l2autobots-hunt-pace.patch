@@ -0,0 +1,55 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.extensions.findClosestGatekeeper
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.HuntingSpot
+import dev.l2j.autobots.population.HuntingSpots
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.NpcTravel
+import dev.l2j.autobots.population.economy.EconomyLog
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+
+/** Leave an empty region through a real nearby gatekeeper and a fare that preserves supplies. */
+internal object HuntRecovery {
+    data class Ride(val gatekeeper: net.sf.l2j.gameserver.model.actor.Npc,val exitId: Int,
+                    val exit: TeleportLocation,val spot: HuntingSpot,val walk: NpcTravel.Walk,var paid: Int=0)
+    fun plan(player: Player,excluded: Set<Long>): Ride? {
+        val gk=player.findClosestGatekeeper() ?: return null
+        if(distance(player,gk)>8000) return null
+        val budget=Errands.spendable(player)
+        val menu=(listOf("data/html/teleporter/${gk.npcId}.htm","data/html/teleporter/${gk.npcId}-1.htm")
+                .mapNotNull { net.sf.l2j.gameserver.data.cache.HtmCache.getInstance().getHtm(it) }).joinToString(" ")
+        val ids=Regex("""_goto\s+(\d+)""").findAll(menu).map { it.groupValues[1].toInt() }.distinct()
+        return ids.mapNotNull { id -> TeleportLocationData.getInstance().getTeleportLocation(id)?.let { id to it } }
+                .filter { (_,exit) -> !exit.isNoble && exit.price>0 && exit.price<=budget &&
+                        dev.l2j.autobots.population.RouteSafety.safeDestination(player,exit) &&
+                        dev.l2j.autobots.population.RouteSafety.safeSegment(player,exit,exit) }
+                .mapNotNull { (id,exit) ->
+                    HuntingSpots.nearArrival(player,exit,excluded).firstNotNullOfOrNull { spot ->
+                        HuntingSpots.huntAnchor(player,spot,exit,validateDirect=false)?.let { anchor ->
+                            NpcTravel.toPoint(player,exit,anchor,8000)?.let { Ride(gk,id,exit,spot,it) }
+                        }
+                    }
+                }.minByOrNull { it.exit.price+it.walk.length/10 }
+    }
+    suspend fun travel(player: Player,ride: Ride): Boolean {
+        val gk=ride.gatekeeper
+        if(!gk.isVisible) return false
+        if(!NpcTravel.reach(player,gk,8000) || !OfflineFarmManager.isActive(player)) return false
+        if(ride.exit.price>Errands.spendable(player)) return false
+        val before=player.adena
+        player.target=gk
+        gk.onBypassFeedback(player,"goto ${ride.exitId}")
+        player.onTeleported()
+        if(distance(player.location(),ride.exit)>200) return false
+        ride.paid=before-player.adena
+        player.target=null
+        EconomyLog.note(player,"paid ${ride.paid} at ${gk.name} for a reachable hunting region (menu ${ride.exitId})")
+        delay(250)
+        return OfflineFarmManager.isActive(player) && !player.isDead
+    }
+}
