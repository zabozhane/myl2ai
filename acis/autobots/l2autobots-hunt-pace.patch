diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/NewbieSupport.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/NewbieSupport.kt
new file mode 100644
index 0000000..6c6ab42
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/NewbieSupport.kt
@@ -0,0 +1,35 @@
+package dev.l2j.autobots.population.economy
+
+import kotlinx.coroutines.delay
+import net.sf.l2j.gameserver.data.xml.NewbieBuffData
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.Npc
+
+/** Eligibility and spells come from the actual server data; success means the effects were received. */
+internal object NewbieSupport {
+    fun spells(player: Player): List<Int> = if(!player.isNewbie) emptyList() else NewbieBuffData.getInstance().buffs
+            .filter { it.isMagicClassBuff==player.isMageClass && player.level in it.lowerLevel..it.upperLevel }.map { it.skillId }
+    fun needs(player: Player): Boolean = spells(player).any { id ->
+        val effect=player.getFirstEffect(id)
+        effect==null || effect.period-effect.time<60
+    }
+    suspend fun receive(player: Player,guide: Npc): Boolean {
+        val ids=spells(player)
+        if(ids.isEmpty() || !guide.isInsideRadius(player,Npc.INTERACTION_DISTANCE,true,false)) return false
+        if(!needs(player)) return true
+        player.target=guide
+        guide.onBypassFeedback(player,"SupportMagic")
+        for(attempt in 1..50) {
+            if(player.isDead) { if(player.target===guide) player.target=null;return false }
+            if(ids.all { id -> player.getFirstEffect(id)?.let { it.period-it.time>=60 }==true }) {
+                if(player.target===guide) player.target=null
+                EconomyLog.note(player,"received newbie buffs from ${guide.name} id=${guide.objectId}: ${ids.joinToString()}")
+                return true
+            }
+            delay(100)
+        }
+        if(player.target===guide) player.target=null
+        EconomyLog.skip(player,"newbie buffs incomplete at ${guide.name}; missing ${ids.filter { player.getFirstEffect(it)==null }}")
+        return false
+    }
+}
