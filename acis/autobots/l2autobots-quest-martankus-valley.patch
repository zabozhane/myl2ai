+    /** A one-way walk through [waypoints] in order, each leg planned on the geodata. */
+    fun through(player: Player,from: Location,waypoints: List<Location>): Walk? {
+        val route=mutableListOf<Location>()
+        var at=from
+        for(point in waypoints) {
+            route+=toPoint(player,at,point,4000)?.points ?: return null
+            at=point
+        }
+        return Walk(route,(listOf(from)+route).zipWithNext().sumOf { distance(it.first,it.second) })
+    }
