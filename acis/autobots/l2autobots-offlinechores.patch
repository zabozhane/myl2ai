+++ b/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineEquipment.kt
@@ -0,0 +1,106 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.autofarm.AutofarmManager
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.trade.Loans
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.items.ArmorType
+import net.sf.l2j.gameserver.enums.skills.Stats
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.item.kind.Item
+import net.sf.l2j.gameserver.model.itemcontainer.Inventory
+import net.sf.l2j.gameserver.skills.Env
+
+/** Conservative upgrades for an owner's character: real item stats, no price-based swaps. */
+internal object OfflineEquipment {
+    fun equip(player: Player) {
+        if (!OfflineFarmManager.isActive(player) || player.isDead || player.isCastingNow || player.isAttackingNow) return
+        AutofarmManager.prepareOfflineBehavior(player)
+        val candidates = player.inventory.items.filter { eligible(player, it) }
+                .sortedByDescending { score(player, it) }
+        for (item in candidates) {
+            if (!OfflineFarmManager.isActive(player)) return
+            val slot = slot(player, item)
+            if (slot < 0 || !fits(player, item)) continue
+            val worn = player.inventory.getPaperdollItem(slot)
+            if (worn == null || score(player, item) > score(player, worn) + 0.01) Gear.equip(player, item)
+        }
+    }
+
+    /** Keep consumables, materials, recipes, future-grade and enhanced/borrowed gear. */
+    fun surplus(player: Player): List<ItemInstance> {
+        val protected = Loans.protectedObjects(player)
+        return player.inventory.items.filter { item ->
+            if (item.isEquipped || !item.isSellable || item.isQuestItem || item.isHeroItem || item.isShadowItem ||
+                    item.isAugmented || item.enchantLevel > 0 || item.objectId in protected ||
+                    item.item.crystalType.id > Gear.gradeFor(player.level).id || (!item.isWeapon && !item.isArmor)) false
+            else {
+                val slot = slot(player, item)
+                val worn = if (slot >= 0) player.inventory.getPaperdollItem(slot) else null
+                worn != null && fits(player, item) && score(player, worn) >= score(player, item)
+            }
+        }
+    }
+
+    private fun eligible(player: Player, item: ItemInstance): Boolean = !item.isEquipped &&
+            item.isEquipable && !item.isQuestItem && !item.isHeroItem && !item.isShadowItem &&
+            (item.isWeapon || item.isArmor) && item.item.crystalType.id <= Gear.gradeFor(player.level).id &&
+            slot(player, item) >= 0
+
+    private fun fits(player: Player, item: ItemInstance): Boolean {
+        val current = player.inventory.getPaperdollItem(slot(player, item))
+        val kit = AutobotData.equipment.firstOrNull { player.level in it.minLevel..it.maxLevel && player.classId == it.classId }
+        if (item.isWeapon) {
+            val expected = kit?.rightHand?.takeIf { it > 0 }?.let { ItemTable.getInstance().getTemplate(it) }
+            if (current != null && item.itemType != current.itemType && item.itemType != expected?.itemType) return false
+            if (current == null && (expected == null || item.itemType != expected.itemType)) return false
+            if (item.weaponItem.isMagical != player.isMageClass) return false
+            // Avoid silently unequipping a shield or a second armor piece.
+            if (item.item.bodyPart == Item.SLOT_LR_HAND && player.inventory.getPaperdollItem(Inventory.PAPERDOLL_LHAND) != null) return false
+        } else if (item.item.type2 != Item.TYPE2_ACCESSORY) {
+            if (current != null && (item.itemType != current.itemType || item.item.bodyPart != current.item.bodyPart)) return false
+            if (current == null && item.itemType == (if (player.isMageClass) ArmorType.HEAVY else ArmorType.MAGIC)) return false
+            if (item.item.bodyPart == Item.SLOT_L_HAND && player.activeWeaponItem?.bodyPart == Item.SLOT_LR_HAND) return false
+            if (item.item.bodyPart == Item.SLOT_LEGS && player.inventory.getPaperdollItem(Inventory.PAPERDOLL_CHEST)?.item?.bodyPart == Item.SLOT_FULL_ARMOR) return false
+            if (item.item.bodyPart == Item.SLOT_FULL_ARMOR && player.inventory.getPaperdollItem(Inventory.PAPERDOLL_LEGS) != null) return false
+        }
+        return true
+    }
+
+    /** Apply the core's own base and enchant functions, without equipping the candidate to measure it. */
+    internal fun score(player: Player, item: ItemInstance): Double {
+        val stat = if (item.isWeapon) {
+            if (player.isMageClass) Stats.MAGIC_ATTACK else Stats.POWER_ATTACK
+        } else if (item.item.type2 == Item.TYPE2_ACCESSORY) Stats.MAGIC_DEFENCE
+        else if (item.item.bodyPart == Item.SLOT_L_HAND) Stats.SHIELD_DEFENCE else Stats.POWER_DEFENCE
+        val env = Env()
+        env.character = player
+        env.target = player
+        env.item = item
+        env.value = 0.0
+        item.item.getStatFuncs(item, player).filter { it.stat == stat }.sortedBy { it.order }.forEach { it.calc(env) }
+        return env.value
+    }
+
+    private fun slot(player: Player, item: ItemInstance): Int = when (item.item.bodyPart) {
+        Item.SLOT_R_HAND, Item.SLOT_LR_HAND -> Inventory.PAPERDOLL_RHAND
+        Item.SLOT_L_HAND -> Inventory.PAPERDOLL_LHAND
+        Item.SLOT_HEAD -> Inventory.PAPERDOLL_HEAD
+        Item.SLOT_CHEST, Item.SLOT_FULL_ARMOR -> Inventory.PAPERDOLL_CHEST
+        Item.SLOT_LEGS -> Inventory.PAPERDOLL_LEGS
+        Item.SLOT_GLOVES -> Inventory.PAPERDOLL_GLOVES
+        Item.SLOT_FEET -> Inventory.PAPERDOLL_FEET
+        Item.SLOT_NECK -> Inventory.PAPERDOLL_NECK
+        Item.SLOT_L_EAR, Item.SLOT_R_EAR, Item.SLOT_LR_EAR -> weaker(player, Inventory.PAPERDOLL_LEAR, Inventory.PAPERDOLL_REAR)
+        Item.SLOT_L_FINGER, Item.SLOT_R_FINGER, Item.SLOT_LR_FINGER -> weaker(player, Inventory.PAPERDOLL_LFINGER, Inventory.PAPERDOLL_RFINGER)
+        else -> -1
+    }
+
+    private fun weaker(player: Player, left: Int, right: Int): Int {
+        val a = player.inventory.getPaperdollItem(left) ?: return left
+        val b = player.inventory.getPaperdollItem(right) ?: return right
+        return if (score(player, a) <= score(player, b)) left else right
+    }
+}
