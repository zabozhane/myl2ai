@@ -0,0 +1,152 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.extensions.moveTo
+import dev.l2j.autobots.population.economy.Approach
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.quests.QuestEvent
+import dev.l2j.autobots.population.quests.QuestLog
+import dev.l2j.autobots.population.quests.QuestWorld
+import dev.l2j.autobots.population.quests.RepeatQuest
+import dev.l2j.autobots.population.quests.RepeatQuests
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.delay
+import dev.l2j.autobots.population.isUnderAttack
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Town errands of an offline-farm character, done like a player's: hand in the repeatable quest the hunt
+ * gathered, sell the junk to a merchant, restock escape scrolls and potions, grab newbie buffs. All of it
+ * reuses the population bots' economy and quest helpers, which already work on any Player. Nothing is given
+ * for free: the quest script pays, the merchant pays, the shop charges.
+ */
+internal object OfflineChores {
+
+    /** One visit to town: quests first (their adena pays for the rest), then sell, then buy, then buffs. */
+    suspend fun run(player: Player) {
+        if (!OfflineFarmManager.isActive(player) || player.isDead) return
+        OfflineEquipment.equip(player)
+        turnInQuests(player)
+        sellJunk(player)
+        buySupplies(player)
+        newbieBuffs(player)
+        player.refreshOverloaded()
+    }
+
+    /** Takes [quest] from [giver] with the same dialog clicks a player makes; the farm walks out afterwards. */
+    suspend fun takeQuest(player: Player, quest: RepeatQuest, giver: Npc) {
+        if (!approach(player, giver)) return
+        player.target = giver
+        pause(player, Rnd.get(1500, 4000).toLong())
+        giver.onBypassFeedback(player, "Quest ${quest.questName}")
+        for (event in quest.takeEvents) {
+            pause(player, Rnd.get(1500, 4000).toLong())
+            player.processQuestEvent(quest.questName, event)
+        }
+        player.target = null
+        if (player.getQuestState(quest.questName)?.isStarted == true)
+            QuestLog.log(player, QuestEvent.Taken, "${quest.questName} taken from ${giver.name} (offline farm, ${quest.rewardNote})")
+    }
+
+    /** Every started repeatable quest with enough loot whose giver stands in this town; the script pays. */
+    private suspend fun turnInQuests(player: Player) {
+        if (!AutobotData.settings.questsEnabled) return
+        for (quest in RepeatQuests.all) {
+            if (!OfflineFarmManager.isActive(player) || player.isDead) return
+            val state = player.getQuestState(quest.questName) ?: continue
+            if (!state.isStarted) continue
+            val items = quest.questItems.sumOf { player.inventory.getInventoryItemCount(it, -1) }
+            if (items < quest.turnInAt) continue
+            val giver = QuestWorld.closestNpc(player, listOf(quest.giver)) ?: continue
+            if (distance(player, giver) > OfflineFarmManager.GIVER_WITHIN) continue
+            if (!approach(player, giver)) continue
+
+            val before = player.adena
+            player.target = giver
+            pause(player, Rnd.get(1500, 4000).toLong())
+            giver.onBypassFeedback(player, "Quest ${quest.questName}")
+            pause(player, Rnd.get(1500, 4000).toLong())
+            player.target = null
+            val earned = player.adena - before
+            if (earned > 0 || player.inventory.getInventoryItemCount(quest.questItems.first(), -1) < items) {
+                QuestLog.adenaEarned(earned)
+                QuestLog.log(player, QuestEvent.TurnedIn,
+                        "${quest.questName} handed in to ${giver.name} (offline farm)" + if (earned > 0) " for $earned adena" else "")
+            }
+        }
+    }
+
+    /** What Gear.surplus marks as unneeded goes to the nearest merchant, like TownTrip does for bots. */
+    private suspend fun sellJunk(player: Player) {
+        val junk = OfflineEquipment.surplus(player)
+        if (junk.isEmpty()) return
+        val shop = Market.closestShop(player) ?: return
+        if (!approach(player, shop.merchant)) return
+        Market.sellToNpc(player, shop, junk)
+    }
+
+    private suspend fun buySupplies(player: Player) {
+        if (Gear.isArcher(player)) buy(player, Gear.arrowId(player), target = 1500, onlyBelow = 500, budgetShare = 0.6)
+        // No town shop sells mana potions in Interlude: mages rest, as players did.
+        val potions = Gear.HEALING_POTIONS.sumOf { Gear.count(player, it) }
+        val potion = Gear.HEALING_POTIONS.firstOrNull { Market.findProduct(player, it) != null }
+        if (potion != null) buy(player, potion, target = 10, onlyBelow = 3, budgetShare = 0.5, have = potions)
+        buy(player, Gear.SCROLL_OF_ESCAPE, target = 2, onlyBelow = 1, budgetShare = 1.0)
+        if (player.level >= 20) {
+            val shotId = Gear.shotId(player)
+            if (shotId > 0) buy(player, shotId, target = 500, onlyBelow = 150, budgetShare = 0.4)
+        }
+    }
+
+    /** Buys up to [target] pieces when the character has fewer than [onlyBelow], spending at most [budgetShare] of its adena. */
+    private suspend fun buy(player: Player, itemId: Int, target: Int, onlyBelow: Int, budgetShare: Double,
+                            have: Int = Gear.count(player, itemId)) {
+        if (have >= onlyBelow) return
+        val (shop, product) = Market.findProduct(player, itemId) ?: return
+        val price = Market.priceWithTax(shop, product).coerceAtLeast(1)
+        val count = minOf(target - have, (player.adena * budgetShare / price).toInt())
+        if (count <= 0) return
+        if (!approach(player, shop.merchant)) return
+        Market.buyFromNpc(player, shop, product, count)
+    }
+
+    private suspend fun newbieBuffs(player: Player) {
+        if (!player.isNewbie || player.level < 10) return
+        val guide = Market.newbieGuideNear(player) ?: return
+        if (!approach(player, guide)) return
+        guide.onBypassFeedback(player, "SupportMagic")
+        pause(player, Rnd.get(1000, 3000).toLong())
+    }
+
+    private suspend fun pause(player: Player, millis: Long) {
+        delay(millis)
+        if (!OfflineFarmManager.isActive(player) || player.isDead || player.isUnderAttack())
+            throw CancellationException("Offline errands interrupted")
+    }
+
+    /**
+     * Walks up to an NPC the way TownTrip.walkTo does for bots: a standing point next to it (some grocers stand
+     * where no path leads), then a short approach, then a pause like a player reading the window.
+     */
+    private suspend fun approach(player: Player, npc: Npc): Boolean {
+        if (!OfflineFarmManager.isActive(player) || player.isDead) return false
+        if (!npc.isInsideRadius(player, Npc.INTERACTION_DISTANCE, true, false)) {
+            val spot = Approach.pointNear(player, npc)
+            if (spot != null) player.moveTo(spot.x, spot.y, spot.z)
+            else player.ai.setIntention(IntentionType.INTERACT, npc)
+            for (second in 1..20) {
+                pause(player, 1000)
+                if (npc.isInsideRadius(player, Npc.INTERACTION_DISTANCE, true, false) || player.isDead) break
+            }
+        }
+        if (!npc.isInsideRadius(player, Npc.INTERACTION_DISTANCE, true, false)) return false
+        player.target = npc
+        pause(player, Rnd.get(1500, 3000).toLong())
+        return OfflineFarmManager.isActive(player) && !player.isDead
+    }
+}
