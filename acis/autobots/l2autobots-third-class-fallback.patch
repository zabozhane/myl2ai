+    /**
+     * The third profession. The bots don't play the sagas yet (fishing, Ketra and Varka drops, 700 Halisha marks and
+     * three solo fights at 76-81 are missing), so at 76 the bot goes to the guild master that gave it the second
+     * profession and gets the third there. Without this the population stayed in its second profession for good.
+     */
+    private suspend fun updateThird(): Boolean {
+        if (bot.level < THIRD_CLASS_LEVEL) return false
+        if (System.currentTimeMillis() < pausedUntil) return false
+        val to = thirdClassFor() ?: return false
+        val masters = SecondClassQuests.classes.firstOrNull { it.to == bot.classId }?.masters.orEmpty()
+        val master = QuestWorld.closestNpc(bot, masters)
+        if (master != null) {
+            if (!reach(master)) return true
+            bot.target = master
+            delay(Rnd.get(1500, 4000).toLong())
+        } else if (!bot.isInsideZone(ZoneId.TOWN)) return false
+        bot.setClassId(to.id)
+        bot.target = null
+        if (bot.classId != to) {
+            pausedUntil = System.currentTimeMillis() + PAUSE_MS
+            return false
+        }
+        applyNewClass()
+        QuestLog.log(bot, QuestEvent.ClassChanged, "became ${bot.classId} without the saga" + (master?.let { " at ${it.name}" } ?: " in town"))
+        return true
+    }
