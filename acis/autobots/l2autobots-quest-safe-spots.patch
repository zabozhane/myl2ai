+    /** Aggressive monsters dangerous to [player] that spawn within [radius] of [at], [ignore]d ones (the prey) aside. */
+    fun dangerNear(player: Player, at: Location, radius: Int, ignore: Set<Int>): Int {
+        var count=0
+        for (cx in Math.floorDiv(at.x-radius,CELL)..Math.floorDiv(at.x+radius,CELL))
+            for (cy in Math.floorDiv(at.y-radius,CELL)..Math.floorDiv(at.y+radius,CELL))
+                count+=threats[cx to cy].orEmpty().count { it.npcId !in ignore && abs(it.loc.z-at.z)<1000 &&
+                        hypot((it.loc.x-at.x).toDouble(),(it.loc.y-at.y).toDouble())<radius && HuntingSpots.isDangerousFor(player,it.level) }
+        return count
+    }
