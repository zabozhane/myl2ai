+    /** The journal is restored once per login, whichever quest kind needs it first. */
+    private fun ensureLoaded() {
+        if (!loaded) {
+            QuestWorld.loadQuestStates(bot)
+            loaded = true
+        }
+    }
+
+    /**
+     * A quester leaving town for [spot] picks up the repeatable quest of that hunting ground when the giver stands
+     * in this town, like a player grabbing an errand on the way out. @return true while the errand owns the tick.
+     */
+    suspend fun beforeLeavingTown(spot: HuntingSpot): Boolean {
+        if (!AutobotData.settings.questsEnabled || bot.isInParty || !RepeatQuests.isQuester(bot)) return false
+        ensureLoaded()
+        // One side job at a time: a quest already running is farmed where its monsters are.
+        if (RepeatQuests.all.any { bot.getQuestState(it.questName)?.isStarted == true }) return false
+        val quest = RepeatQuests.matching(bot, bot.level, spot.npcIds()).firstOrNull() ?: return false
+        val giver = QuestWorld.closestNpc(bot, listOf(quest.giver)) ?: return false
+        if (distance(bot, giver) > GIVER_WITHIN) return false
+        if (!reach(giver)) return true
+
+        bot.target = giver
+        delay(Rnd.get(1500, 4000).toLong())
+        giver.onBypassFeedback(bot, "Quest ${quest.questName}")
+        for (event in quest.takeEvents) {
+            delay(Rnd.get(1500, 4000).toLong())
+            bot.processQuestEvent(quest.questName, event)
+        }
+        bot.target = null
+        if (bot.getQuestState(quest.questName)?.isStarted == true)
+            QuestLog.log(bot, QuestEvent.Taken, "${quest.questName} taken from ${giver.name} on the way out (${quest.rewardNote})")
+        return true
+    }
+
+    /**
+     * A trip to town is the time to hand in what the hunt gathered: every started repeatable quest with enough loot
+     * whose giver is in this town. The quest script itself counts the items and pays.
+     */
+    suspend fun onTownVisit() {
+        if (!AutobotData.settings.questsEnabled) return
+        ensureLoaded()
+        for (quest in RepeatQuests.all) {
+            if (bot.isDead) return
+            val state = bot.getQuestState(quest.questName) ?: continue
+            if (!state.isStarted) continue
+            val items = quest.questItems.sumOf { bot.inventory.getInventoryItemCount(it, -1) }
+            if (items < quest.turnInAt) continue
+            val giver = QuestWorld.closestNpc(bot, listOf(quest.giver)) ?: continue
+            if (distance(bot, giver) > GIVER_WITHIN) continue
+            if (!reach(giver)) continue
+
+            val before = bot.adena
+            bot.target = giver
+            delay(Rnd.get(1500, 4000).toLong())
+            giver.onBypassFeedback(bot, "Quest ${quest.questName}")
+            delay(Rnd.get(1500, 4000).toLong())
+            bot.target = null
+            val earned = bot.adena - before
+            if (earned > 0 || bot.inventory.getInventoryItemCount(quest.questItems.first(), -1) < items) {
+                QuestLog.adenaEarned(earned)
+                QuestLog.log(bot, QuestEvent.TurnedIn, "${quest.questName} handed in to ${giver.name}" + if (earned > 0) " for $earned adena" else "")
+            }
+        }
+    }
+
