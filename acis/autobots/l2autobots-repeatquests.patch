+package dev.l2j.autobots.population.quests
+
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.gameserver.enums.actors.ClassRace
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * A repeatable "bring me the loot" quest a bot does alongside its usual hunt: it is taken when the bot leaves town
+ * for a hunting spot with the quest's monsters, and handed in on the next trip to town. The quest script does the
+ * payouts; this module only walks and talks.
+ *
+ * [turnInAt] is how many quest items make the trip to the giver worth it (for quests that finish and exit, exactly
+ * the count that completes them). [exitsOnTurnIn] quests leave the journal on payout and are taken again before the
+ * next hunt.
+ */
+internal class RepeatQuest(
+        val questName: String,
+        val giver: Int,
+        val takeEvents: List<String>,
+        val minLevel: Int,
+        val maxLevel: Int,
+        val monsters: Set<Int>,
+        val questItems: Set<Int>,
+        val turnInAt: Int,
+        val exitsOnTurnIn: Boolean,
+        val race: ClassRace? = null,
+        val rewardNote: String)
+
+/** The repeatable quests of aCis 382 worth a bot's time; npc, monster and item ids and events are the scripts' own. */
+internal object RepeatQuests {
+
+    val all: List<RepeatQuest> = listOf(
+            // Orc village: Rakeclaw Imps around the village, adena per soulstone.
+            RepeatQuest("Q273_InvadersOfTheHolyLand", 30566, listOf("30566-03.htm"), 6, 16,
+                    setOf(20311, 20312, 20313), setOf(1475, 1476), 10, exitsOnTurnIn = false, race = ClassRace.ORC,
+                    rewardNote = "adena per soulstone"),
+            // Elven village: Spore Fungi in the Elven Forest, 3500 adena for 10 sacs.
+            RepeatQuest("Q313_CollectSpores", 30150, listOf("30150-05.htm"), 8, 16,
+                    setOf(20509), setOf(1118), 10, exitsOnTurnIn = true, rewardNote = "3500 adena"),
+            // Talking Island: Tunath Orc marksmen, 1000 adena for 10 arrowheads.
+            RepeatQuest("Q303_CollectArrowheads", 30029, listOf("30029-03.htm"), 10, 17,
+                    setOf(20361), setOf(963), 10, exitsOnTurnIn = true, rewardNote = "1000 adena"),
+            // Dark elven village: skeleton hunters, 8470 adena for 10 bone fragments.
+            RepeatQuest("Q320_BonesTellTheFuture", 30359, listOf("30359-04.htm"), 10, 18,
+                    setOf(20517, 20518), setOf(809), 10, exitsOnTurnIn = true, rewardNote = "8470 adena"),
+            // Dark elven village: marsh zombies, 3350 adena and a potion for 5 skins.
+            RepeatQuest("Q319_ScentOfDeath", 30138, listOf("30138-04.htm"), 11, 18,
+                    setOf(20015, 20020), setOf(1045), 5, exitsOnTurnIn = true, rewardNote = "3350 adena + potion"),
+            // Dwarven village: Whinstone Golems, two gatekeeper tokens for 20 starstones.
+            RepeatQuest("Q297_GatekeepersFavor", 30540, listOf("30540-03.htm"), 15, 24,
+                    setOf(20521), setOf(1573), 20, exitsOnTurnIn = true, rewardNote = "2 gatekeeper tokens"),
+            // Elven village: Sukar wererats, adena per fang, the foulclaw's fang is the jackpot.
+            RepeatQuest("Q316_DestroyPlagueCarriers", 30155, listOf("30155-04.htm"), 18, 28,
+                    setOf(20040, 20047), setOf(1042, 1043), 15, exitsOnTurnIn = false, rewardNote = "adena per fang"),
+            // Dark elven village: spiders around the swamps, 5810 adena for 10 venom sacs.
+            RepeatQuest("Q324_SweetestVenom", 30351, listOf("30351-04.htm"), 18, 26,
+                    setOf(20034, 20038, 20043), setOf(1077), 10, exitsOnTurnIn = true, rewardNote = "5810 adena"),
+            // Gludin: remnant orcs of the Abandoned Camp, adena per badge.
+            RepeatQuest("Q326_VanquishRemnants", 30435, listOf("30435-03.htm"), 21, 32,
+                    setOf(20053, 20437, 20058, 20436, 20061, 20439, 20063, 20066, 20438), setOf(1359, 1360, 1361),
+                    15, exitsOnTurnIn = false, rewardNote = "adena per badge"),
+            // Giran: harpies, medusas and wyrms, adena per trophy.
+            RepeatQuest("Q331_ArrowOfVengeance", 30125, listOf("30125-03.htm"), 32, 42,
+                    setOf(20145, 20158, 20176), setOf(1452, 1453, 1454), 15, exitsOnTurnIn = false,
+                    rewardNote = "adena per trophy"))
+
+    /** A taste for errands, fixed for life like the rest of the character: about questerPercent of the population. */
+    fun isQuester(bot: Player): Boolean =
+            Math.floorMod(bot.objectId * 7349 + 29, 100) < AutobotData.settings.questerPercent
+
+    /** Quests that fit [level], [race] and whose monsters live in [spotMonsters]. */
+    fun matching(bot: Player, level: Int, spotMonsters: Collection<Int>): List<RepeatQuest> =
+            all.filter { level in it.minLevel..it.maxLevel && (it.race == null || it.race == bot.race) && it.monsters.any { m -> m in spotMonsters } }
+}
