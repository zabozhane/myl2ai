+    /** True when hunting at [spot] doesn't mean a walk across the map: close directly, or close after a teleport exit. */
+    private fun withinReach(bot: Player, spot: HuntingSpot, maxWalk: Int, useExits: Boolean): Boolean {
+        if (maxWalk == Int.MAX_VALUE) return true
+        if (distance(bot.location(), spot.location) <= maxWalk) return true
+        return useExits && (teleportExits.minOfOrNull { distance(it, spot.location) } ?: Double.MAX_VALUE) <= maxWalk
+    }
+
+    /** The non-nobility gatekeeper destinations; a ride lands the bot at one of them, the rest is walking. */
+    private val teleportExits: List<TeleportLocation> by lazy {
+        TeleportLocationData.getInstance().allTeleportLocations.filter { !it.isNoble }
+    }
