+package dev.l2j.autobots.movement
+
+/** Reserve one emergency escape only when the wallet also covers at least three heals. */
+internal object SupplyBudget {
+    fun healingTarget(cash: Int,have: Int,healingPrice: Int,escapePrice: Int,ownsEscape: Boolean): Int {
+        if(healingPrice<=0) return have.coerceIn(0,10)
+        val money=cash.coerceAtLeast(0).toLong()
+        val minimum=(3-have).coerceAtLeast(0).toLong()*healingPrice
+        val reserve=if(!ownsEscape && escapePrice>0 && money>=minimum+escapePrice) escapePrice.toLong() else 0L
+        return (have.coerceAtLeast(0).toLong()+(money-reserve).coerceAtLeast(0)/healingPrice).coerceAtMost(10).toInt()
+    }
+}
