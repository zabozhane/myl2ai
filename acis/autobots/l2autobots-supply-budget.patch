+    fun restockTarget(player: Player,potion: Int): Int {
+        val healing=Market.findProduct(player,potion)?.let { (shop,item) -> Market.priceWithTax(shop,item).coerceAtLeast(1) } ?: return 10
+        val escape=Market.findProduct(player,Gear.SCROLL_OF_ESCAPE)?.let { (shop,item) -> Market.priceWithTax(shop,item) } ?: 0
+        return dev.l2j.autobots.movement.SupplyBudget.healingTarget(player.adena,count(player),healing,escape,Gear.count(player,Gear.SCROLL_OF_ESCAPE)>0)
+    }
