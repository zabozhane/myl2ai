     }
 
+    private suspend fun buy(path: PathQuest, buy: Buy) {
+        val npc = QuestWorld.closestNpc(bot, listOf(buy.npcId)) ?: return giveUp(path, "npc ${buy.npcId} is not in the world")
+        val (shop, product) = dev.l2j.autobots.population.economy.Market.productOf(npc, buy.itemId)
+                ?: return giveUp(path, "${npc.name} doesn't sell ${buy.itemId}")
+        val need = buy.count - QuestView(bot, null).count(buy.itemId)
+        if (need <= 0) return
+        val total = need.toLong() * dev.l2j.autobots.population.economy.Market.priceWithTax(shop, product)
+        if (bot.adena < total) return giveUp(path, "can't afford $need ${product.item.name} for $total (adena ${bot.adena})")
+        if (!reach(npc)) return
+        bot.target = npc
+        delay(Rnd.get(1500, 4000).toLong())
+        val bought = dev.l2j.autobots.population.economy.Market.buyFromNpc(bot, shop, product, need)
+        bot.target = null
+        if (bought) QuestLog.log(bot, QuestEvent.Step, "${path.questName}: bought $need ${product.item.name} from ${npc.name}")
+        else giveUp(path, "couldn't buy $need ${product.item.name} from ${npc.name}")
+    }
+
     private suspend fun talk(path: PathQuest, talk: Talk) {
         val npc = QuestWorld.closestNpc(bot, listOf(talk.npcId))
         if (talk.orElse != null && (npc == null || distance(bot, npc) > SPAWNED_NPC_RADIUS)) return execute(path, talk.orElse)
