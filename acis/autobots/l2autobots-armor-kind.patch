@@ -210,9 +212,38 @@ internal object Gear {
         return replaced
     }
 
+    /** Body armor proper (heavy, light or robe), as opposed to helmets, gloves, boots and shields. */
+    fun isBodyArmor(item: Item): Boolean = item.itemType == ArmorType.HEAVY || item.itemType == ArmorType.LIGHT || item.itemType == ArmorType.MAGIC
+
+    /**
+     * The body armor kind the class wears at this level, from its kit in `equipment.xml`: the chest piece decides,
+     * the legs only when the chest is empty. A level outside every row takes the closest lower row (a fighter who
+     * hasn't taken the profession yet), then the first row. Null when the class has no kit or the kit names no body armor.
+     */
+    fun armorKind(bot: Player): ArmorType? {
+        val rows = AutobotData.equipment.filter { it.classId == bot.classId }
+        val kit = rows.firstOrNull { bot.level in it.minLevel..it.maxLevel }
+                ?: rows.filter { it.minLevel <= bot.level }.maxByOrNull { it.minLevel } ?: rows.minByOrNull { it.minLevel } ?: return null
+        val kind = listOf(kit.chest, kit.legs).asSequence().filter { it > 0 }.mapNotNull { ItemTable.getInstance().getTemplate(it) }
+                .firstOrNull { isBodyArmor(it) }?.itemType as? ArmorType ?: return null
+        // A kit typo never puts a mage into heavy armor or a fighter into a robe.
+        return if (kind == (if (bot.isMageClass) ArmorType.HEAVY else ArmorType.MAGIC)) null else kind
+    }
+
+    /** Body armor of another kind than the class wears: the starting Squire's shirt on a knight, a robe on a warrior. */
+    fun isWrongKind(bot: Player, item: Item): Boolean {
+        if (!isBodyArmor(item)) return false
+        val kind = armorKind(bot) ?: return false
+        return item.itemType != kind
+    }
+
     fun isUpgrade(bot: Player, item: ItemInstance): Boolean {
         val current = bot.inventory.getPaperdollItem(slotOf(bot, item)) ?: return fitsEmptySlot(bot, item)
-        if (current.item.bodyPart != item.item.bodyPart || current.itemType != item.itemType) return false
+        if (current.item.bodyPart != item.item.bodyPart) return false
+        if (isWrongKind(bot, item.item)) return false
+        // The class's armor kind replaces a piece of another kind (the starting light set) once it defends better.
+        if (current.itemType != item.itemType) return isWrongKind(bot, current.item) &&
+                dev.l2j.autobots.offlinelife.OfflineEquipment.score(bot, item) > dev.l2j.autobots.offlinelife.OfflineEquipment.score(bot, current)
         if (item.isWeapon && item.weaponItem.isMagical != current.weaponItem.isMagical) return false
         return item.referencePrice > current.referencePrice * 1.2
     }
