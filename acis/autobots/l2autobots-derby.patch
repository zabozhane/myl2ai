diff --git a/src/main/kotlin/dev/l2j/autobots/population/DerbyVisit.kt b/src/main/kotlin/dev/l2j/autobots/population/DerbyVisit.kt
new file mode 100644
index 0000000..cc03587
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/DerbyVisit.kt
@@ -0,0 +1,354 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.GatekeeperTravel
+import dev.l2j.autobots.population.economy.NpcTravel
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.Config
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.manager.DerbyTrackManager
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.DerbyTrackManagerNpc
+import net.sf.l2j.gameserver.model.location.Location
+import java.util.Random
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * A visit to the Monster Derby Track, like a player who takes a break from hunting to gamble a little: the free ride
+ * from a town gatekeeper (the RaceTrack teleport), one modest bet on a lane at the Race Manager, the race watched from
+ * the stands, the ticket cashed, and the free ride back to the same gatekeeper. Everything goes through the real NPC
+ * dialogs, so adena, tickets and the lane odds (mdt_bets) change exactly as for a player.
+ *
+ * A ticket that could not be cashed (the session ended, the bot was logged out) stays in the bag and is cashed on the
+ * next visit, like a player who finds an old ticket.
+ */
+internal class DerbyVisit(private val bot: Autobot) {
+
+    private enum class Stage { ToTrack, AtTrack, Leave }
+
+    private var stage = Stage.ToTrack
+    private var startedAt = 0L
+    private var betsPlaced = 0
+    private var maxBets = 1
+    private var waitLogged = false
+    private var hopped = false
+
+    /** Starts a new visit; called when the session picks the derby segment. */
+    fun begin() {
+        stage = Stage.ToTrack
+        startedAt = System.currentTimeMillis()
+        betsPlaced = 0
+        // Most players bet once and go; some stay for another race.
+        maxBets = if (Rnd.get(100) < SECOND_BET_PERCENT) 2 else 1
+        waitLogged = false
+        hopped = false
+    }
+
+    /**
+     * One step of the visit. [goToTown] walks or reads a scroll to the nearest town, false when that failed.
+     * @return true when the visit is over (done, or impossible from here) and the next segment should start.
+     */
+    suspend fun update(goToTown: suspend () -> Boolean): Boolean {
+        if (bot.isDead) return false
+        if (bot.isMoving) return false
+        val now = System.currentTimeMillis()
+        if (stage != Stage.Leave && now - startedAt > MAX_VISIT_MS) {
+            note("visit took too long, leaves")
+            stage = Stage.Leave
+        }
+        when (stage) {
+            Stage.ToTrack -> {
+                if (atTrack(bot)) {
+                    stage = Stage.AtTrack
+                    return false
+                }
+                if (!serverRunsDerby()) {
+                    note("the race track is closed on this server")
+                    return true
+                }
+                val gatekeeper = rideGatekeeper(bot)
+                if (gatekeeper == null) {
+                    if (!Errands.atTown(bot)) {
+                        if (goToTown()) return false
+                        note("can't get to town for the race track ride")
+                        return true
+                    }
+                    if (hopped) {
+                        note("no race track ride after the hop")
+                        return true
+                    }
+                    // A village without the ride (the starting ones): a paid hop to a town that has it, if cheap enough.
+                    hopped = true
+                    val offer = GatekeeperTravel.offers(bot)
+                            .filter { offer -> RIDE_TOWNS.any { distance(it, offer.exit) <= RIDE_TOWN_RADIUS } &&
+                                    offer.price <= Errands.spendable(bot) / MAX_HOP_SHARE }
+                            .minByOrNull { it.price }
+                    if (offer == null) {
+                        note("no race track ride from this town")
+                        return true
+                    }
+                    val ok = GatekeeperTravel.travel(bot, offer)
+                    note("hop to a town with the race track ride: ${if (ok) "arrived" else "failed"} paid=${offer.price}")
+                    return !ok
+                }
+                if (bot.isSitting) bot.standUp()
+                if (!NpcTravel.reach(bot, gatekeeper, RIDE_SEARCH_RADIUS) || bot.isDead) {
+                    note("can't reach ${gatekeeper.name} for the race track ride")
+                    return true
+                }
+                talk(gatekeeper, "Quest RaceTrack")
+                if (!atTrack(bot)) {
+                    note("ride from ${gatekeeper.name} failed")
+                    return true
+                }
+                note("rode from ${gatekeeper.name} to the race track")
+                stage = Stage.AtTrack
+                return false
+            }
+            Stage.AtTrack -> {
+                if (!atTrack(bot)) return true
+                if (cashTickets()) return false
+                val derby = DerbyTrackManager.getInstance()
+                val holding = ticketsOf(bot).any { it.enchantLevel >= derby.raceNumber }
+                if (holding) {
+                    watch()
+                    return false
+                }
+                if (betsPlaced >= maxBets) {
+                    stage = Stage.Leave
+                    return false
+                }
+                if (derby.currentRaceState == DerbyTrackManager.RaceState.ACCEPTING_BETS) {
+                    if (!bet()) stage = Stage.Leave
+                    return false
+                }
+                // Ticket sales closed: wait in the stands for the next race, unless that would take the whole visit.
+                if (now - startedAt > MAX_VISIT_MS - NEXT_RACE_WAIT_MS) stage = Stage.Leave else watch()
+                return false
+            }
+            Stage.Leave -> {
+                if (!atTrack(bot)) return true
+                if (bot.isSitting) {
+                    bot.standUp()
+                    return false
+                }
+                // Not left yet: the life loop takes it from here (see LifeBehavior), with its own retry pause.
+                leave()
+                return true
+            }
+        }
+    }
+
+    /**
+     * Back from the track: the Race Manager's free ride to the gatekeeper the bot came from. Without it (a login at the
+     * track after a crash, the ride already used) the bot walks out through the entrance, by the Race Track Gatekeeper,
+     * where a scroll or the road to town works again (inside the track a Scroll of Escape lands back at the track);
+     * the usual life takes it to town from there. @return true when the bot is off the track.
+     */
+    suspend fun leave(): Boolean {
+        if (bot.isSitting) bot.standUp()
+        val manager = nearestManager(bot)
+        val rideBack = bot.getQuestState(RIDE_QUEST)?.isStarted == true
+        if (manager != null && rideBack && NpcTravel.reach(bot, manager, TRACK_RADIUS.toInt()) && !bot.isDead) {
+            talk(manager, "Quest RaceTrack")
+            if (!atTrack(bot)) {
+                note("rode back from the race track")
+                return true
+            }
+        }
+        val entrance = bot.getKnownTypeInRadius(Npc::class.java, TRACK_RADIUS.toInt() * 2)
+                .firstOrNull { it.npcId == TRACK_GATEKEEPER && it.isVisible }
+        if (entrance == null || !NpcTravel.reach(bot, entrance, TRACK_RADIUS.toInt() * 2) || bot.isDead) {
+            note("can't walk out of the race track")
+            return false
+        }
+        note("walked out of the race track")
+        return !atTrack(bot)
+    }
+
+    /** Cashes one ticket of a finished race. @return true when a ticket was handled this tick. */
+    private suspend fun cashTickets(): Boolean {
+        val derby = DerbyTrackManager.getInstance()
+        val ticket = ticketsOf(bot).firstOrNull { it.enchantLevel < derby.raceNumber } ?: return false
+        val manager = nearestManager(bot) ?: return false
+        if (!NpcTravel.reach(bot, manager, TRACK_RADIUS.toInt())) return false
+        val race = ticket.enchantLevel
+        val lane = ticket.customType1
+        val bet = ticket.customType2 * 100L
+        val before = bot.adena.toLong()
+        talk(manager, "CalculateWin ${ticket.objectId}")
+        if (bot.inventory.getItemByObjectId(ticket.objectId) != null) {
+            // No history for that race (an old server wipe): a player would throw such a ticket away.
+            bot.destroyItem("MonsterTrack", ticket, manager, false)
+            note("threw away an old ticket race=$race")
+            return true
+        }
+        val paid = bot.adena.toLong() - before
+        payouts.addAndGet(paid)
+        if (paid >= bet) wins.incrementAndGet()
+        note("cashed ticket race=$race lane=$lane bet=$bet paid=$paid${if (paid >= bet) " WIN" else ""}")
+        return true
+    }
+
+    /** Buys one ticket for the current race. @return false when nothing can be bet. */
+    private suspend fun bet(): Boolean {
+        val tier = betTier(bot)
+        if (tier < 0) {
+            note("too little spare adena to bet")
+            return false
+        }
+        val manager = nearestManager(bot) ?: return false
+        if (!NpcTravel.reach(bot, manager, TRACK_RADIUS.toInt()) || bot.isDead) return false
+        val lane = lane()
+        val price = TICKET_PRICES[tier]
+        val before = bot.adena
+        // The same pages a player clicks through: lane, price, confirmation, purchase.
+        talk(manager, "BuyTicket $lane")
+        talk(manager, "BuyTicket ${11 + tier}")
+        talk(manager, "BuyTicket 20")
+        talk(manager, "BuyTicket 21")
+        val paid = before - bot.adena
+        if (paid <= 0) {
+            note("ticket purchase refused lane=$lane price=$price")
+            return false
+        }
+        betsPlaced++
+        bets.incrementAndGet()
+        staked.addAndGet(paid.toLong())
+        waitLogged = false
+        note("bet race=${DerbyTrackManager.getInstance().raceNumber} lane=$lane paid=$paid adenaLeft=${bot.adena}")
+        return true
+    }
+
+    /** In the stands: stays out of the way and sits, like a player waiting for the start. */
+    private fun watch() {
+        if (!waitLogged) {
+            waitLogged = true
+            val derby = DerbyTrackManager.getInstance()
+            note("watches race=${derby.raceNumber} state=${derby.currentRaceState}")
+        }
+        if (!bot.isSitting) bot.sitDown()
+    }
+
+    // A favourite lane for some, a random pick for others: players have their superstitions.
+    private fun lane(): Int {
+        val random = Random(bot.objectId * LANE_SEED)
+        val favourite = random.nextInt(LANES) + 1
+        return if (random.nextInt(100) < FAVOURITE_LANE_PERCENT) favourite else Rnd.get(1, LANES)
+    }
+
+    private fun talk(npc: Npc, command: String) {
+        bot.target = npc
+        try {
+            npc.onBypassFeedback(bot, command)
+            if (bot.isTeleporting) bot.onTeleported()
+        } finally {
+            if (bot.target === npc) bot.target = null
+        }
+    }
+
+    private fun note(message: String) {
+        if (AutobotData.settings.derbyLog) println("Autobots derby: ${bot.name} id=${bot.objectId} lv ${bot.level}: $message")
+    }
+
+    companion object {
+        /** Monster Race Ticket - Single. */
+        const val TICKET = 4443
+        private const val RIDE_QUEST = "RaceTrack"
+        // Race Track Gatekeeper at the entrance, outside the track zone.
+        private const val TRACK_GATEKEEPER = 31210
+        // Town gatekeepers with the free RaceTrack ride (scripts/teleports/RaceTrack.java).
+        private val RIDE_GATEKEEPERS = setOf(30320, 30256, 30059, 30080, 30899, 30177, 30848, 30233, 31320, 31275, 31964)
+        // Where those gatekeepers stand (the ride back lands there too).
+        private val RIDE_TOWNS = listOf(Location(-80826, 149775, -3043), Location(-12672, 122776, -3116),
+                Location(15670, 142983, -2705), Location(83400, 147943, -3404), Location(111409, 219364, -3545),
+                Location(82956, 53162, -1495), Location(146331, 25762, -2018), Location(116819, 76994, -2714),
+                Location(43835, -47749, -792), Location(147930, -55281, -2728), Location(87386, -143246, -1293))
+        private const val RIDE_TOWN_RADIUS = 3000.0
+        // A hop may cost at most this part of the spare adena: the bet is the point, not the trip.
+        private const val MAX_HOP_SHARE = 20
+        private val TICKET_PRICES = intArrayOf(100, 500, 1000, 5000, 10000, 20000, 50000, 100000)
+        private val TRACK_LANDING = Location(12661, 181687, -3560)
+        private const val LANDING_RADIUS = 300.0
+        private const val TRACK_RADIUS = 2500.0
+        private const val RIDE_SEARCH_RADIUS = 8000
+        private const val LANES = 8
+        private const val LANE_SEED = 1_000_211L
+        private const val FAVOURITE_LANE_PERCENT = 40
+        private const val SECOND_BET_PERCENT = 25
+        // A race takes 20 minutes, bets close at 15: the visit covers one race and the wait for it.
+        private const val MAX_VISIT_MS = 40 * 60_000L
+        private const val NEXT_RACE_WAIT_MS = 25 * 60_000L
+        private const val GAMBLER_SEED = 1_000_117L
+        private const val GAMBLER_PERCENT = 35
+        const val MIN_LEVEL = 10
+        private const val MIN_ADENA = 10_000
+        // A bet is 0.3-1% of the spare adena: pocket money, not savings.
+        private const val MIN_STAKE_PERMILLE = 3
+        private const val MAX_STAKE_PERMILLE = 10
+
+        private val bets = AtomicInteger()
+        private val wins = AtomicInteger()
+        private val staked = AtomicLong()
+        private val payouts = AtomicLong()
+        @Volatile private var managersSeenAt = 0L
+        @Volatile private var managersSeen = false
+
+        val enabled get() = AutobotData.settings.derbyEnabled && AutobotData.settings.derbyChancePercent > 0
+
+        /** Some players like a flutter, most rarely go: a stable trait by the object id. */
+        fun isGambler(bot: Player): Boolean = Random(bot.objectId * GAMBLER_SEED + 3L).nextInt(100) < GAMBLER_PERCENT
+
+        /** The track is open (AllowDerbyTrack in server.properties) and its Race Managers stand in the world. */
+        fun serverRunsDerby(): Boolean {
+            if (!Config.ALLOW_DERBY_TRACK) return false
+            val now = System.currentTimeMillis()
+            if (now - managersSeenAt > 60_000L) {
+                managersSeen = World.getInstance().objects.any { it is DerbyTrackManagerNpc && it.isVisible }
+                managersSeenAt = now
+            }
+            return managersSeen
+        }
+
+        /** Whether the session may offer a derby visit to this bot now. */
+        fun canVisit(bot: Autobot): Boolean = enabled && !bot.isInParty && bot.level >= MIN_LEVEL &&
+                bot.adena >= MIN_ADENA && betTier(bot, MAX_STAKE_PERMILLE) >= 0 && serverRunsDerby()
+
+        fun atTrack(bot: Player): Boolean = bot.isInsideZone(ZoneId.MONSTER_TRACK) || atTrack(bot.location())
+
+        // The zone flag can lag a teleport by a tick: the landing point counts too.
+        fun atTrack(at: Location): Boolean =
+                distance(at, TRACK_LANDING) <= LANDING_RADIUS && kotlin.math.abs(at.z - TRACK_LANDING.z) < 300
+
+        /** The highest ticket within 0.3-1% of the spare adena and the configured cap; -1 when even 100 is too much. */
+        fun betTier(bot: Player, permille: Int = Rnd.get(MIN_STAKE_PERMILLE, MAX_STAKE_PERMILLE)): Int {
+            val spare = Errands.spendable(bot).toLong()
+            val budget = minOf(spare * permille / 1000, AutobotData.settings.derbyMaxBet.toLong())
+            return TICKET_PRICES.indices.lastOrNull { TICKET_PRICES[it] <= budget } ?: -1
+        }
+
+        fun ticketsOf(bot: Player) = bot.inventory.getAllItemsByItemId(TICKET).toList()
+
+        private fun rideGatekeeper(bot: Player): Npc? = bot.getKnownTypeInRadius(Npc::class.java, RIDE_SEARCH_RADIUS)
+                .filter { it.npcId in RIDE_GATEKEEPERS && it.isVisible }
+                .minByOrNull { distance(bot, it) }
+
+        private fun nearestManager(bot: Player): Npc? = bot.getKnownTypeInRadius(DerbyTrackManagerNpc::class.java, TRACK_RADIUS.toInt())
+                .filter { it.isVisible }
+                .minByOrNull { distance(bot, it) }
+
+        /** One line every 10 minutes: how the population gambles. */
+        fun summary(online: Collection<Autobot>) {
+            if (!enabled || !AutobotData.settings.derbyLog) return
+            println("Autobots derby summary: atTrack=${online.count { atTrack(it) }} bets=${bets.getAndSet(0)} " +
+                    "wins=${wins.getAndSet(0)} staked=${staked.getAndSet(0)} paid=${payouts.getAndSet(0)}")
+        }
+    }
+}
