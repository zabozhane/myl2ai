     fun has(vararg itemIds: Int) = itemIds.all { count(it) > 0 }
 }
 
+/** [need] of [item], dropped by [monsters]. */
+internal class Drop(val item: Int, val need: Int, val monsters: IntArray)
+
 internal class QuestRule(val applies: (QuestView) -> Boolean, val actionFor: (QuestView) -> QuestAction) {
     constructor(applies: (QuestView) -> Boolean, action: QuestAction) : this(applies, { _ -> action })
 }
@@ -91,10 +94,13 @@ internal class PathQuestBuilder(private val questName: String, private val from:
      * At [cond], hunt the monsters of every item still short of [need]: the closest of them first, like a player
      * ticking items off a list. Each pair is an item and the monsters that drop it.
      */
-    fun collect(cond: Int, need: Int, vararg drops: Pair<Int, IntArray>) {
-        rules += QuestRule({ it.cond == cond }, { view ->
-            Hunt(drops.filter { (item, _) -> view.count(item) < need }.flatMap { it.second.toList() }.toSet()
-                    .ifEmpty { drops.flatMap { it.second.toList() }.toSet() }, null, null)
+    fun collect(cond: Int, need: Int, vararg drops: Pair<Int, IntArray>) =
+            gather({ it.cond == cond }, *drops.map { Drop(it.first, need, it.second) }.toTypedArray())
+
+    /** Like [collect], while [applies] holds and with its own count for each item. */
+    fun gather(applies: (QuestView) -> Boolean, vararg drops: Drop) {
+        rules += QuestRule({ view -> applies(view) && drops.any { view.count(it.item) < it.need } }, { view ->
+            Hunt(drops.filter { view.count(it.item) < it.need }.flatMap { it.monsters.toList() }.toSet(), null, null)
         })
     }
 
