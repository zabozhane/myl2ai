diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/Clans.kt b/src/main/kotlin/dev/l2j/autobots/population/group/Clans.kt
new file mode 100644
index 0000000..a715715
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/Clans.kt
@@ -0,0 +1,122 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.PopulationManager
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.sql.ClanTable
+import kotlin.math.abs
+
+/**
+ * Bot clans (stage 4a). A bot with real friends founds a clan and names it; the leader invites people it likes and
+ * the invited decide for themselves, by liking, trust, same race, close level and a similar daily schedule.
+ * Membership is the core's own (the autobots table carries clanid and the clan roster unions both tables), so clans
+ * survive relogins and restarts. Reputation, crests, wars and inviting players come later, with clan raids.
+ */
+internal object Clans {
+    private const val MIN_LEVEL = 10
+    private const val FRIENDS_TO_FOUND = 2
+    private const val FOUND_PERCENT = 20
+    private const val MAX_MEMBERS = 12
+    private const val INVITES_PER_TICK = 2
+    private const val INVITE_MIN_AFFINITY = 25
+    private const val ACCEPT_SCORE = 35
+    private const val GREET_PERCENT = 30
+    private const val LEAVE_PERCENT = 20
+    private const val LEAVE_PENALTY_MS = 24 * 60 * 60 * 1000L
+
+    /** Every few minutes: found, invite, leave. */
+    fun tick(online: List<Autobot>) {
+        if (!AutobotData.settings.clansEnabled) return
+        found(online)
+        invite(online)
+        leave(online)
+    }
+
+    /** A returning member greets the clan once in a while. */
+    fun onLogin(bot: Autobot) {
+        val clan = bot.clan ?: return
+        if (Rnd.get(100) < GREET_PERCENT && clan.onlineMembersCount > 1)
+            bot.clanSay(listOf("hi all", "привет всем", "о/", "hey").random())
+    }
+
+    /** A sociable bot with friends and no clan starts its own. */
+    private fun found(online: List<Autobot>) {
+        for (bot in online) {
+            if (bot.clanId != 0 || bot.level < MIN_LEVEL) continue
+            if (System.currentTimeMillis() < bot.clanCreateExpiryTime) continue
+            val friends = Relations.relationsOf(bot).values.count { it.affinity >= Relations.FRIEND }
+            if (friends < FRIENDS_TO_FOUND || Rnd.get(100) >= FOUND_PERCENT) continue
+            val name = nameFor() ?: continue
+            if (ClanTable.getInstance().createClan(bot, name) == null) continue
+            println("Autobots clans: ${bot.name} (lv ${bot.level}) founded \"$name\"")
+        }
+    }
+
+    /** A clan leader invites the person it likes most; not everyone says yes. */
+    private fun invite(online: List<Autobot>) {
+        val byId = online.associateBy { it.objectId }
+        var invited = 0
+        for (clan in ClanTable.getInstance().clans) {
+            if (invited >= INVITES_PER_TICK) return
+            if (clan.membersCount >= MAX_MEMBERS) continue
+            val leader = clan.leader?.playerInstance as? Autobot ?: continue
+            if (!byId.containsKey(leader.objectId)) continue
+            val candidate = Relations.relationsOf(leader)
+                    .filter { it.value.affinity >= INVITE_MIN_AFFINITY }
+                    .mapNotNull { (id, rel) -> byId[id]?.to(rel) }
+                    .filter { (bot, _) -> bot.clanId == 0 && bot.level >= MIN_LEVEL }
+                    .maxByOrNull { (bot, rel) -> sympathy(leader, bot, rel.affinity, rel.trust) }
+                    ?: continue
+            val (bot, rel) = candidate
+            val score = sympathy(leader, bot, rel.affinity, rel.trust)
+            // The invited decides by how the leader looks to it; a borderline offer is a coin flip.
+            if (score < ACCEPT_SCORE + Rnd.get(20)) {
+                if (AutobotData.settings.groupLog) println("Autobots clans: ${bot.name} declined ${clan.name} (score $score)")
+                continue
+            }
+            clan.addClanMember(bot)
+            invited++
+            println("Autobots clans: ${bot.name} (lv ${bot.level}) joined ${clan.name} (${clan.membersCount} members)")
+            if (Rnd.get(100) < 60) bot.clanSay(listOf("hi!", "glad to be here", "привет!", "рад быть с вами").random())
+        }
+    }
+
+    /** Nobody stays where the leader is disliked. */
+    private fun leave(online: List<Autobot>) {
+        for (bot in online) {
+            val clan = bot.clan ?: continue
+            // The leader stays with its own clan; disbanding comes with clan features later.
+            if (clan.leaderId == bot.objectId) continue
+            if ((Relations.of(bot, clan.leaderId)?.affinity ?: 0) > Relations.AVOID || Rnd.get(100) >= LEAVE_PERCENT) continue
+            clan.removeClanMember(bot.objectId, System.currentTimeMillis() + LEAVE_PENALTY_MS)
+            println("Autobots clans: ${bot.name} left ${clan.name}")
+        }
+    }
+
+    /** How much [bot] fits [leader]'s clan: liking, trust, same race, close level, a similar daily schedule. */
+    private fun sympathy(leader: Autobot, bot: Autobot, affinity: Int, trust: Int): Int {
+        var score = affinity + trust / 2
+        if (leader.race == bot.race) score += 10
+        val gap = abs(leader.level - bot.level)
+        if (gap <= 5) score += 10 else if (gap <= 10) score += 4
+        val a = PopulationManager.wakeHour(leader.objectId)
+        val b = PopulationManager.wakeHour(bot.objectId)
+        if (a != null && b != null && abs(a - b) <= 2) score += 8
+        return score
+    }
+
+    private val PREFIX = listOf("Iron", "Silver", "Dark", "Red", "Wild", "Stone", "Night", "Storm", "White", "Blood",
+            "Golden", "Frost", "Black", "Bright", "Green", "Steel", "Grey", "Swift", "Rune", "Moon")
+    private val SUFFIX = listOf("Wolves", "Dragons", "Blades", "Guard", "Fangs", "Hawks", "Bears", "Shadows", "Flame",
+            "Tide", "Oath", "Shield", "Crows", "Talons", "Forge", "Wind", "Spire", "Brothers", "Watch", "Fist")
+
+    /** A two-word clan name, alphanumeric and free; a few tries, then the founder thinks some more. */
+    private fun nameFor(): String? {
+        repeat(10) {
+            val name = PREFIX.random() + SUFFIX.random()
+            if (name.length in 3..16 && ClanTable.getInstance().getClanByName(name) == null) return name
+        }
+        return null
+    }
+}
