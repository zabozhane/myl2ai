+    /** One conservative weapon goal, paid for only from the caller's money after supplies and travel. */
+    fun weaponPurchase(player: Player,budget: Int): Pair<dev.l2j.autobots.population.economy.Shop,net.sf.l2j.gameserver.model.buylist.Product>? {
+        val current=player.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)
+        if(current!=null && (current.enchantLevel>0 || current.isAugmented)) return null
+        val wish=Gear.wishes(player).firstOrNull { it.slot==Inventory.PAPERDOLL_RHAND } ?: return null
+        // A detached value object for stat calculation: never registered, saved or added to an inventory.
+        val candidate=ItemInstance(0,wish.itemId)
+        if(!eligible(player,candidate) || !fits(player,candidate)) return null
+        if(current!=null && (candidate.itemType!=current.itemType || candidate.item.bodyPart!=current.item.bodyPart ||
+                        score(player,candidate)<=score(player,current)*1.2)) return null
+        val offer=dev.l2j.autobots.population.economy.Market.findProduct(player,wish.itemId) ?: return null
+        val price=dev.l2j.autobots.population.economy.Market.priceWithTax(offer.first,offer.second)
+        return offer.takeIf { price>0 && price<=budget }
+    }
