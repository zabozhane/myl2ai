@@ -0,0 +1,20 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.commons.random.Rnd
+
+/** Short remarks bots make about their deals, the way players comment on a lucky enchant or a broken weapon. */
+internal object Chatter {
+    val ENCHANT_SUCCESS = listOf("yes! %s", "%s finally", "gz me %s", "%s :)")
+    val ENCHANT_RESET = listOf("blessed failed... back to 0 from %s", "lost %s, at least not broken")
+    val ENCHANT_BREAK = listOf("damn, broke at %s", "%s and boom", "nooo %s gone", "f... crystals again")
+    val BOUGHT_UPGRADE = listOf("new %s :)", "finally got %s", "saved up for %s")
+
+    private const val CHANCE_PERCENT = 40
+
+    fun maybeSay(bot: Autobot, lines: List<String>, arg: String) {
+        if (!AutobotData.settings.economyChat || Rnd.get(100) >= CHANCE_PERCENT) return
+        bot.say(lines.random().format(arg))
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Enchanter.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Enchanter.kt
new file mode 100644
index 0000000..1c39338
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Enchanter.kt
@@ -0,0 +1,107 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.Config
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.item.kind.Item
+import net.sf.l2j.gameserver.network.clientpackets.AbstractEnchantPacket
+
+/** How far a bot pushes its luck with enchant scrolls; derived from the object id, like the chronotype. */
+internal enum class Temper(val armorCap: Int, val weaponCap: Int) {
+    /** Safe enchants only. */
+    Cautious(0, 0),
+    /** One or two steps over safe, and only with the adena to replace a broken item. */
+    Normal(4, 6),
+    /** Enchants while scrolls last. */
+    Gambler(6, 10);
+
+    companion object {
+        fun of(objectId: Int): Temper = when (Math.floorMod(objectId * 31 + 7, 100)) {
+            in 0..49 -> Cautious
+            in 50..84 -> Normal
+            else -> Gambler
+        }
+    }
+}
+
+/**
+ * Enchants worn gear with the bot's own scrolls, by the core's chances: success adds a level, a failed blessed
+ * scroll resets it to 0, a failed normal scroll crystallizes the item, which then has to be bought or found again.
+ */
+internal object Enchanter {
+
+    fun enchantWorn(bot: Autobot, cautious: Boolean) {
+        val temper = if (cautious) Temper.Cautious else Temper.of(bot.objectId)
+        var attempts = 0
+        while (attempts++ < MAX_ATTEMPTS_PER_VISIT) {
+            val (scrollItem, target) = nextAttempt(bot, temper) ?: return
+            enchant(bot, scrollItem, target)
+        }
+    }
+
+    private fun nextAttempt(bot: Autobot, temper: Temper): Pair<ItemInstance, ItemInstance>? {
+        for (scrollItem in bot.inventory.items.filter { AbstractEnchantPacket._scrolls.containsKey(it.itemId) }) {
+            val scroll = AbstractEnchantPacket._scrolls.getValue(scrollItem.itemId)
+            val target = bot.inventory.paperdollItems
+                    .filter { scroll.isValid(it) && isEnchantable(it) && it.enchantLevel < capFor(bot, it, temper, scroll.isBlessed) }
+                    .minByOrNull { it.enchantLevel } ?: continue
+            return scrollItem to target
+        }
+        return null
+    }
+
+    /** The level the bot is willing to reach on [item]; safe levels are always taken. */
+    private fun capFor(bot: Autobot, item: ItemInstance, temper: Temper, blessed: Boolean): Int {
+        val safe = if (item.item.bodyPart == Item.SLOT_FULL_ARMOR) Config.ENCHANT_SAFE_MAX_FULL else Config.ENCHANT_SAFE_MAX
+        // A blessed scroll can't break the item, so everyone goes as far as a gambler would.
+        val effective = if (blessed && temper != Temper.Cautious) Temper.Gambler else temper
+        val risky = if (item.isWeapon) effective.weaponCap else effective.armorCap
+        if (risky <= safe) return safe
+        // A normal player only risks an item they could afford to replace.
+        if (effective == Temper.Normal && bot.adena < Market.fairValue(item.itemId)) return safe
+        return risky
+    }
+
+    private fun isEnchantable(item: ItemInstance): Boolean = !item.isHeroItem && !item.isShadowItem && !item.isEtcItem &&
+            (item.location == ItemInstance.ItemLocation.INVENTORY || item.location == ItemInstance.ItemLocation.PAPERDOLL)
+
+    private fun enchant(bot: Autobot, scrollItem: ItemInstance, item: ItemInstance) {
+        val scroll = AbstractEnchantPacket._scrolls.getValue(scrollItem.itemId)
+        val chance = scroll.getChance(item)
+        if (chance < 0) return
+        if (bot.inventory.destroyItem("Enchant", scrollItem.objectId, 1, bot, item) == null) return
+
+        val level = item.enchantLevel
+        val name = item.itemName
+        when {
+            Rnd.nextDouble() < chance -> {
+                item.enchantLevel = level + 1
+                item.updateDatabase()
+                EconomyLog.log(bot, Deal.EnchantSuccess, "enchanted $name to +${level + 1} (chance ${(chance * 100).toInt()}%)")
+                if (level + 1 > 5) Chatter.maybeSay(bot, Chatter.ENCHANT_SUCCESS, "+${level + 1}")
+            }
+            scroll.isBlessed -> {
+                item.enchantLevel = 0
+                item.updateDatabase()
+                EconomyLog.log(bot, Deal.EnchantReset, "blessed enchant of $name +$level failed, reset to +0")
+                Chatter.maybeSay(bot, Chatter.ENCHANT_RESET, "+$level")
+            }
+            else -> {
+                val crystalId = item.item.crystalItemId
+                val crystals = (item.crystalCount - (item.item.crystalCount + 1) / 2).coerceAtLeast(1)
+                val destroyed = bot.inventory.destroyItem("Enchant", item, bot, null) ?: return
+                World.getInstance().removeObject(destroyed)
+                if (crystalId != 0) bot.inventory.addItem("Enchant", crystalId, crystals, bot, destroyed)
+                EconomyLog.log(bot, Deal.EnchantBreak, "enchant of $name +$level failed, the item crystallized")
+                Chatter.maybeSay(bot, Chatter.ENCHANT_BREAK, "+$level")
+            }
+        }
+        // Re-equipping refreshes the +4 dual and +6 armor set skills the way the core does on equip.
+        bot.inventory.reloadEquippedItems()
+        bot.broadcastUserInfo()
+    }
+
+    private const val MAX_ATTEMPTS_PER_VISIT = 10
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Fitness.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Fitness.kt
new file mode 100644
index 0000000..244f82c
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Fitness.kt
@@ -0,0 +1,69 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+
+/**
+ * How a bot copes with its hunting: deaths in the last hour and gear against its level decide whether it hunts
+ * normally, falls back to easier monsters to farm adena and gear, or gives up soloing and needs a group.
+ */
+internal class Fitness(private val bot: Autobot) {
+
+    enum class Mode(val levelOffset: Int) { Normal(0), Farm(-5), NeedsGroup(-8) }
+
+    var mode = Mode.Normal
+        private set
+
+    private val deaths = ArrayDeque<Long>()
+    private var modeSince = System.currentTimeMillis()
+
+    fun onDeath() {
+        val now = System.currentTimeMillis()
+        deaths.addLast(now)
+        while (deaths.isNotEmpty() && now - deaths.first() > WINDOW_MS) deaths.removeFirst()
+        // Newbies have nothing easier to fall back to: dying is part of learning there.
+        if (deaths.size < MAX_DEATHS_PER_HOUR || bot.level < MIN_LEVEL) return
+
+        deaths.clear()
+        when (mode) {
+            Mode.Normal -> switchTo(Mode.Farm, "died $MAX_DEATHS_PER_HOUR times in an hour")
+            Mode.Farm, Mode.NeedsGroup -> {
+                bot.needsGroup = true
+                switchTo(Mode.NeedsGroup, "keeps dying even on easy monsters, needs a group")
+            }
+        }
+    }
+
+    /** Re-evaluated whenever a new hunting spot is chosen. @return true if the mode changed. */
+    fun update(): Boolean {
+        val now = System.currentTimeMillis()
+        val weak = Gear.isWeak(bot)
+        return when {
+            mode == Mode.Normal && weak -> switchTo(Mode.Farm, "gear is weak for level ${bot.level}")
+            mode != Mode.Normal && !weak && deaths.isEmpty() && now - modeSince > WINDOW_MS -> {
+                bot.needsGroup = false
+                switchTo(Mode.Normal, "geared up and an hour without deaths")
+            }
+            else -> false
+        }
+    }
+
+    /** The level the bot picks monsters for. */
+    fun huntLevel(): Int = (bot.level + mode.levelOffset).coerceAtLeast(1)
+
+    /** Farming bots only take safe enchants: they can't afford to lose an item. */
+    val isSaving get() = mode != Mode.Normal
+
+    private fun switchTo(next: Mode, reason: String): Boolean {
+        if (next == mode) return false
+        EconomyLog.log(bot, Deal.ModeChange, "mode $mode -> $next: $reason")
+        mode = next
+        modeSince = System.currentTimeMillis()
+        return true
+    }
+
+    companion object {
+        private const val WINDOW_MS = 60 * 60 * 1000L
+        private const val MAX_DEATHS_PER_HOUR = 3
+        private const val MIN_LEVEL = 10
+    }
+}
