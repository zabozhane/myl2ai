index 0000000..fc919ef
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/TownTrip.kt
@@ -0,0 +1,316 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.Sequence
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.extensions.useItem
+import dev.l2j.autobots.utils.CancellationToken
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import dev.l2j.autobots.extensions.moveTo
+import dev.l2j.autobots.AutobotData
+import kotlin.math.sin
+import kotlin.math.cos
+import kotlin.math.abs
+import java.util.concurrent.ConcurrentHashMap
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+
+/** When a bot should leave its hunting spot for town, and what it can afford there. */
+internal object Errands {
+    private const val MIN_MINUTES_BETWEEN_TRIPS = 15
+    private const val ROUTINE_TRIP_MINUTES = 90
+    /** The weight penalty starts at 50% of the limit; a player heads to town before that. */
+    private const val HEAVY_LOAD_PERCENT = 45
+
+    // Enough for a gatekeeper hop; a newbie with 800 adena should still afford a scroll and some potions.
+    fun reserve(bot: Player): Int = 200 + bot.level * 100
+
+    fun spendable(bot: Player): Int = (bot.adena - reserve(bot)).coerceAtLeast(0)
+
+    fun loadPercent(bot: Player): Int = if (bot.maxLoad <= 0) 0 else (bot.currentLoad.toLong() * 100 / bot.maxLoad).toInt()
+
+    fun shouldLeaveSpot(bot: Autobot, lastTripAt: Long): Boolean {
+        val minutesSinceTrip = (System.currentTimeMillis() - lastTripAt) / 60_000
+        if (minutesSinceTrip < MIN_MINUTES_BETWEEN_TRIPS) return false
+        if (loadPercent(bot) >= HEAVY_LOAD_PERCENT) return true
+        if (outOfShots(bot)) return true
+        if (Gear.isArcher(bot) && Gear.count(bot, Gear.arrowId(bot)) < 50) return true
+        if (affordableUpgrade(bot) != null) return true
+        return minutesSinceTrip >= ROUTINE_TRIP_MINUTES && Gear.surplus(bot).isNotEmpty()
+    }
+
+    private fun outOfShots(bot: Autobot): Boolean {
+        val shotId = Gear.shotId(bot)
+        val price = Market.npcPrice(shotId) ?: return false
+        return Gear.count(bot, shotId) == 0 && spendable(bot) >= price * 200 && (bot.level >= 20 || spendable(bot) >= 5000)
+    }
+
+    /** The next piece of the kit that town shops sell and the bot can pay for. */
+    fun affordableUpgrade(bot: Autobot): Wish? = Gear.wishes(bot).firstOrNull { wish ->
+        val price = Market.npcPrice(wish.itemId) ?: return@firstOrNull false
+        price <= spendable(bot)
+    }
+}
+
+/** Gets the bot to town: a Scroll of Escape if it has one, on foot if town is close. */
+internal class GoToTownSequence(override val bot: Autobot, private val onFail: () -> Unit) : Sequence {
+    override var cancellationToken: CancellationToken? = null
+
+    override suspend fun definition() {
+        if (Gear.count(bot, Gear.SCROLL_OF_ESCAPE) > 0) {
+            if (bot.isSitting) bot.standUp()
+            delay(Rnd.get(500, 1500).toLong())
+            bot.useItem(Gear.SCROLL_OF_ESCAPE)
+            // The scroll is a 20 second cast that ends in a teleport.
+            repeat(30) { second ->
+                delay(1000)
+                if (bot.isInsideZone(ZoneId.TOWN) || bot.isDead) return
+                // The cast was interrupted (an attack, a stun): no teleport is coming.
+                if (second > 3 && !bot.isCastingNow && !bot.isTeleporting) return onFail()
+            }
+            return onFail()
+        }
+
+        val town = MapRegionData.getInstance().getLocationToTeleport(bot, MapRegionData.TeleportType.TOWN)
+        if (distance(bot.location(), town) > MAX_WALK_TO_TOWN) return onFail()
+        WalkToSequence(bot, town, 300, onFail).definition()
+    }
+
+    companion object {
+        private const val MAX_WALK_TO_TOWN = 6000
+    }
+}
+
+/**
+ * One visit to town, done like a player: the private stores around first (cheaper than shops, or paying more
+ * than shops), then the merchants to sell junk and buy supplies and the next gear piece, then equip and enchant.
+ */
+internal class TownTrip(override val bot: Autobot, private val cautious: Boolean) : Sequence {
+    override var cancellationToken: CancellationToken? = null
+
+    override suspend fun definition() {
+        if (bot.isInStoreMode) return
+        if (bot.isSitting) bot.standUp()
+
+        Gear.equipUpgradesFromInventory(bot)
+        Crystals.crystallizeJunk(bot)
+        tradeWithStores()
+        sellToNpc(junk())
+        buySupplies()
+        buyGear()
+        // What the new gear replaced is junk now, and so are store goods if the bag is still heavy.
+        val leftovers = Gear.equipUpgradesFromInventory(bot) + junk()
+        val heavy = if (Errands.loadPercent(bot) >= 40) StoreKeeper.storeGoods(bot) else emptyList()
+        sellToNpc((leftovers + heavy).distinct().filter { bot.inventory.getItemByObjectId(it.objectId) != null })
+        Enchanter.enchantWorn(bot, cautious)
+        bot.refreshOverloaded()
+        getNewbieBuffs()
+    }
+
+    /** Last stop before leaving town, so the buffs last into the hunt; the guide itself checks level and class. */
+    private suspend fun getNewbieBuffs() {
+        if (!bot.isNewbie || bot.level < NEWBIE_BUFF_MIN_LEVEL) return
+        val guide = Market.newbieGuideNear(bot) ?: return
+        if (!walkTo(guide, "for newbie buffs")) return
+        guide.onBypassFeedback(bot, "SupportMagic")
+        if (AutobotData.settings.economyLog) println("Autobots economy: ${bot.name} (lv ${bot.level}): got newbie buffs from ${guide.name}")
+        delay(Rnd.get(1000, 3000).toLong())
+    }
+
+    /** Cheap surplus that isn't worth a store slot. */
+    private fun junk(): List<ItemInstance> {
+        val goods = StoreKeeper.storeGoods(bot).map { it.objectId }.toSet()
+        return Gear.surplus(bot).filter { it.isSellable && it.objectId !in goods }
+    }
+
+    private suspend fun tradeWithStores() {
+        var visits = 0
+
+        // Sell surplus to buy stores that pay more than an NPC would.
+        for (item in Gear.surplus(bot)) {
+            if (visits >= MAX_STORE_VISITS) return
+            val offer = Market.buyOffers(bot, item.itemId).firstOrNull { it.tradeItem.price > Market.npcSellPrice(item.itemId) } ?: continue
+            if (!walkTo(offer.owner, "to sell ${item.itemName}")) continue
+            visits++
+            val live = bot.inventory.getItemByObjectId(item.objectId) ?: continue
+            Market.sellToStore(bot, offer, live, minOf(live.count, offer.tradeItem.count))
+            StoreKeeper.forget(bot, item.itemId)
+        }
+
+        // Buy what the bot needs from sell stores cheaper than the shops (or at a fair price if shops don't have it).
+        val needs = Gear.wishes(bot).map { it.itemId to 1 }.toMutableList()
+        needs += Gear.shotId(bot) to SHOTS_PER_TRIP
+        Gear.summonCrystal(bot)?.let { crystal -> (Crystals.WANTED - Gear.count(bot, crystal)).takeIf { it > 0 }?.let { needs += crystal to it } }
+        if (Gear.wishes(bot).isEmpty()) needs += StoreKeeper.wanted(bot).map { it to 1 }
+        for ((itemId, wantedCount) in needs) {
+            if (visits >= MAX_STORE_VISITS) return
+            val limit = StoreKeeper.buyLimit(bot, itemId)
+            val offers = Market.sellOffers(bot, itemId)
+            MarketBook.searched(bot, itemId)
+            // A store a bit over the limit is worth a word with its owner: bots haggle with each other.
+            val offer = offers.firstOrNull { it.tradeItem.price < limit }
+                    ?: offers.firstOrNull { it.owner is Autobot && it.tradeItem.price < limit * MarketHaggle.REACH }
+                    ?: continue
+            val count = minOf(offer.tradeItem.count, wantedCount, Errands.spendable(bot) / minOf(offer.tradeItem.price, limit).coerceAtLeast(1))
+            if (count <= 0 || !walkTo(offer.owner, "to buy ${offer.tradeItem.item.name}")) continue
+            visits++
+            if (offer.tradeItem.price >= limit && !haggle(offer, limit)) continue
+            if (Market.buyFromStore(bot, offer, count)) {
+                bot.inventory.getItemByItemId(itemId)?.takeIf { it.isEquipable && !it.isEquipped }?.let {
+                    Gear.equip(bot, it)
+                    Chatter.maybeSay(bot, Chatter.BOUGHT_UPGRADE, it.itemName)
+                }
+            }
+        }
+    }
+
+    /** Talks the store's price down to what the bot pays; the owner lowers it in its store when they agree. */
+    private suspend fun haggle(offer: StoreOffer, limit: Int): Boolean {
+        val owner = offer.owner
+        val itemId = offer.tradeItem.item.itemId
+        val price = MarketHaggle.haggle(bot, owner, itemId, offer.tradeItem.price, limit, StoreKeeper.unsoldSessions(owner, itemId))
+        if (price == null) {
+            EconomyLog.skip(bot, "${owner.name} wouldn't go down to $limit for ${offer.tradeItem.item.name} (asks ${offer.tradeItem.price})")
+            return false
+        }
+        if (owner.storeType != net.sf.l2j.gameserver.enums.actors.StoreType.SELL || offer.tradeItem !in owner.sellList.items) return false
+        MarketBook.haggled()
+        if (AutobotData.settings.economyLog) println("Autobots economy: ${bot.name} (lv ${bot.level}): haggled ${owner.name} down from ${offer.tradeItem.price} to $price for ${offer.tradeItem.item.name}")
+        offer.tradeItem.price = price
+        return true
+    }
+
+    private suspend fun sellToNpc(items: List<ItemInstance>) {
+        if (items.isEmpty()) return
+        val shop = Market.closestShop(bot) ?: return EconomyLog.skip(bot, "no shop in town to sell to")
+        if (!walkTo(shop.merchant, "to sell")) return
+        Market.sellToNpc(bot, shop, items)
+    }
+
+    private suspend fun buySupplies() {
+        // Shares of what the bot can spend now: a scroll home comes first, potions are cheap insurance,
+        // and the rest stays for gear. The reserve is travel money, and a scroll or a potion is exactly what it is
+        // kept for, so essentials may use all of the adena.
+        buy(Gear.SCROLL_OF_ESCAPE, target = 2, budgetShare = 1.0, onlyBelow = 1, essential = true)
+        if (bot.level >= 20 || Errands.spendable(bot) >= 5000) {
+            buy(Gear.shotId(bot), target = shotsFor(bot.level), budgetShare = 0.4, onlyBelow = shotsFor(bot.level) / 3)
+        }
+        // A bow without arrows can't hunt at all.
+        if (Gear.isArcher(bot)) buy(Gear.arrowId(bot), target = 1500, budgetShare = 0.6, onlyBelow = 500, essential = true)
+        // No town shop sells mana potions in Interlude: mages rest, as players did.
+        val potions = Gear.HEALING_POTIONS.sumOf { Gear.count(bot, it) }
+        val potion = Gear.HEALING_POTIONS.firstOrNull { Market.findProduct(bot, it) != null }
+        if (potion != null) buy(potion, target = 10, budgetShare = 0.5, onlyBelow = 3, have = potions, essential = true)
+    }
+
+    /** Buys up to [target] pieces when the bot has fewer than [onlyBelow], spending at most [budgetShare] of its adena. */
+    private suspend fun buy(itemId: Int, target: Int, budgetShare: Double, onlyBelow: Int, have: Int = Gear.count(bot, itemId),
+                            essential: Boolean = false) {
+        if (have >= onlyBelow) return
+        val name = ItemTable.getInstance().getTemplate(itemId)?.name ?: "$itemId"
+        val (shop, product) = Market.findProduct(bot, itemId) ?: return EconomyLog.skip(bot, "no shop in town sells $name")
+        val price = Market.priceWithTax(shop, product).coerceAtLeast(1)
+        val budget = if (essential) bot.adena else Errands.spendable(bot)
+        val count = minOf(target - have, (budget * budgetShare / price).toInt())
+        if (count <= 0) return EconomyLog.skip(bot, "can't afford $name at $price (adena ${bot.adena}, reserve ${if (essential) 0 else Errands.reserve(bot)})")
+        if (!walkTo(shop.merchant, "for $name")) return
+        Market.buyFromNpc(bot, shop, product, count)
+    }
+
+    private suspend fun buyGear() {
+        val wish = Errands.affordableUpgrade(bot) ?: return
+        val (shop, product) = Market.findProduct(bot, wish.itemId) ?: return
+        if (Market.priceWithTax(shop, product) > Errands.spendable(bot)) return
+        if (!walkTo(shop.merchant, "for ${product.item.name}")) return
+        if (!Market.buyFromNpc(bot, shop, product, 1)) return
+        val item = bot.inventory.getItemsByItemId(wish.itemId).firstOrNull { !it.isEquipped } ?: return
+        Gear.equip(bot, item)
+        Chatter.maybeSay(bot, Chatter.BOUGHT_UPGRADE, item.itemName)
+    }
+
+    /**
+     * Walks up to an NPC or a store and pauses like a player reading the window. An NPC is approached at a standing
+     * point next to it (see [Approach]): several grocers stand on geodata cells no path leads to, behind a counter or
+     * under a roof, so walking to their exact point never arrives. The last steps are a click on the target, the
+     * server's own approach with pathfinding.
+     */
+    private suspend fun walkTo(target: Creature, purpose: String = ""): Boolean {
+        if (bot.isDead) return false
+        val spot = if (target is Npc) Approach.pointNear(bot, target) else null
+        if (!inReach(target)) WalkToSequence(bot, spot ?: target.location(), if (spot != null) SPOT_ARRIVAL_RADIUS else APPROACH_RADIUS) {}.definition()
+        if (!inReach(target) && !bot.isDead) {
+            if (spot != null) bot.moveTo(spot.x, spot.y, spot.z) else bot.ai.setIntention(IntentionType.INTERACT, target)
+            for (second in 1..FINAL_APPROACH_SECONDS) {
+                delay(1000)
+                if (inReach(target) || bot.isDead) break
+            }
+        }
+        if (!inReach(target)) {
+            EconomyLog.skip(bot, "couldn't reach ${target.name} $purpose (${distance(bot, target).toInt()} away, " +
+                    "dz ${target.z - bot.z}, bot at ${bot.x},${bot.y},${bot.z}, spot ${spot?.let { "${it.x},${it.y},${it.z}" } ?: "none"})")
+            return false
+        }
+        bot.target = target
+        delay(Rnd.get(2000, 5000).toLong())
+        return !bot.isDead
+    }
+
+    private fun inReach(target: Creature) = target.isInsideRadius(bot, Npc.INTERACTION_DISTANCE, true, false)
+
+    companion object {
+        private const val MAX_STORE_VISITS = 4
+        private const val SHOTS_PER_TRIP = 1000
+        private const val APPROACH_RADIUS = 300
+        private const val SPOT_ARRIVAL_RADIUS = 30
+        private const val NEWBIE_BUFF_MIN_LEVEL = 10
+        private const val FINAL_APPROACH_SECONDS = 15
+
+        private fun shotsFor(level: Int) = when {
+            level < 20 -> 300
+            level < 40 -> 800
+            else -> 1500
+        }
+    }
+}
+
+/**
+ * Standing points next to NPCs, the way a player stands at a counter: a ring of points around the NPC within talking
+ * distance, on the floor the NPC stands on, that the bot can walk to. Found once per NPC and kept.
+ */
+internal object Approach {
+    private val RADII = intArrayOf(60, 100, 130)
+    private const val DIRECTIONS = 16
+    private const val MAX_FLOOR_DIFFERENCE = 50
+
+    private val points = ConcurrentHashMap<Int, Location>()
+
+    fun pointNear(bot: Player, npc: Npc): Location? = points[npc.objectId] ?: find(bot, npc)?.also { points[npc.objectId] = it }
+
+    private fun find(bot: Player, npc: Npc): Location? {
+        val geo = GeoEngine.getInstance()
+        for (radius in RADII) {
+            for (i in 0 until DIRECTIONS) {
+                val angle = 2 * Math.PI * i / DIRECTIONS
+                val x = npc.x + (cos(angle) * radius).toInt()
+                val y = npc.y + (sin(angle) * radius).toInt()
+                val z = geo.getHeight(x, y, npc.z).toInt()
+                if (abs(z - npc.z) > MAX_FLOOR_DIFFERENCE) continue
+                val reachable = geo.canMoveToTarget(bot.x, bot.y, bot.z, x, y, z) ||
+                        (geo.findPath(bot.x, bot.y, bot.z, x, y, z, true)?.size ?: 0) >= 2
+                if (reachable) return Location(x, y, z)
+            }
+        }
+        return null
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/GroupChat.kt b/src/main/kotlin/dev/l2j/autobots/population/group/GroupChat.kt
