--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Gear.kt
@@ -0,0 +1,197 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.behaviors.attributes.PetOwner
+import dev.l2j.autobots.behaviors.preferences.PetOwnerPreferences
+import dev.l2j.autobots.extensions.getCombatBehavior
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.items.ArmorType
+import net.sf.l2j.gameserver.enums.items.CrystalType
+import net.sf.l2j.gameserver.enums.items.ShotType
+import net.sf.l2j.gameserver.enums.items.WeaponType
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.item.kind.Item
+import net.sf.l2j.gameserver.model.itemcontainer.Inventory
+import net.sf.l2j.gameserver.network.clientpackets.AbstractEnchantPacket
+
+/** A paperdoll slot the bot wants to fill with [itemId]. */
+internal class Wish(val slot: Int, val itemId: Int) {
+    val template: Item get() = ItemTable.getInstance().getTemplate(itemId)
+}
+
+/**
+ * What a bot wears and what it should wear: grades by level, the target kit from `equipment.xml`,
+ * shots and arrows that match the weapon, and which inventory items are worth keeping.
+ */
+internal object Gear {
+    const val SCROLL_OF_ESCAPE = 736
+    /** Healing potions town shops sell, best first: starting villages only have the lesser one. */
+    val HEALING_POTIONS = listOf(1061, 1060)
+
+    private val POTIONS = setOf(725, 726, 727, 728, 1060, 1061, 1539, 1540, 5592)
+    private val BEGINNER_SHOTS = setOf(5789, 5790)
+    private val SOULSHOTS = mapOf(CrystalType.NONE to 1835, CrystalType.D to 1463, CrystalType.C to 1464, CrystalType.B to 1465, CrystalType.A to 1466, CrystalType.S to 1467)
+    private val SPIRITSHOTS = mapOf(CrystalType.NONE to 3947, CrystalType.D to 3948, CrystalType.C to 3949, CrystalType.B to 3950, CrystalType.A to 3951, CrystalType.S to 3952)
+    private val ARROWS = mapOf(CrystalType.NONE to 17, CrystalType.D to 1341, CrystalType.C to 1342, CrystalType.B to 1343, CrystalType.A to 1344, CrystalType.S to 1345)
+
+    /** Paperdoll slots in buying order: weapon first, then the big armor parts, jewels last. */
+    private val SLOT_ORDER = listOf(Inventory.PAPERDOLL_RHAND, Inventory.PAPERDOLL_CHEST, Inventory.PAPERDOLL_LEGS, Inventory.PAPERDOLL_LHAND,
+            Inventory.PAPERDOLL_HEAD, Inventory.PAPERDOLL_GLOVES, Inventory.PAPERDOLL_FEET, Inventory.PAPERDOLL_NECK,
+            Inventory.PAPERDOLL_LEAR, Inventory.PAPERDOLL_REAR, Inventory.PAPERDOLL_LFINGER, Inventory.PAPERDOLL_RFINGER)
+
+    /** The grade a player of [level] can use without penalty, which is also the grade expected of them. */
+    fun gradeFor(level: Int): CrystalType = when {
+        level >= 76 -> CrystalType.S
+        level >= 61 -> CrystalType.A
+        level >= 52 -> CrystalType.B
+        level >= 40 -> CrystalType.C
+        level >= 20 -> CrystalType.D
+        else -> CrystalType.NONE
+    }
+
+    fun weaponGrade(bot: Player): CrystalType = bot.activeWeaponItem?.crystalType ?: CrystalType.NONE
+
+    fun isArcher(bot: Player): Boolean = bot.activeWeaponItem?.itemType == WeaponType.BOW
+
+    /** Shots that work with the equipped weapon: the grade must match the weapon, not the level. */
+    fun shotId(bot: Player): Int {
+        val grade = weaponGrade(bot)
+        return if (bot.getCombatBehavior().getShotType() == ShotType.SOULSHOT) SOULSHOTS.getValue(grade) else SPIRITSHOTS.getValue(grade)
+    }
+
+    fun arrowId(bot: Player): Int = ARROWS.getValue(weaponGrade(bot))
+
+    fun count(bot: Player, itemId: Int): Int = bot.inventory.getItemByItemId(itemId)?.count ?: 0
+
+    /** The pieces of the target kit the bot still lacks, in buying order. */
+    fun wishes(bot: Player): List<Wish> {
+        val kit = AutobotData.equipment.firstOrNull { bot.level in it.minLevel..it.maxLevel && bot.classId == it.classId } ?: return emptyList()
+        val targets = mapOf(Inventory.PAPERDOLL_RHAND to kit.rightHand, Inventory.PAPERDOLL_LHAND to kit.leftHand, Inventory.PAPERDOLL_HEAD to kit.head,
+                Inventory.PAPERDOLL_CHEST to kit.chest, Inventory.PAPERDOLL_LEGS to kit.legs, Inventory.PAPERDOLL_GLOVES to kit.hands,
+                Inventory.PAPERDOLL_FEET to kit.feet, Inventory.PAPERDOLL_NECK to kit.neck, Inventory.PAPERDOLL_LEAR to kit.leftEar,
+                Inventory.PAPERDOLL_REAR to kit.rightEar, Inventory.PAPERDOLL_LFINGER to kit.leftRing, Inventory.PAPERDOLL_RFINGER to kit.rightRing)
+        return SLOT_ORDER.mapNotNull { slot ->
+            val itemId = targets[slot] ?: 0
+            if (itemId <= 0 || ItemTable.getInstance().getTemplate(itemId) == null || isSatisfied(bot, slot, itemId)) null else Wish(slot, itemId)
+        }
+    }
+
+    private fun isSatisfied(bot: Player, slot: Int, itemId: Int): Boolean {
+        val inventory = bot.inventory
+        // A full body armor or a two-handed weapon leaves the other slot legitimately empty.
+        if (slot == Inventory.PAPERDOLL_LEGS && inventory.getPaperdollItem(Inventory.PAPERDOLL_CHEST)?.item?.bodyPart == Item.SLOT_FULL_ARMOR) return true
+        if (slot == Inventory.PAPERDOLL_LHAND && inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)?.item?.bodyPart == Item.SLOT_LR_HAND) return true
+        val current = inventory.getPaperdollItem(slot) ?: return false
+        if (current.itemId == itemId) return true
+        // Something at least as valuable is already worn there (found in loot, or bought before the level band changed).
+        val target = ItemTable.getInstance().getTemplate(itemId)
+        return current.item.crystalType.id >= target.crystalType.id && current.referencePrice >= target.referencePrice
+    }
+
+    /** Weapon or chest more than a grade below the level, or no weapon at all: the bot is undergeared. */
+    fun isWeak(bot: Player): Boolean {
+        val expected = gradeFor(bot.level).id
+        if (expected == 0) return false
+        val weapon = bot.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND) ?: return true
+        val chest = bot.inventory.getPaperdollItem(Inventory.PAPERDOLL_CHEST)
+        return weapon.item.crystalType.id < expected - 1 || (chest?.item?.crystalType?.id ?: -1) < expected - 1
+    }
+
+    /** Puts on loot that is a clear upgrade over what is worn in the same slot. Returns the items taken off. */
+    fun equipUpgradesFromInventory(bot: Player): List<ItemInstance> {
+        val allowedGrade = gradeFor(bot.level).id
+        // A slot's wish is spent on the first matching piece, so a second copy doesn't replace the one just put on.
+        val wished = wishes(bot).map { it.itemId }.toMutableSet()
+        val replaced = mutableListOf<ItemInstance>()
+        val candidates = bot.inventory.items.filter { it.isEquipable && !it.isEquipped && (it.isWeapon || it.isArmor) && it.item.crystalType.id <= allowedGrade }
+        for (item in candidates) {
+            if (wished.remove(item.itemId) || isUpgrade(bot, item)) {
+                val previous = bot.inventory.getPaperdollItem(slotOf(bot, item))
+                equip(bot, item)
+                if (previous != null && !previous.isEquipped) replaced += previous
+            }
+        }
+        return replaced
+    }
+
+    private fun isUpgrade(bot: Player, item: ItemInstance): Boolean {
+        val current = bot.inventory.getPaperdollItem(slotOf(bot, item)) ?: return fitsEmptySlot(bot, item)
+        if (current.item.bodyPart != item.item.bodyPart || current.itemType != item.itemType) return false
+        if (item.isWeapon && item.weaponItem.isMagical != current.weaponItem.isMagical) return false
+        return item.referencePrice > current.referencePrice * 1.2
+    }
+
+    /**
+     * Any jewel fills an empty slot; armor only of the kind the class wears (a mage never puts on heavy armor), and
+     * never a piece that would take off something else: a shield next to a two-handed weapon, legs under a full body.
+     */
+    private fun fitsEmptySlot(bot: Player, item: ItemInstance): Boolean {
+        if (item.item.type2 == Item.TYPE2_ACCESSORY) return true
+        if (!item.isArmor || item.itemType == (if (bot.isMageClass) ArmorType.HEAVY else ArmorType.MAGIC)) return false
+        val inventory = bot.inventory
+        return when (item.item.bodyPart) {
+            Item.SLOT_L_HAND -> inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)?.item?.bodyPart != Item.SLOT_LR_HAND
+            Item.SLOT_LEGS -> inventory.getPaperdollItem(Inventory.PAPERDOLL_CHEST)?.item?.bodyPart != Item.SLOT_FULL_ARMOR
+            Item.SLOT_FULL_ARMOR -> inventory.getPaperdollItem(Inventory.PAPERDOLL_LEGS) == null
+            else -> true
+        }
+    }
+
+    /** The paperdoll slot an item goes to; for earrings and rings, the free one of the pair if there is one. */
+    private fun slotOf(bot: Player, item: ItemInstance): Int = when (item.item.bodyPart) {
+        Item.SLOT_R_HAND, Item.SLOT_LR_HAND -> Inventory.PAPERDOLL_RHAND
+        Item.SLOT_L_HAND -> Inventory.PAPERDOLL_LHAND
+        Item.SLOT_HEAD -> Inventory.PAPERDOLL_HEAD
+        Item.SLOT_CHEST, Item.SLOT_FULL_ARMOR -> Inventory.PAPERDOLL_CHEST
+        Item.SLOT_LEGS -> Inventory.PAPERDOLL_LEGS
+        Item.SLOT_GLOVES -> Inventory.PAPERDOLL_GLOVES
+        Item.SLOT_FEET -> Inventory.PAPERDOLL_FEET
+        Item.SLOT_NECK -> Inventory.PAPERDOLL_NECK
+        Item.SLOT_L_EAR, Item.SLOT_R_EAR, Item.SLOT_LR_EAR -> freeOf(bot, Inventory.PAPERDOLL_LEAR, Inventory.PAPERDOLL_REAR)
+        Item.SLOT_L_FINGER, Item.SLOT_R_FINGER, Item.SLOT_LR_FINGER -> freeOf(bot, Inventory.PAPERDOLL_LFINGER, Inventory.PAPERDOLL_RFINGER)
+        else -> -1
+    }
+
+    private fun freeOf(bot: Player, left: Int, right: Int): Int {
+        val inventory = bot.inventory
+        return if (inventory.getPaperdollItem(left) != null && inventory.getPaperdollItem(right) == null) right else left
+    }
+
+    fun equip(bot: Player, item: ItemInstance) {
+        bot.useEquippableItem(item, true)
+        bot.broadcastUserInfo()
+        EconomyLog.log(bot, Deal.Equip, "equipped ${item.itemName}${if (item.enchantLevel > 0) " +${item.enchantLevel}" else ""}")
+    }
+
+    /** The crystals the bot's summon skill consumes (summoners, necromancers, dark avengers, warsmiths), if any. */
+    fun summonCrystal(bot: Player): Int? {
+        val owner = bot.getCombatBehavior() as? PetOwner ?: return null
+        val skill = bot.getSkill(owner.summonInfo.first.skillId) ?: return null
+        return skill.itemConsumeId.takeIf { it > 0 }
+    }
+
+    /** Beast shots for the servitor, when the class's preferences use them. */
+    fun petShot(bot: Player): Int? {
+        val prefs = bot.getCombatBehavior().combatPreferences as? PetOwnerPreferences ?: return null
+        return prefs.petShotId.takeIf { prefs.petUsesShots && it > 0 }
+    }
+
+    /** Everything the bot does not need and could turn into adena (worthless items like the Tutorial Guide, worth 1 adena, stay). */
+    fun surplus(bot: Player): List<ItemInstance> {
+        val keep = mutableSetOf(57, SCROLL_OF_ESCAPE, shotId(bot))
+        keep += POTIONS
+        keep += BEGINNER_SHOTS
+        if (isArcher(bot)) keep += arrowId(bot)
+        summonCrystal(bot)?.let { keep += it }
+        petShot(bot)?.let { keep += it }
+        keep += wishes(bot).map { it.itemId }
+        // Enchant scrolls for the gear the bot wears are kept for itself; others are for sale.
+        val worn = bot.inventory.paperdollItems
+        keep += AbstractEnchantPacket._scrolls.filter { (_, scroll) -> worn.any { scroll.isValid(it) } }.keys
+        return bot.inventory.items.filter {
+            !it.isEquipped && it.itemId !in keep && !it.isQuestItem && !it.isHeroItem && !it.isShadowItem &&
+                    it.referencePrice >= 2 && (it.isSellable || it.isTradable)
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
new file mode 100644
index 0000000..54e0f4f
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
@@ -0,0 +1,209 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.population.group.Role
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.manager.BuyListManager
+import net.sf.l2j.gameserver.data.sql.SpawnTable
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.ItemRequest
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Merchant
+import net.sf.l2j.gameserver.model.buylist.Product
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.model.tradelist.TradeItem
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/** A merchant NPC with what it sells. */
+internal class Shop(val merchant: Merchant, val products: Map<Int, Product>)
+
+/** An item a private store sells or wants, with its owner. */
+internal class StoreOffer(val owner: Player, val tradeItem: TradeItem)
+
+/**
+ * The bots' view of the market: NPC shops indexed from spawns and buy lists, private stores around, and the
+ * server-side equivalents of the client's buy and sell requests (same checks, same prices, same taxes).
+ */
+internal object Market {
+    /** How far from the bot a shop still counts as "in this town". */
+    const val TOWN_RADIUS = 8000
+    const val STORE_RADIUS = 3000
+
+    private val shops: List<Shop> by lazy { buildShops() }
+
+    /** Lowest NPC price of each item anywhere in the world: what an item is worth to someone who needs it. */
+    private val npcPrices: Map<Int, Int> by lazy {
+        shops.flatMap { it.products.values }.groupBy { it.itemId }.mapValues { (_, products) -> products.minOf { it.price } }
+    }
+
+    fun npcPrice(itemId: Int): Int? = npcPrices[itemId]
+
+    /** What an NPC pays for one piece. */
+    fun npcSellPrice(itemId: Int): Int = (ItemTable.getInstance().getTemplate(itemId)?.referencePrice ?: 0) / 2
+
+    /** Market value of one piece: the shop price if shops sell it, otherwise the reference price. */
+    fun fairValue(itemId: Int): Int = npcPrice(itemId) ?: ItemTable.getInstance().getTemplate(itemId)?.referencePrice ?: 0
+
+    fun shopsNear(bot: Player): List<Shop> = shops.filter { distance(bot, it.merchant) <= TOWN_RADIUS }
+
+    /** The closest shop in town that sells [itemId], with the product. */
+    fun findProduct(bot: Player, itemId: Int): Pair<Shop, Product>? = shopsNear(bot)
+            .mapNotNull { shop -> shop.products[itemId]?.let { shop to it } }
+            .filter { (_, product) -> !product.hasLimitedStock() || product.count > 0 }
+            .minByOrNull { (shop, _) -> distance(bot, shop.merchant) }
+
+    fun closestShop(bot: Player): Shop? = shopsNear(bot).minByOrNull { distance(bot, it.merchant) }
+
+    /** Village Newbie Guides: their "support magic" buffs novices of level 10-24 for free, as on retail. */
+    private val newbieGuides: List<Npc> by lazy {
+        SpawnTable.getInstance().spawns.mapNotNull { it.npc }.filter { it.npcId in NEWBIE_GUIDE_IDS }
+    }
+
+    fun newbieGuideNear(bot: Player): Npc? = newbieGuides.filter { distance(bot, it) <= TOWN_RADIUS }.minByOrNull { distance(bot, it) }
+
+    private val NEWBIE_GUIDE_IDS = setOf(30598, 30599, 30600, 30601, 30602, 31076, 31077)
+
+    /** Price per piece with the castle tax, as RequestBuyItem charges it. */
+    fun priceWithTax(shop: Shop, product: Product): Int = (product.price * (1 + (shop.merchant.castle?.taxRate ?: 0.0))).toInt()
+
+    /** Mirrors RequestBuyItem: checks price, stock and adena, pays the castle tax. */
+    fun buyFromNpc(bot: Player, shop: Shop, product: Product, count: Int): Boolean {
+        if (count <= 0 || product.price <= 0) return false
+        if (!product.item.isStackable && count > 1) return false
+        if (product.hasLimitedStock() && count > product.count) return false
+
+        val price = priceWithTax(shop, product)
+        if (Int.MAX_VALUE / count < price) return false
+        val total = price * count
+        if (!bot.reduceAdena("Buy", total, shop.merchant, false)) return false
+
+        if (product.hasLimitedStock() && !product.decreaseCount(count)) return false
+        bot.inventory.addItem("Buy", product.itemId, count, bot, shop.merchant)
+        shop.merchant.castle?.let { it.addToTreasury((total * it.taxRate).toInt()) }
+        EconomyLog.log(bot, Deal.NpcBuy, "bought ${count}x ${product.item.name} for $total from NPC ${shop.merchant.name}")
+        return true
+    }
+
+    /** Mirrors RequestSellItem: half the reference price, sellable items only. Returns the adena earned. */
+    fun sellToNpc(bot: Player, shop: Shop, items: List<ItemInstance>): Int {
+        var total = 0L
+        val sold = mutableListOf<String>()
+        for (item in items) {
+            if (!item.isSellable || item.isEquipped || item.ownerId != bot.objectId || item.referencePrice < 2) continue
+            val count = item.count
+            val price = item.referencePrice / 2L * count
+            if (bot.inventory.destroyItem("Sell", item.objectId, count, bot, shop.merchant) == null) continue
+            total += price
+            sold += "${count}x ${item.itemName}"
+        }
+        val earned = total.coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
+        if (earned > 0) bot.addAdena("Sell", earned, shop.merchant, false)
+        if (sold.isNotEmpty()) EconomyLog.log(bot, Deal.NpcSell, "sold to NPC for $earned: ${sold.joinToString()}")
+        return earned
+    }
+
+    /** Private stores around the bot, other than its own. */
+    fun storesNear(bot: Player): List<Player> = bot.getKnownTypeInRadius(Player::class.java, STORE_RADIUS)
+            .filter { it !== bot && it.isOnline && !it.isDead }
+
+    fun sellOffers(bot: Player, itemId: Int): List<StoreOffer> = storesNear(bot)
+            .filter { it.storeType == StoreType.SELL }
+            .flatMap { owner -> owner.sellList.items.filter { it.item.itemId == itemId }.map { StoreOffer(owner, it) } }
+            .sortedBy { it.tradeItem.price }
+
+    fun buyOffers(bot: Player, itemId: Int): List<StoreOffer> = storesNear(bot)
+            .filter { it.storeType == StoreType.BUY }
+            .flatMap { owner -> owner.buyList.items.filter { it.item.itemId == itemId }.map { StoreOffer(owner, it) } }
+            .sortedByDescending { it.tradeItem.price }
+
+    /** Mirrors RequestPrivateStoreBuy: the store owner gets the adena, the bot gets the items. */
+    fun buyFromStore(bot: Player, offer: StoreOffer, count: Int): Boolean {
+        val owner = offer.owner
+        if (owner.storeType != StoreType.SELL || count <= 0) return false
+        val request = ItemRequest(offer.tradeItem.objectId, count, offer.tradeItem.price)
+        if (!owner.sellList.privateStoreBuy(bot, mutableSetOf(request))) return false
+        closeIfEmpty(owner)
+        EconomyLog.log(bot, Deal.StoreBuy, "bought ${count}x ${offer.tradeItem.item.name} for ${count.toLong() * offer.tradeItem.price} from store of ${owner.name}")
+        return true
+    }
+
+    /** Mirrors RequestPrivateStoreSell: the store owner pays, the bot hands over the items. */
+    fun sellToStore(bot: Player, offer: StoreOffer, item: ItemInstance, count: Int): Boolean {
+        val owner = offer.owner
+        if (owner.storeType != StoreType.BUY || count <= 0) return false
+        val request = ItemRequest(item.objectId, item.itemId, count, offer.tradeItem.price)
+        if (!owner.buyList.privateStoreSell(bot, arrayOf(request))) return false
+        closeIfEmpty(owner)
+        EconomyLog.log(bot, Deal.StoreSell, "sold ${count}x ${item.itemName} for ${count.toLong() * offer.tradeItem.price} to store of ${owner.name}")
+        return true
+    }
+
+    private fun closeIfEmpty(owner: Player) {
+        val list = if (owner.storeType == StoreType.BUY) owner.buyList else owner.sellList
+        if (list.items.isEmpty()) {
+            owner.storeType = StoreType.NONE
+            owner.broadcastUserInfo()
+        }
+    }
+
+    private fun buildShops(): List<Shop> = SpawnTable.getInstance().spawns
+            .mapNotNull { it.npc as? Merchant }
+            // Clan hall stewards serve their clan only; the world's shops are the town merchants.
+            .filter { !it.title.contains("Steward", ignoreCase = true) }
+            .mapNotNull { merchant ->
+                val products = BuyListManager.getInstance().getBuyListsByNpcId(merchant.npcId)
+                        .flatMap { it.products }
+                        .filter { it.price > 0 }
+                        .groupBy { it.itemId }
+                        .mapValues { (_, list) -> list.minByOrNull { it.price }!! }
+                if (products.isEmpty()) null else Shop(merchant, products)
+            }
+            .also { println("Autobots economy: ${it.size} shops indexed.") }
+
+    fun location(shop: Shop) = shop.merchant.location()
+}
+
+/** Kinds of economy events, counted for the periodic summary. */
+internal enum class Deal { NpcBuy, NpcSell, StoreBuy, StoreSell, Equip, EnchantSuccess, EnchantReset, EnchantBreak, SellStore, BuyStore, ModeChange, Crystallize }
+
+internal object EconomyLog {
+    private val counts = ConcurrentHashMap<Deal, AtomicInteger>()
+
+    fun log(bot: Player, deal: Deal, message: String) {
+        counts.computeIfAbsent(deal) { AtomicInteger() }.incrementAndGet()
+        if (AutobotData.settings.economyLog) println("Autobots economy: ${bot.name} (lv ${bot.level}): $message")
+    }
+
+    /** A planned deal that didn't happen, and why: shows what holds the economy back. */
+    fun skip(bot: Player, reason: String) {
+        if (AutobotData.settings.economyLog) println("Autobots economy: ${bot.name} (lv ${bot.level}): skipped: $reason")
+    }
+
+    /**
+     * One line about the whole population since the last summary, so a run can be judged without reading every deal:
+     * deals by kind, then the state of the bots online.
+     */
+    fun summary(bots: Collection<Autobot>) {
+        val deals = Deal.values().joinToString(" ") { "${it.name}=${counts[it]?.getAndSet(0) ?: 0}" }
+        if (bots.isEmpty()) {
+            println("Autobots economy summary: $deals online=0")
+            return
+        }
+        val adena = bots.sumOf { it.adena.toLong() }
+        val stores = bots.count { it.isInStoreMode }
+        val farming = bots.count { it.life?.isFallingBack == true }
+        val needGroup = bots.count { it.needsGroup }
+        val avgLevel = bots.sumOf { it.level } / bots.size
+        val maxLevel = bots.maxOf { it.level }
+        // Bots below 20 have no role yet; the mix of the others shows whether healers and buffers keep up.
+        val roles = bots.filter { it.level >= 20 }.groupingBy { if (Role.isSummoner(it.classId)) "Summoner" else Role.of(it.classId).name }.eachCount()
+                .entries.sortedBy { it.key }.joinToString(",") { "${it.key}:${it.value}" }
+        println("Autobots economy summary: $deals online=${bots.size} avgLevel=$avgLevel maxLevel=$maxLevel " +
+                "adena=$adena adenaPerBot=${adena / bots.size} stores=$stores farming=$farming needsGroup=$needGroup roles=${roles.ifEmpty { "-" }}")
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/MarketBook.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/MarketBook.kt
new file mode 100644
index 0000000..3ba79b1
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/MarketBook.kt
@@ -0,0 +1,305 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.utils.Klock
+import kotlinx.coroutines.delay
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.ConcurrentLinkedQueue
+import kotlin.math.pow
+
+/**
+ * How a character trades, fixed for life like the rest of its character: greedy ones ask more, bid less and give
+ * little away when haggling; impatient ones cut the price of what doesn't sell quickly.
+ */
+internal object TradeTemper {
+    /** 0 (easy-going) to 1 (greedy). */
+    fun greed(player: Player): Double = Math.floorMod(player.objectId * 48271 + 11, 1000) / 1000.0
+
+    /** 0 (sells off fast) to 1 (waits for a buyer). */
+    fun patience(player: Player): Double = Math.floorMod(player.objectId * 69621 + 7, 1000) / 1000.0
+}
+
+/**
+ * The market as everybody in town sees it: what sells and for how much, what is on offer in stores and what people
+ * look for. Every minute the private stores of everyone online (bots and players) are read: listings give supply
+ * and demand, and listings that shrank are sales. Bots that look for an item add to its demand whether they find it
+ * or not. Sales are kept in `autobot_market` for a week, so prices survive a restart.
+ */
+internal object MarketBook {
+    private class Sale(val price: Int, val count: Int, val time: Long)
+    private class Listing(val itemId: Int, val count: Int, val price: Int, val owned: Int)
+
+    private const val SNAPSHOT_MS = 60_000L
+    private const val SUMMARY_EVERY_SNAPSHOTS = 10
+    private const val PRICE_WINDOW_MS = 3 * 24 * 3600_000L
+    private const val KEEP_MS = 7 * 24 * 3600_000L
+    private const val DEMAND_WINDOW_MS = 24 * 3600_000L
+    private const val MAX_SALES_PER_ITEM = 30
+    /** Sales it takes for the market price to replace the book value altogether. */
+    private const val TRUSTED_SALES = 5
+
+    private val sales = ConcurrentHashMap<Int, ArrayDeque<Sale>>()
+    /** itemId -> who looked for it and when: one entry per character, refreshed on every search. */
+    private val searches = ConcurrentHashMap<Int, ConcurrentHashMap<Int, Long>>()
+    @Volatile private var supply: Map<Int, Int> = emptyMap()
+    @Volatile private var wanted: Map<Int, Int> = emptyMap()
+    /** Store listings seen in the last snapshot: (owner, object id) for sell stores, (owner, -item id) for buy stores. */
+    private val listings = ConcurrentHashMap<Pair<Int, Int>, Listing>()
+    private val unsaved = ConcurrentLinkedQueue<Pair<Int, Sale>>()
+    private var snapshots = 0
+    private var salesSinceSummary = 0
+    private var haggles = 0
+
+    /** A deal two characters agreed on below the asking price, counted for the summary. */
+    fun haggled() {
+        haggles++
+    }
+
+    private val enabled get() = AutobotData.settings.economyEnabled
+
+    init {
+        load()
+        Klock.start("market", SNAPSHOT_MS, SNAPSHOT_MS, CoScopes.generalScope) { snapshot() }
+    }
+
+    /** A deal made outside the stores the book reads, e.g. through the trade window. */
+    fun recordSale(itemId: Int, unitPrice: Int, count: Int) {
+        if (unitPrice <= 0 || count <= 0) return
+        val sale = Sale(unitPrice, count, System.currentTimeMillis())
+        val list = sales.getOrPut(itemId) { ArrayDeque() }
+        synchronized(list) {
+            list.addLast(sale)
+            while (list.size > MAX_SALES_PER_ITEM) list.removeFirst()
+        }
+        unsaved += itemId to sale
+        salesSinceSummary++
+    }
+
+    /** [player] looked for [itemId] in the stores around: demand, whether or not they found it. */
+    fun searched(player: Player, itemId: Int) {
+        searches.getOrPut(itemId) { ConcurrentHashMap() }[player.objectId] = System.currentTimeMillis()
+    }
+
+    /** A store closed by its owner: what is gone from it was not sold. */
+    fun storeClosed(owner: Player) {
+        listings.keys.removeIf { it.first == owner.objectId }
+    }
+
+    /**
+     * What one piece is worth on this market. The book value (shop price, else reference price) gives way to the
+     * median of recent sales as they pile up; scarcity (more people looking than selling) raises it, a flooded market
+     * lowers it. Never more than a shop charges, never less than a shop pays.
+     */
+    fun value(itemId: Int): Int {
+        val book = Market.fairValue(itemId)
+        if (book <= 0) return 0
+        val now = System.currentTimeMillis()
+        val recent = sales[itemId]?.let { list -> synchronized(list) { list.filter { now - it.time < PRICE_WINDOW_MS }.map { it.price } } }.orEmpty()
+        val anchor = if (recent.isEmpty()) book.toDouble() else {
+            val median = recent.sorted()[recent.size / 2]
+            book + (median - book) * minOf(recent.size, TRUSTED_SALES) / TRUSTED_SALES.toDouble()
+        }
+        val price = anchor * pressure(itemId)
+        val ceiling = Market.npcPrice(itemId)?.toDouble() ?: book * 4.0
+        return price.coerceAtMost(ceiling).coerceAtLeast(Market.npcSellPrice(itemId).toDouble()).toInt()
+    }
+
+    /** People looking for an item against stores selling it, damped: from 0.75 (flooded) to 1.5 (sought after). */
+    fun pressure(itemId: Int): Double {
+        val ratio = (demand(itemId) + 1.0) / ((supply[itemId] ?: 0) + 1.0)
+        return ratio.pow(0.2).coerceIn(0.75, 1.5)
+    }
+
+    fun demand(itemId: Int): Int {
+        val since = System.currentTimeMillis() - DEMAND_WINDOW_MS
+        return (searches[itemId]?.values?.count { it > since } ?: 0) + (wanted[itemId] ?: 0)
+    }
+
+    private fun snapshot() {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        val seen = HashMap<Pair<Int, Int>, Listing>()
+        val selling = HashMap<Int, Int>()
+        val buying = HashMap<Int, Int>()
+        val online = World.getInstance().players.associateBy { it.objectId }
+
+        for (owner in online.values) {
+            when (owner.storeType) {
+                StoreType.SELL, StoreType.PACKAGE_SELL -> owner.sellList.items.forEach {
+                    val itemId = it.item.itemId
+                    seen[owner.objectId to it.objectId] = Listing(itemId, it.count, it.price, owner.inventory.getItemByObjectId(it.objectId)?.count ?: 0)
+                    selling.merge(itemId, 1, Int::plus)
+                }
+                StoreType.BUY -> owner.buyList.items.forEach {
+                    val itemId = it.item.itemId
+                    seen[owner.objectId to -itemId] = Listing(itemId, it.count, it.price, owner.inventory.getInventoryItemCount(itemId, -1))
+                    buying.merge(itemId, 1, Int::plus)
+                }
+                else -> {}
+            }
+        }
+
+        // A listing that shrank was sold from; one that vanished was sold out if the goods left the owner too.
+        for ((key, before) in listings) {
+            val owner = online[key.first] ?: continue
+            val after = seen[key]
+            val sold = when {
+                after != null && after.price == before.price -> before.count - after.count
+                after != null -> 0
+                key.second > 0 -> before.owned - (owner.inventory.getItemByObjectId(key.second)?.count ?: 0)
+                else -> owner.inventory.getInventoryItemCount(before.itemId, -1) - before.owned
+            }.coerceIn(0, before.count)
+            if (sold > 0) recordSale(before.itemId, before.price, sold)
+        }
+        listings.clear()
+        listings.putAll(seen)
+        supply = selling
+        wanted = buying
+
+        searches.values.forEach { who -> who.values.removeIf { now - it > DEMAND_WINDOW_MS } }
+        save()
+        if (++snapshots % SUMMARY_EVERY_SNAPSHOTS == 0) summary()
+    }
+
+    /** One line every 10 minutes: sales since the last line and the items whose price moved most from book value. */
+    private fun summary() {
+        if (!AutobotData.settings.economyLog) return
+        val items = (sales.keys + supply.keys + wanted.keys + searches.keys).toSet()
+        val moved = items.mapNotNull { itemId ->
+            val book = Market.fairValue(itemId)
+            if (book <= 0) null else Triple(itemId, book, value(itemId))
+        }.sortedByDescending { (_, book, value) -> kotlin.math.abs(value - book).toDouble() / book }.take(5)
+        println("Autobots market: sales=$salesSinceSummary haggles=$haggles listings=${supply.values.sum()} wanted=${wanted.values.sum()} " +
+                "sought=${searches.count { (_, who) -> who.isNotEmpty() }} moved: " + moved.joinToString { (itemId, book, value) ->
+            "${ItemTable.getInstance().getTemplate(itemId)?.name ?: itemId} $book->$value (demand ${demand(itemId)}, supply ${supply[itemId] ?: 0})"
+        })
+        salesSinceSummary = 0
+        haggles = 0
+    }
+
+    private fun load() {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("DELETE FROM autobot_market WHERE sale_time < ?").use { ps ->
+                    ps.setLong(1, System.currentTimeMillis() - KEEP_MS)
+                    ps.executeUpdate()
+                }
+                con.prepareStatement("SELECT item_id, price, count, sale_time FROM autobot_market ORDER BY sale_time").use { ps ->
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) {
+                            val list = sales.getOrPut(rs.getInt(1)) { ArrayDeque() }
+                            list.addLast(Sale(rs.getInt(2), rs.getInt(3), rs.getLong(4)))
+                            if (list.size > MAX_SALES_PER_ITEM) list.removeFirst()
+                        }
+                    }
+                }
+            }
+            println("Autobots market: ${sales.values.sumOf { it.size }} recent sales of ${sales.size} items loaded.")
+        } catch (e: Exception) {
+            println("Autobots market: could not load sales: ${e.message}")
+        }
+    }
+
+    private fun save() {
+        if (unsaved.isEmpty()) return
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("INSERT INTO autobot_market (item_id, price, count, sale_time) VALUES (?,?,?,?)").use { ps ->
+                    while (true) {
+                        val (itemId, sale) = unsaved.poll() ?: break
+                        ps.setInt(1, itemId)
+                        ps.setInt(2, sale.price)
+                        ps.setInt(3, sale.count)
+                        ps.setLong(4, sale.time)
+                        ps.addBatch()
+                    }
+                    ps.executeBatch()
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots market: could not save sales: ${e.message}")
+        }
+    }
+}
+
+/**
+ * Haggling over a price, the way players do it in whispers: the buyer names a lower price, the seller takes it,
+ * meets them halfway or refuses. How far a seller goes down depends on its greed, on the market (no discount on
+ * something scarce priced below its value), on how long the item has been sitting unsold and on how it likes the buyer.
+ */
+internal object MarketHaggle {
+    /** A buyer haggles only over prices up to this much above what it would pay. */
+    const val REACH = 1.35
+
+    /**
+     * The lowest unit price [seller] would accept for [itemId] it asks [asked] for, from [buyer].
+     * [unsoldSessions] is how many times the item has already been on offer without selling.
+     */
+    fun floor(seller: Player, buyer: Player, itemId: Int, asked: Int, unsoldSessions: Int = 0): Int {
+        val greed = TradeTemper.greed(seller)
+        var give = 0.05 + 0.2 * (1 - greed) + 0.03 * minOf(unsoldSessions, 3)
+        if (asked <= MarketBook.value(itemId)) give /= 2
+        if (Relations.affinity(seller, buyer) >= Relations.FRIEND) give += 0.1
+        return maxOf(Market.npcSellPrice(itemId), (asked * (1 - give)).toInt())
+    }
+
+    /**
+     * The unit price two characters settle on, or null when the seller won't go down to what the buyer can pay.
+     * A greedy seller ends up closer to the buyer's limit, an easy-going one closer to its own floor.
+     */
+    fun settle(buyer: Player, seller: Player, itemId: Int, asked: Int, buyerLimit: Int, unsoldSessions: Int = 0): Int? {
+        if (buyerLimit >= asked) return asked
+        val floor = floor(seller, buyer, itemId, asked, unsoldSessions)
+        if (buyerLimit < floor) return null
+        return (floor + (buyerLimit - floor) * (0.3 + 0.4 * TradeTemper.greed(seller))).toInt().coerceAtMost(asked)
+    }
+
+    /**
+     * The conversation around [settle] between a buying bot and a bot's store, a few whispers with pauses.
+     * @return the agreed unit price, or null without a deal.
+     */
+    suspend fun haggle(buyer: Autobot, seller: Player, itemId: Int, asked: Int, buyerLimit: Int, unsoldSessions: Int = 0): Int? {
+        val russian = Rnd.get(100) < 60
+        // A greedy buyer opens low.
+        val opening = (buyerLimit * (0.95 - 0.15 * TradeTemper.greed(buyer))).toInt()
+        val name = ItemTable.getInstance().getTemplate(itemId)?.name ?: return null
+        buyer.tell(seller.name, if (russian) listOf("скинь $name до ${short(opening)}?", "${short(opening)} за $name отдашь?", "$name за ${short(opening)}?").random()
+                else listOf("${short(opening)} for $name?", "can u do ${short(opening)} for $name?", "$name ${short(opening)} ok?").random())
+        delay(Rnd.get(2000L, 5000L))
+
+        val sellerBot = seller as? Autobot
+        val price = settle(buyer, seller, itemId, asked, buyerLimit, unsoldSessions)
+        when {
+            opening >= floor(seller, buyer, itemId, asked, unsoldSessions) -> {
+                sellerBot?.tell(buyer.name, if (russian) listOf("ок, забирай", "ладно", "договорились").random() else listOf("ok deal", "ok", "fine").random())
+                return opening
+            }
+            price == null -> {
+                sellerBot?.tell(buyer.name, if (russian) listOf("нет, цена нормальная", "не, дешевле не отдам", "нет").random() else listOf("no, price is fine", "nope", "no sry").random())
+                return null
+            }
+            else -> {
+                sellerBot?.tell(buyer.name, if (russian) "давай за ${short(price)}" else "${short(price)} and its yours")
+                delay(Rnd.get(1500L, 4000L))
+                buyer.tell(seller.name, if (russian) listOf("ок", "идёт", "ладно, беру").random() else listOf("ok", "deal", "k").random())
+                return price
+            }
+        }
+    }
+
+    /** Prices the way players write them: 45k, 1.2kk. */
+    fun short(price: Int): String = when {
+        price >= 1_000_000 -> String.format(java.util.Locale.US, "%.1fkk", price / 1_000_000.0).replace(".0kk", "kk")
+        price >= 10_000 -> "${price / 1000}k"
+        else -> "$price"
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/StoreKeeper.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/StoreKeeper.kt
new file mode 100644
index 0000000..ae2860e
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/StoreKeeper.kt
@@ -0,0 +1,168 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+import net.sf.l2j.gameserver.network.clientpackets.AbstractEnchantPacket
+import net.sf.l2j.gameserver.network.serverpackets.PrivateStoreMsgBuy
+import net.sf.l2j.gameserver.network.serverpackets.PrivateStoreMsgSell
+import net.sf.l2j.gameserver.taskmanager.AttackStanceTaskManager
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.math.pow
+
+/**
+ * Private stores of population bots, stocked only with what the bot owns: a sell store for valuable surplus
+ * (materials, recipes, gear, scrolls), or a buy store for gear and scrolls town shops don't sell, paid with the
+ * bot's own adena. Prices sit between what an NPC pays and what it charges, so the store is worth visiting.
+ */
+internal object StoreKeeper {
+    /** A stack worth less than this to an NPC is not worth a store slot; it goes to the shop. */
+    const val MIN_STORE_STACK_VALUE = 2000
+    private const val MIN_DISTANCE_TO_OTHER_STORE = 150
+    private const val MAX_TITLE = 29
+    private const val NOVICE_LEVEL = 20
+
+    // Unsold sessions per bot and item: each one cuts the asking price by 10%. Lost on restart, like a player's memory.
+    private val unsold = ConcurrentHashMap<Int, MutableMap<Int, Int>>()
+    // Asking price multipliers, fixed per bot and item so a store doesn't reprice itself every reopening.
+    private fun roll(botId: Int, itemId: Int, range: ClosedFloatingPointRange<Double>): Double {
+        val r = Math.floorMod(botId * 7919 + itemId * 104729, 1000) / 1000.0
+        return range.start + (range.endInclusive - range.start) * r
+    }
+
+    /** Surplus worth selling in a store rather than to an NPC. */
+    fun storeGoods(bot: Autobot): List<ItemInstance> = Gear.surplus(bot)
+            .filter { it.isTradable && askingPrice(bot, it.itemId).toLong() * it.count >= MIN_STORE_STACK_VALUE && askingPrice(bot, it.itemId) > Market.npcSellPrice(it.itemId) }
+
+    /** Items the bot is looking for that town shops don't sell: the next gear piece and scrolls for its gear. */
+    fun wanted(bot: Autobot): List<Int> {
+        val gear = Gear.wishes(bot).map { it.itemId }.filter { Market.npcPrice(it) == null }.take(1)
+        val scrolls = AbstractEnchantPacket._scrolls
+                .filter { (_, scroll) -> !scroll.isBlessed && !scroll.isCrystal && bot.inventory.paperdollItems.any { scroll.isValid(it) } }
+                .keys
+        // Summoners buy crystals from dwarves' stores: no town shop sells them.
+        val crystals = listOfNotNull(Gear.summonCrystal(bot)?.takeIf { Gear.count(bot, it) < Crystals.WANTED })
+        return (gear + crystals + scrolls).distinct()
+    }
+
+    fun hasBusiness(bot: Autobot): Boolean = storeGoods(bot).isNotEmpty() || (bot.adena > 0 && wanted(bot).any { bidPrice(bot, it) in 1..bot.adena })
+
+    /**
+     * What the bot asks for one piece: the market value, more from a greedy bot, below the shop price for what shops
+     * sell (or nobody would come). A novice guesses with a wider spread. Each session without a sale cuts the price,
+     * by 15% for an impatient bot down to 5% for a patient one.
+     */
+    fun askingPrice(bot: Autobot, itemId: Int): Int {
+        val inShops = Market.npcPrice(itemId) != null
+        val greed = TradeTemper.greed(bot)
+        val low = if (inShops) 0.6 + 0.15 * greed else 0.8 + 0.4 * greed
+        val spread = (if (inShops) 0.15 else 0.3) * if (bot.level < NOVICE_LEVEL) 2 else 1
+        val base = MarketBook.value(itemId) * roll(bot.objectId, itemId, low..low + spread)
+        val discount = (0.85 + 0.1 * TradeTemper.patience(bot)).pow(unsold[bot.objectId]?.get(itemId) ?: 0)
+        return (base * discount).toInt().coerceAtLeast(Market.npcSellPrice(itemId))
+    }
+
+    /** What the bot offers in a buy store: below the market value, lower from a greedy bot. */
+    fun bidPrice(bot: Autobot, itemId: Int): Int {
+        val inShops = Market.npcPrice(itemId) != null
+        val greed = TradeTemper.greed(bot)
+        val high = if (inShops) 0.85 - 0.15 * greed else 1.05 - 0.25 * greed
+        return (MarketBook.value(itemId) * roll(bot.objectId, itemId + 1, high - 0.2..high)).toInt()
+    }
+
+    /** The most the bot pays a store per piece: up to the shop price, or somewhat over the market value for the rest. */
+    fun buyLimit(bot: Autobot, itemId: Int): Int =
+            Market.npcPrice(itemId) ?: (MarketBook.value(itemId) * (1.1 + 0.3 * (1 - TradeTemper.greed(bot)))).toInt()
+
+    fun unsoldSessions(bot: Player, itemId: Int): Int = unsold[bot.objectId]?.get(itemId) ?: 0
+
+    /** Opens a sell store if there is valuable surplus, otherwise a buy store if the bot wants something. */
+    fun open(bot: Autobot): Boolean {
+        if (!canOpenHere(bot)) return false
+        return openSellStore(bot) || openBuyStore(bot)
+    }
+
+    fun canOpenHere(bot: Player): Boolean = !bot.isInsideZone(ZoneId.NO_STORE) && !bot.isInCombat &&
+            !AttackStanceTaskManager.getInstance().isInAttackStance(bot) && !bot.isCastingNow &&
+            bot.getKnownTypeInRadius(Player::class.java, MIN_DISTANCE_TO_OTHER_STORE).none { it.isInStoreMode }
+
+    private fun openSellStore(bot: Autobot): Boolean {
+        val goods = storeGoods(bot).sortedByDescending { askingPrice(bot, it.itemId).toLong() * it.count }.take(bot.privateSellStoreLimit)
+        if (goods.isEmpty()) return false
+
+        val list = bot.sellList
+        list.clear()
+        list.isPackaged = false
+        for (item in goods) list.addItem(item.objectId, item.count, priceAgainstNeighbours(bot, item.itemId))
+        if (list.items.isEmpty()) return false
+        list.title = title("WTS", goods.first().itemName, goods.size)
+
+        bot.sitDown()
+        bot.storeType = StoreType.SELL
+        bot.broadcastUserInfo()
+        bot.broadcastPacket(PrivateStoreMsgSell(bot))
+        EconomyLog.log(bot, Deal.SellStore, "opened sell store: " + list.items.joinToString { "${it.count}x ${it.item.name} @${it.price}" })
+        return true
+    }
+
+    private fun openBuyStore(bot: Autobot): Boolean {
+        // Only what the bot can actually pay for: the store can't promise adena the bot doesn't have.
+        var budget = (bot.adena * 0.8).toLong()
+        val list = bot.buyList
+        list.clear()
+        for (itemId in wanted(bot).take(bot.privateBuyStoreLimit)) {
+            val price = bidPrice(bot, itemId)
+            if (price <= 0) continue
+            val template = ItemTable.getInstance().getTemplate(itemId) ?: continue
+            val count = if (template.isStackable) (budget / price).coerceAtMost(Rnd.get(1, 3).toLong()).toInt() else if (budget >= price) 1 else 0
+            if (count <= 0) continue
+            list.addItemByItemId(itemId, count, price)
+            budget -= price.toLong() * count
+        }
+        if (list.items.isEmpty()) return false
+        list.title = title("WTB", list.items.first().item.name, list.items.size)
+
+        bot.sitDown()
+        bot.storeType = StoreType.BUY
+        bot.broadcastUserInfo()
+        bot.broadcastPacket(PrivateStoreMsgBuy(bot))
+        EconomyLog.log(bot, Deal.BuyStore, "opened buy store: " + list.items.joinToString { "${it.count}x ${it.item.name} @${it.price}" })
+        return true
+    }
+
+    /** An easy-going seller undercuts a store nearby that sells the same thing cheaper; a greedy one keeps its price. */
+    private fun priceAgainstNeighbours(bot: Autobot, itemId: Int): Int {
+        val own = askingPrice(bot, itemId)
+        if (TradeTemper.greed(bot) >= 0.5) return own
+        val cheapest = Market.sellOffers(bot, itemId).firstOrNull()?.tradeItem?.price ?: return own
+        return if (cheapest < own) maxOf((cheapest * 0.97).toInt(), Market.npcSellPrice(itemId) + 1) else own
+    }
+
+    /** Closes the store and remembers what didn't sell, so it's offered cheaper next time. */
+    fun close(bot: Autobot) {
+        if (!bot.isInStoreMode) return
+        if (bot.storeType == StoreType.SELL) {
+            val memory = unsold.computeIfAbsent(bot.objectId) { ConcurrentHashMap() }
+            bot.sellList.items.forEach { memory.merge(it.item.itemId, 1, Int::plus) }
+        }
+        MarketBook.storeClosed(bot)
+        bot.sellList.clear()
+        bot.buyList.clear()
+        bot.storeType = StoreType.NONE
+        bot.standUp()
+        bot.broadcastUserInfo()
+    }
+
+    fun forget(bot: Autobot, itemId: Int) {
+        unsold[bot.objectId]?.remove(itemId)
+    }
+
+    private fun title(kind: String, first: String, count: Int): String {
+        val text = if (count > 1) "$kind $first and more" else "$kind $first"
+        return if (text.length <= MAX_TITLE) text else text.take(MAX_TITLE)
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/TownTrip.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/TownTrip.kt
