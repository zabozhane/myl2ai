--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/PartyInvites.kt
@@ -0,0 +1,81 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import net.sf.l2j.gameserver.network.serverpackets.JoinParty
+
+/** How much a bot likes playing with others; fixed per bot, like the enchanting temper. */
+internal enum class Sociability(val acceptPercent: Int) {
+    Loner(30), Regular(70), TeamPlayer(95);
+
+    companion object {
+        fun of(bot: Player): Sociability {
+            val roll = Math.floorMod(bot.objectId * 31337 + 17, 100)
+            return when {
+                roll < 25 -> Loner
+                roll < 70 -> Regular
+                else -> TeamPlayer
+            }
+        }
+    }
+}
+
+/**
+ * Party invitations to population bots. The client's AskJoinParty window never reaches a bot, so the core calls
+ * [onInvite] after a `/invite` and the bot answers a few seconds later through the same steps as
+ * `RequestAnswerJoinParty`. It decides like a player would: busy, wrong level, a PK, or just not in the mood.
+ */
+internal object PartyInvites {
+    private const val MAX_LEVEL_GAP = 8
+    private const val ANSWER_MIN_MS = 2000L
+    private const val ANSWER_MAX_MS = 6000L
+    private const val EXPLAIN_REFUSAL_PERCENT = 60
+
+    fun onInvite(requestor: Player, bot: Autobot) {
+        if (bot.life == null || !bot.isOnline) return
+        val (accept, reason) = decide(bot, requestor)
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(ANSWER_MIN_MS, ANSWER_MAX_MS))
+            if (bot.activeRequester !== requestor) return@launch
+            answer(bot, requestor, accept)
+            if (!accept && reason != null && Rnd.get(100) < EXPLAIN_REFUSAL_PERCENT) {
+                bot.tell(requestor.name, GroupChat.line(reason, GroupChat.isRussian(requestor)))
+            }
+        }
+    }
+
+    /** Why a bot would turn the invite down, or null to accept. */
+    fun decide(bot: Autobot, requestor: Player): Pair<Boolean, GroupChat.Line?> {
+        if (!groupsEnabled()) return false to null
+        if (bot.isInStoreMode || bot.isDead) return false to GroupChat.Line.Busy
+        if (requestor.karma > 0) return false to GroupChat.Line.NoPk
+
+        val partyLevel = requestor.party?.let { p -> p.members.sumOf { it.level } / p.members.size } ?: requestor.level
+        if (partyLevel - bot.level > MAX_LEVEL_GAP) return false to GroupChat.Line.TooHigh
+        if (bot.level - partyLevel > MAX_LEVEL_GAP) return false to GroupChat.Line.TooLow
+
+        val eager = bot.needsGroup || Role.of(bot.classId) == Role.Healer
+        val chance = if (eager) 98 else Sociability.of(bot).acceptPercent
+        return if (Rnd.get(100) < chance) true to null else false to GroupChat.Line.NotNow
+    }
+
+    /** The bot's answer, the same steps as RequestAnswerJoinParty (party matching rooms aside). */
+    fun answer(bot: Player, requestor: Player, accept: Boolean) {
+        requestor.sendPacket(JoinParty(if (accept) 1 else 0))
+        var party: Party? = requestor.party
+        if (accept && !bot.isInParty) {
+            if (bot is Autobot) bot.cancelSequence()
+            if (party == null) party = Party(requestor, bot, requestor.lootRule) else party.addPartyMember(bot)
+        }
+        party?.setPendingInvitation(false)
+        bot.activeRequester = null
+        requestor.onTransactionResponse()
+    }
+
+    private fun groupsEnabled() = dev.l2j.autobots.AutobotData.settings.groupsEnabled
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/Relations.kt b/src/main/kotlin/dev/l2j/autobots/population/group/Relations.kt
new file mode 100644
index 0000000..22a45f6
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/Relations.kt
@@ -0,0 +1,111 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+
+/** What one bot remembers about another character, bot or player. */
+internal class Relation(var minutesTogether: Int = 0, var affinity: Int = 0, var trust: Int = 0, var lastSeen: Long = 0) {
+    var dirty = false
+}
+
+/**
+ * Each bot's memory of the characters it played with: time in the same party and a liking from -100 to 100 that
+ * grows with play and help and drops with wipes. Groups prefer friends and avoid people they dislike; clans
+ * (stage 4a) and pooling resources (4b) build on it, and trust is filled in by the trading stage (2g).
+ * Kept in memory for bots online, stored in `autobot_relations`.
+ */
+internal object Relations {
+    const val AVOID = -30
+    const val FRIEND = 60
+    private const val MAX_PER_BOT = 50
+    private const val MAX_AFFINITY = 100
+
+    private val memory = ConcurrentHashMap<Int, ConcurrentHashMap<Int, Relation>>()
+
+    fun affinity(bot: Player, other: Player): Int = memory[bot.objectId]?.get(other.objectId)?.affinity ?: 0
+
+    fun of(bot: Player, otherId: Int): Relation? = memory[bot.objectId]?.get(otherId)
+
+    /** Half a minute in the same party, counted for every pair of members within reach of each other. */
+    fun playedTogether(party: List<Player>, minutes: Double) {
+        val now = System.currentTimeMillis()
+        for (bot in party.filterIsInstance<Autobot>()) {
+            for (other in party) {
+                if (other === bot) continue
+                val relation = relation(bot, other.objectId)
+                relation.minutesTogether += kotlin.math.ceil(minutes).toInt()
+                // Liking grows slower the more there is of it: an hour together is about +10.
+                if (relation.affinity < MAX_AFFINITY && Math.random() < minutes / 6) relation.affinity++
+                relation.lastSeen = now
+                relation.dirty = true
+            }
+        }
+    }
+
+    /** A party wipe or someone leaving the party in trouble: everybody likes the others a bit less. */
+    fun badTime(party: List<Player>, amount: Int) {
+        for (bot in party.filterIsInstance<Autobot>()) for (other in party) {
+            if (other === bot) continue
+            relation(bot, other.objectId).apply { affinity = (affinity - amount).coerceAtLeast(-MAX_AFFINITY); dirty = true }
+        }
+    }
+
+    /** Healed or raised by [helper]: a small thanks in memory. */
+    fun helped(bot: Player, helper: Player) {
+        if (bot !is Autobot || bot === helper) return
+        relation(bot, helper.objectId).apply { affinity = (affinity + 1).coerceAtMost(MAX_AFFINITY); dirty = true }
+    }
+
+    private fun relation(bot: Player, otherId: Int): Relation {
+        val relations = memory.getOrPut(bot.objectId) { ConcurrentHashMap() }
+        return relations.getOrPut(otherId) {
+            // A full memory forgets the least liked, least recent acquaintance.
+            if (relations.size >= MAX_PER_BOT) relations.entries.minByOrNull { it.value.affinity * 1000L + it.value.lastSeen / 60_000 }?.let { relations.remove(it.key) }
+            Relation()
+        }
+    }
+
+    fun load(bot: Autobot) {
+        val relations = ConcurrentHashMap<Int, Relation>()
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("SELECT other_id, minutes_together, affinity, trust, last_seen FROM autobot_relations WHERE bot_id=?").use { ps ->
+                    ps.setInt(1, bot.objectId)
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) relations[rs.getInt(1)] = Relation(rs.getInt(2), rs.getInt(3), rs.getInt(4), rs.getLong(5))
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+        memory[bot.objectId] = relations
+    }
+
+    fun save(bot: Autobot, forget: Boolean = false) {
+        val relations = (if (forget) memory.remove(bot.objectId) else memory[bot.objectId]) ?: return
+        val changed = relations.filter { it.value.dirty }
+        if (changed.isEmpty()) return
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("REPLACE INTO autobot_relations (bot_id, other_id, minutes_together, affinity, trust, last_seen) VALUES (?,?,?,?,?,?)").use { ps ->
+                    for ((otherId, r) in changed) {
+                        ps.setInt(1, bot.objectId)
+                        ps.setInt(2, otherId)
+                        ps.setInt(3, r.minutesTogether)
+                        ps.setInt(4, r.affinity)
+                        ps.setInt(5, r.trust)
+                        ps.setLong(6, r.lastSeen)
+                        ps.addBatch()
+                        r.dirty = false
+                    }
+                    ps.executeBatch()
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+}
