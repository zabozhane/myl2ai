+
+// Monsters outside the level window give little or no exp (or are too dangerous), unless they already attack us.
+private const val TARGET_LEVEL_BELOW = 5
+private const val TARGET_LEVEL_ABOVE = 3
+
+private fun Creature.isWorthTargeting(target: Creature): Boolean {
+    if (target !is Monster || target.target === this) return true
+    return target.level in (level - TARGET_LEVEL_BELOW)..(level + TARGET_LEVEL_ABOVE)
+}
