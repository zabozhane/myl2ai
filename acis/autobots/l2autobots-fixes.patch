+++ b/src/main/kotlin/dev/l2j/autobots/population/group/GroupChat.kt
@@ -0,0 +1,203 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import java.util.Collections
+import java.util.WeakHashMap
+
+/**
+ * What a player says in party chat, taken as a teammate's suggestion and never as an order. The bots weigh it
+ * against the party's state and answer, agreeing or explaining why not. Keyword matching in Russian and English
+ * for now; this is the single entry the LLM of stage 5 will take over.
+ */
+internal object GroupChat {
+
+    enum class Intent(val pattern: Regex) {
+        AssistMe(Regex("(асс?ист|assist|бейте|бей|bei).{0,12}(меня|мою|мой|me\\b|my)", RegexOption.IGNORE_CASE)),
+        Rest(Regex("(отд(ох|ых)|передохн|сид(им|ите)|\\bmed\\b|\\brest\\b|мп\\b|\\bmp\\b|ман(ы|а) нет|no mana)", RegexOption.IGNORE_CASE)),
+        Buff(Regex("(баф|buff|\\bbb\\b)", RegexOption.IGNORE_CASE)),
+        NewSpot(Regex("(пойд[её]м|го в|go to|сменим|другое место|тут скучно|move spot|change spot|другой спот)", RegexOption.IGNORE_CASE)),
+        Brb(Regex("(брб|\\bbrb\\b|в город|\\bafk\\b|афк|щас вернусь)", RegexOption.IGNORE_CASE)),
+        Leaving(Regex("(я уш[её]л|ухожу|всем пока|\\bgtg\\b|\\bbye\\b|спс за пати|ty for party|всё,? я)", RegexOption.IGNORE_CASE));
+    }
+
+    /** Things a bot says, in both languages; the bot answers in the language it was spoken to in. */
+    enum class Line(val ru: List<String>, val en: List<String>) {
+        Ok(listOf("ок", "давай", "го", "ага"), listOf("ok", "sure", "k", "np")),
+        AssistTank(listOf("давай на танка, так надёжнее", "не, ассист на танка лучше", "лучше по танку бить"), listOf("better assist the tank", "nah, assist tank is safer")),
+        Resting(listOf("ок, сидим", "сели", "давай, мп добрать"), listOf("ok, resting", "sit", "k, med")),
+        NoNeedRest(listOf("да вроде все полные", "не, норм, бьём дальше"), listOf("everyone is full", "nah we're fine, keep going")),
+        BuffSoon(listOf("ща бафну", "ок, бафаю"), listOf("buffing", "ok, sec")),
+        BuffLasts(listOf("баф ещё %d мин", "ещё %d мин висит"), listOf("buff still %d min", "%d min left on buffs")),
+        NewSpotOk(listOf("ок, ищем другое место", "давай, тут правда пусто"), listOf("ok, lets move", "sure, moving")),
+        NewSpotNo(listOf("тут норм, давай ещё посидим", "не, тут хорошо идёт"), listOf("its good here, lets stay a bit", "nah, good exp here")),
+        Wait(listOf("ок, ждём", "давай, мы тут"), listOf("ok, we wait", "k, we're here")),
+        Thanks(listOf("спс за пати", "пока, спс", "удачи"), listOf("ty for party", "bye, ty", "gl")),
+        Busy(listOf("сорри, я торгую", "занят щас"), listOf("sorry, busy", "trading now, sorry")),
+        NoPk(listOf("с пк не пойду", "не, ты красный"), listOf("no pk, sorry", "you're red, no")),
+        TooHigh(listOf("ты для меня высоковат", "у вас уровень высокий, я там умру"), listOf("too high for me", "your lvl is too high for me")),
+        TooLow(listOf("сорри, ты для нас низковат", "маловат уровень"), listOf("sorry, too low for us", "lvl too low")),
+        NotNow(listOf("не, я соло", "сорри, не сейчас", "спс, но я сам"), listOf("no thanks, solo", "sorry, not now", "thx but no")),
+        RoleTaken(listOf("сорри, эта роль у нас уже есть", "у нас уже есть такой, нужен другой класс"), listOf("sorry, we have one already", "role taken, sorry")),
+        WeakGear(listOf("сорри, шмот слабоват для нашего места", "приоденься немного и пиши"), listOf("sorry, gear too weak for our spot", "get some gear and pm me")),
+        Inviting(listOf("ок, кидаю пати", "го, инвайт", "давай, приглашаю"), listOf("ok, inviting", "sure, inv", "k, sending invite"));
+    }
+
+    /** A player looking for a group, in public chat. */
+    private val LOOKING_FOR_PARTY = Regex("(ищу (пати|группу|конст)|возьм(ите|и) в (пати|группу)|кто в пати|\\blfp\\b|\\blfg\\b|looking for (a )?(party|group)|need (a )?party)", RegexOption.IGNORE_CASE)
+    /** A player answering a bot's shout or asking to join in a whisper. */
+    private val WANTS_TO_JOIN = Regex("(\\+|возьм|можно к вам|я к вам|инв|invite|\\binv\\b|join|пати|party|group|группу)", RegexOption.IGNORE_CASE)
+    private const val OFFER_MIN_MS = 10_000L
+    private const val OFFER_MAX_MS = 60_000L
+
+    private val RUSSIAN = Regex("[а-яА-ЯёЁ]")
+    private const val REPLY_MIN_MS = 1000L
+    private const val REPLY_MAX_MS = 4000L
+    private const val BUFF_ENOUGH_SECONDS = 600
+
+    fun isRussian(text: String) = RUSSIAN.containsMatchIn(text)
+
+    /** A player's language, guessed from the last thing they said to a bot; English until then. */
+    private val playerLanguage = Collections.synchronizedMap(WeakHashMap<Player, Boolean>())
+
+    fun isRussian(player: Player) = playerLanguage[player] ?: false
+
+    fun line(line: Line, russian: Boolean): String = (if (russian) line.ru else line.en).random()
+
+    /** The leader's shout for members: what the party lacks, its levels and where it is. */
+    fun lookingForMembers(party: Party, needs: List<Role>, place: String): String {
+        val low = party.members.minOf { it.level }
+        val high = party.members.maxOf { it.level }
+        val levels = if (low == high) "$low" else "$low-$high"
+        val russian = Rnd.get(100) < 50
+        val wanted = needs.joinToString(", ") { roleName(it, russian) }
+        return if (russian) "ищем в пати $wanted, уровень $levels, кач у $place, пм"
+        else "LF $wanted for party lvl $levels near $place, pm"
+    }
+
+    private fun roleName(role: Role, russian: Boolean) = when (role) {
+        Role.Healer -> if (russian) "хила" else "healer"
+        Role.Tank -> if (russian) "танка" else "tank"
+        Role.Buffer -> if (russian) "бафера" else "buffer"
+        Role.Spoiler -> if (russian) "спойлера" else "spoiler"
+        Role.Damage -> if (russian) "дд" else "dd"
+    }
+
+    /**
+     * A player says in public chat they look for a party. The leaders of bot parties around that could use them
+     * whisper an offer a little later, the way players do: who they are, where they hunt and what they need; the
+     * first one to get an answer wins. Nothing happens if the player is already in a party by then.
+     */
+    fun onPublicChat(chatter: Player, text: String, online: Collection<Autobot>) {
+        if (chatter is Autobot || chatter.isInParty || !LOOKING_FOR_PARTY.containsMatchIn(text)) return
+        val russian = isRussian(text)
+        playerLanguage[chatter] = russian
+        val parties = GroupFinder.partiesFor(chatter, online).filter { GroupFinder.judge(it, chatter) == null }.shuffled().take(2)
+        for (party in parties) {
+            val leader = party.leader as? Autobot ?: continue
+            CoScopes.generalScope.launch {
+                delay(Rnd.get(OFFER_MIN_MS, OFFER_MAX_MS))
+                if (chatter.isInParty || !chatter.isOnline || leader.party !== party) return@launch
+                val levels = "${party.members.minOf { it.level }}-${party.members.maxOf { it.level }}"
+                val place = GroupFinder.placeName(leader)
+                leader.tell(chatter.name, if (russian) "привет, у нас пати ${party.membersCount} чел, $levels ур., качаемся у $place. пойдёшь?"
+                        else "hi, we are ${party.membersCount} lvl $levels near $place, want to join?")
+                GroupFinder.offered(leader, chatter)
+            }
+        }
+    }
+
+    /**
+     * A whisper to a bot. A leader with room takes it as a request to join when it offered a place or the text
+     * asks for one, inspects the player and invites or explains why not.
+     * @return true if the whisper was handled here.
+     */
+    fun onWhisper(chatter: Player, bot: Autobot, text: String): Boolean {
+        if (chatter is Autobot || chatter.isInParty) return false
+        val party = bot.party ?: return false
+        if (party.leader !== bot || party.membersCount >= 9) return false
+        if (!GroupFinder.wasOffered(bot, chatter) && !WANTS_TO_JOIN.containsMatchIn(text)) return false
+        val russian = isRussian(text)
+        playerLanguage[chatter] = russian
+        GroupFinder.considerPlayer(bot, chatter, russian)
+        return true
+    }
+
+    fun onPartyChat(chatter: Player, text: String) {
+        if (chatter is Autobot) return
+        val party = chatter.party ?: return
+        val bots = party.members.filterIsInstance<Autobot>().filter { it.life != null && !it.isDead }
+        if (bots.isEmpty()) return
+
+        val russian = isRussian(text)
+        playerLanguage[chatter] = russian
+        val intent = Intent.values().firstOrNull { it.pattern.containsMatchIn(text) } ?: return
+        // One voice answers: the bot leading the party, else any bot in it.
+        val speaker = (party.leader as? Autobot)?.takeIf { it in bots } ?: bots.random()
+
+        val reply = react(intent, chatter, party, bots) ?: return
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(REPLY_MIN_MS, REPLY_MAX_MS))
+            val (answer, arg) = reply
+            speaker.partySay(line(answer, russian).let { if (arg != null) it.format(arg) else it })
+        }
+    }
+
+    /** Weighs the suggestion and changes the party plan when the party agrees. @return the answer and its argument. */
+    private fun react(intent: Intent, chatter: Player, party: Party, bots: List<Autobot>): Pair<Line, Int?>? = when (intent) {
+        Intent.AssistMe -> {
+            val worthIt = Role.of(chatter.classId) == Role.Tank || party.leader === chatter ||
+                    party.members.none { Role.of(it.classId) == Role.Tank }
+            if (worthIt) {
+                PartyPlan.state(party).assist = chatter
+                Line.Ok to null
+            } else Line.AssistTank to null
+        }
+        Intent.Rest -> {
+            val needed = party.members.any { it.currentMp < it.maxMp * 0.5 || it.currentHp < it.maxHp * 0.5 }
+            if (needed) {
+                PartyPlan.state(party).restUntilFull = true
+                Line.Resting to null
+            } else Line.NoNeedRest to null
+        }
+        Intent.Buff -> {
+            val buffers = bots.filter { Role.of(it.classId) == Role.Buffer || Role.of(it.classId) == Role.Healer }
+            if (buffers.isEmpty()) null
+            else {
+                val left = chatter.allEffects.filter { it.skill.isActive && it.period > 60 }.minOfOrNull { it.period - it.time }
+                if (left != null && left > BUFF_ENOUGH_SECONDS) Line.BuffLasts to left / 60 else Line.BuffSoon to null
+            }
+        }
+        Intent.NewSpot -> {
+            // The party agrees when most of it is bored: few kills lately, nobody hurt.
+            val agree = party.leader is Autobot && Rnd.get(100) < 60
+            if (agree) {
+                PartyPlan.state(party).newSpotRequested = true
+                Line.NewSpotOk to null
+            } else Line.NewSpotNo to null
+        }
+        Intent.Brb -> Line.Wait to null
+        Intent.Leaving -> Line.Thanks to null
+    }
+}
+
+/** What a party decides together: shared by its bots, dropped with the party. */
+internal class PartyState {
+    /** A member the others agreed to assist instead of the tank. */
+    var assist: Player? = null
+    /** Someone asked to rest: the leader sits until everybody is full. */
+    var restUntilFull = false
+    /** Someone asked to move on: the leading bot picks another spot. */
+    var newSpotRequested = false
+    /** Since when the leader waits for the others to come; null while the party is together. */
+    var gatheringSince: Long? = null
+    /** Full or casual; a party a player put together counts as casual. */
+    var kind = PartyKind.Casual
+    /** When a casual party bots formed goes separate ways; null for the others. */
+    var breakUpAt: Long? = null
+}
