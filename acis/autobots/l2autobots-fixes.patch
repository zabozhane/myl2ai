new file mode 100644
index 0000000..07e8f6d
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/Role.kt
@@ -0,0 +1,42 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.gameserver.enums.actors.ClassId
+import net.sf.l2j.gameserver.enums.actors.ClassId.*
+
+/** What a profession does in a party, as players of Interlude see it. Below 20 everybody is a damage dealer. */
+internal enum class Role {
+    Tank, Healer, Buffer, Spoiler, Damage;
+
+    companion object {
+        private val TANKS = setOf(KNIGHT, ELVEN_KNIGHT, PALUS_KNIGHT, PALADIN, DARK_AVENGER, TEMPLE_KNIGHT, SHILLIEN_KNIGHT,
+                PHOENIX_KNIGHT, HELL_KNIGHT, EVAS_TEMPLAR, SHILLIEN_TEMPLAR)
+        private val HEALERS = setOf(CLERIC, BISHOP, CARDINAL, ELVEN_ORACLE, ELVEN_ELDER, EVAS_SAINT, SHILLIEN_ORACLE, SHILLIEN_ELDER, SHILLIEN_SAINT)
+        private val BUFFERS = setOf(PROPHET, HIEROPHANT, ORC_SHAMAN, WARCRYER, DOOMCRYER, OVERLORD, DOMINATOR,
+                SWORD_SINGER, SWORD_MUSE, BLADEDANCER, SPECTRAL_DANCER)
+        private val SPOILERS = setOf(SCAVENGER, BOUNTY_HUNTER, FORTUNE_SEEKER)
+        private val SUMMONERS = setOf(WARLOCK, ARCANA_LORD, ELEMENTAL_SUMMONER, ELEMENTAL_MASTER, PHANTOM_SUMMONER, SPECTRAL_MASTER)
+
+        fun of(classId: ClassId): Role = when (classId) {
+            in TANKS -> Tank
+            in HEALERS -> Healer
+            in BUFFERS -> Buffer
+            in SPOILERS -> Spoiler
+            else -> Damage
+        }
+
+        fun isSummoner(classId: ClassId) = classId in SUMMONERS
+
+        /** Relative chance of picking [classId] at a profession change; `config.xml` tunes the population's mix. */
+        fun professionWeight(classId: ClassId): Int {
+            val settings = AutobotData.settings
+            return when {
+                isSummoner(classId) -> settings.professionWeightSummoner
+                of(classId) == Healer -> settings.professionWeightHealer
+                of(classId) == Buffer -> settings.professionWeightBuffer
+                of(classId) == Tank -> settings.professionWeightTank
+                else -> 100
+            }.coerceAtLeast(0)
+        }
+    }
+}
