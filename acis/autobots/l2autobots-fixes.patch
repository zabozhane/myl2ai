diff --git a/src/main/kotlin/dev/l2j/autobots/behaviors/LootPicker.kt b/src/main/kotlin/dev/l2j/autobots/behaviors/LootPicker.kt
new file mode 100644
index 0000000..e6679fb
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/behaviors/LootPicker.kt
@@ -0,0 +1,50 @@
+package dev.l2j.autobots.behaviors
+
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getHealthPercentage
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+
+/**
+ * Picks up drops around the bot one item per think tick, the way a player clicks them.
+ * Looting goes before fighting back (a live player grabs the drop first), unless health is low.
+ */
+internal class LootPicker(private val player: Player) {
+
+    // Pick-up attempts per item: an attempt can be dropped silently (the AI refuses PICK_UP mid-attack or mid-cast,
+    // the path is blocked), so an item is retried a few times and then given up, so the bot never loops on it.
+    private val attemptsByItemId = mutableMapOf<Int, Int>()
+
+    /** @return true while the bot is busy looting, so the combat step of this tick is skipped. */
+    fun onUpdate(): Boolean {
+        if (player.isDead || player.getHealthPercentage() < MIN_HEALTH_PERCENT_TO_LOOT) return false
+        if (player.ai.desire.intention == IntentionType.PICK_UP) return true
+
+        val item = findClosestLootableItem() ?: return false
+        // The AI ignores PICK_UP while an attack or cast is in progress; wait for it to end instead of spending an attempt.
+        if (player.isAttackingNow || player.isCastingNow) return true
+
+        attemptsByItemId.merge(item.objectId, 1, Int::plus)
+        player.ai.setIntention(IntentionType.PICK_UP, item)
+        return true
+    }
+
+    private fun findClosestLootableItem(): ItemInstance? = player.getKnownTypeInRadius(ItemInstance::class.java, LOOT_RADIUS)
+            .filter { isLootable(it) }
+            .minByOrNull { distance(player.x, player.y, player.z, it.x, it.y, it.z) }
+
+    private fun isLootable(item: ItemInstance): Boolean = item.isVisible &&
+            attemptsByItemId.getOrDefault(item.objectId, 0) < MAX_PICK_UP_ATTEMPTS &&
+            (item.ownerId == 0 || player.isLooterOrInLooterParty(item.ownerId)) &&
+            player.inventory.validateWeight(item.count * item.item.weight) &&
+            player.inventory.validateCapacity(item) &&
+            GeoEngine.getInstance().canMoveToTarget(player.x, player.y, player.z, item.x, item.y, item.z)
+
+    companion object {
+        private const val LOOT_RADIUS = 400
+        private const val MIN_HEALTH_PERCENT_TO_LOOT = 40.0
+        private const val MAX_PICK_UP_ATTEMPTS = 3
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/behaviors/Rester.kt b/src/main/kotlin/dev/l2j/autobots/behaviors/Rester.kt
new file mode 100644
