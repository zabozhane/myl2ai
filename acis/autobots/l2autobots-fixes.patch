+/** A profession among [choices], weighted by role so the population's mix can be tuned. */
+internal fun pickWeighted(choices: List<ClassId>): ClassId? {
+    if (choices.isEmpty()) return null
+    val total = choices.sumOf { Role.professionWeight(it) }
+    if (total <= 0) return choices.random()
