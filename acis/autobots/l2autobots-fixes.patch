+package dev.l2j.autobots.population.economy
+
+import net.sf.l2j.gameserver.enums.items.CrystalType
+import net.sf.l2j.gameserver.model.L2Skill
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Crystals: summoners need them for every summon and no shop sells them. Dwarves with the Crystallize skill break
+ * their unneeded graded gear into crystals instead of selling it to an NPC, and sell the crystals in their stores.
+ */
+internal object Crystals {
+    /** How many crystals a summoner tries to keep. */
+    const val WANTED = 40
+
+    fun crystallizeJunk(bot: Player) {
+        val skillLevel = bot.getSkillLevel(L2Skill.SKILL_CRYSTALLIZE)
+        if (skillLevel <= 0 || bot.isInStoreMode) return
+
+        for (item in Gear.surplus(bot)) {
+            val template = item.item
+            if (!item.isEquipable || item.isHeroItem || item.isShadowItem || !template.isCrystallizable || template.crystalCount <= 0) continue
+            // The same grade limits as RequestCrystallizeItem: level 1 breaks D, each level one grade more.
+            if (template.crystalType == CrystalType.NONE || template.crystalType.id > skillLevel) continue
+
+            val count = item.crystalCount
+            val removed = bot.inventory.destroyItem("Crystalize", item.objectId, item.count, bot, null) ?: continue
+            bot.inventory.addItem("Crystalize", template.crystalItemId, count, bot, bot)
+            EconomyLog.log(bot, Deal.Crystallize, "crystallized ${removed.itemName} into $count ${template.crystalType} crystals")
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Enchanter.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Enchanter.kt
