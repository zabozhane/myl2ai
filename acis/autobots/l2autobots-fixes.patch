@@ -0,0 +1,59 @@
+package dev.l2j.autobots.behaviors.sequences
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.extensions.moveTo
+import dev.l2j.autobots.population.isUnderAttack
+import dev.l2j.autobots.utils.CancellationToken
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+
+/**
+ * Walks to [destination] in short legs, so pathfinding only has to solve nearby obstacles.
+ * Stops when the bot is attacked, and calls [onStuck] when it stops getting closer.
+ */
+internal class WalkToSequence(override val bot: Player, private val destination: Location, private val arrivalRadius: Int, private val onStuck: () -> Unit) : Sequence {
+
+    override var cancellationToken: CancellationToken? = null
+
+    override suspend fun definition() {
+        var bestDistance = Double.MAX_VALUE
+        var checksWithoutProgress = 0
+
+        while (true) {
+            val remaining = distance(bot.location(), destination)
+            if (remaining <= arrivalRadius || bot.isDead || bot.isUnderAttack()) return
+
+            if (remaining < bestDistance - MIN_PROGRESS) {
+                bestDistance = remaining
+                checksWithoutProgress = 0
+            } else if (++checksWithoutProgress >= MAX_CHECKS_WITHOUT_PROGRESS) {
+                onStuck()
+                return
+            }
+
+            if (!bot.isMoving) {
+                val leg = nextLeg(remaining)
+                bot.moveTo(leg.x, leg.y, leg.z)
+            }
+            delay(CHECK_INTERVAL_MS)
+        }
+    }
+
+    private fun nextLeg(remaining: Double): Location {
+        if (remaining <= LEG_LENGTH) return destination
+        val ratio = LEG_LENGTH / remaining
+        return Location(
+                bot.x + ((destination.x - bot.x) * ratio).toInt(),
+                bot.y + ((destination.y - bot.y) * ratio).toInt(),
+                bot.z + ((destination.z - bot.z) * ratio).toInt())
+    }
+
+    companion object {
+        private const val LEG_LENGTH = 2000.0
+        private const val MIN_PROGRESS = 100
+        private const val CHECK_INTERVAL_MS = 2000L
+        private const val MAX_CHECKS_WITHOUT_PROGRESS = 15
+    }
+}
