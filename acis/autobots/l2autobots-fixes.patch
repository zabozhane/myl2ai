+package dev.l2j.autobots.population
+
+import java.time.LocalDate
+import java.util.Random
+
+/**
+ * The long-term life of one bot as a player, derived from its object id: it plays for a while, takes a break,
+ * comes back, and after some play period quits for good. Many players only try the game for a few days.
+ */
+internal class Career(private val botId: Int, private val firstDay: LocalDate) {
+
+    fun isActiveOn(day: LocalDate): Boolean {
+        val rnd = Random(botId.toLong() * CAREER_SEED_MULTIPLIER)
+        var phaseStart = firstDay
+        while (true) {
+            // Squaring skews play periods towards short ones: lots of tourists, few veterans.
+            val playDays = MIN_PLAY_DAYS + (rnd.nextDouble() * rnd.nextDouble() * (MAX_PLAY_DAYS - MIN_PLAY_DAYS)).toLong()
+            phaseStart = phaseStart.plusDays(playDays)
+            if (day < phaseStart) return true
+            if (rnd.nextDouble() < QUIT_CHANCE) return false
+
+            phaseStart = phaseStart.plusDays(MIN_BREAK_DAYS + rnd.nextInt(MAX_BREAK_DAYS - MIN_BREAK_DAYS + 1).toLong())
+            if (day < phaseStart) return false
+        }
+    }
+
+    companion object {
+        private const val MIN_PLAY_DAYS = 2
+        private const val MAX_PLAY_DAYS = 60
+        private const val MIN_BREAK_DAYS = 2
+        private const val MAX_BREAK_DAYS = 30
+        private const val QUIT_CHANCE = 0.3
+        private const val CAREER_SEED_MULTIPLIER = 7919L
+    }
+}
