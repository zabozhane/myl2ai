+package dev.l2j.autobots.behaviors.classes
+
+import dev.l2j.autobots.behaviors.CombatBehavior
+import dev.l2j.autobots.behaviors.attributes.MiscItem
+import dev.l2j.autobots.behaviors.attributes.PetOwner
+import dev.l2j.autobots.behaviors.preferences.CombatPreferences
+import dev.l2j.autobots.behaviors.preferences.SkillPreferences
+import dev.l2j.autobots.extensions.useMagicSkill
+import dev.l2j.autobots.skills.BotSkill
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getHealthPercentage
+import dev.l2j.autobots.utils.getManaPercentage
+import dev.l2j.autobots.utils.hasEffect
+import net.sf.l2j.gameserver.enums.items.ShotType
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Warlock, Elemental Summoner, Phantom Summoner and their third professions. The servitor does the fighting: the
+ * bot summons it with its own crystals (the skill consumes them, and more over time while it stays out), keeps it
+ * healed and buffed with servitor skills, sends it at the target and adds a nuke when it has mana to spare.
+ */
+internal class SummonerBehavior(player: Player, combatPreferences: CombatPreferences,
+                                private val summons: List<Int>, private val nukes: List<BotSkill>) : CombatBehavior(player, combatPreferences), PetOwner {
+
+    override var skillPreferences: SkillPreferences = SkillPreferences(true)
+
+    override fun getShotType(): ShotType = ShotType.BLESSED_SPIRITSHOT
+
+    override val conditionalSkills: List<Int> = emptyList()
+
+    /** The strongest attacking servitor the bot knows; summoned out of combat, like a player would. */
+    override val summonInfo: Pair<BotSkill, MiscItem?>
+        get() = Pair(BotSkill(summons.firstOrNull { player.getSkill(it) != null } ?: summons.first()) { bot, _, _ -> !bot.isInCombat }, null)
+
+    // Servitor buffs are cast for real below, not applied from a list.
+    override val petBuffs: Array<IntArray> = emptyArray()
+
+    override val getOffensiveSkills: List<BotSkill>
+        get() = if (player.getManaPercentage() > OWN_NUKE_MP || !player.hasServitor()) nukes else emptyList()
+
+    override val getSelfSupportSkills: List<BotSkill> = listOf(
+            BotSkill(TRANSFER_PAIN) { bot, _, _ -> bot.hasServitor() && !bot.hasEffect(TRANSFER_PAIN) })
+
+    override suspend fun idleSupport(): Boolean = supportServitor()
+
+    override suspend fun attack() {
+        if (supportServitor()) return
+        super.attack()
+    }
+
+    private fun supportServitor(): Boolean {
+        if (player.isCastingNow || !player.hasServitor()) return false
+        val servitor = player.summon
+        if (servitor.isDead || distance(player, servitor) > SERVITOR_RANGE) return false
+
+        if (servitor.getHealthPercentage() < SERVITOR_HEAL_BELOW && cast(SERVITOR_HEAL)) return true
+        if (servitor.getManaPercentage() < SERVITOR_RECHARGE_BELOW && cast(SERVITOR_RECHARGE)) return true
+        if (player.isInCombat || player.getManaPercentage() < BUFF_OWN_MP) return false
+        return SERVITOR_BUFFS.any { id -> servitor.getFirstEffect(id).let { it == null || it.period - it.time < REBUFF_SECONDS } && cast(id) }
+    }
+
+    private fun cast(skillId: Int): Boolean {
+        val skill = player.getSkill(skillId) ?: return false
+        if (skill.mpConsume > player.currentMp || !player.checkDoCastConditions(skill) || player.isSkillDisabled(skill)) return false
+        val previous = player.target
+        player.target = player.summon
+        player.useMagicSkill(skill)
+        player.target = previous
+        return true
+    }
+
+    companion object {
+        private const val TRANSFER_PAIN = 1262
+        private const val SERVITOR_HEAL = 1127
+        private const val SERVITOR_RECHARGE = 1126
+        private val SERVITOR_BUFFS = listOf(1146, 1145, 1299, 1140, 1141, 1139, 1144) // Mighty/Bright Servitor, Empowerment, shields, Haste, Wind Walk
+        private const val SERVITOR_RANGE = 900
+        private const val SERVITOR_HEAL_BELOW = 60.0
+        private const val SERVITOR_RECHARGE_BELOW = 30.0
+        private const val BUFF_OWN_MP = 40.0
+        private const val OWN_NUKE_MP = 50.0
+        private const val REBUFF_SECONDS = 60
+
+        // Attacking servitors first; Interlude skill ids.
+        val WARLOCK_SUMMONS = listOf(1111, 1276, 1225)            // Kat the Cat, Kai the Cat, Mew the Cat
+        val ELEMENTAL_SUMMONS = listOf(1226, 1277, 1227)          // Boxer, Merrow, Mirage the Unicorn
+        val PHANTOM_SUMMONS = listOf(1128, 1228, 1278)            // Shadow, Silhouette, Soulless
+        val WARLOCK_NUKES = listOf(BotSkill(1220), BotSkill(1274), BotSkill(1181))   // Blaze, Energy Bolt, Flame Strike
+        val ELEMENTAL_NUKES = listOf(BotSkill(1264), BotSkill(1175), BotSkill(1274)) // Solar Spark, Aqua Swirl, Energy Bolt
+        val PHANTOM_NUKES = listOf(BotSkill(1266), BotSkill(1178), BotSkill(1175))   // Shadow Spark, Twister, Aqua Swirl
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/behaviors/classes/support/SupportBehavior.kt b/src/main/kotlin/dev/l2j/autobots/behaviors/classes/support/SupportBehavior.kt
new file mode 100644
index 0000000..64d5932
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/behaviors/classes/support/SupportBehavior.kt
@@ -0,0 +1,186 @@
+package dev.l2j.autobots.behaviors.classes.support
+
+import dev.l2j.autobots.behaviors.CombatBehavior
+import dev.l2j.autobots.behaviors.preferences.CombatPreferences
+import dev.l2j.autobots.behaviors.preferences.SkillPreferences
+import dev.l2j.autobots.extensions.useMagicSkill
+import dev.l2j.autobots.skills.BotSkill
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getHealthPercentage
+import dev.l2j.autobots.utils.getManaPercentage
+import net.sf.l2j.gameserver.enums.items.ShotType
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+import net.sf.l2j.gameserver.model.L2Skill
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+
+/** Who a buff is worth casting on: mages want casting speed and m.atk, fighters want p.atk, speed and crits. */
+internal enum class BuffFor { All, Mages, Fighters }
+
+internal class Buff(val skillId: Int, val target: BuffFor = BuffFor.All)
+
+/**
+ * Healers and buffers. They heal, raise and buff with their own skills and mana: the party first, themselves when
+ * alone. With nothing to support they fight like any mystic, except a healer in a party keeps its mana for heals.
+ * Everything goes through `useMagic`, the same path as a player's skill use.
+ */
+internal abstract class SupportBehavior(player: Player, combatPreferences: CombatPreferences) : CombatBehavior(player, combatPreferences) {
+
+    override var skillPreferences: SkillPreferences = SkillPreferences(true)
+
+    override fun getShotType(): ShotType = ShotType.BLESSED_SPIRITSHOT
+
+    override val conditionalSkills: List<Int> = emptyList()
+
+    /** Single target heals, strongest first; battle heals are the fast ones for emergencies. */
+    protected open val heals: List<Int> = emptyList()
+    protected open val battleHeals: List<Int> = emptyList()
+    protected open val groupHeals: List<Int> = emptyList()
+    protected open val resurrections: List<Int> = emptyList()
+    protected open val recharges: List<Int> = emptyList()
+    protected open val buffs: List<Buff> = emptyList()
+
+    /** True for classes whose job in a party is healing: they keep their mana for it. */
+    protected open val isHealer: Boolean get() = heals.isNotEmpty()
+
+    // Set when this tick went to supporting someone, so the regular attack does not override the cast.
+    private var supported = false
+
+    override suspend fun targetAppropriateTarget() {
+        supported = false
+        if (player.isCastingNow || player.isAllSkillsDisabled) return
+
+        supported = support()
+        if (!supported) super.targetAppropriateTarget()
+    }
+
+    override suspend fun idleSupport(): Boolean = !player.isCastingNow && !player.isAllSkillsDisabled && support()
+
+    override suspend fun attack() {
+        if (supported) return
+        if (isHealer && player.isInParty && player.getManaPercentage() < PARTY_HEALER_ATTACK_MP) return
+        super.attack()
+    }
+
+    private fun support(): Boolean {
+        val members = membersAround()
+        return resurrect(members) || heal(members) || recharge(members) || buff(members)
+    }
+
+    /** Living and dead party members in reach, the bot itself included; just the bot when it has no party. */
+    protected fun membersAround(): List<Player> {
+        val party = player.party ?: return listOf(player)
+        return party.members.filter { it === player || (distance(player, it) <= SUPPORT_RANGE && GeoEngine.getInstance().canSeeTarget(player, it)) }
+    }
+
+    private fun resurrect(members: List<Player>): Boolean {
+        if (resurrections.isEmpty() || inDanger()) return false
+        val dead = members.firstOrNull { it.isDead && it !== player && !it.isReviveRequested } ?: return false
+        return cast(resurrections, dead)
+    }
+
+    private fun heal(members: List<Player>): Boolean {
+        val alive = members.filter { !it.isDead }
+        val wounded = alive.filter { it.getHealthPercentage() < HEAL_BELOW }
+        if (wounded.isEmpty()) return false
+
+        if (wounded.size >= 2 && cast(groupHeals, player)) return true
+
+        // The tank first when it is about as hurt as the others: losing it loses the party.
+        val target = wounded.minByOrNull { it.getHealthPercentage() - if (it.isTank()) TANK_PRIORITY else 0.0 }!!
+        if (target.getHealthPercentage() < EMERGENCY_BELOW && cast(battleHeals, target)) return true
+        if (cast(heals, target) || cast(battleHeals, target)) return true
+
+        // Without real heals (a mystic before its first profession) only Self Heal is left.
+        return target === player && target.getHealthPercentage() < SELF_HEAL_BELOW && cast(listOf(SELF_HEAL), player)
+    }
+
+    /** Oracles and elders give mana to the party's casters; Recharge cannot target the caster itself. */
+    private fun recharge(members: List<Player>): Boolean {
+        if (recharges.isEmpty() || player.getManaPercentage() < RECHARGE_OWN_MP) return false
+        val target = members.filter { it !== player && !it.isDead && it.getManaPercentage() < RECHARGE_BELOW }
+                .minByOrNull { it.getManaPercentage() } ?: return false
+        return cast(recharges, target)
+    }
+
+    /** Missing or expiring buffs, out of combat and with mana to spare; party-wide chants are checked on the caster. */
+    private fun buff(members: List<Player>): Boolean {
+        if (buffs.isEmpty() || inDanger() || player.getManaPercentage() < BUFF_OWN_MP) return false
+
+        for (buff in buffs) {
+            val skill = player.getSkill(buff.skillId) ?: continue
+            if (skill.targetType == L2Skill.SkillTargetType.TARGET_PARTY) {
+                if (needsBuff(player, skill) && cast(skill, player)) return true
+                continue
+            }
+            val target = members.firstOrNull { !it.isDead && wants(it, buff) && needsBuff(it, skill) } ?: continue
+            if (cast(skill, target)) return true
+        }
+        return false
+    }
+
+    private fun wants(member: Player, buff: Buff) = when (buff.target) {
+        BuffFor.All -> true
+        BuffFor.Mages -> member.isMageClass
+        BuffFor.Fighters -> !member.isMageClass
+    }
+
+    private fun needsBuff(member: Player, skill: L2Skill): Boolean {
+        val effect = member.getFirstEffect(skill.id) ?: return true
+        return effect.skill.level < skill.level || effect.period - effect.time < REBUFF_SECONDS
+    }
+
+    /** A monster is busy with someone of the party: no time for raising and buffing. */
+    protected fun inDanger(): Boolean {
+        val members = membersAround()
+        return player.getKnownTypeInRadius(Monster::class.java, DANGER_RADIUS).any { monster ->
+            !monster.isDead && members.any { monster.target === it }
+        }
+    }
+
+    private fun cast(skillIds: List<Int>, target: Player): Boolean {
+        for (id in skillIds) {
+            val skill = player.getSkill(id) ?: continue
+            if (cast(skill, target)) return true
+        }
+        return false
+    }
+
+    private fun cast(skill: L2Skill, target: Player): Boolean {
+        if (skill.mpConsume > player.currentMp || !player.checkDoCastConditions(skill) || player.isSkillDisabled(skill)) return false
+        val previous = player.target
+        player.target = target
+        if (!skill.checkCondition(player, target, false)) {
+            player.target = previous
+            return false
+        }
+        player.useMagicSkill(skill)
+        return true
+    }
+
+    private fun Player.isTank() = classId.name.let { it.contains("KNIGHT") || it == "PALADIN" || it == "DARK_AVENGER" ||
+            it == "PHOENIX_KNIGHT" || it == "HELL_KNIGHT" || it == "EVAS_TEMPLAR" || it == "SHILLIEN_TEMPLAR" }
+
+    companion object {
+        const val SUPPORT_RANGE = 900
+        private const val DANGER_RADIUS = 1200
+        private const val HEAL_BELOW = 70.0
+        private const val EMERGENCY_BELOW = 35.0
+        private const val SELF_HEAL_BELOW = 50.0
+        private const val TANK_PRIORITY = 15.0
+        private const val RECHARGE_BELOW = 40.0
+        private const val RECHARGE_OWN_MP = 50.0
+        private const val BUFF_OWN_MP = 40.0
+        private const val PARTY_HEALER_ATTACK_MP = 70.0
+        private const val REBUFF_SECONDS = 60
+        private const val SELF_HEAL = 1216
+
+        // Skill ids (Interlude). A class owns only part of each list; the first owned and usable one is cast.
+        val HEALS = listOf(1401, 1217, 1011)          // Major Heal, Greater Heal, Heal
+        val BATTLE_HEALS = listOf(1218, 1015)         // Greater Battle Heal, Battle Heal
+        val GROUP_HEALS = listOf(1402, 1219, 1027)    // Major Group Heal, Greater Group Heal, Group Heal
+        val RESURRECTIONS = listOf(1016)              // Resurrection
+        val RECHARGES = listOf(1013)                  // Recharge
+        val MYSTIC_NUKES = listOf(BotSkill(1184), BotSkill(1177), BotSkill(1147)) // Ice Bolt, Wind Strike, Vampiric Touch
+    }
+}
