+package dev.l2j.autobots.behaviors.sequences
+
+import dev.l2j.autobots.extensions.findClosestGatekeeper
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.CancellationToken
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+
+/** Walks to the nearest gatekeeper and pays for a teleport to [exit]; calls [onFail] when that is not possible. */
+internal class TravelByGatekeeperSequence(override val bot: Player, private val exit: TeleportLocation, private val onFail: () -> Unit) : Sequence {
+
+    override var cancellationToken: CancellationToken? = null
+
+    override suspend fun definition() {
+        val gatekeeper = bot.findClosestGatekeeper() ?: return onFail()
+
+        WalkToSequence(bot, gatekeeper.location(), INTERACTION_RADIUS, onFail).definition()
+        if (distance(bot, gatekeeper) > INTERACTION_RADIUS * 2) return
+
+        bot.target = gatekeeper
+        delay(Rnd.get(2000, 4000).toLong())
+        if (exit.price > 0 && !bot.reduceAdena("Teleport", exit.price, gatekeeper, false)) return onFail()
+
+        bot.teleportTo(exit, 20)
+    }
+
+    companion object {
+        private const val INTERACTION_RADIUS = 150
+    }
+}
