--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/HuntingSpots.kt
@@ -0,0 +1,86 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.sql.SpawnTable
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.math.exp
+
+/** A patch of the map where monsters spawn, with the levels of those monsters. */
+internal class HuntingSpot(val key: Long, val location: Location, private val monsterLevels: List<Int>) {
+    fun monstersFor(level: Int): Int = HuntingSpots.suitableLevels(level).let { range -> monsterLevels.count { it in range } }
+}
+
+/**
+ * Hunting spots derived from the server's monster spawns: the map is cut into square cells and each cell
+ * holding monsters becomes a spot. Bots pick spots with monsters of their level, preferring close and less
+ * crowded ones, like a player who looks for a free place near the village.
+ */
+internal object HuntingSpots {
+    private const val CELL_SIZE = 2500
+    private const val MIN_SUITABLE_MONSTERS = 4
+    private const val DISTANCE_DECAY = 10000.0
+    private const val CANDIDATES = 5
+
+    private val spots: List<HuntingSpot> by lazy { buildSpots() }
+    private val hunters = ConcurrentHashMap<Long, AtomicInteger>()
+
+    fun suitableLevels(level: Int): IntRange = (level - 4).coerceAtLeast(1)..(level + 2)
+
+    fun isSuitable(spot: HuntingSpot, level: Int): Boolean = spot.monstersFor(level) >= MIN_SUITABLE_MONSTERS
+
+    fun choose(bot: Player, excluded: Set<Long>): HuntingSpot? {
+        val candidates = spots.asSequence()
+                .filter { it.key !in excluded && isSuitable(it, bot.level) }
+                .map { it to score(it, bot) }
+                .sortedByDescending { it.second }
+                .take(CANDIDATES)
+                .toList()
+        if (candidates.isEmpty()) return null
+
+        var roll = Rnd.nextDouble() * candidates.sumOf { it.second }
+        for ((spot, score) in candidates) {
+            roll -= score
+            if (roll <= 0) return spot
+        }
+        return candidates.last().first
+    }
+
+    fun join(spot: HuntingSpot) {
+        hunters.computeIfAbsent(spot.key) { AtomicInteger() }.incrementAndGet()
+    }
+
+    fun leave(spot: HuntingSpot) {
+        hunters[spot.key]?.decrementAndGet()
+    }
+
+    private fun score(spot: HuntingSpot, bot: Player): Double {
+        val crowd = hunters[spot.key]?.get() ?: 0
+        return spot.monstersFor(bot.level) * exp(-distance(bot.location(), spot.location) / DISTANCE_DECAY) / (1 + crowd)
+    }
+
+    private class MonsterSpawn(val x: Int, val y: Int, val z: Int, val level: Int)
+
+    private fun buildSpots(): List<HuntingSpot> = SpawnTable.getInstance().spawns
+            .filter { it.template.isType("Monster") }
+            .mapNotNull { spawn ->
+                // Territory spawns have no fixed location; the monster they placed tells where they are.
+                val loc = spawn.loc ?: spawn.npc?.position ?: return@mapNotNull null
+                MonsterSpawn(loc.x, loc.y, loc.z, spawn.template.level.toInt())
+            }
+            .groupBy { cellKey(it.x, it.y) }
+            .map { (key, spawns) ->
+                val centerX = spawns.map { it.x }.average()
+                val centerY = spawns.map { it.y }.average()
+                // A real spawn point is known to be walkable ground, unlike the bare cell center.
+                val anchor = spawns.minByOrNull { (it.x - centerX) * (it.x - centerX) + (it.y - centerY) * (it.y - centerY) }!!
+                HuntingSpot(key, Location(anchor.x, anchor.y, anchor.z), spawns.map { it.level })
+            }
+            .also { println("Autobots population: ${it.size} hunting spots.") }
+
+    private fun cellKey(x: Int, y: Int): Long = (Math.floorDiv(x, CELL_SIZE).toLong() shl 32) or (Math.floorDiv(y, CELL_SIZE).toLong() and 0xffffffffL)
+}
