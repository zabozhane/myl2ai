+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Bots gathering parties on their own, every 30 seconds. A bot looks for a group when it keeps dying (needsGroup),
+ * or because it likes company: team players in most sessions from `groupFinderMinLevel`, regular ones now and then, loners only
+ * when they must. Lookers of one map region and close levels team up behind the most sociable of them.
+ *
+ * Two kinds of parties come out of it. From level [FULL_FROM_LEVEL] some bots (mostly team players) gather a full party:
+ * a tank and a healer at least, a buffer and a spoiler when there are any, damage dealers up to [PartyKind.Full]'s size.
+ * Such a bot waits [WAIT_FOR_FULL_MS] for the roles to turn up and then settles for a casual party: whoever is around,
+ * any professions, which hunts for an hour or so and goes separate ways. A bot-led party with free places shouts for
+ * members and answers players looking for a group, inviting the ones it can use.
+ */
+internal object GroupFinder {
+    const val FULL_FROM_LEVEL = 20
+    private const val MAX_LEVEL_SPREAD = 5
+    private const val MIN_SIZE = 3
+    private const val WAIT_FOR_FULL_MS = 10 * 60_000L
+    private const val CASUAL_MIN_MS = 30 * 60_000L
+    private const val CASUAL_MAX_MS = 90 * 60_000L
+    private const val SHOUT_MIN_MS = 3 * 60_000L
+    private const val SHOUT_MAX_MS = 5 * 60_000L
+    private const val PLAYER_INVITE_EXPIRY_MS = 60_000L
+    private const val DISBAND_AFTER_MS = 10 * 60_000L
+
+    /** Bots looking for a group: object id -> since when. */
+    private val looking = ConcurrentHashMap<Int, Long>()
+    /** Lookers who would rather gather a full party, see [wantsFull]. */
+    private val fullSeekers: MutableSet<Int> = ConcurrentHashMap.newKeySet()
+    /** Leaders' next shout and their pending invite to a player (the place is held for them meanwhile). */
+    private val nextShout = ConcurrentHashMap<Int, Long>()
+    private val pendingPlayer = ConcurrentHashMap<Int, Pair<Int, Long>>()
+    private val smallSince = ConcurrentHashMap<Int, Long>()
+    /** A leader's whispered offer to a looking player: their answer is taken as a request to join for a while. */
+    private val offers = ConcurrentHashMap<Int, Pair<Int, Long>>()
+    private const val OFFER_VALID_MS = 5 * 60_000L
+
+    private val settings get() = AutobotData.settings
+    private val enabled get() = settings.groupsEnabled && settings.groupFinderEnabled
+
+    /** Decided once per session, when the bot logs in. */
+    fun onSessionStart(bot: Autobot) {
+        if (!enabled || bot.level < settings.groupFinderMinLevel) return
+        val percent = when (Sociability.of(bot)) {
+            Sociability.TeamPlayer -> 60
+            Sociability.Regular -> 25
+            Sociability.Loner -> 0
+        }
+        if (Rnd.get(100) < percent) startLooking(bot)
+    }
+
+    /** A bot that keeps dying, or whose spot is too hard, wants a group before it falls back to farming. */
+    fun wantGroup(bot: Autobot) {
+        if (enabled && bot.level >= settings.groupFinderMinLevel && !bot.isInParty && !looking.containsKey(bot.objectId)) startLooking(bot)
+    }
+
+    /** From [FULL_FROM_LEVEL] a bot may set out to gather a full party: most team players, some regular ones. */
+    private fun startLooking(bot: Autobot) {
+        looking[bot.objectId] = System.currentTimeMillis()
+        val fullPercent = when (Sociability.of(bot)) {
+            Sociability.TeamPlayer -> 70
+            Sociability.Regular -> 30
+            Sociability.Loner -> 10
+        }
+        if (bot.level >= FULL_FROM_LEVEL && Rnd.get(100) < fullPercent) fullSeekers += bot.objectId else fullSeekers -= bot.objectId
+    }
+
+    private fun wantsFull(bot: Autobot) = bot.objectId in fullSeekers && bot.level >= FULL_FROM_LEVEL
+
+    /** Still holding out for a full party; a casual one won't do yet. */
+    private fun waitsForFull(bot: Autobot, now: Long) = wantsFull(bot) && now - (looking[bot.objectId] ?: now) < WAIT_FOR_FULL_MS
+
+    fun isLooking(bot: Autobot) = looking.containsKey(bot.objectId)
+
+    fun forget(bot: Player) {
+        looking.remove(bot.objectId)
+        fullSeekers.remove(bot.objectId)
+        nextShout.remove(bot.objectId)
+        pendingPlayer.remove(bot.objectId)
+        smallSince.remove(bot.objectId)
+        offers.remove(bot.objectId)
+    }
+
+    fun offered(leader: Autobot, player: Player) {
+        offers[leader.objectId] = player.objectId to System.currentTimeMillis() + OFFER_VALID_MS
+    }
+
+    fun wasOffered(leader: Autobot, player: Player) =
+            offers[leader.objectId]?.let { it.first == player.objectId && it.second > System.currentTimeMillis() } ?: false
+
+    fun tick(online: Collection<Autobot>) {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        val cap = online.size * settings.groupMaxPopulationPercent / 100
+        var grouped = online.count { it.isInParty }
+
+        val lookers = online.filter { looking.containsKey(it.objectId) && isFree(it) }
+        // Already in a party: nobody to look for any more.
+        online.filter { it.isInParty }.forEach {
+            looking.remove(it.objectId)
+            fullSeekers.remove(it.objectId)
+        }
+
+        for ((_, regionLookers) in lookers.groupBy { MapRegionData.getInstance().getMapRegion(it.x, it.y) }) {
+            val pool = regionLookers.sortedWith(compareByDescending<Autobot> { Sociability.of(it).ordinal }.thenByDescending { it.level }).toMutableList()
+            // Full parties first: they need particular people, a casual party takes whoever is left.
+            for (leader in pool.filter { wantsFull(it) }) {
+                if (leader !in pool || grouped >= cap) continue
+                val members = composeFull(leader, pool.filter { it !== leader }) ?: continue
+                pool.remove(leader)
+                pool.removeAll(members)
+                form(leader, members, PartyKind.Full)
+                grouped += members.size + 1
+            }
+            val casual = pool.filter { !waitsForFull(it, now) }.toMutableList()
+            while (casual.size >= MIN_SIZE && grouped < cap) {
+                val leader = casual.removeAt(0)
+                val members = composeCasual(leader, casual) ?: continue
+                casual.removeAll(members)
+                form(leader, members, PartyKind.Casual)
+                grouped += members.size + 1
+            }
+        }
+
+        online.filter { it.isInParty && it.party.leader === it }.forEach { recruit(it, now) }
+        remember(online)
+    }
+
+    /**
+     * One line every 10 minutes: parties, how many members are with their leader, dead, in combat or sitting,
+     * how many bots are looking, and the levels gained by party members since the last line.
+     */
+    fun summary(online: Collection<Autobot>) {
+        if (!settings.groupLog) return
+        val parties = online.filter { it.isInParty }.map { it.party }.distinct()
+        val members = parties.flatMap { it.members }
+        val near = parties.sumOf { p -> p.members.count { it !== p.leader && distance(p.leader, it) < PartyPlan.RANGE } }
+        val levels = members.associate { it.objectId to it.level }
+        val gained = levels.entries.sumOf { (id, level) -> lastLevels[id]?.let { level - it } ?: 0 }
+        lastLevels.clear()
+        lastLevels.putAll(levels)
+        println("Autobots groups summary: parties=${parties.size} members=${members.size} nearLeader=$near/${members.size - parties.size} " +
+                "dead=${members.count { it.isDead }} fighting=${members.count { it.isInCombat }} sitting=${members.count { it.isSitting }} " +
+                "looking=${looking.size} levelsGained=$gained wipes=$wipes")
+        wipes = 0
+        for (party in parties) {
+            val leader = party.leader
+            println("  ${PartyPlan.state(party).kind.name.lowercase()} party ${leader.name} lv ${leader.level}: " + party.members.filter { it !== leader }.joinToString {
+                "${it.name} ${Role.of(it.classId)} ${distance(leader, it).toInt()}${if (it.isDead) " dead" else ""} ${(it as? Autobot)?.activeSequence?.javaClass?.simpleName ?: it.ai.desire.intention}"
+            } + " | leader ${(leader as? Autobot)?.activeSequence?.javaClass?.simpleName ?: leader.ai.desire.intention}" + if (leader.isDead) " (leader dead)" else "")
+        }
+    }
+
+    private val lastLevels = HashMap<Int, Int>()
+    private var wipes = 0
+
+    private val wiped: MutableSet<Party> = java.util.Collections.newSetFromMap(java.util.WeakHashMap())
+
+    /** Half a minute more spent together by every party with bots in it; a wipe spoils the mood once. */
+    private fun remember(online: Collection<Autobot>) {
+        for (party in online.filter { it.isInParty }.map { it.party }.distinct()) {
+            val leader = party.leader
+            Relations.playedTogether(party.members.filter { it === leader || distance(leader, it) < PartyPlan.RANGE }, 0.5)
+            if (party.members.all { it.isDead }) {
+                if (wiped.add(party)) {
+                    Relations.badTime(party.members, 5)
+                    wipes++
+                }
+            } else wiped.remove(party)
+        }
+    }
+
+    private fun isFree(bot: Autobot) = !bot.isInParty && !bot.isDead && !bot.isInStoreMode && bot.life != null && bot.controller == null
+
+    /** Lookers around the leader's level it doesn't avoid, the ones it likes best first. */
+    private fun fitting(leader: Autobot, pool: List<Autobot>) =
+            pool.filter { kotlin.math.abs(it.level - leader.level) <= MAX_LEVEL_SPREAD && Relations.affinity(leader, it) > Relations.AVOID }
+                    .sortedByDescending { Relations.affinity(leader, it) }
+
+    /**
+     * A full party: a tank and a healer or nothing, then a buffer and a spoiler if any are around (before the second
+     * profession only orc shamans buff), then damage dealers. The leader's own role counts.
+     */
+    private fun composeFull(leader: Autobot, pool: List<Autobot>): List<Autobot>? {
+        val fit = fitting(leader, pool)
+        val chosen = mutableListOf<Autobot>()
+        val leaderRole = Role.of(leader.classId)
+        for (role in listOf(Role.Tank, Role.Healer)) {
+            if (role == leaderRole) continue
+            chosen += fit.firstOrNull { Role.of(it.classId) == role } ?: return null
+        }
+        for (role in listOf(Role.Buffer, Role.Spoiler)) {
+            if (role == leaderRole) continue
+            fit.firstOrNull { Role.of(it.classId) == role && it !in chosen }?.let { chosen += it }
+        }
+        fit.filter { it !in chosen && Role.of(it.classId) == Role.Damage }.take((PartyKind.Full.wantedSize - 1 - chosen.size).coerceAtLeast(0)).forEach { chosen += it }
+        return if (chosen.size + 1 >= PartyKind.Full.minSize) chosen else null
+    }
+
+    /** A casual party: whoever is around, whatever they play. */
+    private fun composeCasual(leader: Autobot, pool: List<Autobot>): List<Autobot>? {
+        val chosen = fitting(leader, pool).take(PartyKind.Casual.wantedSize - 1)
+        return if (chosen.size + 1 >= MIN_SIZE) chosen else null
+    }
+
+    private fun form(leader: Autobot, members: List<Autobot>, kind: PartyKind) {
+        val lootRule = if (members.any { Role.of(it.classId) == Role.Spoiler } || Role.of(leader.classId) == Role.Spoiler) LootRule.ITEM_RANDOM_SPOIL else LootRule.ITEM_RANDOM
+        leader.lootRule = lootRule
+        // Whatever each was on its way to, the party goes together now.
+        (members + leader).forEach { it.cancelSequence() }
+        for (member in members) {
+            val party: Party? = leader.party
+            if (party == null) Party(leader, member, lootRule) else party.addPartyMember(member)
+            looking.remove(member.objectId)
+            fullSeekers.remove(member.objectId)
+        }
+        looking.remove(leader.objectId)
+        fullSeekers.remove(leader.objectId)
+        leader.party?.let { party ->
+            val state = PartyPlan.state(party)
+            state.kind = kind
+            state.breakUpAt = if (kind == PartyKind.Casual) System.currentTimeMillis() + Rnd.get(CASUAL_MIN_MS, CASUAL_MAX_MS) else null
+        }
+        nextShout[leader.objectId] = System.currentTimeMillis() + Rnd.get(SHOUT_MIN_MS, SHOUT_MAX_MS)
+        if (settings.groupLog) println("Autobots groups: ${leader.name} (lv ${leader.level}) formed a ${kind.name.lowercase()} party: " +
+                (listOf(leader) + members).joinToString { "${it.name} ${it.level} ${Role.of(it.classId)}" })
+    }
+
+    /**
+     * A bot-led party short of people shouts for them now and then; a party that stays too small breaks up, and so does
+     * a casual one after its hour or so, once it is out of a fight.
+     */
+    private fun recruit(leader: Autobot, now: Long) {
+        val party = leader.party ?: return
+        val state = PartyPlan.state(party)
+        val breakUpAt = state.breakUpAt
+        if (breakUpAt != null && now > breakUpAt && party.members.none { it.isInCombat }) {
+            leader.partySay(listOf("ok guys, thx for party", "gtg, ty all", "спасибо за пати, разбегаемся", "всем спасибо, я дальше сам").random())
+            party.disband()
+            smallSince.remove(leader.objectId)
+            return
+        }
+        val size = party.membersCount
+        if (size < MIN_SIZE) {
+            val since = smallSince.getOrPut(leader.objectId) { now }
+            if (now - since > DISBAND_AFTER_MS) {
+                leader.partySay(listOf("ok, not enough people, gg", "nobody comes, cya", "ладно, расходимся").random())
+                party.disband()
+                smallSince.remove(leader.objectId)
+                return
+            }
+        } else smallSince.remove(leader.objectId)
+
+        if (size >= state.kind.wantedSize || now < (nextShout[leader.objectId] ?: 0)) return
+        nextShout[leader.objectId] = now + Rnd.get(SHOUT_MIN_MS, SHOUT_MAX_MS)
+        looking[leader.objectId] = looking[leader.objectId] ?: now
+        leader.shout(GroupChat.lookingForMembers(party, needs(party), placeName(leader)))
+    }
+
+    /** What the party lacks most, as a player would put it in a shout. A casual party takes anybody. */
+    fun needs(party: Party): List<Role> {
+        if (PartyPlan.state(party).kind == PartyKind.Casual) return listOf(Role.Damage)
+        val roles = party.members.map { Role.of(it.classId) }
+        val wanted = mutableListOf<Role>()
+        if (Role.Healer !in roles) wanted += Role.Healer
+        if (Role.Tank !in roles) wanted += Role.Tank
+        if (Role.Buffer !in roles) wanted += Role.Buffer
+        wanted += Role.Damage
+        return wanted
+    }
+
+    fun placeName(bot: Player): String = MapRegionData.getInstance().getClosestTownName(bot.x, bot.y)
+
+    /** A party a looking player could join: led by a bot of this region, with room and levels that fit. */
+    fun partiesFor(player: Player, online: Collection<Autobot>): List<Party> = online
+            .filter { it.isInParty && it.party.leader === it && it.party.membersCount < (PartyPlan.state(it.party).kind.wantedSize + 2).coerceAtMost(9) }
+            .filter { MapRegionData.getInstance().getMapRegion(it.x, it.y) == MapRegionData.getInstance().getMapRegion(player.x, player.y) }
+            .map { it.party }
+            .filter { p -> kotlin.math.abs(p.members.sumOf { it.level } / p.membersCount - player.level) <= MAX_LEVEL_SPREAD }
+            .filter { p -> pendingPlayer[p.leader.objectId]?.let { it.second < System.currentTimeMillis() } ?: true }
+            .distinct()
+
+    /**
+     * Whether a player is worth a place, judged like a player inspecting another: a role the party lacks, a level that
+     * fits and gear of the expected grade. A friend of the leader is taken with weaker gear.
+     */
+    fun judge(party: Party, player: Player): GroupChat.Line? {
+        val leader = party.leader
+        val average = party.members.sumOf { it.level } / party.membersCount
+        if (kotlin.math.abs(average - player.level) > MAX_LEVEL_SPREAD) return if (player.level > average) GroupChat.Line.TooHigh else GroupChat.Line.TooLow
+        if (player.karma > 0) return GroupChat.Line.NoPk
+        val role = Role.of(player.classId)
+        val roles = party.members.map { Role.of(it.classId) }
+        if ((role == Role.Tank || role == Role.Healer) && role in roles && party.membersCount >= PartyPlan.state(party).kind.wantedSize) return GroupChat.Line.RoleTaken
+        val expected = Gear.gradeFor(player.level).id
+        val weapon = player.activeWeaponItem?.crystalType?.id ?: -1
+        val friend = leader is Autobot && Relations.affinity(leader, player) >= Relations.FRIEND
+        if (weapon < expected && !friend) return GroupChat.Line.WeakGear
+        return null
+    }
+
+    /** Sends a player the party window, holding the place for them for a minute. Same steps as RequestJoinParty. */
+    fun invitePlayer(leader: Autobot, player: Player) {
+        val party = leader.party
+        if (player.isInParty || player.isProcessingRequest || leader.isProcessingRequest) return
+        if (party != null) {
+            if (party.membersCount >= 9 || (party.pendingInvitation && !party.isInvitationRequestExpired)) return
+            party.setPendingInvitation(true)
+        }
+        pendingPlayer[leader.objectId] = player.objectId to System.currentTimeMillis() + PLAYER_INVITE_EXPIRY_MS
+        leader.onTransactionRequest(player)
+        player.sendPacket(AskJoinParty(leader.name, leader.lootRule.ordinal))
+    }
+
+    /** Answers a player's request to join after a short pause, inviting them or saying why not. */
+    fun considerPlayer(leader: Autobot, player: Player, russian: Boolean) {
+        val party = leader.party ?: return
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(3000L, 8000L))
+            val refusal = judge(party, player)
+            if (refusal != null) {
+                leader.tell(player.name, GroupChat.line(refusal, russian))
+                return@launch
+            }
+            leader.tell(player.name, GroupChat.line(GroupChat.Line.Inviting, russian))
+            delay(Rnd.get(1000L, 3000L))
+            invitePlayer(leader, player)
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/PartyBehavior.kt b/src/main/kotlin/dev/l2j/autobots/population/group/PartyBehavior.kt
