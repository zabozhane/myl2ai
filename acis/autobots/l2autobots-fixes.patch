@@ -0,0 +1,40 @@
+package dev.l2j.autobots.behaviors
+
+import dev.l2j.autobots.population.isUnderAttack
+import dev.l2j.autobots.utils.getHealthPercentage
+import dev.l2j.autobots.utils.getManaPercentage
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Player
+
+/** Sits down to regenerate between fights, the way a player without potions does. */
+internal class Rester(private val player: Player) {
+
+    /** Returns true while resting, so the bot does not start a new fight. */
+    fun onUpdate(): Boolean {
+        if (player.isDead) return false
+
+        if (player.isSitting) {
+            if (player.isUnderAttack() || isRested()) player.standUp()
+            return true
+        }
+
+        if (isTired() && !player.isUnderAttack() && !player.isMoving && !hasLiveTarget()) {
+            player.sitDown()
+            return true
+        }
+        return false
+    }
+
+    private fun isTired() = player.getHealthPercentage() < TIRED_HEALTH_PERCENT || player.getManaPercentage() < TIRED_MANA_PERCENT
+
+    private fun isRested() = player.getHealthPercentage() >= RESTED_HEALTH_PERCENT && player.getManaPercentage() >= RESTED_MANA_PERCENT
+
+    private fun hasLiveTarget() = (player.target as? Creature)?.let { !it.isDead && it !== player } ?: false
+
+    companion object {
+        private const val TIRED_HEALTH_PERCENT = 45.0
+        private const val TIRED_MANA_PERCENT = 20.0
+        private const val RESTED_HEALTH_PERCENT = 95.0
+        private const val RESTED_MANA_PERCENT = 90.0
+    }
+}
