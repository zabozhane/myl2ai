--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/PartyBehavior.kt
@@ -0,0 +1,240 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.TravelByGatekeeperSequence
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.economy.GoToTownSequence
+import dev.l2j.autobots.population.isUnderAttack
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getHealthPercentage
+import dev.l2j.autobots.utils.getManaPercentage
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.group.Party
+import net.sf.l2j.gameserver.model.location.Location
+
+/**
+ * A population bot in a party. Members follow the leader and assist the tank (or the leader without a tank): they
+ * hit what it hits and never pull monsters themselves. Healers, buffers and summoners support between fights.
+ * A bot leading the party hunts as usual (its spot fits the party, see [huntLevel]) and stops for the party to rest.
+ * A player leading the party is followed the same way; nothing a player does is an order, see the group chat.
+ */
+internal class PartyBehavior(private val bot: Autobot) {
+
+    private var lastGreetedParty: Party? = null
+    private var travelFailedAt = 0L
+
+    /** @return true when the party took care of this tick; false leaves it to the solo life (town errands, leading). */
+    suspend fun onUpdate(): Boolean {
+        val party = bot.party ?: return false
+        greet(party)
+
+        if (bot.isDead) {
+            bot.combatBehavior.onUpdate()
+            return true
+        }
+
+        val leader = party.leader ?: return false
+        if (leader === bot) return lead(party)
+
+        if (followFar(leader)) return true
+
+        val target = assistTarget(party, leader)
+        if (target != null) {
+            if (bot.isSitting) bot.standUp()
+            if (bot.target !== target) {
+                bot.target = target
+                bot.combatBehavior.committedTarget = target
+            }
+            bot.combatBehavior.onUpdate()
+            return true
+        }
+
+        if (bot.isUnderAttack()) {
+            bot.combatBehavior.onUpdate()
+            return true
+        }
+
+        if (leader.isSitting && !bot.isMoving) {
+            bot.combatBehavior.idleUpdate()
+            if (!bot.isSitting && !bot.isCastingNow) bot.sitDown()
+            return true
+        }
+
+        if (stayClose(leader)) return true
+        bot.combatBehavior.idleUpdate()
+        return true
+    }
+
+    private fun greet(party: Party) {
+        if (lastGreetedParty === party) return
+        lastGreetedParty = party
+        if (Rnd.get(100) < GREET_PERCENT) bot.partySay(listOf("hi", "hey all", "hello", "o/", "hi guys").random())
+    }
+
+    /** The leader hunts on its own terms; it only holds the party back while the healer drinks mana or someone heals up. */
+    private suspend fun lead(party: Party): Boolean {
+        if (bot.isUnderAttack()) return false
+        if (gather(party)) return true
+        val tired = party.members.filter { it !== bot && distance(bot, it) < PartyPlan.RANGE }.any { member ->
+            (Role.of(member.classId) == Role.Healer && member.getManaPercentage() < REST_HEALER_MP) || member.getHealthPercentage() < REST_MEMBER_HP
+        }
+        val rested = party.members.all { it.getManaPercentage() >= RESTED_PERCENT || Role.of(it.classId) != Role.Healer } &&
+                party.members.all { it.getHealthPercentage() >= RESTED_PERCENT }
+
+        val state = PartyPlan.state(party)
+        val full = party.members.all { it.getManaPercentage() >= FULL_PERCENT && it.getHealthPercentage() >= FULL_PERCENT }
+        if (bot.isSitting) {
+            if (if (state.restUntilFull) full else rested) {
+                state.restUntilFull = false
+                bot.standUp()
+            }
+            return true
+        }
+        if ((tired || state.restUntilFull) && !hasLiveTarget()) {
+            if (Rnd.get(100) < REST_SAY_PERCENT) bot.partySay(listOf("rest", "sit for mp", "lets rest a bit", "med").random())
+            bot.sitDown()
+            return true
+        }
+        return false
+    }
+
+    /**
+     * A party gathers before it hunts: while most living members are out of reach, the leader waits where it is,
+     * for a few minutes at most, then goes on and lets the others catch up.
+     */
+    private fun gather(party: Party): Boolean {
+        val state = PartyPlan.state(party)
+        val others = party.members.filter { it !== bot && !it.isDead }
+        val away = others.count { distance(bot, it) > PartyPlan.RANGE }
+        if (away * 2 <= others.size || bot.isInCombat) {
+            state.gatheringSince = null
+            return false
+        }
+        val now = System.currentTimeMillis()
+        val since = state.gatheringSince ?: now.also {
+            state.gatheringSince = it
+            bot.partySay(listOf("waiting for everyone", "come to me", "ждём всех", "подтягивайтесь").random())
+        }
+        // After a wait the leader goes on for a while and lets the late ones catch up, then waits again.
+        if (now - since > GATHER_MAX_MS + GATHER_MOVE_MS) state.gatheringSince = now
+        else if (now - since > GATHER_MAX_MS) return false
+        if (bot.isMoving) bot.stopMove(null)
+        return true
+    }
+
+    /** What the party is fighting: the tank's target, else the leader's, else a monster busy with any member. */
+    private fun assistTarget(party: Party, leader: Player): Creature? {
+        val near = party.members.filter { it !== bot && !it.isDead && distance(bot, it) < PartyPlan.RANGE }
+        val agreed = PartyPlan.state(party).assist?.takeIf { it in near }
+        val tank = near.firstOrNull { Role.of(it.classId) == Role.Tank }
+        listOfNotNull(agreed, tank, leader).forEach { ally ->
+            val target = ally.target as? Monster
+            if (target != null && !target.isDead && (ally.isInCombat || target.target === ally)) return target
+        }
+        return bot.getKnownTypeInRadius(Monster::class.java, PartyPlan.RANGE).firstOrNull { monster ->
+            !monster.isDead && near.any { monster.target === it }
+        }
+    }
+
+    /** Far away (another region, a teleport ago): town by scroll, then the gatekeeper closest to the leader, then on foot. */
+    private suspend fun followFar(leader: Player): Boolean {
+        val gap = distance(bot, leader)
+        if (gap <= FAR) return false
+        if (System.currentTimeMillis() - travelFailedAt < TRAVEL_RETRY_MS) return false
+        if (bot.isSitting) bot.standUp()
+
+        val inTown = bot.isInsideZone(ZoneId.TOWN)
+        var failed = false
+        when {
+            inTown && !leader.isInsideZone(ZoneId.TOWN) -> {
+                val exit = TeleportLocationData.getInstance().allTeleportLocations.filter { !it.isNoble }.minByOrNull { distance(it, leader.location()) }
+                if (exit != null && distance(bot.location(), leader.location()) - distance(exit, leader.location()) > MIN_WALK_SAVED_BY_TELEPORT) {
+                    TravelByGatekeeperSequence(bot, exit) { failed = true }.execute()
+                } else {
+                    WalkToSequence(bot, leader.location(), FOLLOW_DISTANCE) { failed = true }.execute()
+                }
+            }
+            gap > SCROLL_DISTANCE && !inTown -> GoToTownSequence(bot) { failed = true }.execute()
+            else -> WalkToSequence(bot, leader.location(), FOLLOW_DISTANCE) { failed = true }.execute()
+        }
+        if (failed) travelFailedAt = System.currentTimeMillis()
+        return !failed
+    }
+
+    /** Keeps within a few steps of the leader; casters stay a bit further back. */
+    private fun stayClose(leader: Player): Boolean {
+        val keep = if (bot.isMageClass) FOLLOW_DISTANCE_CASTER else FOLLOW_DISTANCE
+        if (distance(bot, leader) <= keep) return false
+        if (bot.isSitting) bot.standUp()
+        val angle = Math.toRadians(Rnd.get(360).toDouble())
+        val offset = Rnd.get(80, keep / 2)
+        val spot = Location(leader.x + (offset * Math.cos(angle)).toInt(), leader.y + (offset * Math.sin(angle)).toInt(), leader.z)
+        bot.ai.setIntention(IntentionType.MOVE_TO, spot)
+        return true
+    }
+
+    private fun hasLiveTarget() = (bot.target as? Creature)?.let { !it.isDead && it !== bot } ?: false
+
+    companion object {
+        private const val FOLLOW_DISTANCE = 300
+        private const val FOLLOW_DISTANCE_CASTER = 500
+        private const val FAR = 2500
+        private const val SCROLL_DISTANCE = 15000
+        private const val MIN_WALK_SAVED_BY_TELEPORT = 8000
+        private const val TRAVEL_RETRY_MS = 60_000L
+        private const val REST_HEALER_MP = 30.0
+        private const val REST_MEMBER_HP = 50.0
+        private const val RESTED_PERCENT = 80.0
+        private const val FULL_PERCENT = 95.0
+        private const val GREET_PERCENT = 70
+        private const val GATHER_MAX_MS = 2 * 60_000L
+        private const val GATHER_MOVE_MS = 60_000L
+        private const val REST_SAY_PERCENT = 30
+    }
+}
+
+/**
+ * Two kinds of parties: a full one gathered on purpose (tank, healer, buffer, damage dealers) that stays together, and a
+ * casual one of whoever was around, smaller and for an hour or so.
+ */
+internal enum class PartyKind(val minSize: Int, val wantedSize: Int) {
+    Full(5, 7),
+    Casual(3, 5),
+}
+
+/** What a party decides together. For now: the level of monsters it can take. */
+internal object PartyPlan {
+    /** Members further than this don't share experience (`PartyRange` in players.properties). */
+    const val RANGE = 1500
+
+    private val states = java.util.Collections.synchronizedMap(java.util.WeakHashMap<Party, PartyState>())
+
+    fun state(party: Party): PartyState = states.getOrPut(party) { PartyState() }
+
+    /**
+     * The level a bot-led party hunts at: the average level, a bit higher when the party is big enough and has a
+     * healer, a bit lower without one; a full party with its tank and healer goes for the hardest. A party should beat
+     * what its members can solo.
+     */
+    fun huntLevel(party: Party): Int {
+        val members = party.members
+        val average = members.sumOf { it.level } / members.size
+        val roles = members.map { Role.of(it.classId) }
+        val hasHealer = Role.Healer in roles
+        val bonus = when {
+            state(party).kind == PartyKind.Full && hasHealer && Role.Tank in roles && members.size >= PartyKind.Full.minSize -> 4
+            hasHealer && members.size >= 4 -> 3
+            hasHealer && members.size >= 2 -> 2
+            members.size >= 3 -> 1
+            else -> 0
+        }
+        return (average + bonus).coerceAtLeast(1)
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/PartyInvites.kt b/src/main/kotlin/dev/l2j/autobots/population/group/PartyInvites.kt
