@@ -0,0 +1,51 @@
+package dev.l2j.autobots.population
+
+import java.time.LocalDate
+import java.time.ZonedDateTime
+import java.util.Random
+import kotlin.math.sqrt
+
+/**
+ * A human-like day of one bot, derived from its object id so it survives restarts without storage.
+ *
+ * Each bot has a stable chronotype: the minute of the day it wakes up. The awake hours after it hold
+ * a few play sessions, more often late than early; the last [sleepHours] of the bot's day are sleep.
+ * Session count and placement change from day to day.
+ */
+internal class DailySchedule(
+        private val botId: Int,
+        private val sleepHours: Int,
+        private val sessions: IntRange,
+        private val sessionMinutes: IntRange
+) {
+    private val wakeMinute: Int = run {
+        val rnd = Random(botId.toLong())
+        (TYPICAL_WAKE_MINUTE + rnd.nextGaussian() * WAKE_DEVIATION_MINUTES).toInt().coerceIn(EARLIEST_WAKE_MINUTE, LATEST_WAKE_MINUTE)
+    }
+
+    fun isPlaying(now: ZonedDateTime): Boolean {
+        val sinceWake = now.minusMinutes(wakeMinute.toLong())
+        val minuteOfBotDay = sinceWake.hour * 60 + sinceWake.minute
+        return sessionsOf(sinceWake.toLocalDate()).any { minuteOfBotDay in it }
+    }
+
+    private fun sessionsOf(day: LocalDate): List<IntRange> {
+        val rnd = Random(botId.toLong() * DAY_SEED_MULTIPLIER + day.toEpochDay())
+        val awakeMinutes = (24 - sleepHours) * 60
+        val count = sessions.first + rnd.nextInt(sessions.last - sessions.first + 1)
+        return (0 until count).map {
+            val length = sessionMinutes.first + rnd.nextInt(sessionMinutes.last - sessionMinutes.first + 1)
+            // The square root makes later hours more likely: people mostly play in the evening, before sleep.
+            val start = ((awakeMinutes - length) * sqrt(rnd.nextDouble())).toInt()
+            start until start + length
+        }
+    }
+
+    companion object {
+        private const val TYPICAL_WAKE_MINUTE = 8 * 60
+        private const val WAKE_DEVIATION_MINUTES = 150.0
+        private const val EARLIEST_WAKE_MINUTE = 5 * 60
+        private const val LATEST_WAKE_MINUTE = 14 * 60
+        private const val DAY_SEED_MULTIPLIER = 1_000_003L
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/HuntingSpots.kt b/src/main/kotlin/dev/l2j/autobots/population/HuntingSpots.kt
