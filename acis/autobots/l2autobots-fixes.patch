+  <defaultTargetingRange>1000</defaultTargetingRange>
   <defaultAttackPlayerType>None</defaultAttackPlayerType>
-  <defaultTargetingPreference>Random</defaultTargetingPreference>
+  <defaultTargetingPreference>Closest</defaultTargetingPreference>
   <useManaPots>true</useManaPots>
   <useQuickHealingPots>true</useQuickHealingPots>
   <useGreaterHealingPots>true</useGreaterHealingPots>
   <useGreaterCpPots>true</useGreaterCpPots>
+  <!-- Living population: bots that play on human-like schedules, take breaks, quit and get replaced by newbies.
+       populationSize is how many of them are active (not on a break, not quit); about half of them are online at the evening peak.
+       0 disables it. -->
+  <populationSize>1110</populationSize>
+  <populationNewbiesPerDay>40</populationNewbiesPerDay>
+  <populationLoginsPerTick>10</populationLoginsPerTick>
+  <populationTimeZone>Europe/Moscow</populationTimeZone>
+  <populationSleepHours>8</populationSleepHours>
+  <populationMinSessions>2</populationMinSessions>
+  <populationMaxSessions>4</populationMaxSessions>
+  <populationMinSessionMinutes>60</populationMinSessionMinutes>
+  <populationMaxSessionMinutes>180</populationMaxSessionMinutes>
+  <!-- Load testing: every active member stays online, ignoring sleep and sessions. Keep false for a living world. -->
+  <populationAlwaysOnline>false</populationAlwaysOnline>
+  <!-- Living economy for population bots: they sell loot, buy supplies and gear in town shops, enchant, and trade
+       in private stores. economyLog writes every deal to the game server log, economyChat lets bots comment in chat. -->
+  <economyEnabled>true</economyEnabled>
+  <economyLog>true</economyLog>
+  <economyChat>true</economyChat>
+  <!-- Profession mix: the relative chance (100 = same as any other branch) that a bot picks a healer, buffer, tank
+       or summoner profession when it has a choice at 20 and 40. The every-10-minutes summary shows the result. -->
+  <professionWeightHealer>100</professionWeightHealer>
+  <professionWeightBuffer>100</professionWeightBuffer>
+  <professionWeightTank>100</professionWeightTank>
+  <professionWeightSummoner>100</professionWeightSummoner>
+  <!-- Parties: population bots in a party follow the leader, assist the tank, heal, buff and rest together. -->
+  <groupsEnabled>true</groupsEnabled>
+  <!-- Bots gather parties on their own (a healer from level 25, then tank, buffer, spoiler and damage dealers),
+       shout for missing members and answer players who look for a group in chat. At most this percent of the
+       online population plays in parties; the rest hunt alone. groupLog prints every formed party. -->
+  <groupFinderEnabled>true</groupFinderEnabled>
+  <!-- Lowest level at which bots look for a party on their own (players group up from about 10-15 in Interlude). -->
+  <groupFinderMinLevel>10</groupFinderMinLevel>
+  <groupMaxPopulationPercent>40</groupMaxPopulationPercent>
+  <groupLog>true</groupLog>
+  <!-- Test only: a newly created population bot starts at this level (0 = level 1, like a real newbie). -->
+  <populationTestLevel>0</populationTestLevel>
 </settings>
