--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/LifeBehavior.kt
@@ -0,0 +1,139 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.TravelByGatekeeperSequence
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+
+/** A monster that targets us, or a flagged or PK player who does: both are worth fighting back. */
+internal fun Player.isUnderAttack(): Boolean =
+        getKnownTypeInRadius(Monster::class.java, ATTACKER_RADIUS).any { !it.isDead && it.target === this } ||
+        getKnownTypeInRadius(Player::class.java, ATTACKER_RADIUS).any { !it.isDead && it.target === this && (it.pvpFlag > 0 || it.karma > 0) }
+
+private const val ATTACKER_RADIUS = 1000
+
+/**
+ * What a population bot does during one play session: either hunts at a spot that fits its level,
+ * or stays AFK where it logged in. Self-defense and death handling are always on.
+ */
+internal class LifeBehavior(private val bot: Autobot) {
+
+    private enum class Activity { Hunt, Afk }
+
+    private val activity = if (Rnd.get(100) < AFK_SESSION_PERCENT) Activity.Afk else Activity.Hunt
+    private var spot: HuntingSpot? = null
+    private var spotLevel = 0
+    private val badSpots = mutableSetOf<Long>()
+    private var idleTicks = 0
+    private var gatekeeperFailed = false
+
+    suspend fun onUpdate() {
+        if (bot.isDead || bot.isUnderAttack()) {
+            bot.combatBehavior.onUpdate()
+            return
+        }
+
+        when (activity) {
+            Activity.Afk -> if (!bot.isSitting && !bot.isMoving) bot.sitDown()
+            Activity.Hunt -> hunt()
+        }
+    }
+
+    fun onLogout() {
+        spot?.let { HuntingSpots.leave(it) }
+        spot = null
+    }
+
+    private suspend fun hunt() {
+        val inTown = bot.isInsideZone(ZoneId.TOWN)
+        if (inTown) bot.socialBehavior.onUpdate()
+
+        val target = currentSpot()
+        if (target == null) {
+            if (!inTown) bot.combatBehavior.onUpdate()
+            return
+        }
+
+        val isAway = distance(bot.location(), target.location) > SPOT_RADIUS
+        if (inTown || (isAway && bot.target == null && !bot.isSitting)) {
+            travelTo(target, inTown)
+            return
+        }
+
+        // A crowded spot is left between fights, like a player who would rather walk on than wait for respawns.
+        if (bot.target == null && bot.getKnownTypeInRadius(Player::class.java, SPOT_RADIUS).size > MAX_PLAYERS_AT_SPOT) {
+            abandon(target)
+            return
+        }
+
+        bot.combatBehavior.onUpdate()
+        if (bot.target == null && !bot.isMoving && !bot.isSitting) idleTicks++ else idleTicks = 0
+        if (idleTicks >= MAX_IDLE_TICKS) abandon(target)
+    }
+
+    private fun currentSpot(): HuntingSpot? {
+        val current = spot
+        if (current != null && (bot.level == spotLevel || HuntingSpots.isSuitable(current, bot.level))) {
+            spotLevel = bot.level
+            return current
+        }
+
+        current?.let { HuntingSpots.leave(it) }
+        val next = HuntingSpots.choose(bot, badSpots)
+        next?.let { HuntingSpots.join(it) }
+        spot = next
+        spotLevel = bot.level
+        idleTicks = 0
+        gatekeeperFailed = false
+        return next
+    }
+
+    private suspend fun travelTo(target: HuntingSpot, inTown: Boolean) {
+        if (bot.isSitting) {
+            bot.standUp()
+            return
+        }
+
+        val exit = if (inTown && !gatekeeperFailed) gatekeeperExitFor(target) else null
+        val sequence = if (exit != null) {
+            TravelByGatekeeperSequence(bot, exit) { gatekeeperFailed = true }
+        } else {
+            WalkToSequence(bot, target.location, SPOT_RADIUS) { abandon(target) }
+        }
+        sequence.execute()
+    }
+
+    /** The teleport destination worth paying for: one that saves a long walk to [target]. */
+    private fun gatekeeperExitFor(target: HuntingSpot): TeleportLocation? {
+        val exit = TeleportLocationData.getInstance().allTeleportLocations
+                .filter { !it.isNoble }
+                .minByOrNull { distance(it, target.location) } ?: return null
+        val walkSaved = distance(bot.location(), target.location) - distance(exit, target.location)
+        return if (walkSaved > MIN_WALK_SAVED_BY_TELEPORT) exit else null
+    }
+
+    /** Forgets a spot that is empty or unreachable, so the next update picks another one. */
+    private fun abandon(target: HuntingSpot) {
+        badSpots.add(target.key)
+        if (spot === target) {
+            HuntingSpots.leave(target)
+            spot = null
+        }
+    }
+
+    companion object {
+        private const val AFK_SESSION_PERCENT = 10
+        private const val SPOT_RADIUS = 1500
+        private const val MAX_PLAYERS_AT_SPOT = 6
+        private const val MIN_WALK_SAVED_BY_TELEPORT = 12000
+        // About 20 seconds at the default think interval.
+        private const val MAX_IDLE_TICKS = 60
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/PopulationManager.kt b/src/main/kotlin/dev/l2j/autobots/population/PopulationManager.kt
new file mode 100644
index 0000000..c47f926
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/PopulationManager.kt
@@ -0,0 +1,135 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.AutobotsManager
+import dev.l2j.autobots.AutobotsNameService
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.behaviors.preferences.ActivityType
+import dev.l2j.autobots.behaviors.preferences.AttackPlayerType
+import dev.l2j.autobots.behaviors.preferences.SocialPreferences
+import dev.l2j.autobots.dao.AutobotsDao
+import dev.l2j.autobots.models.RespawnAction
+import dev.l2j.autobots.utils.Klock
+import dev.l2j.autobots.utils.getRandomAppearance
+import dev.l2j.autobots.utils.getSupportedClassesForLevel
+import kotlinx.coroutines.launch
+import net.sf.l2j.Config
+import net.sf.l2j.gameserver.data.sql.PlayerInfoTable
+import net.sf.l2j.gameserver.data.xml.PlayerData
+import net.sf.l2j.gameserver.idfactory.IdFactory
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.ZonedDateTime
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The living population: bots that start as level 1 newbies in their race's village, play on their own daily
+ * schedules, take breaks, quit, and are replaced by new players, so the world lives without a GM spawning anyone.
+ */
+internal object PopulationManager {
+    private const val TICK_MS = 15_000L
+    private const val SAVE_EVERY_TICKS = 20
+
+    private class Member(val name: String, val firstDay: LocalDate, val career: Career, val schedule: DailySchedule)
+
+    private val members = ConcurrentHashMap<Int, Member>()
+    private val settings get() = AutobotData.settings
+    private val zone get() = ZoneId.of(settings.populationTimeZone)
+    private var ticks = 0
+
+    fun start() {
+        if (settings.populationSize <= 0) return
+
+        CoScopes.generalScope.launch {
+            AutobotsDao.loadPopulationMembers().forEach {
+                addMember(it.objectId, it.name, Instant.ofEpochMilli(it.creationTime).atZone(zone).toLocalDate())
+            }
+            // A fresh server opens with a crowd of newbies; later on they only trickle in.
+            if (members.isEmpty()) repeat(settings.populationSize) { createNewbie() }
+            println("Autobots population: ${members.size} members.")
+            Klock.start("population", 0, TICK_MS, CoScopes.generalScope) { tick() }
+        }
+    }
+
+    private suspend fun tick() {
+        try {
+            val now = ZonedDateTime.now(zone)
+            welcomeNewbies(now)
+
+            val today = now.toLocalDate()
+            val (playing, offline) = members.values.partition { it.career.isActiveOn(today) && it.schedule.isPlaying(now) }
+
+            offline.mapNotNull { AutobotsManager.activeBots[it.name] }
+                    .filter { it.controller == null && !it.isInCombat }
+                    .forEach { logout(it) }
+
+            playing.filter { !AutobotsManager.activeBots.containsKey(it.name) }
+                    .shuffled()
+                    .take(settings.populationLoginsPerTick)
+                    .forEach { login(it) }
+
+            if (++ticks % SAVE_EVERY_TICKS == 0) {
+                members.values.mapNotNull { AutobotsManager.activeBots[it.name] }.forEach { AutobotsDao.saveAutobot(it) }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    /** Replaces players who quit or took a break, spreading today's newcomers over the day. */
+    private fun welcomeNewbies(now: ZonedDateTime) {
+        val today = now.toLocalDate()
+        val active = members.values.count { it.career.isActiveOn(today) }
+        val arrivedToday = members.values.count { it.firstDay == today }
+        val allowedByNow = settings.populationNewbiesPerDay * (now.hour * 60 + now.minute + 1) / (24 * 60)
+        repeat(minOf(settings.populationSize - active, allowedByNow - arrivedToday)) { createNewbie() }
+    }
+
+    private fun addMember(objectId: Int, name: String, firstDay: LocalDate) {
+        members[objectId] = Member(name, firstDay, Career(objectId, firstDay), DailySchedule(objectId, settings.populationSleepHours,
+                settings.populationMinSessions..settings.populationMaxSessions,
+                settings.populationMinSessionMinutes..settings.populationMaxSessionMinutes))
+    }
+
+    /** Creates a level 1 character the way the client does: starter class, village spawn, starter kit only. */
+    private fun createNewbie() {
+        val classId = getSupportedClassesForLevel(1).random()
+        val template = PlayerData.getInstance().getTemplate(classId)
+        val bot = Autobot(IdFactory.getInstance().nextId, template, getRandomAppearance(template.race))
+        bot.name = AutobotsNameService.getRandomAvailableName()
+        bot.title = ""
+        bot.setAccessLevel(Config.DEFAULT_ACCESS_LEVEL)
+        bot.setBaseClass(bot.classId)
+        bot.position.set(template.randomSpawn)
+
+        for (holder in template.items) {
+            val item = bot.inventory.addItem("Init", holder.id, holder.value, bot, null) ?: continue
+            if (item.isEquipable && holder.isEquipped) bot.inventory.equipItemAndRecord(item)
+        }
+        bot.heal()
+        bot.combatBehavior.activityPreferences.activityType = ActivityType.Population
+        bot.socialBehavior.socialPreferences = SocialPreferences()
+
+        AutobotsDao.createAutobot(bot)
+        AutobotsDao.saveAutobot(bot)
+        bot.inventory.deleteMe()
+        PlayerInfoTable.getInstance().addPlayer(bot.objectId, "Autobots", bot.name, bot.accessLevel.level)
+        addMember(bot.objectId, bot.name, LocalDate.now(zone))
+    }
+
+    private suspend fun login(member: Member) {
+        val bot = AutobotsDao.loadByName(member.name) ?: return
+        bot.life = LifeBehavior(bot)
+        bot.respawnAction = RespawnAction.None
+        // Like a player: fight back against whoever flags on us, never start PvP on the innocent.
+        bot.combatBehavior.combatPreferences.attackPlayerType = AttackPlayerType.Flagged
+        AutobotsManager.spawnAutobot(bot)
+    }
+
+    private fun logout(bot: Autobot) {
+        bot.cancelSequence()
+        bot.despawn()
+    }
+}
