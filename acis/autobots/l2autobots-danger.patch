@@ -0,0 +1,44 @@
+package dev.l2j.autobots.population
+
+import net.sf.l2j.L2DatabaseFactory
+
+/**
+ * Danger marks of hunting spots (`autobot_spot_danger`): a cell where an aggressive monster of some level killed a
+ * hunter. Loaded when the spots are built and written when a mark appears, so a restart doesn't send hunters back
+ * into a known death trap.
+ */
+internal object SpotDangerDao {
+    private const val SELECT = "SELECT spot_key, danger_level FROM autobot_spot_danger"
+    private const val UPSERT = "INSERT INTO autobot_spot_danger (spot_key, danger_level) VALUES (?,?)" +
+            " ON DUPLICATE KEY UPDATE danger_level = GREATEST(danger_level, VALUES(danger_level))"
+
+    fun load(): Map<Long, Int> {
+        val marks = HashMap<Long, Int>()
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement(SELECT).use { ps ->
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) marks[rs.getLong("spot_key")] = rs.getInt("danger_level")
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots population: couldn't load spot danger marks: $e")
+        }
+        return marks
+    }
+
+    fun save(key: Long, level: Int) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement(UPSERT).use { ps ->
+                    ps.setLong(1, key)
+                    ps.setInt(2, level)
+                    ps.execute()
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots population: couldn't save a spot danger mark: $e")
+        }
+    }
+}
