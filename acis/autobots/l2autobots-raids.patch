diff --git a/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBehavior.kt b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBehavior.kt
new file mode 100644
index 0000000..5a59948
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBehavior.kt
@@ -0,0 +1,297 @@
+package dev.l2j.autobots.population.raid
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.extensions.attack
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.group.Role
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.utils.getHealthPercentage
+import dev.l2j.autobots.utils.getManaPercentage
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.model.L2Skill.SkillTargetType
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.actor.instance.RaidBoss
+import net.sf.l2j.gameserver.model.group.Party
+import net.sf.l2j.gameserver.model.location.Location
+
+/**
+ * A party member at a raid boss, the leader included. At the boss the leader checks it is there and free, waits for
+ * a second party when one was called, lets everybody rest and buff, then the tank pulls. Damage dealers wait a few
+ * seconds for the tank to hold the boss, kill the minions first and step back to the tank when the boss turns on
+ * them; everybody but the tank steps out of an area skill. The party leaves when half of it is dead or the healers
+ * are, and loots a while after a kill.
+ */
+internal object RaidBehavior {
+    /** The leader counts as arrived this close to the boss's spawn. */
+    const val ARRIVE = 1200
+    private const val LOOK_FOR_BOSS_MS = 20_000L
+    private const val WAIT_POLITELY_MS = 5 * 60_000L
+    private const val WAIT_FOR_HELP_MS = 10 * 60_000L
+    private const val PULL_DELAY_MS = 4000L
+    private const val GATHER_MS = 3 * 60_000L
+    private const val LOOT_MS = 40_000L
+    private const val RETREAT_MS = 40_000L
+    private const val RETREAT_DISTANCE = 2500
+    private const val READY_PERCENT = 90.0
+    private const val NEAR_BOSS = 1500
+    private const val PVP_RANGE = 1200
+    private const val PVP_PERCENT = 50
+    private const val ENOUGH_WITHOUT_HELP = 7
+
+    private val AURA = setOf(SkillTargetType.TARGET_AURA, SkillTargetType.TARGET_FRONT_AURA, SkillTargetType.TARGET_BEHIND_AURA)
+    private val AREA = setOf(SkillTargetType.TARGET_AREA, SkillTargetType.TARGET_FRONT_AREA, SkillTargetType.TARGET_BEHIND_AREA)
+
+    /** @return true when the raid took care of this tick. */
+    suspend fun update(bot: Autobot, party: Party): Boolean {
+        val raid = RaidPlanner.raidOf(party) ?: return false
+        val leader = party.leader ?: return false
+        return when (raid.phase) {
+            Raid.Phase.Travel -> {
+                if (leader === bot && distance(bot.location(), raid.boss.location) <= ARRIVE) {
+                    raid.phase = Raid.Phase.Wait
+                    RaidLog.count(RaidLog.Event.Arrived)
+                }
+                false
+            }
+            Raid.Phase.Wait -> if (leader === bot) waitAtBoss(bot, party, raid) else false
+            Raid.Phase.Fight -> fight(bot, party, raid)
+            Raid.Phase.Loot -> loot(bot, party, raid)
+            Raid.Phase.Retreat -> retreat(bot, party, raid)
+        }
+    }
+
+    private suspend fun waitAtBoss(leader: Autobot, party: Party, raid: Raid): Boolean {
+        if (leader.isMoving) leader.stopMove(null)
+        // A helping party joins the fight its caller starts.
+        raid.calledBy?.let { caller ->
+            val callerRaid = RaidPlanner.raidOf(caller)
+            if (callerRaid == null || callerRaid.boss !== raid.boss) return endRaid(party, "the calling party is gone")
+            if (callerRaid.phase == Raid.Phase.Fight) {
+                raid.puller = callerRaid.puller
+                raid.pulledAt = callerRaid.pulledAt
+                raid.phase = Raid.Phase.Fight
+                return true
+            }
+        }
+
+        val boss = RaidBosses.visible(leader, raid.boss)
+        if (boss == null) {
+            if (raid.elapsed() < LOOK_FOR_BOSS_MS) return true
+            RaidBosses.sawEmpty(raid.boss)
+            RaidLog.count(RaidLog.Event.Empty)
+            leader.partySay(listOf("rb not here", "рб нет, уже убили", "пусто, опоздали", "no rb, someone killed it").random())
+            return endRaid(party, "not at its place")
+        }
+
+        // The boss came for us before we were ready: fight now.
+        if ((boss.target as? Player)?.party in RaidPlanner.allies(party)) return pull(leader, party, raid)
+
+        val rivals = rivals(boss, party)
+        if (rivals.isNotEmpty() && !raid.intercept) {
+            if (Manners.of(leader) == Manners.Rude) {
+                raid.intercept = true
+                raid.pvp = Rnd.get(100) < PVP_PERCENT
+                RaidLog.count(RaidLog.Event.Intercepted)
+                leader.partySay(listOf("whatever, we take it", "забираем рб", "бьём, кто успел тот и съел").random())
+                RaidLog.note(leader, "takes ${raid.boss.name} from ${rivals.first().name}${if (raid.pvp) " and fights them for it" else ""}")
+                return pull(leader, party, raid)
+            }
+            if (raid.elapsed() > WAIT_POLITELY_MS) {
+                RaidLog.count(RaidLog.Event.GaveWay)
+                leader.partySay(listOf("its taken, lets go", "рб заняли, уходим", "ладно, не наш").random())
+                return endRaid(party, "left it to ${rivals.first().name}")
+            }
+            return true
+        }
+
+        if (raid.calledForHelp && raid.helper?.leader?.let { distance(it, boss) < NEAR_BOSS } != true) {
+            if (raid.elapsed() < WAIT_FOR_HELP_MS) return rest(leader, party)
+            if (party.membersCount < ENOUGH_WITHOUT_HELP) {
+                leader.partySay(listOf("nobody came, not enough people", "никто не пришёл, нас мало, уходим").random())
+                return endRaid(party, "no help came")
+            }
+        }
+
+        // Everybody (but one straggler) comes to the boss first; after a few minutes the party goes with who is there.
+        val here = party.members.count { !it.isDead && distance(it, boss) < NEAR_BOSS }
+        // Recruits still on the way get a few minutes too.
+        if (here < party.membersCount - 1 && raid.elapsed() < GATHER_MS) return rest(leader, party) || true
+        if (rest(leader, party)) return true
+        return pull(leader, party, raid)
+    }
+
+    /** Sits until everyone near is almost full. @return true while resting. */
+    private fun rest(leader: Autobot, party: Party): Boolean {
+        val ready = party.members.filter { distance(leader, it) < NEAR_BOSS && !it.isDead }
+                .all { it.getHealthPercentage() >= READY_PERCENT && it.getManaPercentage() >= READY_PERCENT }
+        if (ready) {
+            if (leader.isSitting) leader.standUp()
+            return false
+        }
+        if (!leader.isSitting && !leader.isCastingNow) leader.sitDown()
+        return true
+    }
+
+    private fun pull(leader: Autobot, party: Party, raid: Raid): Boolean {
+        raid.puller = party.members.firstOrNull { Role.of(it.classId) == Role.Tank && !it.isDead && distance(leader, it) < NEAR_BOSS } ?: leader
+        raid.pulledAt = System.currentTimeMillis()
+        raid.phase = Raid.Phase.Fight
+        if (leader.isSitting) leader.standUp()
+        leader.partySay(listOf("go", "pull", "пул", "го").random())
+        return true
+    }
+
+    private suspend fun fight(bot: Autobot, party: Party, raid: Raid): Boolean {
+        val boss = RaidBosses.visible(bot, raid.boss)
+        val now = System.currentTimeMillis()
+        if (boss != null) raid.lastSeen = now
+        if (boss == null) {
+            if (party.leader !== bot) return false
+            // The leader may be away (dead and back in town): the fight goes on while a member still sees the boss.
+            if (party.members.any { !it.isDead && RaidBosses.visible(it, raid.boss) != null }) {
+                raid.lastSeen = now
+                return false
+            }
+            // A kill counts only when the boss really died, not when the party lost sight of it.
+            if (RaidBosses.isDead(raid.boss)) {
+                RaidBosses.sawKilled(raid.boss)
+                RaidLog.count(RaidLog.Event.Killed)
+                bot.partySay(listOf("gg", "гг", "изи", "gg wp").random())
+                raid.phase = Raid.Phase.Loot
+                RaidPlanner.allies(party).filter { it !== party }.forEach { RaidPlanner.raidOf(it)?.phase = Raid.Phase.Loot }
+                RaidLog.note(bot, "${raid.boss.name} is dead")
+            } else if (now - raid.lastSeen > LOOK_FOR_BOSS_MS) {
+                RaidLog.count(RaidLog.Event.Lost)
+                bot.partySay(listOf("lost the rb", "рб ушёл, потеряли", "упустили рб").random())
+                return endRaid(party, "lost it")
+            }
+            return true
+        }
+        if (party.leader === bot && shouldRetreat(party)) {
+            raid.phase = Raid.Phase.Retreat
+            RaidLog.count(RaidLog.Event.Retreated)
+            bot.partySay(listOf("run!", "уходим!", "бежим, вайп", "retreat!").random())
+            return true
+        }
+
+        val role = Role.of(bot.classId)
+        val holder = raid.puller?.takeIf { !it.isDead } ?: party.leader
+        if (bot !== holder && role != Role.Tank) {
+            if (stepOutOfArea(bot, boss)) return true
+            // The boss turned on us: stop hitting it and come to whoever holds it.
+            if (boss.target === bot && distance(bot, holder) > 150) {
+                bot.ai.setIntention(IntentionType.MOVE_TO, holder.location())
+                return true
+            }
+        }
+        if (raid.pvp && role == Role.Damage && pvp(bot, boss, party)) return true
+
+        if (bot !== holder && System.currentTimeMillis() - raid.pulledAt < PULL_DELAY_MS) {
+            bot.combatBehavior.idleUpdate()
+            return true
+        }
+        val target: Creature = if (bot === holder) boss else minionOnUs(bot, boss, party) ?: boss
+        if (bot.isSitting) bot.standUp()
+        if (bot.target !== target) {
+            bot.target = target
+            bot.combatBehavior.committedTarget = target
+        }
+        bot.combatBehavior.onUpdate()
+        return true
+    }
+
+    private fun shouldRetreat(party: Party): Boolean {
+        val members = party.members
+        val healers = members.filter { Role.of(it.classId) == Role.Healer }
+        return members.count { it.isDead } * 2 >= members.size || (healers.isNotEmpty() && healers.all { it.isDead })
+    }
+
+    /** Players outside our parties busy with the boss or its minions. */
+    private fun rivals(boss: RaidBoss, party: Party): List<Player> {
+        val ours = RaidPlanner.allies(party)
+        return boss.getKnownTypeInRadius(Player::class.java, NEAR_BOSS).filter { player ->
+            !player.isDead && player.party !in ours && player.target is Creature && RaidBosses.belongsTo(player.target as Creature, boss) &&
+                    (player.isInCombat || boss.target === player)
+        }
+    }
+
+    /** A minion going after someone of ours: damage dealers clear those first. */
+    private fun minionOnUs(bot: Autobot, boss: RaidBoss, party: Party): Monster? =
+            bot.getKnownTypeInRadius(Monster::class.java, NEAR_BOSS).filter { minion ->
+                !minion.isDead && minion.isMinion && minion.master === boss && (minion.target as? Player)?.party === party
+            }.minByOrNull { distance(bot, it) }
+
+    /** Moves out of an area skill the boss is casting. @return true while stepping away. */
+    private fun stepOutOfArea(bot: Autobot, boss: RaidBoss): Boolean {
+        if (!boss.isCastingNow) return false
+        val skill = boss.lastSkillCast ?: return false
+        val radius = skill.skillRadius
+        if (radius <= 0 || !skill.isOffensive) return false
+        val center: Creature = when (skill.targetType) {
+            in AURA -> boss
+            in AREA -> boss.target as? Creature ?: return false
+            else -> return false
+        }
+        val gap = distance(bot, center)
+        if (gap >= radius + 50) return false
+        val away = radius + 200.0
+        val dx = if (gap < 1) 1.0 else (bot.x - center.x) / gap
+        val dy = if (gap < 1) 0.0 else (bot.y - center.y) / gap
+        bot.ai.setIntention(IntentionType.MOVE_TO, Location(center.x + (dx * away).toInt(), center.y + (dy * away).toInt(), bot.z))
+        return true
+    }
+
+    /** A rude party fights the rivals for its boss: hits the closest one still on it. @return true if it attacked. */
+    private fun pvp(bot: Autobot, boss: RaidBoss, party: Party): Boolean {
+        val rival = rivals(boss, party).filter { distance(bot, it) < PVP_RANGE }.minByOrNull { distance(bot, it) } ?: return false
+        if (bot.target !== rival) {
+            bot.target = rival
+            RaidLog.count(RaidLog.Event.Pvp)
+            RaidLog.note(bot, "attacks ${rival.name} over ${boss.name}")
+        }
+        if (bot.isSitting) bot.standUp()
+        bot.attack(true)
+        return true
+    }
+
+    private suspend fun loot(bot: Autobot, party: Party, raid: Raid): Boolean {
+        if (raid.elapsed() > LOOT_MS) {
+            if (party.leader === bot) endRaid(party, "killed")
+            return false
+        }
+        bot.combatBehavior.idleUpdate()
+        return true
+    }
+
+    /** Everybody runs after the leader, who walks away from the boss; no fighting back until the boss is left behind. */
+    private suspend fun retreat(bot: Autobot, party: Party, raid: Raid): Boolean {
+        val leader = party.leader ?: return false
+        if (raid.elapsed() > RETREAT_MS) {
+            if (leader === bot) endRaid(party, "retreated")
+            return false
+        }
+        if (bot.isDead) return false
+        if (bot.isSitting) bot.standUp()
+        bot.target = null
+        bot.combatBehavior.committedTarget = null
+        if (leader === bot) {
+            if (!bot.isMoving) {
+                val gap = distance(bot.location(), raid.boss.location).coerceAtLeast(1.0)
+                val dx = (bot.x - raid.boss.location.x) / gap
+                val dy = (bot.y - raid.boss.location.y) / gap
+                bot.ai.setIntention(IntentionType.MOVE_TO, Location(bot.x + (dx * RETREAT_DISTANCE).toInt(), bot.y + (dy * RETREAT_DISTANCE).toInt(), bot.z))
+            }
+        } else if (!leader.isDead && distance(bot, leader) > 150) {
+            bot.ai.setIntention(IntentionType.MOVE_TO, leader.location())
+        }
+        return true
+    }
+
+    private fun endRaid(party: Party, outcome: String): Boolean {
+        RaidPlanner.end(party, outcome)
+        return true
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBosses.kt b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBosses.kt
new file mode 100644
index 0000000..d0159f5
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidBosses.kt
@@ -0,0 +1,72 @@
+package dev.l2j.autobots.population.raid
+
+import net.sf.l2j.gameserver.data.manager.RaidBossManager
+import net.sf.l2j.gameserver.data.xml.NpcData
+import net.sf.l2j.gameserver.enums.BossStatus
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.actor.instance.RaidBoss
+import net.sf.l2j.gameserver.model.location.Location
+import java.util.concurrent.ConcurrentHashMap
+
+/** A raid boss as the bots know it: where it stands, its level and how much health it has. */
+internal class BossInfo(val npcId: Int, val name: String, val level: Int, val hp: Int, val location: Location) {
+    /** Bosses this tough want two parties, or one full party. */
+    val needsTwoParties get() = hp >= TWO_PARTIES_HP
+
+    companion object {
+        const val TWO_PARTIES_HP = 150_000
+    }
+}
+
+/**
+ * The raid bosses of `raidboss_spawnlist` and what the bots remember about them. Before stage 2d every bot knows
+ * where the bosses stand. Nobody reads the server's respawn timer: a boss is known to be dead only when a bot saw it
+ * die or found its place empty, and a kill is good for the shortest respawn (12 hours by default).
+ */
+internal object RaidBosses {
+    private const val SEARCH_RADIUS = 3000
+    /** The shortest respawn of a standard boss: 36 h minus the random 24 h. */
+    private const val MIN_RESPAWN_MS = 12 * 3600_000L
+    /** An empty place is checked again after this long: the boss may have respawned meanwhile. */
+    private const val RECHECK_EMPTY_MS = 2 * 3600_000L
+
+    val all: List<BossInfo> by lazy {
+        NpcData.getInstance().getTemplates { it.isType("RaidBoss") }.mapNotNull { template ->
+            val bossSpawn = RaidBossManager.getInstance().getBossSpawn(template.npcId) ?: return@mapNotNull null
+            val spawn = bossSpawn.spawn ?: return@mapNotNull null
+            // Raid bosses get more health than the template says (raid stat multipliers): a live boss tells the real one.
+            val hp = bossSpawn.boss?.maxHp ?: template.getBaseHpMax(template.level.toInt()).toInt()
+            BossInfo(template.npcId, template.name, template.level.toInt(), hp, Location(spawn.locX, spawn.locY, spawn.locZ))
+        }
+    }
+
+    /** The core's word that the boss died: checked only by a party that was fighting it and lost sight of it. */
+    fun isDead(boss: BossInfo) = RaidBossManager.getInstance().getStatus(boss.npcId) == BossStatus.DEAD
+
+    private val killedAt = ConcurrentHashMap<Int, Long>()
+    private val emptyAt = ConcurrentHashMap<Int, Long>()
+
+    fun info(npcId: Int) = all.firstOrNull { it.npcId == npcId }
+
+    /** Worth a trip as far as the bots know: not seen dead lately. */
+    fun mayBeAlive(boss: BossInfo, now: Long = System.currentTimeMillis()): Boolean =
+            now - (killedAt[boss.npcId] ?: 0L) > MIN_RESPAWN_MS && now - (emptyAt[boss.npcId] ?: 0L) > RECHECK_EMPTY_MS
+
+    fun sawKilled(boss: BossInfo) {
+        killedAt[boss.npcId] = System.currentTimeMillis()
+    }
+
+    fun sawEmpty(boss: BossInfo) {
+        emptyAt[boss.npcId] = System.currentTimeMillis()
+    }
+
+    /** The boss standing near [bot], if it can see one. */
+    fun visible(bot: Player, boss: BossInfo): RaidBoss? =
+            bot.getKnownTypeInRadius(RaidBoss::class.java, SEARCH_RADIUS).firstOrNull { it.npcId == boss.npcId && !it.isDead }
+
+    /** True for the boss itself or one of its minions. */
+    fun belongsTo(creature: Creature, boss: RaidBoss): Boolean =
+            creature === boss || (creature is Monster && creature.isMinion && creature.master === boss)
+}
