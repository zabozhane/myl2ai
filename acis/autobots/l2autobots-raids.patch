+package dev.l2j.autobots.population.raid
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/** Raid events in the server log: one line per decision or outcome, and a summary every 10 minutes. */
+internal object RaidLog {
+    enum class Event { Planned, Helped, Arrived, Empty, GaveWay, Intercepted, Pvp, Killed, Lost, Retreated, Deaths }
+
+    private val counts = ConcurrentHashMap<Event, AtomicInteger>()
+
+    fun count(event: Event) {
+        counts.getOrPut(event) { AtomicInteger() }.incrementAndGet()
+    }
+
+    fun note(bot: Player, text: String) {
+        if (AutobotData.settings.raidLog) println("Autobots raids: ${bot.name} (lv ${bot.level}) $text")
+    }
+
+    fun summary(online: Collection<Autobot>) {
+        if (!AutobotData.settings.raidLog || !RaidPlanner.enabled) return
+        val active = online.filter { it.isInParty && it.party.leader === it }.mapNotNull { RaidPlanner.raidOf(it.party) }
+        println("Autobots raids summary: " + Event.values().joinToString(" ") { "${it.name.replaceFirstChar(Char::lowercase)}=${counts[it]?.getAndSet(0) ?: 0}" } +
+                " active=${active.size} " + active.joinToString(" ") { "${it.boss.name}:${it.phase}" })
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/raid/RaidPlanner.kt b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidPlanner.kt
new file mode 100644
index 0000000..93dc1e2
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/raid/RaidPlanner.kt
@@ -0,0 +1,238 @@
+package dev.l2j.autobots.population.raid
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.economy.Temper
+import dev.l2j.autobots.population.group.GroupChat
+import dev.l2j.autobots.population.group.PartyPlan
+import dev.l2j.autobots.population.group.Role
+import dev.l2j.autobots.utils.distance
+import dev.l2j.autobots.extensions.location
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import java.util.concurrent.ConcurrentHashMap
+
+/** How a bot treats a boss someone else is already fighting; fixed per bot, like the enchanting temper. */
+internal enum class Manners {
+    /** Waits for its turn. */
+    Polite,
+    /** Takes the boss anyway. */
+    Rude;
+
+    companion object {
+        fun of(bot: Player): Manners = if (Math.floorMod(bot.objectId * 7919 + 3, 100) < RUDE_PERCENT) Rude else Polite
+        private const val RUDE_PERCENT = 25
+    }
+}
+
+/** A party's trip to a raid boss, kept in its [dev.l2j.autobots.population.group.PartyState]. */
+internal class Raid(val boss: BossInfo) {
+    enum class Phase { Travel, Wait, Fight, Loot, Retreat }
+
+    var phase = Phase.Travel
+        set(value) {
+            field = value
+            phaseSince = System.currentTimeMillis()
+        }
+    var phaseSince = System.currentTimeMillis()
+    /** Who pulls and holds the boss: the tank, else the leader. */
+    var puller: Player? = null
+    var pulledAt = 0L
+    /** The boss was busy with others and this party took it anyway; [pvp] when it also fights them for it. */
+    var intercept = false
+    var pvp = false
+    /** The party that called for help, for a party that answered the call; the helper, for the caller. */
+    var calledBy: Party? = null
+    var helper: Party? = null
+    var calledForHelp = false
+    var shouted = false
+    /** When a member last saw the boss during the fight. */
+    var lastSeen = System.currentTimeMillis()
+
+    fun elapsed() = System.currentTimeMillis() - phaseSince
+}
+
+/**
+ * When a bot-led party goes for a raid boss. The leader thinks about it every few minutes while the party is
+ * together and has a healer; the boss must fit everyone's level and the raid curse (nobody over boss + 8). How often
+ * it goes is up to the bots: a chance that grows with the leader's temper, no daily limit. A boss too tough for one
+ * party gets a call for a second one in shout chat; other bot parties of fitting level may answer it.
+ */
+internal object RaidPlanner {
+    private const val THINK_EVERY_MS = 5 * 60_000L
+    private const val RETRY_MS = 30_000L
+    private const val MIN_MEMBERS = 5
+    private const val FULL_PARTY = 9
+    private const val MAX_TRIP = 60_000.0
+    private const val CURSE_GAP = 8
+    private const val BELOW_AVERAGE = 3
+    private const val ABOVE_YOUNGEST = 3
+    private const val CALL_VALID_MS = 10 * 60_000L
+
+    private val settings get() = AutobotData.settings
+    val enabled get() = settings.groupsEnabled && settings.raidsEnabled
+
+    private val nextThink = ConcurrentHashMap<Party, Long>()
+    private val nextFill = ConcurrentHashMap<Party, Long>()
+    private const val FILL_EVERY_MS = 60_000L
+    /** Open calls for a second party: the calling party's raid and until when the call holds. */
+    private val calls = ConcurrentHashMap<Party, Pair<Raid, Long>>()
+
+    fun raidOf(party: Party?): Raid? = party?.let { PartyPlan.state(it).raid }
+
+    fun isRaiding(bot: Player): Boolean = raidOf(bot.party)?.let { it.phase != Raid.Phase.Travel } ?: false
+
+    /** Where the leader should walk instead of a hunting spot, or null. */
+    fun destination(bot: Autobot) = raidOf(bot.party)?.takeIf { raid ->
+        bot.party.leader === bot && (raid.phase == Raid.Phase.Travel ||
+                (raid.phase == Raid.Phase.Fight && distance(bot.location(), raid.boss.location) > RaidBehavior.ARRIVE * 2))
+    }?.boss?.location
+
+    /** The leader's regular thought; does nothing most of the time. */
+    fun consider(leader: Autobot) {
+        val party = leader.party ?: return
+        if (!enabled || party.leader !== leader || raidOf(party) != null) return
+        val now = System.currentTimeMillis()
+        if (now < (nextThink[party] ?: 0L)) return
+        // A party not ready yet (still gathering, someone dead) is looked at again soon.
+        nextThink[party] = now + RETRY_MS
+        if (!ready(party, leader)) return
+        nextThink[party] = now + THINK_EVERY_MS
+
+        answerCall(leader, party)?.let { return }
+
+        val chance = when (Temper.of(leader.objectId)) {
+            Temper.Cautious -> 15
+            Temper.Normal -> 30
+            Temper.Gambler -> 50
+        } * settings.raidChancePercent / 100
+        if (Rnd.get(100) >= chance) return
+        val boss = choose(leader, party) ?: return
+        start(leader, party, boss, russian = Rnd.get(100) < 50)
+    }
+
+    /** A player in the party suggests a raid: the leader agrees if a boss fits, else says why not. */
+    fun proposedByPlayer(party: Party, russian: Boolean): GroupChat.Line {
+        val leader = party.leader as? Autobot ?: return GroupChat.Line.RaidNotLeader
+        if (!enabled) return GroupChat.Line.RaidNoBoss
+        if (raidOf(party) != null) return GroupChat.Line.RaidAlready
+        if (party.membersCount < MIN_MEMBERS) return GroupChat.Line.RaidTooFew
+        if (party.members.none { Role.of(it.classId) == Role.Healer }) return GroupChat.Line.RaidNoHealer
+        val boss = choose(leader, party) ?: return GroupChat.Line.RaidNoBoss
+        start(leader, party, boss, russian)
+        return GroupChat.Line.RaidOk
+    }
+
+    private fun ready(party: Party, leader: Autobot): Boolean =
+            party.membersCount >= MIN_MEMBERS &&
+            party.members.any { Role.of(it.classId) == Role.Healer } &&
+            party.members.none { it.isDead } &&
+            !leader.isInCombat
+
+    /** Bosses this party can take, as far as it knows alive; the closest one, with a bit of chance between the few closest. */
+    fun choose(leader: Autobot, party: Party): BossInfo? {
+        val cautious = Temper.of(leader.objectId) == Temper.Cautious
+        return RaidBosses.all.asSequence()
+                .filter { fits(party, it) && (!cautious || it.level <= party.members.minOf { m -> m.level }) }
+                .filter { RaidBosses.mayBeAlive(it) && calls.values.none { (raid, _) -> raid.boss === it } }
+                .map { it to distance(leader.location(), it.location) }
+                .filter { it.second < MAX_TRIP }
+                .sortedBy { it.second }
+                .take(3).toList().randomOrNull()?.first
+    }
+
+    fun fits(party: Party, boss: BossInfo): Boolean {
+        val levels = party.members.map { it.level }
+        return levels.max() <= boss.level + CURSE_GAP &&
+                boss.level >= levels.average().toInt() - BELOW_AVERAGE &&
+                boss.level <= levels.min() + ABOVE_YOUNGEST
+    }
+
+    private fun start(leader: Autobot, party: Party, boss: BossInfo, russian: Boolean) {
+        val raid = Raid(boss)
+        PartyPlan.state(party).raid = raid
+        leader.cancelSequence()
+        leader.partySay(if (russian) listOf("го на рб ${boss.name}", "идём на ${boss.name}, все за мной", "рб ${boss.name}, ${boss.level} ур, пошли").random()
+                else listOf("lets go rb ${boss.name}", "rb ${boss.name} lvl ${boss.level}, follow me", "going for ${boss.name}").random())
+        if (boss.needsTwoParties && party.membersCount < FULL_PARTY) callForHelp(leader, party, raid)
+        RaidLog.count(RaidLog.Event.Planned)
+        RaidLog.note(leader, "goes for ${boss.name} (lv ${boss.level}, ${boss.hp} hp) with ${party.membersCount}: " +
+                party.members.joinToString { "${it.name} ${it.level} ${Role.of(it.classId)}" })
+    }
+
+    private fun callForHelp(leader: Autobot, party: Party, raid: Raid) {
+        raid.calledForHelp = true
+        calls[party] = raid to System.currentTimeMillis() + CALL_VALID_MS
+        val low = party.members.minOf { it.level }
+        val high = party.members.maxOf { it.level }
+        leader.shout(if (Rnd.get(100) < 50) "собираем на рб ${raid.boss.name} (${raid.boss.level}), нужна ещё пати $low-$high, пм"
+                else "need one more party for rb ${raid.boss.name} lvl ${raid.boss.level}, $low-$high, pm")
+    }
+
+    /**
+     * A party on its way to a boss fills up to a full party: the leader shouts for the raid, and free bots of the
+     * region that fit the boss come along by their sociability (a raid draws more people than a hunt).
+     */
+    fun fill(leader: Autobot, free: List<Autobot>) {
+        val party = leader.party ?: return
+        val raid = raidOf(party) ?: return
+        if (raid.phase != Raid.Phase.Travel && raid.phase != Raid.Phase.Wait) return
+        val now = System.currentTimeMillis()
+        if (party.membersCount >= FULL_PARTY || now < (nextFill[party] ?: 0L)) return
+        nextFill[party] = now + FILL_EVERY_MS
+        if (!raid.shouted) {
+            raid.shouted = true
+            val roles = dev.l2j.autobots.population.group.GroupFinder.needs(party).joinToString(", ") { it.name.lowercase() }
+            leader.shout(if (Rnd.get(100) < 50) "собираем на рб ${raid.boss.name} (${raid.boss.level}), нужны $roles, пм"
+                    else "LF $roles for rb ${raid.boss.name} lvl ${raid.boss.level}, pm")
+        }
+        val region = net.sf.l2j.gameserver.data.xml.MapRegionData.getInstance()
+        val here = region.getMapRegion(leader.x, leader.y)
+        val joining = free.asSequence()
+                .filter { region.getMapRegion(it.x, it.y) == here && it.level <= raid.boss.level + CURSE_GAP && it.level >= raid.boss.level - BELOW_AVERAGE }
+                .filter { Rnd.get(100) < dev.l2j.autobots.population.group.Sociability.of(it).acceptPercent / 2 }
+                .take(FULL_PARTY - party.membersCount).toList()
+        for (bot in joining) {
+            bot.cancelSequence()
+            party.addPartyMember(bot)
+            bot.partySay(listOf("+ on rb", "я с вами на рб", "иду", "+").random())
+        }
+        if (joining.isNotEmpty()) RaidLog.note(leader, "took ${joining.joinToString { it.name }} for ${raid.boss.name}, now ${party.membersCount}")
+    }
+
+    /** Joins another party's call for help when the boss fits this party too. @return the boss, or null. */
+    private fun answerCall(leader: Autobot, party: Party): BossInfo? {
+        val now = System.currentTimeMillis()
+        calls.entries.removeIf { (caller, call) -> call.second < now || raidOf(caller) !== call.first || caller.leader == null }
+        val (caller, call) = calls.entries.firstOrNull { (caller, call) ->
+            caller !== party && call.first.helper == null && fits(party, call.first.boss) &&
+                    distance(leader.location(), call.first.boss.location) < MAX_TRIP
+        } ?: return null
+        val raid = Raid(call.first.boss).also { it.calledBy = caller }
+        call.first.helper = party
+        calls.remove(caller)
+        PartyPlan.state(party).raid = raid
+        leader.cancelSequence()
+        caller.leader?.let { leader.tell(it.name, listOf("we come for ${raid.boss.name}", "идём к вам на ${raid.boss.name}", "+ пати на рб").random()) }
+        leader.partySay(listOf("helping a party on rb ${raid.boss.name}", "идём помогать на рб ${raid.boss.name}").random())
+        RaidLog.count(RaidLog.Event.Helped)
+        RaidLog.note(leader, "answers ${caller.leader?.name}'s call for ${raid.boss.name}")
+        return raid.boss
+    }
+
+    /** The raid is over, whatever the outcome; the party goes back to hunting. */
+    fun end(party: Party, outcome: String) {
+        val raid = raidOf(party) ?: return
+        PartyPlan.state(party).raid = null
+        calls.remove(party)
+        nextThink[party] = System.currentTimeMillis() + THINK_EVERY_MS
+        party.leader?.let { RaidLog.note(it, "${raid.boss.name}: $outcome") }
+    }
+
+    /** Parties on the same boss: this one and its helper or caller. */
+    fun allies(party: Party): List<Party> {
+        val raid = raidOf(party) ?: return listOf(party)
+        return listOfNotNull(party, raid.helper, raid.calledBy).distinct()
+    }
+}
