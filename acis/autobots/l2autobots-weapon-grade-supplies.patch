diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Gear.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Gear.kt
index 4d4e65f..b22b71d 100644
--- a/src/main/kotlin/dev/l2j/autobots/population/economy/Gear.kt
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Gear.kt
@@ -75,6 +75,20 @@ internal object Gear {
 
     fun arrowId(bot: Player): Int = ARROWS.getValue(weaponGrade(bot))
 
+    /** A bow purchase must also fund the ordinary arrow stock of the weapon it will equip. */
+    fun weaponStockReserveAt(bot: Player,target: Item,origin: net.sf.l2j.gameserver.model.location.Location): Int? {
+        if(target !is net.sf.l2j.gameserver.model.item.kind.Weapon || target.itemType!=WeaponType.BOW) return 0
+        val arrows=ARROWS.getValue(target.crystalType)
+        val have=count(bot,arrows)
+        if(have>=500) return 0
+        val needed=(1500-have).coerceAtLeast(0)
+        val offer=Market.findProductAt(arrows,origin) ?: return null
+        val price=Market.priceWithTax(offer.first,offer.second)
+        if(price<=0 || offer.second.hasLimitedStock() && offer.second.count<needed) return null
+        val total=needed.toLong()*price
+        return total.takeIf { it<=Int.MAX_VALUE }?.toInt()
+    }
+
     fun count(bot: Player, itemId: Int): Int = bot.inventory.getItemByItemId(itemId)?.count ?: 0
 
     /** The pieces of the target kit the bot still lacks, in buying order. */
