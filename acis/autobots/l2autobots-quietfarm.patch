     }
 
     /** The player who whispered or spoke to the bot in the last 10 minutes, if any. */
     fun lastTalker(bot: Player): String? =
             talkedWith[bot.objectId]?.takeIf { (talkedAt[bot.objectId] ?: 0L) > System.currentTimeMillis() - TALK_MEMORY_MS }
+                    ?.let { World.getInstance().getPlayer(it) }?.takeIf { it.isLiveAudience() }?.name
 
     fun isNear(bot: Autobot): Boolean {
-        if (bot.party?.members?.any { it !is Autobot } == true) return true
-        if ((talkedAt[bot.objectId] ?: 0L) > System.currentTimeMillis() - TALK_MEMORY_MS) return true
