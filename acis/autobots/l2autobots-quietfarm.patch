+        return bot.getKnownTypeInRadius(Player::class.java, AutobotData.settings.llmNearRange).any { it.isLiveAudience() }
     }
 
     fun tier(bot: Autobot): Llm.Tier = if (isNear(bot)) Llm.Tier.Near else Llm.Tier.Far
