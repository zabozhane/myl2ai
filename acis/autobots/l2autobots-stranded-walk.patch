 /** Leave an empty region through a real nearby gatekeeper and a fare that preserves supplies. */
 internal object HuntRecovery {
+    data class WalkPlan(val spot: HuntingSpot,val anchor: Location,val origin: Location,val walk: NpcTravel.Walk)
+    private val walkingSearches=java.util.concurrent.Semaphore(2)
+
+    private fun checkedWalk(player: Player,spot: HuntingSpot,origin: Location): WalkPlan? {
+        val anchor=HuntingSpots.huntAnchor(player,spot,origin,validateDirect=false) ?: return null
+        val walk=NpcTravel.toPoint(player,origin,anchor,100000) ?: return null
+        if(walk.length/player.moveSpeed.coerceAtLeast(30)*2000+15_000>15*60_000) return null
+        return WalkPlan(spot,anchor,origin,walk)
+    }
+
+    /** A close goal may require a wide detour around a lake or mountain. */
+    fun walkTo(player: Player,spot: HuntingSpot): WalkPlan? {
+        if(!walkingSearches.tryAcquire()) return null
+        return try { checkedWalk(player,spot,player.location()) } finally { walkingSearches.release() }
+    }
+
+    /** A stranded hunter can walk farther once, rather than waiting forever in an empty region. */
+    fun walkPlan(player: Player,excluded: Set<Long>): WalkPlan? {
+        if(!walkingSearches.tryAcquire()) return null
+        try {
+            val origin=player.location()
+            val deadline=System.nanoTime()+8_000_000_000L
+            for(spot in HuntingSpots.nearArrival(player,origin,excluded,100000,surfaceOnly=true)) {
+                if(System.nanoTime()>=deadline) break
+                checkedWalk(player,spot,origin)?.let { return it }
+            }
+            return null
+        } finally { walkingSearches.release() }
+    }
+
