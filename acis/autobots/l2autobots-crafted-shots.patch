@@ -74,6 +74,21 @@ internal object Gear {
     fun canBuyShots(bot: Player): Boolean = !hasBeginnerShots(bot) &&
             (Market.npcPrice(shotId(bot))?.let { Errands.spendable(bot)>=it*20 }?:false)
 
+    /** Shots this many and fewer send the bot to the stores for more; the stock it then buys up to. */
+    const val SHOT_STOCK_LOW = 1000 / 3
+    const val SHOT_STOCK = 1000
+
+    /**
+     * Graded shots no town shop sells: as in Interlude, dwarves craft them and sell them in their stores, so a bot
+     * low on them looks for them in sell stores and bids for them in its own buy store.
+     */
+    fun wantsCraftedShots(bot: Player): Boolean {
+        if (hasBeginnerShots(bot) || weaponGrade(bot) == CrystalType.NONE) return false
+        val id = shotId(bot)
+        return Market.npcPrice(id) == null && count(bot, id) < SHOT_STOCK_LOW &&
+                Errands.spendable(bot) >= Market.fairValue(id).coerceAtLeast(1) * 20
+    }
+
     fun arrowId(bot: Player): Int = ARROWS.getValue(weaponGrade(bot))
 
     /** A bow purchase must also fund the ordinary arrow stock of the weapon it will equip. */
