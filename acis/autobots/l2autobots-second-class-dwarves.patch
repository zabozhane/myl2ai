+    /** Learns the quest's recipe, gets the materials and crafts one piece a tick, sitting for MP in between. */
+    private fun craft(path: PathQuest, craft: Craft) {
+        val book = dev.l2j.autobots.population.economy.craft.CraftBook
+        val recipe = book.byRecipeItem(craft.recipeItemId) ?: return giveUp(path, "no recipe ${craft.recipeItemId}")
+        if (QuestView(bot, null).count(craft.productId) >= craft.count || bot.isCrafting) return
+        if (!bot.hasRecipeList(recipe.id)) {
+            val item = bot.inventory.getItemByItemId(craft.recipeItemId) ?: return giveUp(path, "lost recipe ${craft.recipeItemId}")
+            if (book.skillLevel(bot) < recipe.level) return giveUp(path, "can't craft level ${recipe.level}")
+            if (bot.dwarvenRecipeBook.size >= bot.dwarfRecipeLimit) return giveUp(path, "recipe book full")
+            net.sf.l2j.gameserver.handler.ItemHandler.getInstance().getHandler(item.etcItem)?.useItem(bot, item, false)
+            if (!bot.hasRecipeList(recipe.id)) return giveUp(path, "couldn't learn ${item.itemName}")
+            dev.l2j.autobots.population.economy.craft.RecipeBookDao.save(bot)
+            QuestLog.log(bot, QuestEvent.Step, "${path.questName}: learned ${item.itemName}")
+            return
+        }
+        val short = recipe.materials.filter { !acquire(it.id, it.value) }
+        if (short.isNotEmpty()) return giveUp(path, "short of materials ${short.joinToString { "${it.id}x${it.value}" }}")
+        if (bot.currentMp < recipe.mpCost) {
+            if (!bot.isSitting && !bot.isMoving) bot.sitDown()
+            return
         }
+        if (bot.isSitting) {
+            bot.standUp()
+            return
+        }
+        val maker = net.sf.l2j.gameserver.model.craft.RecipeItemMaker(bot, recipe, bot)
+        if (!maker._isValid) {
+            bot.isCrafting = false
+            return giveUp(path, "can't craft ${craft.productId} now")
+        }
+        maker.run()
+        QuestLog.log(bot, QuestEvent.Step, "${path.questName}: crafted, ${QuestView(bot, null).count(craft.productId)}/${craft.count} of ${craft.productId}")
+    }
+
+    /**
+     * Makes sure the bag holds [count] of a tradable item: what is short is bought from private stores around (up to
+     * half again the market value) or a shop close by. @return true when the bag holds enough.
+     */
+    private fun acquire(itemId: Int, count: Int): Boolean {
+        val market = dev.l2j.autobots.population.economy.Market
+        var short = count - QuestView(bot, null).count(itemId)
+        if (short <= 0) return true
+        val limit = (dev.l2j.autobots.population.economy.MarketBook.value(itemId) * 1.5).toInt().coerceAtLeast(1)
+        for (offer in market.sellOffers(bot, itemId).filter { it.tradeItem.price <= limit }.sortedBy { it.tradeItem.price }) {
+            val n = minOf(short, offer.tradeItem.count, bot.adena / offer.tradeItem.price.coerceAtLeast(1))
+            if (n > 0 && market.buyFromStore(bot, offer, n)) short -= n
+            if (short <= 0) return true
+        }
+        market.shopsNear(bot).firstNotNullOfOrNull { shop -> shop.products[itemId]?.let { shop to it } }?.let { (shop, product) ->
+            val n = minOf(short, bot.adena / market.priceWithTax(shop, product).coerceAtLeast(1))
+            if (n > 0 && market.buyFromNpc(bot, shop, product, n)) short -= n
+        }
+        return short <= 0
     }
 
