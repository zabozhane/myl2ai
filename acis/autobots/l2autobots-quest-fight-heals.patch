+                .firstOrNull { !bot.isSkillDisabled(it) && bot.currentMp >= it.mpConsume } ?: return false
+        if (bot.ai.desire.intention == IntentionType.ATTACK) bot.ai.setIntention(IntentionType.IDLE)
+        bot.useMagicSkill(skill)
+        return true
     }
 
