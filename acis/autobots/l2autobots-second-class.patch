+                cond(3, talk(30623, "30623-16.htm"))
+                collect(4, 3,
+                        2779 to intArrayOf(20214), 2780 to intArrayOf(20217), 2781 to intArrayOf(20554),
+                        2782 to intArrayOf(20588), 2783 to intArrayOf(20604))
+                cond(5, talk(30623))
+            },
+            mark("Q223_TestOfTheChampion", MARK_OF_CHAMPION, 39) {
+                start(30624, "30624-06.htm")
+                cond(1, talk(30625, "30625-03.htm"))
+                cond(2, hunt(20780))
+                cond(3, talk(30625))
+                cond(4, talk(30624, "30624-10.htm"))
+                cond(5, talk(30093, "30093-02.htm"))
+                collect(6, 30, 3287 to intArrayOf(20145, 27088), 3288 to intArrayOf(20158), 3289 to intArrayOf(20553))
+                cond(7, talk(30093))
+                cond(8, talk(30624, "30624-14.htm"))
+                cond(9, talk(30196, "30196-03.htm"))
+                cond(10, hunt(20551, 27089))
+                cond(11, talk(30196, "30196-06.htm"))
+                cond(12, hunt(20577, 20578, 20579, 20580, 20581, 20582))
+                cond(13, talk(30196))
+                cond(14, talk(30624))
+            },
+    ).associateBy { it.mark }
