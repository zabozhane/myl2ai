+package dev.l2j.autobots.population.quests
+
+import net.sf.l2j.gameserver.enums.actors.ClassId
+import net.sf.l2j.gameserver.enums.actors.ClassId.*
+
+/**
+ * A second profession as the SecondClassChange script of aCis 382 grants it: a guild master of [masters] changes
+ * [from] into [to] on [masterEvent] when the player is 40 or above and carries the three [marks].
+ */
+internal class SecondClass(val from: ClassId, val to: ClassId, val masterEvent: String, val marks: List<Int>, val masters: List<Int>)
+
+/**
+ * The mark quests of aCis 382 (scripting/quests/Q211-Q233) as steps a bot can play, and the second professions they
+ * open. Npc, monster, item ids and event names are the scripts' own. A mark quest is not tied to one class (the
+ * script checks who may take it), so its [PathQuest.from]/[PathQuest.to] are unused placeholders.
+ */
+internal object SecondClassQuests {
+
+    const val MARK_OF_CHALLENGER = 2627
+    const val MARK_OF_TRUST = 2734
+    const val MARK_OF_DUELIST = 2762
+    const val MARK_OF_CHAMPION = 3276
+
+    /** Human and elven fighter guild masters of SecondClassChange. */
+    private val HUMAN_ELF_FIGHTER_MASTERS = listOf(30109, 30187, 30689, 30849, 30900, 31965, 32094)
+
+    val classes: List<SecondClass> = listOf(
+            SecondClass(WARRIOR, GLADIATOR, "GL", listOf(MARK_OF_CHALLENGER, MARK_OF_TRUST, MARK_OF_DUELIST), HUMAN_ELF_FIGHTER_MASTERS),
+            SecondClass(WARRIOR, WARLORD, "WL", listOf(MARK_OF_CHALLENGER, MARK_OF_TRUST, MARK_OF_CHAMPION), HUMAN_ELF_FIGHTER_MASTERS))
+
+    private fun mark(questName: String, mark: Int, minLevel: Int, body: PathQuestBuilder.() -> Unit): PathQuest =
+            path(questName, HUMAN_FIGHTER, HUMAN_FIGHTER, mark, "") { level(minLevel); body() }
+
+    val quests: Map<Int, PathQuest> = listOf(
+            // Taken from 36 although the script allows 35: Filaur halfway through wants 36, a bot must not stall there.
+            mark("Q211_TrialOfTheChallenger", MARK_OF_CHALLENGER, 36) {
+                start(30644, "30644-05.htm")
+                cond(1, hunt(27110))
+                cond(2, talk(30644))
+                cond(3, talk(30645, "30645-02.htm"))
+                cond(4, hunt(27112))
+                cond(5, talk(30645))
+                cond(6, hunt(27113))
+                // Raldo shows up for 100 seconds where Baraham fell; a new kill brings him back.
+                cond(7, talkOr(30646, "30646-04.htm", orElse = hunt(27113)))
+                // Filaur sends the bot on only from 36.
+                rule({ it.cond == 8 && it.player.level >= 36 }, talk(30535))
+                cond(9, hunt(27114))
+                cond(10, talkOr(30646, orElse = hunt(27114)))
+            },
+            // Taken from 38 although the script allows 37: Seresin halfway through wants 38.
+            mark("Q217_TestimonyOfTrust", MARK_OF_TRUST, 38) {
+                start(30191, "30191-04.htm")
+                cond(1, talk(30154, "30154-03.htm"))
+                // Dryads and Lireins call up the spirits that carry the seed and the breath.
+                rule({ it.cond == 2 && !it.has(SEED_OF_VERDURE) }, hunt(20013, 20019, 27121))
+                rule({ it.cond == 2 && !it.has(BREATH_OF_WINDS) }, hunt(20036, 20044, 27120))
+                cond(3, talk(30154))
+                cond(4, talk(30358, "30358-02.htm"))
+                cond(5, talk(30464))
+                rule({ it.cond == 6 && !it.has(STAKATO_ICHOR) }, hunt(20157, 20230, 20232, 20234))
+                rule({ it.cond == 6 && !it.has(HONEY_DEW) }, hunt(20082, 20084, 20086, 20087, 20088))
+                rule({ it.cond == 6 && !it.has(BASILIK_PLASMA) }, hunt(20550))
+                cond(7, talk(30464))
+                cond(8, talk(30358))
+                cond(9, talk(30191))
+                // Seresin sends the bot on only from 38.
+                rule({ (it.cond == 10 || it.cond == 11) && it.player.level >= 38 }, talk(30657, "30657-03.htm"))
+                cond(12, talk(30565, "30565-02.htm"))
+                cond(13, talk(30515, "30515-02.htm"))
+                cond(14, hunt(20553))
+                cond(15, talk(30515))
+                cond(16, talk(30565))
+                cond(17, talk(30531, "30531-02.htm"))
+                cond(18, talk(30621, "30621-02.htm"))
+                cond(19, hunt(20213))
+                cond(20, talk(30621))
+                cond(21, talk(30531))
+                cond(22, talk(30191))
+                cond(23, talk(30031))
+            },
+            mark("Q222_TestOfTheDuelist", MARK_OF_DUELIST, 39) {
+                start(30623, "30623-07.htm")
+                collect(2, 10,
+                        2768 to intArrayOf(20085), 2769 to intArrayOf(20090), 2770 to intArrayOf(20234),
