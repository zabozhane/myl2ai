@@ -0,0 +1,31 @@
+package dev.l2j.autobots.offlinelife
+
+import net.sf.l2j.L2DatabaseFactory
+import java.util.logging.Logger
+
+/** Spots an offline character avoids after a death there; survives restarts, stores no resources. */
+internal object DeadlySpotStore {
+    private val logger=Logger.getLogger(DeadlySpotStore::class.java.name)
+    fun initialize() {
+        L2DatabaseFactory.getInstance().connection.use { c -> c.createStatement().use {
+            it.executeUpdate("CREATE TABLE IF NOT EXISTS character_offline_deadly_spots (char_id INT UNSIGNED NOT NULL, spot_key BIGINT NOT NULL, marked_at BIGINT NOT NULL, PRIMARY KEY(char_id,spot_key))")
+        } }
+    }
+    fun load(id: Int,since: Long): Map<Long,Long> = runCatching {
+        L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("DELETE FROM character_offline_deadly_spots WHERE char_id=? AND marked_at<?").use { it.setInt(1,id);it.setLong(2,since);it.executeUpdate() }
+            c.prepareStatement("SELECT spot_key,marked_at FROM character_offline_deadly_spots WHERE char_id=?").use {
+                it.setInt(1,id)
+                it.executeQuery().use { r -> buildMap { while(r.next()) put(r.getLong(1),r.getLong(2)) } }
+            }
+        }
+    }.getOrElse { logger.warning("Deadly spot read failed for $id: $it");emptyMap() }
+    fun save(id: Int,marks: Map<Long,Long>) {
+        runCatching { L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("INSERT INTO character_offline_deadly_spots(char_id,spot_key,marked_at) VALUES(?,?,?) ON DUPLICATE KEY UPDATE marked_at=VALUES(marked_at)").use { ps ->
+                for((key,at) in marks) { ps.setInt(1,id);ps.setLong(2,key);ps.setLong(3,at);ps.addBatch() }
+                ps.executeBatch()
+            }
+        } }.onFailure { logger.warning("Deadly spot write failed for $id: $it") }
+    }
+}
