+package dev.l2j.autobots.population.news
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.group.launchSafely
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.enums.items.EtcItemType
+import net.sf.l2j.gameserver.model.WorldObject
+import net.sf.l2j.gameserver.model.actor.Creature
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.item.kind.Armor
+import net.sf.l2j.gameserver.model.item.kind.EtcItem
+import net.sf.l2j.gameserver.model.item.kind.Item
+import net.sf.l2j.gameserver.model.item.kind.Weapon
+import net.sf.l2j.gameserver.model.pledge.Clan
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * The server's news feed (docs/news.md): raid bosses killed, rare drops, PKs and clan wars, by bots and players
+ * alike. The core reports events through AutobotsManager; the feed keeps the last [KEEP] items in memory and in
+ * `autobot_news` for a week. [NewsBoard] shows it on the community board, [Rumors] retells it in shout.
+ */
+internal object ServerNews {
+    enum class Kind(val code: String) {
+        Raid("raid"), Drop("drop"), Pk("pk"),
+        WarDeclared("war_declared"), WarMutual("war_mutual"), WarSurrender("war_surrender"), WarStopped("war_stopped"), WarBattle("war_battle");
+
+        val isWar get() = name.startsWith("War")
+
+        companion object {
+            fun of(code: String) = values().firstOrNull { it.code == code }
+        }
+    }
+
+    /**
+     * One event. Raid: [actor] killed [subject] with a party of [count], [extra] lists notable drops. Drop: [actor]
+     * got [count] [subject] from [other]. Pk: [actor] killed [other] (level [extra]), [count] is the killer's PK count.
+     * Wars: [actorClan] did it to [otherClan]; a battle is [count] kills of [actorClan] against [extra] of [otherClan].
+     * [region] is the map region for rumors, -1 when the news is not tied to a place.
+     */
+    class Entry(val id: Long, val at: Long, val kind: Kind, val actor: String, val actorClan: String, val other: String,
+                val otherClan: String, val subject: String, val place: String, val region: Int, val count: Int, val extra: String)
+
+    private const val KEEP = 200
+    private const val WEEK_MS = 7 * 24 * 3_600_000L
+    private const val BATTLE_WINDOW_MS = 30 * 60_000L
+    private const val BATTLE_MIN_KILLS = 3
+
+    private val settings get() = AutobotData.settings
+    val enabled get() = settings.newsEnabled
+
+    private val feed = ArrayDeque<Entry>()
+    private val nextId = AtomicLong(1)
+    @Volatile private var loaded = false
+
+    /** Notable drops of a raid boss that is dying right now: the core drops before it reports the kill. */
+    private val raidDrops = ConcurrentHashMap<Int, MutableList<String>>()
+    /** Surrenders of the last seconds, so the war's end that follows is not a second item. */
+    private val surrendered = ConcurrentHashMap<Long, Long>()
+
+    private class Battle(var kills: Int = 0, var deaths: Int = 0)
+    /** (clan, enemy) with the lower id first -> kills of the first and the second in the current window. */
+    private val battles = ConcurrentHashMap<Long, Battle>()
+    private var battleWindow = System.currentTimeMillis()
+
+    private val counts = ConcurrentHashMap<Kind, AtomicInteger>()
+
+    // ---------------------------------------------------------------- core events
+
+    fun onRaidKilled(boss: Npc, killer: Creature?) {
+        val drops = raidDrops.remove(boss.objectId)
+        if (!enabled) return
+        val player = killer?.actingPlayer ?: return
+        val head = player.party?.leader ?: player
+        val size = player.party?.membersCount ?: 1
+        add(Kind.Raid, head.name, clanName(head), "", "", "${boss.name} (${boss.level})", boss, size, drops?.distinct()?.take(3)?.joinToString(", ") ?: "")
+    }
+
+    fun onMonsterDrop(monster: Monster, player: Player, itemId: Int, count: Int) {
+        if (!enabled) return
+        val item = ItemTable.getInstance().getTemplate(itemId) ?: return
+        if (!notable(item)) return
+        if (monster.isRaidRelated) {
+            raidDrops.getOrPut(monster.objectId) { java.util.Collections.synchronizedList(ArrayList()) }.add(item.name)
+            return
+        }
+        val chance = monster.template.dropData.filter { !it.isSweep }.flatMap { it.allDrops }.filter { it.itemId == itemId }.minOfOrNull { it.chance } ?: return
+        if (chance > settings.newsRareDropChance) return
+        add(Kind.Drop, player.name, clanName(player), monster.name, "", item.name, monster, count, "")
+    }
+
+    fun onPk(killer: Player, victim: Player) {
+        if (!enabled) return
+        add(Kind.Pk, killer.name, clanName(killer), victim.name, clanName(victim), "", victim, killer.pkKills, victim.level.toString())
+    }
+
+    /** A PvP kill: counted when the two clans are at war with each other, and told as a battle every 30 minutes. */
+    fun onPvpKill(killer: Player, victim: Player) {
+        if (!enabled) return
+        val a = killer.clan ?: return
+        val b = victim.clan ?: return
+        if (!a.isAtWarWith(b.clanId) || !b.isAtWarWith(a.clanId)) return
+        val battle = battles.getOrPut(key(minOf(a.clanId, b.clanId), maxOf(a.clanId, b.clanId))) { Battle() }
+        synchronized(battle) { if (a.clanId < b.clanId) battle.kills++ else battle.deaths++ }
+    }
+
+    fun onWarDeclared(attacker: Clan, attacked: Clan) {
+        if (!enabled) return
+        add(if (attacked.isAtWarWith(attacker.clanId)) Kind.WarMutual else Kind.WarDeclared, "", attacker.name, "", attacked.name, "", null, 0, "")
+    }
+
+    fun onWarSurrender(loser: Clan, winner: Clan) {
+        surrendered[key(loser.clanId, winner.clanId)] = System.currentTimeMillis()
+        if (!enabled) return
+        add(Kind.WarSurrender, "", loser.name, "", winner.name, "", null, 0, "")
+    }
+
+    fun onWarEnded(clan: Clan, enemy: Clan) {
+        val surrender = surrendered.remove(key(clan.clanId, enemy.clanId))
+        if (surrender != null && System.currentTimeMillis() - surrender < 10_000L) return
+        if (!enabled) return
+        add(Kind.WarStopped, "", clan.name, "", enemy.name, "", null, 0, "")
+    }
+
+    // ---------------------------------------------------------------- feed
+
+    /** Every population tick: closes the battle window and forgets stale raid drops. */
+    fun tick() {
+        if (!enabled) return
+        load()
+        val now = System.currentTimeMillis()
+        if (now - battleWindow < BATTLE_WINDOW_MS) return
+        battleWindow = now
+        for ((k, battle) in battles.entries.toList()) {
+            battles.remove(k)
+            if (battle.kills + battle.deaths < BATTLE_MIN_KILLS) continue
+            val a = net.sf.l2j.gameserver.data.sql.ClanTable.getInstance().getClan(first(k)) ?: continue
+            val b = net.sf.l2j.gameserver.data.sql.ClanTable.getInstance().getClan(second(k)) ?: continue
+            val (winner, loser, wk, lk) = if (battle.kills >= battle.deaths) Quad(a, b, battle.kills, battle.deaths) else Quad(b, a, battle.deaths, battle.kills)
+            add(Kind.WarBattle, "", winner.name, "", loser.name, "", null, wk, lk.toString())
+        }
+        if (raidDrops.size > 50) raidDrops.clear()
+        surrendered.entries.removeIf { now - it.value > 60_000L }
+    }
+
+    private data class Quad(val a: Clan, val b: Clan, val x: Int, val y: Int)
+
+    /** Newest first, at most [limit], optionally of some kinds only. */
+    fun latest(limit: Int, filter: (Entry) -> Boolean = { true }): List<Entry> {
+        load()
+        synchronized(feed) { return feed.asReversed().asSequence().filter(filter).take(limit).toList() }
+    }
+
+    private fun add(kind: Kind, actor: String, actorClan: String, other: String, otherClan: String, subject: String,
+                    where: WorldObject?, count: Int, extra: String) {
+        load()
+        val place = where?.let { MapRegionData.getInstance().getClosestTownName(it.x, it.y) } ?: ""
+        val region = where?.let { MapRegionData.getInstance().getMapRegion(it.x, it.y) } ?: -1
+        val entry = Entry(nextId.getAndIncrement(), System.currentTimeMillis(), kind, actor, actorClan, other, otherClan, subject, place, region, count, extra)
+        synchronized(feed) {
+            feed.addLast(entry)
+            while (feed.size > KEEP) feed.removeFirst()
+        }
+        counts.getOrPut(kind) { AtomicInteger() }.incrementAndGet()
+        if (settings.newsLog) println("Autobots news: ${kind.code} ${NewsText.board(entry)}")
+        launchSafely { store(entry) }
+    }
+
+    fun summary() {
+        if (!enabled || !settings.newsLog) return
+        println("Autobots news summary: " + Kind.values().joinToString(" ") { "${it.code}=${counts[it]?.getAndSet(0) ?: 0}" } +
+                " feed=${synchronized(feed) { feed.size }} " + Rumors.summary())
+    }
+
+    // ---------------------------------------------------------------- helpers
+
+    /** Gear, jewels, recipes, enchant scrolls and spellbooks: what players brag about. Materials and potions are not news. */
+    fun notable(item: Item): Boolean = when {
+        item.itemId == 57 -> false
+        item is Weapon || item is Armor -> true
+        (item as? EtcItem)?.itemType in setOf(EtcItemType.RECIPE, EtcItemType.SCRL_ENCHANT_WP, EtcItemType.SCRL_ENCHANT_AM,
+                EtcItemType.BLESS_SCRL_ENCHANT_WP, EtcItemType.BLESS_SCRL_ENCHANT_AM) -> true
+        item.name.startsWith("Spellbook") || item.name.startsWith("Amulet:") -> true
+        else -> false
+    }
+
+    private fun clanName(player: Player) = player.clan?.name ?: ""
+
+    private fun key(a: Int, b: Int) = (a.toLong() shl 32) or (b.toLong() and 0xffffffffL)
+    private fun first(k: Long) = (k shr 32).toInt()
+    private fun second(k: Long) = k.toInt()
+
+    // ---------------------------------------------------------------- storage
+
+    @Synchronized
+    private fun load() {
+        if (loaded) return
+        loaded = true
+        try {
+            val stored = ArrayList<Entry>()
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.createStatement().use {
+                    it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_news (id BIGINT NOT NULL, at BIGINT NOT NULL, kind VARCHAR(16) NOT NULL, " +
+                            "actor VARCHAR(35) NOT NULL, actor_clan VARCHAR(45) NOT NULL, other VARCHAR(45) NOT NULL, other_clan VARCHAR(45) NOT NULL, " +
+                            "subject VARCHAR(120) NOT NULL, place VARCHAR(60) NOT NULL, region INT NOT NULL, count INT NOT NULL, extra VARCHAR(200) NOT NULL, " +
+                            "PRIMARY KEY(id), KEY(at))")
+                }
+                con.prepareStatement("DELETE FROM autobot_news WHERE at < ?").use { it.setLong(1, System.currentTimeMillis() - WEEK_MS); it.executeUpdate() }
+                con.prepareStatement("SELECT id, at, kind, actor, actor_clan, other, other_clan, subject, place, region, count, extra FROM autobot_news ORDER BY id DESC LIMIT $KEEP").use { ps ->
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) {
+                            val kind = Kind.of(rs.getString(3)) ?: continue
+                            stored += Entry(rs.getLong(1), rs.getLong(2), kind, rs.getString(4), rs.getString(5), rs.getString(6), rs.getString(7),
+                                    rs.getString(8), rs.getString(9), rs.getInt(10), rs.getInt(11), rs.getString(12))
+                        }
+                    }
+                }
+                con.prepareStatement("SELECT COALESCE(MAX(id), 0) FROM autobot_news").use { ps ->
+                    ps.executeQuery().use { rs -> if (rs.next()) nextId.updateAndGet { maxOf(it, rs.getLong(1) + 1) } }
+                }
+            }
+            synchronized(feed) {
+                // Items reported before the table was read are newer than anything stored.
+                val early = feed.toList()
+                feed.clear()
+                stored.asReversed().forEach { feed.addLast(it) }
+                early.forEach { feed.addLast(it) }
+                while (feed.size > KEEP) feed.removeFirst()
+            }
+            if (settings.newsLog) println("Autobots news: loaded ${stored.size} items")
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    private fun store(e: Entry) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("REPLACE INTO autobot_news (id, at, kind, actor, actor_clan, other, other_clan, subject, place, region, count, extra) " +
+                        "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)").use { ps ->
+                    ps.setLong(1, e.id); ps.setLong(2, e.at); ps.setString(3, e.kind.code); ps.setString(4, e.actor.take(35))
+                    ps.setString(5, e.actorClan.take(45)); ps.setString(6, e.other.take(45)); ps.setString(7, e.otherClan.take(45))
+                    ps.setString(8, e.subject.take(120)); ps.setString(9, e.place.take(60)); ps.setInt(10, e.region); ps.setInt(11, e.count)
+                    ps.setString(12, e.extra.take(200))
+                    ps.executeUpdate()
+                }
+            }
+        } catch (ex: Exception) {
+            ex.printStackTrace()
+        }
+    }
+}
