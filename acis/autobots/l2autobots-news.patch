@@ -0,0 +1,154 @@
+package dev.l2j.autobots.population.news
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.news.ServerNews.Kind
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.communitybbs.Manager.BaseBBSManager
+import net.sf.l2j.gameserver.data.sql.ClanTable
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+
+/**
+ * The news board on the community board (Alt+B opens `_bbsnews`): the feed with tabs and pages, the clan wars going
+ * on with their score, and PKs online. `_bbsnews;<tab>;<page>`.
+ */
+internal object NewsBoard {
+    private const val PAGE = 12
+    private const val WARS_CACHE_MS = 60_000L
+
+    private enum class Tab(val code: String, val title: String, val filter: (ServerNews.Entry) -> Boolean) {
+        All("all", "Все", { true }),
+        Raid("raid", "РБ", { it.kind == Kind.Raid }),
+        Drop("drop", "Дроп", { it.kind == Kind.Drop }),
+        Pk("pk", "ПК", { it.kind == Kind.Pk }),
+        War("war", "Войны", { it.kind.isWar });
+    }
+
+    private val TIME = DateTimeFormatter.ofPattern("HH:mm")
+    private val DAY_TIME = DateTimeFormatter.ofPattern("dd.MM HH:mm")
+
+    @Volatile private var scores: Map<Pair<Int, Int>, Pair<Int, Int>> = emptyMap()
+    @Volatile private var scoresAt = 0L
+
+    fun show(player: Player, command: String) {
+        val parts = command.split(';')
+        val tab = Tab.values().firstOrNull { it.code == parts.getOrNull(1) } ?: Tab.All
+        val page = (parts.getOrNull(2)?.toIntOrNull() ?: 0).coerceAtLeast(0)
+        // The board takes at most three packets of 4090 characters.
+        var html = html(tab, page, PAGE)
+        if (html.length >= 12_200) html = html(tab, page, PAGE / 2)
+        BaseBBSManager.separateAndSend(html, player)
+    }
+
+    private fun html(tab: Tab, page: Int, perPage: Int): String {
+        val all = ServerNews.latest(200, tab.filter)
+        val rows = all.drop(page * perPage).take(perPage)
+        val sb = StringBuilder(8000)
+        sb.append("<html><body><br><center>")
+        sb.append("<table width=610><tr><td width=400><font color=LEVEL>Новости сервера</font></td>")
+        sb.append("<td width=210 align=right><a action=\"bypass _bbshome\">Главная</a></td></tr></table><br>")
+        sb.append("<table width=610 bgcolor=333333><tr>")
+        for (t in Tab.values()) {
+            if (t == tab) sb.append("<td width=122 align=center><font color=LEVEL>").append(t.title).append("</font></td>")
+            else sb.append("<td width=122 align=center><a action=\"bypass _bbsnews;").append(t.code).append(";0\">").append(t.title).append("</a></td>")
+        }
+        sb.append("</tr></table><br>")
+        if (!ServerNews.enabled) sb.append("<table width=610><tr><td>Новости выключены.</td></tr></table>")
+        else if (rows.isEmpty()) sb.append("<table width=610><tr><td><font color=AAAAAA>Пока тихо. Здесь будут убитые РБ, редкий дроп, ПК и войны кланов.</font></td></tr></table>")
+        else {
+            sb.append("<table width=610>")
+            for ((i, e) in rows.withIndex()) {
+                sb.append("<tr><td width=80 valign=top><font color=AAAAAA>").append(time(e.at)).append("</font></td><td width=530>")
+                sb.append("<font color=").append(color(e.kind)).append(">").append(esc(NewsText.board(e))).append("</font></td></tr>")
+                if (i < rows.size - 1) sb.append("<tr><td height=4></td></tr>")
+            }
+            sb.append("</table>")
+        }
+        if (page > 0 || all.size > (page + 1) * perPage) {
+            sb.append("<br><table width=610><tr><td width=305 align=left>")
+            if (page > 0) sb.append("<a action=\"bypass _bbsnews;").append(tab.code).append(';').append(page - 1).append("\">&lt; Новее</a>")
+            sb.append("</td><td width=305 align=right>")
+            if (all.size > (page + 1) * perPage) sb.append("<a action=\"bypass _bbsnews;").append(tab.code).append(';').append(page + 1).append("\">Старше &gt;</a>")
+            sb.append("</td></tr></table>")
+        }
+        if (page == 0) {
+            wars(sb)
+            wanted(sb)
+        }
+        sb.append("</center></body></html>")
+        return sb.toString()
+    }
+
+    /** Wars going on: mutual or declared, with the score bot clans keep. */
+    private fun wars(sb: StringBuilder) {
+        val clans = ClanTable.getInstance().clans
+        val lines = ArrayList<String>()
+        for (clan in clans) {
+            for (enemyId in clan.warList) {
+                val enemy = ClanTable.getInstance().getClan(enemyId) ?: continue
+                val mutual = enemy.isAtWarWith(clan.clanId)
+                if (mutual && clan.clanId > enemyId) continue
+                val score = score(clan.clanId, enemyId)
+                lines += if (mutual) "${esc(clan.name)} <font color=FF6666>vs</font> ${esc(enemy.name)}" + (score?.let { " — ${it.first}:${it.second}" } ?: "")
+                else "${esc(clan.name)} объявил войну ${esc(enemy.name)}" + (score?.let { " — ${it.first}:${it.second}" } ?: "")
+            }
+        }
+        if (lines.isEmpty()) return
+        sb.append("<br><table width=610 bgcolor=333333><tr><td><font color=LEVEL>Войны кланов</font></td></tr></table><table width=610>")
+        lines.take(8).forEach { sb.append("<tr><td>").append(it).append("</td></tr>") }
+        if (lines.size > 8) sb.append("<tr><td><font color=AAAAAA>и ещё ").append(lines.size - 8).append("</font></td></tr>")
+        sb.append("</table>")
+    }
+
+    /** PKs online now. */
+    private fun wanted(sb: StringBuilder) {
+        val pks = World.getInstance().players.filter { it.karma > 0 && it.isOnline }.sortedByDescending { it.karma }.take(5)
+        if (pks.isEmpty()) return
+        sb.append("<br><table width=610 bgcolor=333333><tr><td><font color=LEVEL>ПК онлайн</font></td></tr></table><table width=610>")
+        for (p in pks) {
+            sb.append("<tr><td><font color=FF6666>").append(esc(p.name)).append("</font> ").append(p.level).append(" ур., ПК ").append(p.pkKills)
+            p.clan?.let { sb.append(", ").append(esc(it.name)) }
+            sb.append(", у ").append(esc(NewsText.placeOf(p))).append("</td></tr>")
+        }
+        sb.append("</table>")
+    }
+
+    /** Kills and deaths of [clan] in its war on [enemy] as bot clans count them (autobot_clan_wars), if known. */
+    private fun score(clan: Int, enemy: Int): Pair<Int, Int>? {
+        val now = System.currentTimeMillis()
+        if (now - scoresAt > WARS_CACHE_MS) {
+            scoresAt = now
+            val map = HashMap<Pair<Int, Int>, Pair<Int, Int>>()
+            try {
+                L2DatabaseFactory.getInstance().connection.use { con ->
+                    con.prepareStatement("SELECT clan_id, enemy_id, kills, deaths FROM autobot_clan_wars").use { ps ->
+                        ps.executeQuery().use { rs -> while (rs.next()) map[rs.getInt(1) to rs.getInt(2)] = rs.getInt(3) to rs.getInt(4) }
+                    }
+                }
+            } catch (e: Exception) {
+                // No table yet: clan wars of bots have never run.
+            }
+            scores = map
+        }
+        return scores[clan to enemy] ?: scores[enemy to clan]?.let { it.second to it.first }
+    }
+
+    private fun time(at: Long): String {
+        val zone = runCatching { ZoneId.of(AutobotData.settings.populationTimeZone) }.getOrDefault(ZoneId.systemDefault())
+        val t = Instant.ofEpochMilli(at).atZone(zone)
+        return if (t.toLocalDate() == LocalDate.now(zone)) t.format(TIME) else t.format(DAY_TIME)
+    }
+
+    private fun color(kind: Kind) = when (kind) {
+        Kind.Raid -> "FFCC33"
+        Kind.Drop -> "66CCFF"
+        Kind.Pk -> "FF6666"
+        else -> "FF9966"
+    }
+
+    private fun esc(s: String) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/news/NewsText.kt b/src/main/kotlin/dev/l2j/autobots/population/news/NewsText.kt
