+++ b/src/main/kotlin/dev/l2j/autobots/population/news/NewsText.kt
@@ -0,0 +1,125 @@
+package dev.l2j.autobots.population.news
+
+import dev.l2j.autobots.population.news.ServerNews.Entry
+import dev.l2j.autobots.population.news.ServerNews.Kind
+import net.sf.l2j.commons.random.Rnd
+
+/**
+ * How news reads: a full line for the board, and chat lines for rumors and answers, Russian or English. Lines are
+ * code templates, no model: a rumor is a few words a player would shout, not an article.
+ */
+internal object NewsText {
+    /** "у X" for a map region (genitive), the way players name places in chat. */
+    private val PLACE_RU = arrayOf("Говорящего острова", "эльфийской деревни", "деревни тёмных эльфов", "деревни орков",
+            "деревни гномов", "Глудио", "Глудина", "Диона", "Гирана", "Орена", "Адена", "Деревни охотников", "гавани Гирана",
+            "Хейна", "Руны", "Годдарда", "Шутгарта", "Флорана", "Первобытного острова")
+    private val PLACE_EN = arrayOf("TI", "Elven Village", "DE Village", "Orc Village", "Dwarf Village", "Gludio", "Gludin",
+            "Dion", "Giran", "Oren", "Aden", "Hunters", "Giran Harbor", "Heine", "Rune", "Goddard", "Schuttgart", "Floran", "Primeval Isle")
+
+    fun place(e: Entry, ru: Boolean): String {
+        val names = if (ru) PLACE_RU else PLACE_EN
+        return names.getOrNull(e.region) ?: e.place
+    }
+
+    fun placeOf(p: net.sf.l2j.gameserver.model.actor.Player): String =
+            PLACE_RU.getOrNull(net.sf.l2j.gameserver.data.xml.MapRegionData.getInstance().getMapRegion(p.x, p.y)) ?: ""
+
+    private fun who(e: Entry) = if (e.actorClan.isNotEmpty()) "${e.actor} (${e.actorClan})" else e.actor
+
+    /** The board's line: who, what, where, in full. */
+    fun board(e: Entry): String = when (e.kind) {
+        Kind.Raid -> "${if (e.count > 1) "Пати ${who(e)}, ${e.count} чел.," else who(e)} ${if (e.count > 1) "убила" else "убил(а)"} ${e.subject} у ${place(e, true)}" +
+                (if (e.extra.isNotEmpty()) ". Упало: ${e.extra}" else "")
+        Kind.Drop -> "${who(e)} выбил(а) ${e.subject}${if (e.count > 1) " x${e.count}" else ""} с ${e.other} у ${place(e, true)}"
+        Kind.Pk -> "${who(e)} убил(а) ${e.other}${if (e.otherClan.isNotEmpty()) " (${e.otherClan})" else ""}, ${e.extra} ур., у ${place(e, true)}. На счету ПК: ${e.count}"
+        Kind.WarDeclared -> "Клан ${e.actorClan} объявил войну клану ${e.otherClan}"
+        Kind.WarMutual -> "Клан ${e.actorClan} ответил на войну клана ${e.otherClan}: война взаимная"
+        Kind.WarSurrender -> "Клан ${e.actorClan} сдался клану ${e.otherClan}"
+        Kind.WarStopped -> "Война ${e.actorClan} с ${e.otherClan} окончена"
+        Kind.WarBattle -> "Бои ${e.actorClan} против ${e.otherClan} за полчаса: ${e.count}:${e.extra}"
+    }
+
+    private fun boss(e: Entry) = e.subject.substringBefore(" (")
+
+    /**
+     * A rumor about [e] in shout. [old]: retold later, so it sounds like hearsay and may grow in the telling.
+     * [self]: the teller took part (the raid killer brags, the PK victim complains).
+     */
+    fun rumor(e: Entry, ru: Boolean, old: Boolean, self: Boolean): String {
+        val at = place(e, ru)
+        val pick = { ruLines: List<String>, enLines: List<String> -> (if (ru) ruLines else enLines).random() }
+        return when (e.kind) {
+            Kind.Raid -> {
+                // A party grows in the retelling.
+                val size = if (old && e.count > 1 && Rnd.get(100) < 25) e.count + Rnd.get(1, 3) else e.count
+                val drop = if (e.extra.isNotEmpty() && Rnd.get(100) < 60) (if (ru) ", упало: ${e.extra}" else ", drop: ${e.extra}") else ""
+                when {
+                    self -> pick(listOf("мы только что положили ${boss(e)}!", "${boss(e)} наш, гг", "убили ${boss(e)} у $at$drop"),
+                            listOf("we just killed ${boss(e)}!", "${boss(e)} down, gg", "killed ${boss(e)} near $at$drop"))
+                    old -> pick(listOf("говорят, ${e.actor} с пати в $size чел. убили ${boss(e)} у $at", "слышал, ${boss(e)} уже убит, ${e.actorClan.ifEmpty { e.actor }} постарались",
+                            "${boss(e)} у $at уже лёг, ${e.actor} забрали"),
