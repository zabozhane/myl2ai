+                    else -> pick(listOf("${boss(e)} лёг! ${e.actorClan.ifEmpty { e.actor }} забрали, у $at$drop", "${e.actor} с пати только что убили ${boss(e)} у $at$drop",
+                            "слышали? ${e.actor} и ко положили ${boss(e)}$drop"),
+                            listOf("${boss(e)} is down! ${e.actorClan.ifEmpty { e.actor }} took it near $at$drop", "${e.actor} and co just killed ${boss(e)}$drop"))
+                }
+            }
+            Kind.Drop -> when {
+                self -> pick(listOf("выбил ${e.subject}!!!", "ура, ${e.subject} упал с ${e.other}", "кто бы мог подумать, ${e.subject} с ${e.other}"),
+                        listOf("got ${e.subject}!!!", "${e.subject} dropped from ${e.other}, finally"))
+                old -> pick(listOf("говорят, кто-то у $at выбил ${e.subject}", "слышал, ${e.actor} выбил ${e.subject} с ${e.other}"),
+                        listOf("heard someone got ${e.subject} near $at", "${e.actor} got ${e.subject}, they say"))
+                else -> pick(listOf("${e.actor} выбил ${e.subject} с ${e.other}, везёт же", "у $at ${e.subject} упал! ${e.actor}, кажется"),
+                        listOf("${e.actor} got ${e.subject} from ${e.other}, lucky", "${e.subject} dropped near $at! ${e.actor} i think"))
+            }
+            Kind.Pk -> when {
+                self -> pick(listOf("меня ${e.actor} убил у $at, гад", "${e.actor} пкшит у $at, меня положил", "осторожно, у $at ПК ${e.actor}, только что меня слил"),
+                        listOf("${e.actor} pked me near $at", "careful, ${e.actor} is pking near $at"))
+                old -> pick(listOf("говорят, у $at бегает ПК ${e.actor}", "слышал, ${e.actor} красный, ${e.count} пк уже"),
+                        listOf("heard there's a pk near $at, ${e.actor}", "${e.actor} is red, ${e.count} pks they say"))
+                else -> pick(listOf("${e.actor} опять ПКшит у $at, убил ${e.other}", "осторожно у $at: ${e.actor} красный, положил ${e.other}"),
+                        listOf("${e.actor} is pking near $at, killed ${e.other}", "careful near $at, ${e.actor} is red"))
+            }
+            Kind.WarDeclared -> pick(listOf("${e.actorClan} объявили войну ${e.otherClan}", "слыхали? ${e.actorClan} против ${e.otherClan}, война", "${e.otherClan} получили войну от ${e.actorClan}"),
+                    listOf("${e.actorClan} declared war on ${e.otherClan}", "${e.actorClan} vs ${e.otherClan}, war"))
+            Kind.WarMutual -> pick(listOf("${e.actorClan} ответили ${e.otherClan}, теперь война по-настоящему", "${e.actorClan} и ${e.otherClan} воюют, оба объявили"),
+                    listOf("${e.actorClan} answered ${e.otherClan}, it's a real war now", "${e.actorClan} and ${e.otherClan} are at war"))
+            Kind.WarSurrender -> pick(listOf("${e.actorClan} сдались ${e.otherClan}", "${e.actorClan} слились, сдались ${e.otherClan}"),
+                    listOf("${e.actorClan} surrendered to ${e.otherClan}", "${e.actorClan} gave up, ${e.otherClan} won"))
+            Kind.WarStopped -> pick(listOf("${e.actorClan} и ${e.otherClan} больше не воюют", "война ${e.actorClan} с ${e.otherClan} всё"),
+                    listOf("${e.actorClan} and ${e.otherClan} stopped the war", "war ${e.actorClan} vs ${e.otherClan} is over"))
+            Kind.WarBattle -> pick(listOf("${e.actorClan} против ${e.otherClan}: ${e.count}:${e.extra} за полчаса", "${e.actorClan} гоняют ${e.otherClan}, ${e.count}:${e.extra}"),
+                    listOf("${e.actorClan} vs ${e.otherClan}: ${e.count}:${e.extra} in half an hour", "${e.actorClan} are beating ${e.otherClan}, ${e.count}:${e.extra}"))
+        }
+    }
+
+    /** Another bot's reaction to a rumor. */
+    fun reply(e: Entry, ru: Boolean): String = when (e.kind) {
+        Kind.Raid -> (if (ru) listOf("гц", "грац", "а что упало?", "опять без нас", "кто там был?", "мы тоже туда шли(", "ну наконец-то")
+                else listOf("gz", "grats", "what dropped?", "without us again", "who was there?"))
+        Kind.Drop -> (if (ru) listOf("везёт", "продаёшь?", "гц с дропом", "сколько хочешь за него?", "а я его неделю выбиваю")
+                else listOf("lucky", "wts?", "gz on the drop", "how much?", "been farming it for a week"))
+        Kind.Pk -> (if (ru) listOf("опять он", "кто-нибудь его уже прибьёт?", "не ходите туда", "карму отмывать будет долго", "сколько можно")
+                else listOf("him again", "someone kill him already", "stay away from there", "again?"))
+        Kind.WarDeclared, Kind.WarMutual, Kind.WarBattle -> (if (ru) listOf("попкорн", "кто кого?", "давно пора", "ну всё, на споте будет жарко", "держусь подальше")
+                else listOf("popcorn", "who wins?", "about time", "stay away from them"))
+        Kind.WarSurrender, Kind.WarStopped -> (if (ru) listOf("слились", "гг", "быстро они", "мир, дружба, жвачка")
+                else listOf("gg", "that was quick", "peace at last"))
+    }.random()
+
+    /** A short answer to "what's new": one or two items, freshest first. */
+    fun answer(items: List<Entry>, ru: Boolean): String {
+        if (items.isEmpty()) return (if (ru) listOf("тихо пока", "да ничего особенного", "ничего не слышал") else listOf("quiet so far", "nothing much", "haven't heard anything")).random()
+        val lines = items.take(2).map { shortLine(it, ru) }
+        val text = lines.joinToString(if (ru) "; ещё " else "; also ")
+        val hint = if (Rnd.get(100) < 40) (if (ru) " (всё на доске, Alt+B)" else " (all on the board, Alt+B)") else ""
+        return (text + hint).take(200)
+    }
+
+    private fun shortLine(e: Entry, ru: Boolean): String = when (e.kind) {
+        Kind.Raid -> if (ru) "${e.actorClan.ifEmpty { e.actor }} убили ${boss(e)}" else "${e.actorClan.ifEmpty { e.actor }} killed ${boss(e)}"
+        Kind.Drop -> if (ru) "${e.actor} выбил ${e.subject}" else "${e.actor} got ${e.subject}"
+        Kind.Pk -> if (ru) "${e.actor} пкшит у ${place(e, true)}" else "${e.actor} is pking near ${place(e, false)}"
+        else -> rumor(e, ru, old = false, self = false)
+    }
+}
