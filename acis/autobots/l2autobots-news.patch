@@ -0,0 +1,148 @@
+package dev.l2j.autobots.population.news
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.group.GroupChat
+import dev.l2j.autobots.population.group.Sociability
+import dev.l2j.autobots.population.group.launchSafely
+import dev.l2j.autobots.population.llm.Attention.isLiveAudience
+import dev.l2j.autobots.population.news.ServerNews.Kind
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.math.MathUtil
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Rumors (docs/news.md): where a live player is, a bot of the region retells fresh news in shout and others react;
+ * a player asking "what's new" gets the last news from a bot. Code templates only, so it costs nothing.
+ */
+internal object Rumors {
+    private const val MAX_AGE_MS = 60 * 60_000L
+    private const val HEARSAY_MS = 15 * 60_000L
+    private const val ASK_COOLDOWN_MS = 30_000L
+    private const val ANSWER_NEWS_MS = 3 * 3_600_000L
+
+    private val QUESTION = Regex("(что нового|что новенького|какие новости|\\bновост|что слышно|кто убил|что случилось|что происходит|" +
+            "what'?s new|\\bany news\\b|\\bnews\\b|what happened)", RegexOption.IGNORE_CASE)
+
+    private val settings get() = AutobotData.settings
+    private val enabled get() = ServerNews.enabled && settings.newsRumorsEnabled
+
+    private val lastInRegion = ConcurrentHashMap<Int, Long>()
+    /** region -> ids of news already told there. */
+    private val told = ConcurrentHashMap<Int, MutableSet<Long>>()
+    private val asked = ConcurrentHashMap<Int, Long>()
+    private var hourStarted = System.currentTimeMillis()
+    private val hour = AtomicInteger()
+    private val rumors = AtomicInteger()
+    private val replies = AtomicInteger()
+    private val answers = AtomicInteger()
+
+    private fun region(p: Player) = MapRegionData.getInstance().getMapRegion(p.x, p.y)
+
+    private fun canTalk(bot: Autobot) = bot.life != null && !bot.isDead && bot.isOnline
+
+    /** Every 30 seconds: one rumor at most per region with a live player and a quiet shout. */
+    fun tick(online: List<Autobot>) {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        synchronized(this) {
+            if (now - hourStarted > 3_600_000L) { hourStarted = now; hour.set(0) }
+        }
+        val regions = World.getInstance().players.filter { it.isLiveAudience() }.map { region(it) }.distinct().shuffled()
+        if (regions.isEmpty()) return
+        val fresh = ServerNews.latest(30) { now - it.at < MAX_AGE_MS }
+        if (fresh.isEmpty()) return
+        val byRegion = online.filter { canTalk(it) }.groupBy { region(it) }
+        for (region in regions) {
+            if (hour.get() >= settings.newsRumorsPerHour) return
+            if (now - (lastInRegion[region] ?: 0L) < settings.newsRumorMinutes * 60_000L) continue
+            val bots = byRegion[region] ?: continue
+            val done = told.getOrPut(region) { ConcurrentHashMap.newKeySet() }
+            val candidates = fresh.filter { it.id !in done && (it.region == region || it.kind == Kind.Raid || it.kind.isWar) }
+            // News from here first, then the loudest from elsewhere.
+            val entry = candidates.firstOrNull { it.region == region } ?: candidates.firstOrNull() ?: continue
+            val self = bots.firstOrNull { it.name == entry.actor && entry.kind in setOf(Kind.Raid, Kind.Drop) }
+                    ?: bots.firstOrNull { it.name == entry.other && entry.kind == Kind.Pk }
+            val teller = self?.takeIf { Rnd.get(100) < 60 }
+                    ?: bots.filter { it.name != entry.actor && Sociability.of(it) != Sociability.Loner }.randomOrNull()
+                    ?: continue
+            done += entry.id
+            lastInRegion[region] = now
+            hour.incrementAndGet()
+            tell(teller, entry, self === teller, now - entry.at > HEARSAY_MS, bots - teller)
+        }
+        if (told.values.sumOf { it.size } > 2000) told.clear()
+    }
+
+    private fun tell(teller: Autobot, entry: ServerNews.Entry, self: Boolean, old: Boolean, others: List<Autobot>) {
+        val ru = Rnd.get(100) < 70
+        val line = NewsText.rumor(entry, ru, old, self)
+        rumors.incrementAndGet()
+        if (settings.newsLog) println("Autobots news: rumor ${entry.kind.code} by ${teller.name} in region ${region(teller)}: $line")
+        launchSafely {
+            delay(Rnd.get(1000, 5000).toLong())
+            if (!canTalk(teller)) return@launchSafely
+            teller.shout(line)
+            val repliers = others.filter { it.name != entry.actor && Rnd.get(100) < if (Sociability.of(it) == Sociability.Loner) 10 else 35 }
+                    .shuffled().take(Rnd.get(0, 3))
+            for (bot in repliers) {
+                delay(Rnd.get(4000, 10000).toLong())
+                if (!canTalk(bot)) continue
+                bot.shout(NewsText.reply(entry, ru))
+                replies.incrementAndGet()
+            }
+        }
+    }
+
+    /**
+     * A player's line in general chat (type 0) or shout (1) asking what's new: a bot nearby or in the region answers.
+     * @return true if it was such a question, so the usual chat answers stay quiet.
+     */
+    fun onPublicChat(type: Int, player: Player, text: String, online: Collection<Autobot>): Boolean {
+        if (!enabled || player is Autobot || !QUESTION.containsMatchIn(text) || !mayAsk(player)) return false
+        val bots = online.filter { canTalk(it) && Sociability.of(it) != Sociability.Loner }
+        val bot = when (type) {
+            0 -> bots.filter { MathUtil.checkIfInRange(1250, it, player, true) }.randomOrNull()
+            1 -> bots.filter { region(it) == region(player) }.randomOrNull()
+            else -> null
+        } ?: return false
+        val ru = GroupChat.isRussian(text) || !text.any { it in 'a'..'z' || it in 'A'..'Z' }
+        val reply = NewsText.answer(ServerNews.latest(2) { System.currentTimeMillis() - it.at < ANSWER_NEWS_MS }, ru)
+        answers.incrementAndGet()
+        if (settings.newsLog) println("Autobots news: ${bot.name} answers ${player.name}: $reply")
+        launchSafely {
+            delay(Rnd.get(3000, 7000).toLong())
+            if (!canTalk(bot)) return@launchSafely
+            if (type == 1) bot.shout(reply) else bot.say(reply)
+        }
+        return true
+    }
+
+    /** A whisper to a bot asking what's new. @return true if handled. */
+    fun onWhisper(player: Player, bot: Autobot, text: String): Boolean {
+        if (!enabled || player is Autobot || !QUESTION.containsMatchIn(text) || !mayAsk(player)) return false
+        val ru = GroupChat.isRussian(text) || !text.any { it in 'a'..'z' || it in 'A'..'Z' }
+        val reply = NewsText.answer(ServerNews.latest(2) { System.currentTimeMillis() - it.at < ANSWER_NEWS_MS }, ru)
+        answers.incrementAndGet()
+        if (settings.newsLog) println("Autobots news: ${bot.name} whispers ${player.name}: $reply")
+        launchSafely {
+            delay(Rnd.get(2000, 6000).toLong())
+            if (bot.isOnline && player.isOnline) bot.tell(player.name, reply)
+        }
+        return true
+    }
+
+    private fun mayAsk(player: Player): Boolean {
+        val now = System.currentTimeMillis()
+        if (now - (asked[player.objectId] ?: 0L) < ASK_COOLDOWN_MS) return false
+        asked[player.objectId] = now
+        return true
+    }
+
+    fun summary() = "rumors=${rumors.getAndSet(0)} replies=${replies.getAndSet(0)} answers=${answers.getAndSet(0)}"
+}
