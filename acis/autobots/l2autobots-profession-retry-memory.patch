@@ -0,0 +1,47 @@
+package dev.l2j.autobots.population.quests
+
+import net.sf.l2j.L2DatabaseFactory
+import java.util.logging.Logger
+
+internal data class QuestRetryState(val classId: Int,val quest: String,val until: Long,
+        val x: Int,val y: Int,val z: Int,val stage: String)
+
+/** Failed profession work survives a runner, login or server restart; never stores quest rewards/progress. */
+internal object QuestRetryStore {
+    private val logger=Logger.getLogger(QuestRetryStore::class.java.name)
+
+    fun initialize() {
+        L2DatabaseFactory.getInstance().connection.use { c -> c.createStatement().use {
+            it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_quest_retry (obj_Id INT UNSIGNED NOT NULL, class_id INT NOT NULL, quest_name VARCHAR(96) NOT NULL, retry_at BIGINT NOT NULL, x INT NOT NULL, y INT NOT NULL, z INT NOT NULL, stage VARCHAR(64) NOT NULL, PRIMARY KEY(obj_Id))")
+        } }
+    }
+
+    fun save(id: Int,state: QuestRetryState) {
+        runCatching {
+            L2DatabaseFactory.getInstance().connection.use { c ->
+                c.prepareStatement("INSERT INTO autobot_quest_retry(obj_Id,class_id,quest_name,retry_at,x,y,z,stage) VALUES(?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE class_id=VALUES(class_id),quest_name=VALUES(quest_name),retry_at=VALUES(retry_at),x=VALUES(x),y=VALUES(y),z=VALUES(z),stage=VALUES(stage)").use {
+                    it.setInt(1,id);it.setInt(2,state.classId);it.setString(3,state.quest);it.setLong(4,state.until)
+                    it.setInt(5,state.x);it.setInt(6,state.y);it.setInt(7,state.z);it.setString(8,state.stage);it.executeUpdate()
+                }
+            }
+        }.onFailure { logger.warning("Profession retry write failed for $id: $it") }
+    }
+
+    fun load(id: Int): QuestRetryState? = runCatching {
+        L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("SELECT class_id,quest_name,retry_at,x,y,z,stage FROM autobot_quest_retry WHERE obj_Id=?").use {
+                it.setInt(1,id)
+                it.executeQuery().use { rows ->
+                    if(!rows.next()) null else QuestRetryState(rows.getInt(1),rows.getString(2),rows.getLong(3),
+                            rows.getInt(4),rows.getInt(5),rows.getInt(6),rows.getString(7))
+                }
+            }
+        }
+    }.getOrElse { logger.warning("Profession retry read failed for $id: $it");null }
+
+    fun clear(id: Int) {
+        runCatching { L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("DELETE FROM autobot_quest_retry WHERE obj_Id=?").use { it.setInt(1,id);it.executeUpdate() }
+        } }.onFailure { logger.warning("Profession retry delete failed for $id: $it") }
+    }
+}
