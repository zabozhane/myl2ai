+    /** Books for lessons the character already has the SP for, from an ordinary town shop; the trainer visit follows. */
+    private suspend fun buySpellbooks(player: Player) {
+        val lessons=dev.l2j.autobots.population.skills.SkillLearner.lessons(player).filter { player.sp>=it.correctedCost }
+                .sortedByDescending { offensive(it.id,it.value) }
+        // Only the first attack spell is essential; once one is known the rest are optional purchases.
+        var attackBookOwed=player.skills.values.none { it.isOffensive && it.isMagic && it.isActive }
+        for(node in lessons) {
+            val book=dev.l2j.autobots.population.skills.SkillLearner.bookFor(node)
+            if(book<=0 || !OfflineFarmManager.isActive(player) || player.isDead || Gear.count(player,book)>0) continue
+            val (shop,product)=Market.findProduct(player,book) ?: continue
+            val price=Market.priceWithTax(shop,product)
+            // An attack spell is how a mystic fights at all: its book is essential like healing, the rest is optional.
+            val essential=attackBookOwed && offensive(node.id,node.value)
+            val budget=if(essential) (player.adena-returnFare(player)).coerceAtLeast(0) else optionalBudget(player)
+            if(price>budget) {
+                println("Offline skills: ${player.name} id=${player.objectId} waits book=${product.item.name} price=$price budget=$budget reason=money")
+                continue
+            }
+            if(!approach(player,shop.merchant)) return
+            if(Market.buyFromNpc(player,shop,product,1)) {
+                if(essential) attackBookOwed=false
+                println("Offline skills: ${player.name} id=${player.objectId} bought book=${product.item.name} for $price")
+            }
+        }
+    }
+
+    private fun offensive(id: Int,level: Int): Boolean =
+            net.sf.l2j.gameserver.data.SkillTable.getInstance().getInfo(id,level)?.isOffensive==true
+
