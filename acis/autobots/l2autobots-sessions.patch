diff --git a/src/main/kotlin/dev/l2j/autobots/population/SessionPlan.kt b/src/main/kotlin/dev/l2j/autobots/population/SessionPlan.kt
new file mode 100644
index 0000000..ff91d55
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/SessionPlan.kt
@@ -0,0 +1,169 @@
+package dev.l2j.autobots.population
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import net.sf.l2j.commons.random.Rnd
+import java.time.ZoneId
+import java.time.ZonedDateTime
+import java.util.Random
+
+/**
+ * One play session of a population bot as a chain of segments, like a player who hunts for an hour, goes AFK for a
+ * smoke, sits in a store for a while and hunts again, then walks back to town before logging out.
+ *
+ * Segments end on time or for a reason a player would have: a death, a new level, a town trip that ends with goods to
+ * sell. Each bot has a stable [Style] that sets how long it hunts and how often it takes breaks or trades.
+ * A session is never AFK the whole way: AFK segments are short, never follow each other, and a bot with a pending
+ * goal (a quest) mostly plays and does not open stores.
+ */
+internal class SessionPlan(private val bot: Autobot) {
+
+    enum class Activity { Hunt, Afk, Trade, Home }
+
+    /** How a player likes to spend a session. Crafters are traders; the others are fixed by the object id. */
+    enum class Style { Grinder, Casual, Trader }
+
+    /** What the bot knows when it picks the next segment. */
+    class Context(val hasGoal: Boolean, val canTrade: Boolean, val isCrafter: Boolean)
+
+    var activity: Activity? = null
+        private set
+    private var endsAt = 0L
+    // Hunting time since the last break: the longer, the likelier a break.
+    private var huntingSince = 0L
+    // An event that ended the current segment early, and how it shapes the next choice.
+    private var cause: Cause? = null
+
+    private enum class Cause(val text: String) { Death("died"), LevelUp("new level"), TownTrip("goods to sell after a town trip") }
+
+    private val baseStyle: Style = Random(bot.objectId * STYLE_SEED + 7L).nextInt(100).let {
+        when {
+            it < GRINDER_PERCENT -> Style.Grinder
+            it < GRINDER_PERCENT + TRADER_PERCENT -> Style.Trader
+            else -> Style.Casual
+        }
+    }
+
+    fun style(context: Context): Style = if (context.isCrafter) Style.Trader else baseStyle
+
+    /** True when the current segment ran out, an event cut it short, or none started yet. */
+    fun isOver(): Boolean = activity == null || System.currentTimeMillis() >= endsAt
+
+    /** A death in the middle of hunting: some players take a break or go trade, others just run back. */
+    fun onDeath(context: Context) {
+        val chance = when (style(context)) { Style.Grinder -> 15; Style.Casual -> 45; Style.Trader -> 35 }
+        if (activity == Activity.Hunt && !context.hasGoal && Rnd.get(100) < chance) cut(Cause.Death)
+    }
+
+    /** A new level is a good moment to stretch, look at the skills and the chat. */
+    fun onLevelUp(context: Context) {
+        val chance = when (style(context)) { Style.Grinder -> 5; Style.Casual -> 25; Style.Trader -> 15 }
+        if (activity == Activity.Hunt && Rnd.get(100) < chance) cut(Cause.LevelUp)
+    }
+
+    /** Back in town with goods to sell: a trader may stay behind a store instead of running back to the spot. */
+    fun onTownTrip(context: Context) {
+        val chance = when (style(context)) { Style.Grinder -> 5; Style.Casual -> 15; Style.Trader -> 45 }
+        if (activity == Activity.Hunt && context.canTrade && !context.hasGoal && Rnd.get(100) < chance) cut(Cause.TownTrip)
+    }
+
+    /** Chooses the next segment and returns it. */
+    fun next(context: Context, reason: String = "segment over"): Activity {
+        val previous = activity
+        val weights = weights(previous, context)
+        var roll = Rnd.get(weights.values.sum().coerceAtLeast(1))
+        val chosen = weights.entries.firstOrNull { roll -= it.value; roll < 0 }?.key ?: Activity.Hunt
+        start(chosen, minutes(chosen, previous, context), cause?.text ?: if (previous == null) "session start" else reason)
+        return chosen
+    }
+
+    /** Switches to [next] for [minutes] right away: going home before logout, a store kept after the session. */
+    fun switchTo(next: Activity, minutes: Int, reason: String) = start(next, minutes, reason)
+
+    private fun cut(why: Cause) {
+        cause = why
+        endsAt = 0
+    }
+
+    private fun start(next: Activity, minutes: Int, reason: String) {
+        val now = System.currentTimeMillis()
+        if (AutobotData.settings.populationSessionLog && next != activity) {
+            println("Autobots session: ${bot.name} lv ${bot.level} ${activity ?: "login"} -> $next for $minutes min ($reason)")
+        }
+        if (next == Activity.Hunt && activity != Activity.Hunt) huntingSince = now
+        activity = next
+        endsAt = now + minutes * 60_000L
+        cause = null
+    }
+
+    private fun weights(previous: Activity?, context: Context): Map<Activity, Int> {
+        val style = style(context)
+        val base: Map<Activity, Double> = when (previous) {
+            null -> mapOf(Activity.Hunt to 75.0, Activity.Trade to 15.0, Activity.Afk to 10.0)
+            Activity.Afk -> mapOf(Activity.Hunt to 75.0, Activity.Trade to 25.0)
+            Activity.Trade, Activity.Home -> mapOf(Activity.Hunt to 80.0, Activity.Afk to 20.0)
+            Activity.Hunt -> when (cause) {
+                Cause.TownTrip -> mapOf(Activity.Trade to 100.0)
+                Cause.LevelUp -> mapOf(Activity.Afk to 100.0)
+                Cause.Death -> mapOf(Activity.Hunt to 25.0, Activity.Afk to 45.0, Activity.Trade to 30.0)
+                null -> mapOf(Activity.Hunt to 45.0, Activity.Afk to 35.0, Activity.Trade to 20.0)
+            }
+        }
+        val fatigueHours = if (previous == Activity.Hunt) (System.currentTimeMillis() - huntingSince) / 3_600_000.0 else 0.0
+        return base.mapValues { (activity, weight) ->
+            when (activity) {
+                Activity.Hunt -> weight * when (style) { Style.Grinder -> 1.6; Style.Casual -> 1.0; Style.Trader -> 0.8 }
+                Activity.Afk -> weight * (1 + fatigueHours) * (if (isNight()) 2.0 else 1.0) *
+                        when (style) { Style.Grinder -> 0.5; Style.Casual -> 1.3; Style.Trader -> 1.0 }
+                Activity.Trade -> weight * when (style) { Style.Grinder -> 0.4; Style.Casual -> 1.0; Style.Trader -> 2.5 }
+                Activity.Home -> weight
+            }
+        }.filter { (activity, _) ->
+            when (activity) {
+                Activity.Trade -> context.canTrade && !context.hasGoal
+                // At login or with a goal waiting, a break only comes after some hunting.
+                Activity.Afk -> !context.hasGoal || previous == Activity.Hunt
+                else -> true
+            }
+        }.mapValues { it.value.toInt() }
+    }
+
+    private fun minutes(next: Activity, previous: Activity?, context: Context): Int {
+        val style = style(context)
+        return when (next) {
+            Activity.Hunt -> when (style) {
+                Style.Grinder -> Rnd.get(60, 120)
+                Style.Casual -> Rnd.get(30, 75)
+                Style.Trader -> Rnd.get(20, 50)
+            }
+            Activity.Trade -> if (style == Style.Trader) Rnd.get(30, 90) else Rnd.get(15, 40)
+            Activity.Afk -> {
+                // Right after login, after a new level or with a goal waiting, AFK is just a moment away from the keyboard.
+                val short = previous == null || context.hasGoal || cause == Cause.LevelUp
+                val minutes = if (short) Rnd.get(2, 8) else Rnd.get(3, if (style == Style.Casual) 25 else 15)
+                if (isNight()) minutes * 3 / 2 else minutes
+            }
+            Activity.Home -> HOME_MINUTES
+        }
+    }
+
+    private fun isNight(): Boolean = ZonedDateTime.now(ZoneId.of(AutobotData.settings.populationTimeZone)).hour in NIGHT_HOURS
+
+    companion object {
+        private const val STYLE_SEED = 1_000_033L
+        private const val GRINDER_PERCENT = 30
+        private const val TRADER_PERCENT = 20
+        private val NIGHT_HOURS = 1..5
+        // Long enough to cover the rest of the session; the population manager logs the bot out.
+        private const val HOME_MINUTES = 60
+
+        /** One line for the every-10-minutes log: what the online population is busy with. */
+        fun summary(online: Collection<Autobot>) {
+            val solo = online.filter { !it.isInParty }.mapNotNull { it.life?.activity }
+            val counts = Activity.values().associateWith { activity -> solo.count { it == activity } }
+            println("Autobots session summary: online=${online.size} hunting=${counts[Activity.Hunt]} trading=${counts[Activity.Trade]} " +
+                    "afk=${counts[Activity.Afk]} goingHome=${counts[Activity.Home]} inParty=${online.count { it.isInParty }} " +
+                    "inStore=${online.count { it.isInStoreMode }}")
+        }
+    }
+}
