+package dev.l2j.autobots.autofarm
+
+import com.fasterxml.jackson.annotation.JsonProperty
+
+/** Per character auto hunt settings, shared by all classes of the character. */
+internal data class AutofarmSettings(
+        /** Hunting area radius around the spot where auto hunt was started; also the target search radius. */
+        @JsonProperty("radius") var radius: Int = 1000,
+        @JsonProperty("hpPotionPercent") var hpPotionPercent: Int = 50,
+        @JsonProperty("mpPotionPercent") var mpPotionPercent: Int = 30,
+        @JsonProperty("cpPotionPercent") var cpPotionPercent: Int = 70,
+        /** Sit down to regenerate between fights. */
+        @JsonProperty("rest") var rest: Boolean = true,
+        @JsonProperty("loot") var loot: Boolean = true,
+        @JsonProperty("attackRaids") var attackRaids: Boolean = false,
+        @JsonProperty("disabledSkills") var disabledSkills: MutableSet<Int> = mutableSetOf()
+) {
+    companion object {
+        val RADIUS_OPTIONS = listOf(600, 1000, 1500)
+        const val PERCENT_STEP = 10
+    }
+}
