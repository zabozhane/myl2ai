+package dev.l2j.autobots.autofarm
+
+import net.sf.l2j.gameserver.enums.ShortcutType
+import net.sf.l2j.gameserver.model.Macro
+import net.sf.l2j.gameserver.model.Shortcut
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.network.serverpackets.ShortCutRegister
+
+/**
+ * The Interlude client has no auto hunt button, so every character gets two macros on its shortcut bar once:
+ * one toggles auto hunt, the other opens its settings. A macro the player deletes is not brought back.
+ */
+internal object AutofarmMacros {
+
+    private const val MEMO_KEY = "autofarm_macros"
+    /** Macro command type for a chat line (the client calls it an action: "/attack", text, ".command"). */
+    private const val CMD_TYPE_TEXT = 3
+    private const val MAX_MACROS = 24
+    private const val SHORTCUTS_PER_PAGE = 12
+    private const val SHORTCUT_PAGES = 10
+    private const val CHARACTER_TYPE_PLAYER = 1
+
+    private data class MacroSpec(val name: String, val description: String, val acronym: String, val icon: Int, val command: String)
+
+    private val MACROS = listOf(
+            MacroSpec("AutoHunt", "Auto hunt on/off", "Auto", 1, AutofarmCommandHandler.TOGGLE_COMMAND),
+            MacroSpec("AutoHuntSet", "Auto hunt settings", "Set", 2, AutofarmCommandHandler.MENU_COMMAND)
+    )
+
+    fun ensureOnShortcutBar(player: Player) {
+        if (player.memos.getBool(MEMO_KEY, false)) return
+
+        val macroList = player.macroList
+        if (macroList.macros.size + MACROS.size > MAX_MACROS) {
+            player.sendMessage("Auto hunt: no room for its macros. Type ${AutofarmCommandHandler.TOGGLE_COMMAND} in chat to toggle it.")
+            return
+        }
+
+        // Rightmost free slots of the first bar (F12, F11...), then the next bars.
+        val taken = player.shortcutList.shortcuts.map { it.page * SHORTCUTS_PER_PAGE + it.slot }.toSet()
+        val freeSlots = (0 until SHORTCUT_PAGES).flatMap { page -> (SHORTCUTS_PER_PAGE - 1 downTo 0).map { page * SHORTCUTS_PER_PAGE + it } }
+                .filter { it !in taken }
+
+        MACROS.forEachIndexed { index, spec ->
+            val macro = Macro(0, spec.icon, spec.name, spec.description, spec.acronym,
+                    arrayOf(Macro.MacroCmd(0, CMD_TYPE_TEXT, 0, 0, spec.command)))
+            macroList.registerMacro(macro)
+
+            val slot = freeSlots.getOrNull(index) ?: return@forEachIndexed
+            val shortcut = Shortcut(slot % SHORTCUTS_PER_PAGE, slot / SHORTCUTS_PER_PAGE, ShortcutType.MACRO, macro.id, -1, CHARACTER_TYPE_PLAYER)
+            player.shortcutList.addShortcut(shortcut)
+            player.sendPacket(ShortCutRegister(shortcut))
+        }
+
+        player.memos.set(MEMO_KEY, true)
+        player.sendMessage("Auto hunt: the AutoHunt and AutoHuntSet macros are on your shortcut bar (${AutofarmCommandHandler.TOGGLE_COMMAND} in chat does the same).")
+    }
+}
