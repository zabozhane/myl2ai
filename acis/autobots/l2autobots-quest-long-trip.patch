+    /**
+     * The hop that reaches the NPC, else, across the map (no gatekeeper goes all the way, e.g. Gludio to Giran), a hop
+     * to the town closest to it: from there the next hop completes the trip. Every such hop brings the bot at least
+     * [MIN_LONG_HOP_GAIN] closer, so it never circles between towns.
+     */
+    private fun routeExitFrom(origin: Location,destination: Location,npc: Npc?): dev.l2j.autobots.population.economy.GatekeeperTravel.Offer? =
+            completeExitFrom(origin,destination,npc) ?: if(distance(origin,destination)<=LONG_TRIP) null else
+                dev.l2j.autobots.population.economy.GatekeeperTravel.offersFrom(bot,origin)
+                        .filter { distance(origin,destination)-distance(it.exit,destination)>MIN_LONG_HOP_GAIN }
+                        .minByOrNull { distance(it.exit,destination)+it.price/10.0 }
+
     /** A partial cheap hop is not proof that the quest NPC can actually be reached. */
     private fun completeExitFrom(origin: Location,destination: Location,npc: Npc?): dev.l2j.autobots.population.economy.GatekeeperTravel.Offer? =
             dev.l2j.autobots.population.economy.GatekeeperTravel.offersFrom(bot,origin)
