+    /**
+     * A monster below the deadly margin can still kill this character here (a caster against a fighter,
+     * several at once). The spawn data cannot tell that, so do not send it back to that prey for a while.
+     */
+    private fun rememberDeadlySpots(player: Player,killer: Monster) {
+        val now=System.currentTimeMillis()
+        val keys=HuntingSpots.keysWithNpcNear(player.location(),killer.npcId,DEADLY_SPOT_RADIUS)
+        if(keys.isEmpty()) return
+        val marks=deadlySpots.getOrPut(player.objectId){ConcurrentHashMap()}
+        keys.forEach { marks[it]=now }
