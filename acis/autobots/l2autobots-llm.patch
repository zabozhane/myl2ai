index 0000000..e95cc43
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/BotChatter.kt
@@ -0,0 +1,151 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.GroupFinder
+import dev.l2j.autobots.population.group.Sociability
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.handler.ChatHandler
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Bots talking among themselves where a real player can hear it: in a party with the player, in clan chat, next to
+ * the player, or in the shout of the player's region. Something that happened to a bot (a death, a new level, a raid,
+ * a scam) or plain small talk in a party starts it; the bot says a line and one to three others pick it up.
+ * Nobody reads chat far from players, so it costs nothing there; with a far model (Ollama) it could run everywhere.
+ */
+internal object BotChatter {
+    enum class Channel { Party, Clan, Nearby, Shout }
+
+    private const val MAX_REPLIES = 3
+    private const val TRANSCRIPT_LINES = 8
+
+    private val lastTalk = ConcurrentHashMap<String, Long>()
+    private val hour = AtomicInteger()
+    private var hourStarted = System.currentTimeMillis()
+
+    init {
+        dev.l2j.autobots.population.trade.TradeEvents.scamListeners += dev.l2j.autobots.population.trade.TradeEvents.ScamListener { victim, _, scammerName, what ->
+            if (victim is Autobot) event(victim, "$scammerName scammed you: $what", loud = true)
+        }
+    }
+
+    private val settings get() = AutobotData.settings
+    private val enabled get() = settings.llmBotChatter && settings.llmChat && Llm.near.available
+
+    /** Something worth telling happened to [bot]; [what] is a short English description for the model. */
+    fun event(bot: Autobot, what: String, loud: Boolean = false) {
+        if (!enabled || bot.life == null) return
+        val (channel, listeners) = audience(bot, loud) ?: return
+        start(bot, channel, listeners, "Just now: $what. You may mention it in chat, the way players do (complain, brag, joke).")
+    }
+
+    /** Every population tick: parties with a real player sometimes chat about nothing in particular. */
+    fun tick(online: Collection<Autobot>) {
+        if (!enabled) return
+        online.asSequence()
+                .mapNotNull { it.party }
+                .distinct()
+                .filter { p -> p.members.any { it !is Autobot && it.isOnline } && p.members.count { it is Autobot } >= 2 }
+                .forEach { party ->
+                    if (Rnd.get(100) >= settings.llmBotSmallTalkPercent) return@forEach
+                    val bots = party.members.filterIsInstance<Autobot>().filter { it.life != null && !it.isDead }
+                    val starter = bots.filter { Sociability.of(it) != Sociability.Loner }.randomOrNull() ?: return@forEach
+                    start(starter, Channel.Party, bots - starter,
+                            "A quiet moment while hunting near ${GroupFinder.placeName(starter)}. Say something to the party: " +
+                                    "small talk, a joke, a question about gear, spots, the server, real life, or a comment on how it goes.")
+                }
+    }
+
+    /** Where a real player would hear this bot, and which other bots could answer there. */
+    private fun audience(bot: Autobot, loud: Boolean): Pair<Channel, List<Autobot>>? {
+        val party = bot.party
+        if (party != null && party.members.any { it !is Autobot && it.isOnline }) {
+            return Channel.Party to party.members.filterIsInstance<Autobot>().filter { it !== bot && it.life != null && !it.isDead }
+        }
+        val clan = bot.clan
+        if (clan != null) {
+            val online = clan.onlineMembers
+            if (online.any { it !is Autobot }) return Channel.Clan to online.filterIsInstance<Autobot>().filter { it !== bot && it.life != null }
+        }
+        val range = settings.llmNearRange
+        if (bot.getKnownTypeInRadius(Player::class.java, range).any { it !is Autobot && it.isOnline }) {
+            return Channel.Nearby to bot.getKnownTypeInRadius(Autobot::class.java, range).filter { it !== bot && it.life != null && !it.isDead }
+        }
+        if (loud) {
+            val region = MapRegionData.getInstance().getMapRegion(bot.x, bot.y)
+            val players = World.getInstance().players.filter { it !is Autobot && MapRegionData.getInstance().getMapRegion(it.x, it.y) == region }
+            if (players.isNotEmpty()) return Channel.Shout to World.getInstance().players.filterIsInstance<Autobot>()
+                    .filter { it !== bot && it.life != null && MapRegionData.getInstance().getMapRegion(it.x, it.y) == region }.shuffled().take(20)
+        }
+        return null
+    }
+
+    private fun start(starter: Autobot, channel: Channel, others: List<Autobot>, situation: String) {
+        val key = when (channel) {
+            Channel.Party -> "party:${System.identityHashCode(starter.party)}"
+            Channel.Clan -> "clan:${starter.clanId}"
+            Channel.Nearby -> "near:${starter.x / 3000}:${starter.y / 3000}"
+            Channel.Shout -> "shout:${MapRegionData.getInstance().getMapRegion(starter.x, starter.y)}"
+        }
+        val now = System.currentTimeMillis()
+        if (now - (lastTalk[key] ?: 0L) < settings.llmBotChatMinutes * 60_000L) return
+        synchronized(this) {
+            if (now - hourStarted > 3_600_000L) { hourStarted = now; hour.set(0) }
+            if (hour.get() >= settings.llmBotChatPerHour) return
+            hour.incrementAndGet()
+        }
+        lastTalk[key] = now
+        val where = when (channel) {
+            Channel.Party -> "party chat"
+            Channel.Clan -> "clan chat"
+            Channel.Nearby -> "general chat, people around can read it"
+            Channel.Shout -> "shout chat, the whole region reads it"
+        }
+        CoScopes.generalScope.launch {
+            val transcript = ArrayList<String>()
+            val first = line(starter, "$situation You write in $where.", transcript, mayStaySilent = false) ?: return@launch
+            say(starter, channel, first)
+            transcript += "${starter.name}: $first"
+            val repliers = others.filter { Rnd.get(100) < when (Sociability.of(it)) { Sociability.Loner -> 20; Sociability.Regular -> 50; Sociability.TeamPlayer -> 80 } }
+                    .shuffled().take(Rnd.get(1, MAX_REPLIES))
+            for (bot in repliers) {
+                delay(Rnd.get(4000, 10000).toLong())
+                if (!bot.isOnline) continue
+                val reply = line(bot, "Others are chatting in $where; join in if you have something to say.", transcript, mayStaySilent = true) ?: continue
+                say(bot, channel, reply)
+                transcript += "${bot.name}: $reply"
+            }
+        }
+    }
+
+    private suspend fun line(bot: Autobot, situation: String, transcript: List<String>, mayStaySilent: Boolean): String? {
+        val system = Persona.system(bot, null, situation) +
+                (if (mayStaySilent) " If you have nothing to add, reply with exactly -" else "") +
+                " Write in Russian unless the chat so far is in English."
+        val user = if (transcript.isEmpty()) "(nobody has said anything yet; write your line)"
+                else transcript.takeLast(TRANSCRIPT_LINES).joinToString("\n") + "\n(your line)"
+        val reply = Llm.near.chat(system, listOf(LlmMessage("user", user)), settings.llmMaxReplyTokens, Llm.Purpose.Talk) ?: return null
+        val line = reply.text.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() } ?: return null
+        val clean = line.removePrefix("${bot.name}:").trim().trim('"', '«', '»').take(120)
+        if (clean.isBlank() || clean.trim('.', ' ') == "-") return null
+        return clean
+    }
+
+    private fun say(bot: Autobot, channel: Channel, text: String) {
+        when (channel) {
+            Channel.Party -> bot.partySay(text)
+            Channel.Clan -> if (bot.clan != null) ChatHandler.getInstance().getHandler(4).handleChat(4, bot, null, text)
+            Channel.Nearby -> bot.say(text)
+            Channel.Shout -> bot.shout(text)
+        }
+        Llm.log("${bot.name} (${channel.name.lowercase()}): $text")
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt
new file mode 100644
index 0000000..5d8a10f
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt
@@ -0,0 +1,212 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.GroupChat
+import dev.l2j.autobots.population.group.GroupFinder
+import dev.l2j.autobots.population.group.Sociability
+import dev.l2j.autobots.population.trade.PlayerTrade
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Free talk through the language model: whatever a player says to a bot that the game code has no answer for
+ * (a whisper that is not about trading or joining, party chat that is not a suggestion, a nearby line that
+ * names the bot). Decisions stay in the game code; this only gives the bot a voice. Without a model it does
+ * nothing and the bots stay silent as before.
+ *
+ * Each conversation (bot and player in whispers or nearby, the whole party in party chat) keeps its last lines
+ * for half an hour, so the bot remembers what was just said.
+ */
+internal object BotTalk {
+    private const val HISTORY_LINES = 10
+    private const val HISTORY_TTL_MS = 30 * 60_000L
+    private const val BOT_COOLDOWN_MS = 4000L
+    private const val MAX_INPUT_CHARS = 300
+    private const val MAX_LINE_CHARS = 120
+    private const val SHOUT_EVERY_MS = 15_000L
+    private const val NEARBY_EVERY_MS = 10_000L
+    /** What the model answers when a real player would not reply at all. */
+    private const val SILENCE = "-"
+
+    private class Conversation {
+        val lines = ArrayList<LlmMessage>()
+        var touched = System.currentTimeMillis()
+    }
+
+    private val conversations = ConcurrentHashMap<String, Conversation>()
+    private val lastSpoke = ConcurrentHashMap<Int, Long>()
+
+    // Talk always involves a real player, so it goes to the near (smarter) model.
+    private val enabled get() = AutobotData.settings.llmChat && Llm.near.available
+
+    /**
+     * A whisper the keyword rules of trading and grouping did not take. The model first reads whether it is a
+     * request after all ("у тебя лук лишний есть?"); then the bot just talks.
+     */
+    fun onWhisper(player: Player, bot: Autobot, text: String) {
+        if (player is Autobot) return
+        Attention.talked(bot, player)
+        if (!Llm.near.available) return
+        CoScopes.generalScope.launch {
+            val russian = GroupChat.isRussian(text)
+            val command = Understand.command(text, Understand.Channel.Whisper)
+            if (command != null && (Persuasion.onWhisper(player, bot, command, russian, text) ||
+                            PlayerTrade.onWhisper(player, bot, command, russian) || GroupChat.onWhisper(player, bot, command, russian))) {
+                Llm.log("understood ${player.name} -> ${bot.name}: '$command'")
+                return@launch
+            }
+            if (!enabled) return@launch
+            val situation = "${player.name} whispers to you in private messages, you are ${activity(bot)}"
+            respond(bot, player, "pm:${bot.objectId}:${player.objectId}", "${player.name}: $text", situation) { bot.tell(player.name, it) }
+        }
+    }
+
+    /** Party chat that was no suggestion by keywords: maybe one in other words, else one bot answers. */
+    fun onPartyChat(player: Player, party: Party, bots: List<Autobot>, text: String) {
+        if (player is Autobot || bots.isEmpty() || !Llm.near.available) return
+        CoScopes.generalScope.launch {
+            val command = Understand.command(text, Understand.Channel.Party)
+            if (command != null) {
+                Llm.log("understood ${player.name} in party: '$command'")
+                GroupChat.onPartyChat(player, command, GroupChat.isRussian(text), understood = true)
+            } else talkInParty(player, party, bots, text)
+        }
+    }
+
+    private fun talkInParty(player: Player, party: Party, bots: List<Autobot>, text: String) {
+        if (!enabled) return
+        val named = bots.firstOrNull { text.contains(it.name, ignoreCase = true) }
+        // Not every line needs an answer: people chat in party without expecting one.
+        if (named == null && Rnd.get(100) >= AutobotData.settings.llmPartyAnswerPercent) {
+            remember("party:${System.identityHashCode(party)}", LlmMessage("user", "${player.name}: $text"))
+            return
+        }
+        val speaker = named ?: bots.random()
+        val members = party.members.joinToString(", ") { "${it.name} (${it.level} ${it.template.className})" }
+        val situation = "party chat; you hunt together with $members near ${GroupFinder.placeName(speaker)}" +
+                (if (party.leader === speaker) ", you lead the party" else "")
+        respond(speaker, player, "party:${System.identityHashCode(party)}", "${player.name}: $text", situation, group = true) { speaker.partySay(it) }
+    }
+
+    /**
+     * Normal chat nearby. A bot named in the line answers; otherwise one bot around may answer if a player in its
+     * place would (the model can stay silent), like people standing next to each other in town.
+     */
+    fun onNearbyChat(player: Player, text: String, nearby: Collection<Autobot>) {
+        if (!enabled || player is Autobot) return
+        val named = nearby.firstOrNull { text.contains(it.name, ignoreCase = true) }
+        if (named != null) {
+            Attention.talked(named, player)
+            val situation = "${player.name} says something to you in general chat nearby, others can see it; you are ${activity(named)}"
+            respond(named, player, "near:${player.objectId}", "${player.name}: $text", situation) { named.say(it) }
+            return
+        }
+        if (!throttle("near:${player.objectId}", NEARBY_EVERY_MS)) return
+        val bot = pickTalkers(nearby, 1).firstOrNull() ?: return
+        Attention.talked(bot, player)
+        val situation = "${player.name}, a player standing near you, says this in general chat to everyone around, not to you in particular; " +
+                "you are ${activity(bot)}"
+        respond(bot, player, "near:${player.objectId}", "${player.name}: $text", situation, group = true, maySkip = true) { bot.say(it) }
+    }
+
+    /**
+     * A player's shout (!) to the whole region. One or two bots of the region may answer, the second seeing the first
+     * one's reply; each can stay silent if a real player would just scroll past.
+     */
+    fun onShout(player: Player, text: String, region: Collection<Autobot>) {
+        if (!enabled || player is Autobot) return
+        if (!throttle("shout:${player.objectId}", SHOUT_EVERY_MS)) return
+        val key = "shout:${player.objectId}"
+        pickTalkers(region, 2).forEachIndexed { i, bot ->
+            CoScopes.generalScope.launch {
+                delay(i * Rnd.get(4000, 9000).toLong())
+                val situation = "${player.name} shouts this to the whole region (shout chat, everyone nearby sees it, people often joke, " +
+                        "argue, ask for help, sell stuff or ask questions there); you are ${activity(bot)}"
+                respond(bot, player, key, "${player.name}: $text", situation, group = true, maySkip = true) { bot.shout(it) }
+            }
+        }
+    }
+
+    /** Who of the bots around feels like talking: sociable ones first, never two answers in a row from one bot. */
+    private fun pickTalkers(bots: Collection<Autobot>, count: Int): List<Autobot> = bots
+            .filter { it.life != null && !it.isDead && (lastSpoke[it.objectId] ?: 0L) < System.currentTimeMillis() - BOT_COOLDOWN_MS }
+            .filter { Rnd.get(100) < when (Sociability.of(it)) { Sociability.Loner -> 15; Sociability.Regular -> 50; Sociability.TeamPlayer -> 90 } }
+            .shuffled().take(count)
+
+    private val throttled = ConcurrentHashMap<String, Long>()
+
+    /** At most one answered line per [everyMs] for this key, so a chatty player does not cost a request a line. */
+    private fun throttle(key: String, everyMs: Long): Boolean {
+        val now = System.currentTimeMillis()
+        val last = throttled[key] ?: 0L
+        if (now - last < everyMs) return false
+        throttled[key] = now
+        return true
+    }
+
+    private fun activity(bot: Autobot): String = when {
+        bot.isInStoreMode -> "sitting in your private store in ${GroupFinder.placeName(bot)}"
+        bot.isInParty -> "hunting in a party near ${GroupFinder.placeName(bot)}"
+        bot.isInCombat -> "fighting monsters near ${GroupFinder.placeName(bot)}"
+        else -> "near ${GroupFinder.placeName(bot)}"
+    }
+
+    private fun respond(bot: Autobot, player: Player, key: String, line: String, situation: String,
+                        group: Boolean = false, maySkip: Boolean = false, send: (String) -> Unit) {
+        val now = System.currentTimeMillis()
+        val previous = lastSpoke[bot.objectId]
+        if (previous != null && now - previous < BOT_COOLDOWN_MS) {
+            remember(key, LlmMessage("user", line.take(MAX_INPUT_CHARS)))
+            return
+        }
+        lastSpoke[bot.objectId] = now
+        val history = remember(key, LlmMessage("user", line.take(MAX_INPUT_CHARS)))
+        CoScopes.generalScope.launch {
+            val started = System.currentTimeMillis()
+            val system = Persona.system(bot, player, situation) +
+                    (if (maySkip) " If a real player in your place would not answer this at all, reply with exactly $SILENCE" else "")
+            val reply = Llm.near.chat(system, history, AutobotData.settings.llmMaxReplyTokens, Llm.Purpose.Talk) ?: return@launch
+            val answer = clean(reply.text, bot.name) ?: return@launch
+            if (answer.trim() == SILENCE || answer.trim().trim('.') == SILENCE) return@launch
+            // Typing takes time: about a second for 15 characters, after reading the line.
+            val typing = 1200L + answer.length * 70L + Rnd.get(0, 1500)
+            delay((typing - (System.currentTimeMillis() - started)).coerceAtLeast(300L))
+            if (!bot.isOnline || !player.isOnline) return@launch
+            // In party chat several bots answer; each sees the others' lines as part of the transcript.
+            remember(key, if (group) LlmMessage("user", "${bot.name}: $answer") else LlmMessage("assistant", answer))
+            send(answer)
+            Llm.log("${bot.name} -> ${player.name}: $answer")
+        }
+    }
+
+    /** Models sometimes quote the line or sign it with the name; chat wants one bare line. */
+    private fun clean(text: String, name: String): String? {
+        var line = text.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() } ?: return null
+        if (line.startsWith("$name:", ignoreCase = true)) line = line.substring(name.length + 1).trim()
+        line = line.trim('"', '«', '»', '“', '”')
+        return line.take(MAX_LINE_CHARS).ifBlank { null }
+    }
+
+    /** Adds a line and returns a copy of the conversation to send. */
+    private fun remember(key: String, message: LlmMessage): List<LlmMessage> {
+        val now = System.currentTimeMillis()
+        if (conversations.size > 500) conversations.entries.removeIf { now - it.value.touched > HISTORY_TTL_MS }
+        val conversation = conversations.compute(key) { _, old -> if (old == null || now - old.touched > HISTORY_TTL_MS) Conversation() else old }!!
+        synchronized(conversation) {
+            conversation.touched = now
+            // Chat models want user and assistant turns; several player lines in a row are merged into one turn.
+            val last = conversation.lines.lastOrNull()
+            if (last != null && last.role == message.role) conversation.lines[conversation.lines.size - 1] = LlmMessage(message.role, last.content + "\n" + message.content)
+            else conversation.lines += message
+            while (conversation.lines.size > HISTORY_LINES) conversation.lines.removeAt(0)
+            while (conversation.lines.firstOrNull()?.role == "assistant") conversation.lines.removeAt(0)
+            return conversation.lines.toList()
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/Decisions.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/Decisions.kt
new file mode 100644
index 0000000..a6c012e
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/Decisions.kt
@@ -0,0 +1,122 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/** One thing the bot may do: a short key the model answers with, what it means, and how often the code picks it. */
+internal class Choice(val key: String, val meaning: String, val usualPercent: Int? = null)
+
+/**
+ * The bot's own decisions through the language model, on the same forks where the game code decides. The code
+ * offers the menu (only what is allowed right now), the model picks by the bot's character and situation, and the
+ * code carries it out. No answer in time, an answer off the menu, or no model for the bot's tier: the code decides
+ * the old way.
+ *
+ * Two ways to ask: [ask] waits (with a timeout) where the code already runs in a coroutine and may wait a few
+ * seconds; [prepare] and [take] ask ahead for forks that must be answered on the spot, like the next session segment.
+ */
+internal object Decisions {
+    private const val ASK_TIMEOUT_MS = 6000L
+    private const val PREPARED_TTL_MS = 5 * 60_000L
+
+    private class Prepared(val choices: List<Choice>, val since: Long = System.currentTimeMillis()) {
+        @Volatile var done = false
+        @Volatile var key: String? = null
+    }
+
+    /** What a prepared question came to: the key, or null when the model gave no usable answer. */
+    class Taken(val key: String?)
+
+    private val prepared = ConcurrentHashMap<String, Prepared>()
+
+    private val asked = AtomicInteger()
+    private val chosen = AtomicInteger()
+    private val fallback = AtomicInteger()
+
+    /** The model is on for this bot now (its tier is configured and not paused). */
+    fun usable(bot: Autobot): Boolean = AutobotData.settings.llmDecisions && Llm.tier(Attention.tier(bot)).available
+
+    /** Asks and waits; null means the code decides. */
+    suspend fun ask(bot: Autobot, kind: String, situation: String, choices: List<Choice>, timeoutMs: Long = ASK_TIMEOUT_MS): String? {
+        if (choices.size < 2 || !usable(bot)) return null
+        val key = withTimeoutOrNull(timeoutMs) { query(bot, kind, situation, choices) }
+        if (key == null) fallback.incrementAndGet()
+        return key
+    }
+
+    /** Starts asking ahead; does nothing when a question of this kind is already out or the model is off. */
+    fun prepare(bot: Autobot, kind: String, situation: () -> String, choices: List<Choice>) {
+        if (choices.size < 2 || !usable(bot)) return
+        val id = "${bot.objectId}:$kind"
+        val existing = prepared[id]
+        if (existing != null && System.currentTimeMillis() - existing.since < PREPARED_TTL_MS) return
+        val question = Prepared(choices)
+        prepared[id] = question
+        CoScopes.generalScope.launch {
+            question.key = withTimeoutOrNull(AutobotData.settings.llmTimeoutSeconds * 1000L) { query(bot, kind, situation(), choices) }
+            question.done = true
+        }
+    }
+
+    /**
+     * The prepared answer, if the question is settled: null while nothing was asked or it is still out.
+     * @param allowed keys the code allows now; an answer outside them counts as no answer.
+     */
+    fun take(bot: Autobot, kind: String, allowed: Collection<String>): Taken? {
+        val id = "${bot.objectId}:$kind"
+        val question = prepared[id] ?: return null
+        if (!question.done) {
+            if (System.currentTimeMillis() - question.since < PREPARED_TTL_MS) return null
+            prepared.remove(id)
+            return null
+        }
+        prepared.remove(id)
+        val key = question.key?.takeIf { it in allowed }
+        if (key == null) fallback.incrementAndGet()
+        return Taken(key)
+    }
+
+    /** True while a prepared question of this kind is out. */
+    fun pending(bot: Autobot, kind: String): Boolean = prepared["${bot.objectId}:$kind"]?.done == false
+
+    private suspend fun query(bot: Autobot, kind: String, situation: String, choices: List<Choice>): String? {
+        val tier = Attention.tier(bot)
+        asked.incrementAndGet()
+        val system = buildString {
+            append(Persona.identity(bot))
+            append("You decide what your character does next, the way this player would, true to the character. ")
+            append("Answer with exactly one option key from the list and nothing else.")
+        }
+        val question = buildString {
+            append("Situation: $situation\n")
+            append("Options:\n")
+            choices.forEach { c ->
+                append("${c.key} - ${c.meaning}")
+                if (c.usualPercent != null) append(" (players like you pick this about ${c.usualPercent}% of the time)")
+                append('\n')
+            }
+            append("Your choice (key only):")
+        }
+        val reply = Llm.tier(tier).chat(system, listOf(LlmMessage("user", question)), 16, Llm.Purpose.Decision) ?: return null
+        val key = parseKey(reply.text, choices)
+        if (key != null) {
+            chosen.incrementAndGet()
+            Llm.log("decision ${bot.name} ($tier) $kind -> $key")
+        } else Llm.log("decision ${bot.name} ($tier) $kind: answer off the menu '${reply.text.take(40)}'")
+        return key
+    }
+
+    /** The option key in a model's answer, the longest match first ("BOSS12" before "BOSS1"); null when none. */
+    fun parseKey(text: String, choices: List<Choice>): String? {
+        val answer = text.uppercase()
+        return choices.map { it.key }.sortedByDescending { it.length }
+                .firstOrNull { Regex("(?<![A-Z0-9_])${Regex.escape(it.uppercase())}(?![A-Z0-9_])").containsMatchIn(answer) }
+    }
+
+    fun summary(): String = "asked ${asked.getAndSet(0)}, chosen ${chosen.getAndSet(0)}, left to the code ${fallback.getAndSet(0)}"
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt
new file mode 100644
index 0000000..deadeac
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt
@@ -0,0 +1,212 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import java.io.File
+import java.time.Duration
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.format.DateTimeFormatter
+import java.util.ArrayDeque
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * The bots' language models, in two tiers. Bots a real player can see or talks to ([Attention.isNear]) think with
+ * the near model (by default OpenAI through the API: smart, paid); all the others with the far model (by default
+ * off, later a local Ollama: free, simpler). A tier that is off, paused after errors or over its limits answers
+ * nothing, and the game code decides and talks the old way.
+ *
+ * API keys never live in the repository: they come from the environment (`OPENAI_API_KEY`, or `LLM_API_KEY` for
+ * other vendors), which docker-compose fills from the untracked `llm.env`.
+ */
+internal object Llm {
+    enum class Tier { Near, Far }
+
+    /** What a call is for, so the summary shows where the tokens go. */
+    enum class Purpose { Talk, Understand, Decision }
+
+    // Container output is lost when the container is re-created; the model's lines are also kept in log/llm.log,
+    // which docker-compose maps to logs/game/llm.log on the host.
+    private val file = File("log/llm.log")
+    private val stamp = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")
+
+    private fun write(line: String) {
+        println(line)
+        try {
+            synchronized(file) { file.parentFile?.mkdirs(); file.appendText("${LocalDateTime.now().format(stamp)} $line\n") }
+        } catch (_: Exception) {
+        }
+    }
+
+    val near = LlmTier("near")
+    val far = LlmTier("far")
+
+    fun tier(tier: Tier) = if (tier == Tier.Near) near else far
+
+    fun log(message: String) {
+        if (AutobotData.settings.llmLog) write("Autobots llm: $message")
+    }
+
+    /** Every 10 minutes with the other summaries; counters restart after each. */
+    fun summary() {
+        val parts = listOfNotNull(near.summary(), far.summary())
+        if (parts.isNotEmpty()) write("Autobots llm summary: ${parts.joinToString("; ")}; decisions ${Decisions.summary()}")
+    }
+}
+
+/** One model with its own limits and circuit breaker. */
+internal class LlmTier(val name: String) {
+    private val failuresToPause = 3
+    private val pauseMs = 10 * 60_000L
+
+    @Volatile private var provider: LlmProvider? = null
+    @Volatile private var initialized = false
+    private var inFlight = Semaphore(1)
+
+    private val recent = ArrayDeque<Long>()
+    private var day: LocalDate = LocalDate.now()
+    private var today = 0
+
+    // A dead key or network fails every call; after a few in a row the tier rests and bots fall back to the code.
+    private val failedInRow = AtomicInteger()
+    @Volatile private var pausedUntil = 0L
+
+    /** Requests and tokens per purpose for the 10-minute window, and the day's totals for the cost. */
+    private class Usage {
+        val requests = AtomicInteger()
+        val inputTokens = AtomicLong()
+        val outputTokens = AtomicLong()
+    }
+    private val window = Llm.Purpose.values().associateWith { Usage() }
+    private val todayInput = AtomicLong()
+    private val todayOutput = AtomicLong()
+
+    private val requests = AtomicInteger()
+    private val failures = AtomicInteger()
+    private val dropped = AtomicInteger()
+    private val inputTokens = AtomicLong()
+    private val outputTokens = AtomicLong()
+    private val latencyMs = AtomicLong()
+
+    /** A provider is configured (it may still be paused after errors). */
+    val enabled: Boolean get() = current() != null
+
+    /** The model can be asked right now: configured and not paused. Limits are checked per call. */
+    val available: Boolean get() = current() != null && System.currentTimeMillis() >= pausedUntil
+
+    /** Asks the model; null when it is off, paused, over a limit or failed. Suspends, never blocks a thread. */
+    suspend fun chat(system: String, messages: List<LlmMessage>, maxTokens: Int, purpose: Llm.Purpose): LlmReply? {
+        val provider = current() ?: return null
+        if (System.currentTimeMillis() < pausedUntil) return null
+        if (!takeSlot()) {
+            dropped.incrementAndGet()
+            return null
+        }
+        return inFlight.withPermit {
+            val started = System.currentTimeMillis()
+            requests.incrementAndGet()
+            val reply = provider.chat(system, messages, maxTokens)
+            latencyMs.addAndGet(System.currentTimeMillis() - started)
+            if (reply == null) {
+                failures.incrementAndGet()
+                if (failedInRow.incrementAndGet() >= failuresToPause) {
+                    failedInRow.set(0)
+                    pausedUntil = System.currentTimeMillis() + pauseMs
+                    Llm.log("$name: $failuresToPause failed calls in a row, paused for ${pauseMs / 60_000} min; its bots decide and talk the old way")
+                }
+            } else {
+                failedInRow.set(0)
+                inputTokens.addAndGet(reply.inputTokens.toLong())
+                outputTokens.addAndGet(reply.outputTokens.toLong())
+                window.getValue(purpose).let {
+                    it.requests.incrementAndGet()
+                    it.inputTokens.addAndGet(reply.inputTokens.toLong())
+                    it.outputTokens.addAndGet(reply.outputTokens.toLong())
+                }
+                todayInput.addAndGet(reply.inputTokens.toLong())
+                todayOutput.addAndGet(reply.outputTokens.toLong())
+            }
+            reply
+        }
+    }
+
+    @Synchronized
+    private fun takeSlot(): Boolean {
+        val config = config()
+        val now = System.currentTimeMillis()
+        if (LocalDate.now() != day) { day = LocalDate.now(); today = 0; todayInput.set(0); todayOutput.set(0) }
+        while (recent.isNotEmpty() && recent.peekFirst() < now - 60_000L) recent.pollFirst()
+        if (config.perMinute > 0 && recent.size >= config.perMinute) return false
+        if (config.perDay > 0 && today >= config.perDay) return false
+        recent.addLast(now)
+        today++
+        return true
+    }
+
+    private class Config(val provider: String, val model: String, val baseUrl: String, val reasoningEffort: String,
+                         val perMinute: Int, val perDay: Int, val parallel: Int, val priceIn: Double, val priceOut: Double)
+
+    private fun config(): Config = AutobotData.settings.let {
+        if (name == "near") Config(it.llmNearProvider, it.llmNearModel, it.llmNearBaseUrl, it.llmNearReasoningEffort,
+                it.llmNearMaxRequestsPerMinute, it.llmNearMaxRequestsPerDay, it.llmNearParallel,
+                it.llmNearPriceInputPerMillion, it.llmNearPriceOutputPerMillion)
+        else Config(it.llmFarProvider, it.llmFarModel, it.llmFarBaseUrl, it.llmFarReasoningEffort,
+                it.llmFarMaxRequestsPerMinute, it.llmFarMaxRequestsPerDay, it.llmFarParallel,
+                it.llmFarPriceInputPerMillion, it.llmFarPriceOutputPerMillion)
+    }
+
+    private fun current(): LlmProvider? {
+        if (!initialized) synchronized(this) {
+            if (!initialized) {
+                val config = config()
+                inFlight = Semaphore(config.parallel.coerceAtLeast(1))
+                provider = create(config)
+                initialized = true
+                Llm.log("$name model " + (provider?.let { "on: ${it.name} ${config.model}, " +
+                        "up to ${if (config.perMinute > 0) config.perMinute else "any"}/min and ${if (config.perDay > 0) config.perDay else "any"}/day" } ?: "off"))
+            }
+        }
+        return provider
+    }
+
+    private fun create(config: Config): LlmProvider? {
+        val kind = config.provider.trim().lowercase()
+        val timeout = Duration.ofSeconds(AutobotData.settings.llmTimeoutSeconds.toLong())
+        val key = System.getenv("LLM_API_KEY")?.takeIf { it.isNotBlank() } ?: System.getenv("OPENAI_API_KEY")?.takeIf { it.isNotBlank() }
+        return when (kind) {
+            "", "off", "none" -> null
+            "openai" -> if (key == null) {
+                Llm.log("$name: provider openai but OPENAI_API_KEY is not set (put it in llm.env next to docker-compose.yml)")
+                null
+            } else OpenAiCompatibleProvider("openai", config.baseUrl.ifBlank { "https://api.openai.com/v1" }, key, config.model, config.reasoningEffort, timeout)
+            // Ollama on the Docker host: http://host.docker.internal:11434/v1, no key.
+            "ollama" -> OpenAiCompatibleProvider("ollama", config.baseUrl.ifBlank { "http://host.docker.internal:11434/v1" }, null, config.model, config.reasoningEffort, timeout)
+            // Any other vendor with an OpenAI-compatible API: base URL, LLM_API_KEY and model.
+            "compatible" -> if (config.baseUrl.isBlank()) { Llm.log("$name: provider compatible but its base URL is empty"); null }
+                else OpenAiCompatibleProvider("compatible", config.baseUrl, key, config.model, config.reasoningEffort, timeout)
+            else -> { Llm.log("$name: unknown provider '$kind' (off, openai, ollama, compatible)"); null }
+        }
+    }
+
+    fun summary(): String? {
+        if (current() == null) return null
+        val count = requests.getAndSet(0)
+        val latency = latencyMs.getAndSet(0)
+        val config = config()
+        fun cost(input: Long, output: Long) = (input * config.priceIn + output * config.priceOut) / 1_000_000.0
+        val byPurpose = window.entries.filter { it.value.requests.get() > 0 }.joinToString(", ") { (purpose, usage) ->
+            val input = usage.inputTokens.getAndSet(0)
+            val output = usage.outputTokens.getAndSet(0)
+            "${purpose.name.lowercase()} ${usage.requests.getAndSet(0)} req $input/$output tok"
+        }.ifEmpty { "nothing" }
+        val todayCost = cost(todayInput.get(), todayOutput.get())
+        return "$name [$byPurpose] " +
+                (if (config.priceIn > 0 || config.priceOut > 0) "today tokens ${todayInput.get()}/${todayOutput.get()} ~$${"%.4f".format(java.util.Locale.ROOT, todayCost)}, " else "") +
+                "requests $count, failed ${failures.getAndSet(0)}, dropped by limits ${dropped.getAndSet(0)}, " +
+                "tokens in ${inputTokens.getAndSet(0)} out ${outputTokens.getAndSet(0)}, avg ${if (count > 0) latency / count else 0} ms, " +
+                (if (System.currentTimeMillis() < pausedUntil) "PAUSED after errors, " else "") +
+                "today ${synchronized(this) { today }}" + config().perDay.let { if (it > 0) "/$it" else "" }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/LlmProvider.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/LlmProvider.kt
new file mode 100644
index 0000000..8294509
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/LlmProvider.kt
@@ -0,0 +1,19 @@
+package dev.l2j.autobots.population.llm
+
+/** One line of a conversation as chat models take it: role is "user" or "assistant". */
+internal data class LlmMessage(val role: String, val content: String)
+
+/** What a model answered and what it cost in tokens. */
+internal class LlmReply(val text: String, val inputTokens: Int, val outputTokens: Int)
+
+/**
+ * A language model behind the bots' heads. Swapping OpenAI for a local model (Ollama) or another vendor is a new
+ * implementation and a line in `config.xml`; nothing that talks through [Llm] knows which one answers.
+ * Implementations never block a game thread: [chat] suspends on the network call.
+ */
+internal interface LlmProvider {
+    val name: String
+
+    /** @return the model's answer, or null when the call failed (the reason is logged). */
+    suspend fun chat(system: String, messages: List<LlmMessage>, maxTokens: Int): LlmReply?
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/OpenAiCompatibleProvider.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/OpenAiCompatibleProvider.kt
new file mode 100644
index 0000000..01ddb14
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/OpenAiCompatibleProvider.kt
@@ -0,0 +1,82 @@
+package dev.l2j.autobots.population.llm
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.fasterxml.jackson.databind.node.ObjectNode
+import kotlinx.coroutines.future.await
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.time.Duration
+
+/**
+ * The OpenAI Chat Completions API. Ollama, LM Studio, vLLM and most vendors speak the same protocol at their own
+ * base URL, so one class covers them; only the URL, the key and the model differ.
+ * @param reasoningEffort sent as `reasoning_effort` for reasoning models (GPT-5 family); empty sends nothing.
+ */
+internal class OpenAiCompatibleProvider(
+        override val name: String,
+        baseUrl: String,
+        private val apiKey: String?,
+        private val model: String,
+        reasoningEffort: String,
+        private val timeout: Duration
+) : LlmProvider {
+    private val endpoint = URI.create(baseUrl.trimEnd('/') + "/chat/completions")
+    private val client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build()
+    private val json = ObjectMapper()
+    // A model that rejects reasoning_effort (gpt-4.1, most local models) is retried without it, once for good.
+    @Volatile private var reasoningEffort = reasoningEffort.trim()
+
+    override suspend fun chat(system: String, messages: List<LlmMessage>, maxTokens: Int): LlmReply? {
+        val response = post(body(system, messages, maxTokens)) ?: return null
+        if (response.statusCode() == 400 && reasoningEffort.isNotEmpty() && response.body().contains("reasoning")) {
+            Llm.log("model $model does not take reasoning_effort=$reasoningEffort, sending without it")
+            reasoningEffort = ""
+            return chat(system, messages, maxTokens)
+        }
+        if (response.statusCode() != 200) {
+            Llm.log("$name answered HTTP ${response.statusCode()}: ${response.body().take(300).replace('\n', ' ')}")
+            return null
+        }
+        return try {
+            val root = json.readTree(response.body())
+            val text = root.path("choices").path(0).path("message").path("content").asText("").trim()
+            val usage = root.path("usage")
+            if (text.isEmpty()) {
+                Llm.log("$name returned an empty answer (finish_reason=${root.path("choices").path(0).path("finish_reason").asText()})")
+                null
+            } else LlmReply(text, usage.path("prompt_tokens").asInt(0), usage.path("completion_tokens").asInt(0))
+        } catch (e: Exception) {
+            Llm.log("$name answer is not JSON: ${e.message}")
+            null
+        }
+    }
+
+    private fun body(system: String, messages: List<LlmMessage>, maxTokens: Int): String {
+        val root: ObjectNode = json.createObjectNode()
+        root.put("model", model)
+        val list = root.putArray("messages")
+        list.addObject().put("role", "system").put("content", system)
+        messages.forEach { list.addObject().put("role", it.role).put("content", it.content) }
+        // Reasoning models spend part of the budget thinking even at low effort; leave them room.
+        root.put("max_completion_tokens", if (reasoningEffort.isEmpty() || reasoningEffort == "none" || reasoningEffort == "minimal") maxTokens else maxTokens + 1000)
+        if (reasoningEffort.isNotEmpty()) root.put("reasoning_effort", reasoningEffort)
+        return json.writeValueAsString(root)
+    }
+
+    private suspend fun post(body: String): HttpResponse<String>? {
+        val request = HttpRequest.newBuilder(endpoint)
+                .timeout(timeout)
+                .header("Content-Type", "application/json")
+                .apply { if (!apiKey.isNullOrBlank()) header("Authorization", "Bearer $apiKey") }
+                .POST(HttpRequest.BodyPublishers.ofString(body))
+                .build()
+        return try {
+            client.sendAsync(request, HttpResponse.BodyHandlers.ofString()).await()
+        } catch (e: Exception) {
+            Llm.log("$name is unreachable at $endpoint: ${e.javaClass.simpleName} ${e.message ?: ""}")
+            null
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/Persona.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/Persona.kt
new file mode 100644
index 0000000..3e252e2
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/Persona.kt
@@ -0,0 +1,98 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.population.economy.Temper
+import dev.l2j.autobots.population.economy.TradeTemper
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.population.group.Sociability
+import dev.l2j.autobots.population.raid.Manners
+import dev.l2j.autobots.population.trade.Honesty
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Who a bot is when it talks: its character traits (fixed by the object id, the same ones that drive its trading,
+ * grouping and enchanting) turned into a short system prompt, plus a typing manner of its own. The model only
+ * gives the bot a voice; what the bot does is still decided by the game code, so the prompt forbids promises.
+ */
+internal object Persona {
+
+    /** How a bot types; fixed per bot so it is recognisable. */
+    private enum class Manner(val rule: String) {
+        Lazy("you type all lowercase, no punctuation, drop words, like 'да норм ща'"),
+        Sloppy("you type fast with occasional typos and no capital letters"),
+        Smiley("you type casually and often end with ')' or ':D'"),
+        Proper("you type in short normal sentences, still informal"),
+        Terse("you answer with one to three words when you can");
+
+        companion object {
+            fun of(bot: Player): Manner = values()[Math.floorMod(bot.objectId * 40503 + 5, values().size)]
+        }
+    }
+
+    /** Who the bot is and what it is like, shared by talking and deciding. */
+    fun identity(bot: Autobot): String {
+        val traits = mutableListOf<String>()
+        traits += when (Sociability.of(bot)) {
+            Sociability.Loner -> "a loner who prefers to play solo and is a bit curt with strangers"
+            Sociability.Regular -> "friendly enough, chats when there is time"
+            Sociability.TeamPlayer -> "sociable, likes parties and small talk"
+        }
+        traits += when (Temper.of(bot.objectId)) {
+            Temper.Cautious -> "cautious, never risks gear on enchanting"
+            Temper.Normal -> "takes reasonable risks"
+            Temper.Gambler -> "a gambler who loves enchanting and risky plays"
+        }
+        val greed = TradeTemper.greed(bot)
+        if (greed > 0.7) traits += "greedy about adena and prices"
+        else if (greed < 0.3) traits += "easy-going about money"
+        if (Manners.of(bot) == Manners.Rude) traits += "rude and cocky, teases people"
+        when (Honesty.of(bot)) {
+            Honesty.Scammer -> traits += "secretly a scammer: you talk smoothly and sweet, and like to sound generous"
+            Honesty.Opportunist -> traits += "looks after yourself first"
+            Honesty.Honest -> {}
+        }
+
+        return "You are ${bot.name}, a ${sex(bot)} ${bot.race.name.lowercase()} ${bot.template.className} of level ${bot.level} " +
+                "playing Lineage 2 Interlude on a small private server. You are a real player at the keyboard, never an AI, a bot or an assistant.\n" +
+                "Character: ${traits.joinToString("; ")}.\n"
+    }
+
+    fun system(bot: Autobot, other: Player?, situation: String): String {
+        val relation = other?.let { relationText(bot, it) }
+        return buildString {
+            append(identity(bot))
+            append("If someone asks whether you are a bot, laugh it off like a player would.\n")
+            append("Typing manner: ${Manner.of(bot).rule}.\n")
+            append("Right now: $situation.\n")
+            if (relation != null) append("About ${other.name}: $relation.\n")
+            append("Rules: answer in the language you were written to (Russian by default), in MMO chat slang. ")
+            append("One short chat line, under 100 characters, no quotes, no emoji pictures, no name prefix. ")
+            append("Do not promise to do anything (follow, give items, go somewhere, invite): ")
+            append("you only chat, your actions happen in the game separately, so answer vaguely if asked. ")
+            append("Don't invent server facts you don't know; say you don't know. Stay in character and in the game world.")
+        }
+    }
+
+    private fun sex(bot: Player) = if (bot.appearance.sex.ordinal == 0) "male" else "female"
+
+    fun relationText(bot: Player, other: Player): String {
+        val relation = Relations.of(bot, other.objectId)
+        val parts = mutableListOf<String>()
+        parts += "level ${other.level} ${other.template.className}"
+        if (relation == null) parts += "you don't know them"
+        else {
+            val affinity = relation.affinity
+            val trust = relation.trust
+            parts += when {
+                affinity >= 30 -> "a friend you often play with"
+                affinity > 0 -> "someone you partied with before"
+                affinity < -20 -> "you dislike them"
+                else -> "you barely know them"
+            }
+            if (trust <= -30) parts += "they cheated you, you don't trust them at all"
+            else if (trust >= 30) parts += "they kept their word in trades"
+        }
+        if (other.karma > 0) parts += "they are a PK (red name)"
+        return parts.joinToString(", ")
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/Persuasion.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/Persuasion.kt
new file mode 100644
index 0000000..eedcedf
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/Persuasion.kt
@@ -0,0 +1,100 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.GroupChat
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.population.group.Sociability
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import java.time.ZoneId
+import java.time.ZonedDateTime
+
+/**
+ * "Stay a bit longer": a bot about to log off says so to the real players it plays with, and they may talk it into
+ * another 20-60 minutes. Whether it agrees is a decision of the language model (by character, hour and the words
+ * used), or of the code by sociability and liking when there is no model. At most twice a session.
+ */
+internal object Persuasion {
+    private val STAY = Regex("(остан(ь|ся|ешься)|не уходи|не ливай|ещ[её] (немного|чуть|часок|пол ?часа|полчасик|полчаса|разок)|давай ещ[её]|" +
+            "поиграй|посиди ещ|куда (ты|уже)|\\bstay\\b|one more|don'?t go|dont leave|don'?t leave|few more|play more|^stay$)", RegexOption.IGNORE_CASE)
+    private const val MAX_TIMES = 2
+    private const val EXTEND_MIN = 20
+    private const val EXTEND_MAX = 60
+
+    private val leavingRu = listOf("всё, мне скоро уходить, ещё минут %d и спать", "я минут через %d ливну", "ещё %d мин и я всё на сегодня")
+    private val leavingEn = listOf("gotta go in about %d min", "i'll log off in %d min", "%d more min and i'm off for today")
+    private val stayRu = listOf("ладно, уговорил, ещё часик", "ну ок, ещё немного посижу", "эх, давай ещё полчасика")
+    private val stayEn = listOf("ok fine, one more hour", "alright, a bit more", "ok, half an hour more")
+    private val leaveRu = listOf("не, правда пора, завтра зайду", "сорри, реально надо идти", "не могу, утром вставать")
+    private val leaveEn = listOf("nah, really gotta go, tomorrow", "sorry, really need to go", "can't, early morning tomorrow")
+
+    /** Called every tick of a population bot: announces the coming logoff to the players it plays with, once. */
+    fun tick(bot: Autobot, minutesLeft: Long, announced: Boolean): Boolean {
+        if (announced) return true
+        val players = bot.party?.members?.filter { it !is Autobot && it.isOnline }.orEmpty()
+        val talker = Attention.lastTalker(bot)
+        if (players.isEmpty() && talker == null) return false
+        val minutes = minutesLeft.coerceIn(2, 20).toInt()
+        CoScopes.generalScope.launch {
+            delay(Rnd.get(1000, 4000).toLong())
+            if (players.isNotEmpty()) bot.partySay((if (GroupChat.isRussian(players.first())) leavingRu else leavingEn).random().format(minutes))
+            else if (talker != null) bot.tell(talker, leavingRu.random().format(minutes))
+        }
+        return true
+    }
+
+    fun onWhisper(player: Player, bot: Autobot, text: String, russian: Boolean = GroupChat.isRussian(text), original: String = text): Boolean {
+        if (player is Autobot || !STAY.containsMatchIn(text) || !wrappingUp(bot)) return false
+        decide(player, bot, original, russian) { bot.tell(player.name, it) }
+        return true
+    }
+
+    /** A party line asking the bots to stay: every bot of the party that is about to leave thinks it over. */
+    fun onPartyChat(player: Player, party: Party, text: String, russian: Boolean, original: String = text): Boolean {
+        if (player is Autobot || !STAY.containsMatchIn(text)) return false
+        val leaving = party.members.filterIsInstance<Autobot>().filter { wrappingUp(it) }
+        if (leaving.isEmpty()) return false
+        leaving.forEach { bot -> decide(player, bot, original, russian) { bot.partySay(it) } }
+        return true
+    }
+
+    private fun wrappingUp(bot: Autobot): Boolean = bot.life?.isWrappingUp() == true
+
+    private fun decide(player: Player, bot: Autobot, words: String, russian: Boolean, say: (String) -> Unit) {
+        val life = bot.life ?: return
+        Attention.talked(bot, player)
+        CoScopes.generalScope.launch {
+            val hour = ZonedDateTime.now(ZoneId.of(AutobotData.settings.populationTimeZone)).hour
+            val night = hour in 0..5
+            val usual = usualPercent(bot, player, night, life.persuadedTimes)
+            val stay = if (life.persuadedTimes >= MAX_TIMES) false else Decisions.ask(bot, "stay",
+                    "It is $hour:00${if (night) " at night" else ""}. You were about to log off for today " +
+                            "(asked to stay ${life.persuadedTimes} times already this session). " +
+                            "${player.name} (${Persona.relationText(bot, player)}) writes: \"${words.take(200)}\"",
+                    listOf(Choice("STAY", "play another 20-60 minutes", usual), Choice("LEAVE", "log off as planned", 100 - usual)))
+                    ?.let { it == "STAY" } ?: (Rnd.get(100) < usual)
+            delay(Rnd.get(1500, 4000).toLong())
+            if (!bot.isOnline) return@launch
+            if (stay) {
+                val minutes = Rnd.get(EXTEND_MIN, EXTEND_MAX)
+                life.persuaded(minutes)
+                say((if (russian) stayRu else stayEn).random())
+                Llm.log("${player.name} talked ${bot.name} into $minutes more min")
+            } else say((if (russian) leaveRu else leaveEn).random())
+        }
+    }
+
+    private fun usualPercent(bot: Autobot, player: Player, night: Boolean, times: Int): Int {
+        val base = when (Sociability.of(bot)) {
+            Sociability.Loner -> 15
+            Sociability.Regular -> 40
+            Sociability.TeamPlayer -> 65
+        }
+        return (base + Relations.affinity(bot, player) / 2 - (if (night) 20 else 0) - times * 20).coerceIn(5, 90)
+    }
+}
