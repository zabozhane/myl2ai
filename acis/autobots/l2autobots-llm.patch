@@ -0,0 +1,33 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Which bots a real player is paying attention to, and so which model tier they think with. A bot is near when a
+ * player is within `llmNearRange`, shares its party, or talked to it in the last 10 minutes.
+ */
+internal object Attention {
+    private const val TALK_MEMORY_MS = 10 * 60_000L
+    private val talkedAt = ConcurrentHashMap<Int, Long>()
+    private val talkedWith = ConcurrentHashMap<Int, String>()
+
+    fun talked(bot: Player, player: Player) {
+        talkedAt[bot.objectId] = System.currentTimeMillis()
+        talkedWith[bot.objectId] = player.name
+    }
+
+    /** The player who whispered or spoke to the bot in the last 10 minutes, if any. */
+    fun lastTalker(bot: Player): String? =
+            talkedWith[bot.objectId]?.takeIf { (talkedAt[bot.objectId] ?: 0L) > System.currentTimeMillis() - TALK_MEMORY_MS }
+
+    fun isNear(bot: Autobot): Boolean {
+        if (bot.party?.members?.any { it !is Autobot } == true) return true
+        if ((talkedAt[bot.objectId] ?: 0L) > System.currentTimeMillis() - TALK_MEMORY_MS) return true
+        return bot.getKnownTypeInRadius(Player::class.java, AutobotData.settings.llmNearRange).any { it !is Autobot && it.isOnline }
+    }
+
+    fun tier(bot: Autobot): Llm.Tier = if (isNear(bot)) Llm.Tier.Near else Llm.Tier.Far
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/BotChatter.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/BotChatter.kt
