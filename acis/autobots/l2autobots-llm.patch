+  <!-- Language models (stage 5), two tiers. Bots a real player can see (llmNearRange), shares a party with or
+       talked to in the last 10 minutes use the near model; all other bots use the far model. A tier that is off,
+       paused after 3 failed calls in a row (10 minutes) or over its limits gives no answer, and its bots decide and
+       talk the old way. Provider: off, openai, ollama (local, OpenAI-compatible API on the Docker host,
+       http://host.docker.internal:11434/v1 unless BaseUrl is set), compatible (any OpenAI-compatible vendor at BaseUrl
+       with LLM_API_KEY). Keys are never in this file: OPENAI_API_KEY comes from llm.env next to docker-compose.yml.
+       Model: any chat model name of the provider. ReasoningEffort goes to reasoning models (none, minimal, low...);
+       empty sends nothing, a model that rejects it is retried without. Limits: requests per minute and per day
+       (0 = no limit); requests over them are dropped, not queued. Parallel: calls in flight at once. -->
+  <llmNearProvider>openai</llmNearProvider>
+  <llmNearModel>gpt-5.4-mini</llmNearModel>
+  <llmNearBaseUrl></llmNearBaseUrl>
+  <llmNearReasoningEffort>none</llmNearReasoningEffort>
+  <llmNearMaxRequestsPerMinute>30</llmNearMaxRequestsPerMinute>
+  <llmNearMaxRequestsPerDay>3000</llmNearMaxRequestsPerDay>
+  <llmNearParallel>4</llmNearParallel>
+  <!-- Price per 1M tokens in dollars, only for the cost estimate in the summary (gpt-5.4-mini: 0.75 in, 4.50 out). -->
+  <llmNearPriceInputPerMillion>0.75</llmNearPriceInputPerMillion>
+  <llmNearPriceOutputPerMillion>4.5</llmNearPriceOutputPerMillion>
+  <llmFarProvider>off</llmFarProvider>
+  <llmFarModel>qwen2.5:7b</llmFarModel>
+  <llmFarBaseUrl></llmFarBaseUrl>
+  <llmFarReasoningEffort></llmFarReasoningEffort>
+  <llmFarMaxRequestsPerMinute>60</llmFarMaxRequestsPerMinute>
+  <llmFarMaxRequestsPerDay>0</llmFarMaxRequestsPerDay>
+  <llmFarParallel>2</llmFarParallel>
+  <llmFarPriceInputPerMillion>0</llmFarPriceInputPerMillion>
+  <llmFarPriceOutputPerMillion>0</llmFarPriceOutputPerMillion>
+  <llmNearRange>2500</llmNearRange>
+  <llmMaxReplyTokens>120</llmMaxReplyTokens>
+  <llmTimeoutSeconds>20</llmTimeoutSeconds>
+  <!-- What the models do. llmChat: bots answer free talk (whispers, party chat, nearby chat that names them) with
+       their character; always the near model, a real player is reading. llmUnderstand: the model reads a request
+       the keyword rules missed ("может посидим, я пустой" = rest) and passes it to the same game code.
+       llmDecisions: bots' own choices go to the model of their tier: the next session segment, accepting a party
+       invite, a party leader's raid and who leaves an overfull party, staying when a player asks. The code offers
+       only what is allowed and checks the answer. llmPartyAnswerPercent: how often a bot answers a party line
+       that names nobody. llmLog prints every answer and decision; the model lines and summaries also go to log/llm.log (logs/game/llm.log on the host). -->
+  <llmChat>true</llmChat>
+  <llmUnderstand>true</llmUnderstand>
+  <llmDecisions>true</llmDecisions>
+  <!-- Bots chatting among themselves where a real player hears it (party with the player, clan, next to the player,
+       shout of the player's region for raids and scams): a death, a new level, a raid, a scam or small talk in a party
+       (llmBotSmallTalkPercent chance every 30 s per party with a player) starts it, 1-3 bots pick it up. At most one
+       conversation per place every llmBotChatMinutes and llmBotChatPerHour in total. -->
+  <llmBotChatter>true</llmBotChatter>
+  <llmBotChatMinutes>3</llmBotChatMinutes>
+  <llmBotChatPerHour>40</llmBotChatPerHour>
+  <llmBotSmallTalkPercent>15</llmBotSmallTalkPercent>
+  <llmPartyAnswerPercent>60</llmPartyAnswerPercent>
+  <llmLog>true</llmLog>
 </settings>
