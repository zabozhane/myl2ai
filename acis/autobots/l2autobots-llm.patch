diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt
new file mode 100644
index 0000000..f3b51e2
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/BotTalk.kt
@@ -0,0 +1,130 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.group.GroupFinder
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Free talk through the language model: whatever a player says to a bot that the game code has no answer for
+ * (a whisper that is not about trading or joining, party chat that is not a suggestion, a nearby line that
+ * names the bot). Decisions stay in the game code; this only gives the bot a voice. Without a model it does
+ * nothing and the bots stay silent as before.
+ *
+ * Each conversation (bot and player in whispers or nearby, the whole party in party chat) keeps its last lines
+ * for half an hour, so the bot remembers what was just said.
+ */
+internal object BotTalk {
+    private const val HISTORY_LINES = 10
+    private const val HISTORY_TTL_MS = 30 * 60_000L
+    private const val BOT_COOLDOWN_MS = 4000L
+    private const val MAX_INPUT_CHARS = 300
+    private const val MAX_LINE_CHARS = 120
+
+    private class Conversation {
+        val lines = ArrayList<LlmMessage>()
+        var touched = System.currentTimeMillis()
+    }
+
+    private val conversations = ConcurrentHashMap<String, Conversation>()
+    private val lastSpoke = ConcurrentHashMap<Int, Long>()
+
+    private val enabled get() = AutobotData.settings.llmChat && Llm.enabled
+
+    /** A whisper no other module took. */
+    fun onWhisper(player: Player, bot: Autobot, text: String) {
+        if (!enabled || player is Autobot) return
+        val situation = buildString {
+            append("${player.name} whispers to you in private messages")
+            append(", you are ").append(activity(bot))
+        }
+        respond(bot, player, "pm:${bot.objectId}:${player.objectId}", "${player.name}: $text", situation) { bot.tell(player.name, it) }
+    }
+
+    /** Party chat that was not a suggestion to the party: one bot answers, the one named or a random one. */
+    fun onPartyChat(player: Player, party: Party, bots: List<Autobot>, text: String) {
+        if (!enabled || player is Autobot || bots.isEmpty()) return
+        val named = bots.firstOrNull { text.contains(it.name, ignoreCase = true) }
+        // Not every line needs an answer: people chat in party without expecting one.
+        if (named == null && Rnd.get(100) >= AutobotData.settings.llmPartyAnswerPercent) {
+            remember("party:${System.identityHashCode(party)}", LlmMessage("user", "${player.name}: $text"))
+            return
+        }
+        val speaker = named ?: bots.random()
+        val members = party.members.joinToString(", ") { "${it.name} (${it.level} ${it.template.className})" }
+        val situation = "party chat; you hunt together with $members near ${GroupFinder.placeName(speaker)}" +
+                (if (party.leader === speaker) ", you lead the party" else "")
+        respond(speaker, player, "party:${System.identityHashCode(party)}", "${player.name}: $text", situation, group = true) { speaker.partySay(it) }
+    }
+
+    /** Normal chat nearby: only a bot addressed by name answers. */
+    fun onNearbyChat(player: Player, text: String, nearby: Collection<Autobot>) {
+        if (!enabled || player is Autobot) return
+        val bot = nearby.firstOrNull { text.contains(it.name, ignoreCase = true) } ?: return
+        val situation = "${player.name} says something to you in general chat nearby, others can see it; you are ${activity(bot)}"
+        respond(bot, player, "near:${bot.objectId}:${player.objectId}", "${player.name}: $text", situation) { bot.say(it) }
+    }
+
+    private fun activity(bot: Autobot): String = when {
+        bot.isInStoreMode -> "sitting in your private store in ${GroupFinder.placeName(bot)}"
+        bot.isInParty -> "hunting in a party near ${GroupFinder.placeName(bot)}"
+        bot.isInCombat -> "fighting monsters near ${GroupFinder.placeName(bot)}"
+        else -> "near ${GroupFinder.placeName(bot)}"
+    }
+
+    private fun respond(bot: Autobot, player: Player, key: String, line: String, situation: String,
+                        group: Boolean = false, send: (String) -> Unit) {
+        val now = System.currentTimeMillis()
+        val previous = lastSpoke[bot.objectId]
+        if (previous != null && now - previous < BOT_COOLDOWN_MS) {
+            remember(key, LlmMessage("user", line.take(MAX_INPUT_CHARS)))
+            return
+        }
+        lastSpoke[bot.objectId] = now
+        val history = remember(key, LlmMessage("user", line.take(MAX_INPUT_CHARS)))
+        CoScopes.generalScope.launch {
+            val started = System.currentTimeMillis()
+            val reply = Llm.chat(Persona.system(bot, player, situation), history) ?: return@launch
+            val answer = clean(reply.text, bot.name) ?: return@launch
+            // Typing takes time: about a second for 15 characters, after reading the line.
+            val typing = 1200L + answer.length * 70L + Rnd.get(0, 1500)
+            delay((typing - (System.currentTimeMillis() - started)).coerceAtLeast(300L))
+            if (!bot.isOnline || !player.isOnline) return@launch
+            // In party chat several bots answer; each sees the others' lines as part of the transcript.
+            remember(key, if (group) LlmMessage("user", "${bot.name}: $answer") else LlmMessage("assistant", answer))
+            send(answer)
+            if (AutobotData.settings.llmLog) println("Autobots llm: ${bot.name} -> ${player.name}: $answer")
+        }
+    }
+
+    /** Models sometimes quote the line or sign it with the name; chat wants one bare line. */
+    private fun clean(text: String, name: String): String? {
+        var line = text.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() } ?: return null
+        if (line.startsWith("$name:", ignoreCase = true)) line = line.substring(name.length + 1).trim()
+        line = line.trim('"', '«', '»', '“', '”')
+        return line.take(MAX_LINE_CHARS).ifBlank { null }
+    }
+
+    /** Adds a line and returns a copy of the conversation to send. */
+    private fun remember(key: String, message: LlmMessage): List<LlmMessage> {
+        val now = System.currentTimeMillis()
+        if (conversations.size > 500) conversations.entries.removeIf { now - it.value.touched > HISTORY_TTL_MS }
+        val conversation = conversations.compute(key) { _, old -> if (old == null || now - old.touched > HISTORY_TTL_MS) Conversation() else old }!!
+        synchronized(conversation) {
+            conversation.touched = now
+            // Chat models want user and assistant turns; several player lines in a row are merged into one turn.
+            val last = conversation.lines.lastOrNull()
+            if (last != null && last.role == message.role) conversation.lines[conversation.lines.size - 1] = LlmMessage(message.role, last.content + "\n" + message.content)
+            else conversation.lines += message
+            while (conversation.lines.size > HISTORY_LINES) conversation.lines.removeAt(0)
+            while (conversation.lines.firstOrNull()?.role == "assistant") conversation.lines.removeAt(0)
+            return conversation.lines.toList()
+        }
+    }
+}
diff --git a/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt b/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt
new file mode 100644
index 0000000..6754e6f
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/llm/Llm.kt
@@ -0,0 +1,119 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import java.time.Duration
+import java.time.LocalDate
+import java.util.ArrayDeque
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * The bots' language model: one shared [LlmProvider] chosen by `llmProvider` in `config.xml`, behind limits that keep
+ * the bill and the server safe. Requests over the per-minute or per-day limit are dropped, not queued: a bot that
+ * cannot think of an answer stays silent like a busy player.
+ *
+ * The API key never lives in the repository: it comes from the environment (`OPENAI_API_KEY`, or `LLM_API_KEY` for
+ * other vendors), which docker-compose fills from the untracked `llm.env`.
+ */
+internal object Llm {
+    private const val MAX_IN_FLIGHT = 4
+
+    @Volatile private var provider: LlmProvider? = null
+    @Volatile private var initialized = false
+    private val inFlight = Semaphore(MAX_IN_FLIGHT)
+
+    private val recent = ArrayDeque<Long>()
+    private var day: LocalDate = LocalDate.now()
+    private var today = 0
+
+    private val requests = AtomicInteger()
+    private val failures = AtomicInteger()
+    private val dropped = AtomicInteger()
+    private val inputTokens = AtomicLong()
+    private val outputTokens = AtomicLong()
+    private val latencyMs = AtomicLong()
+
+    val enabled: Boolean get() = current() != null
+
+    /** Asks the model; null when it is off, over a limit or failed. Suspends, never blocks a thread. */
+    suspend fun chat(system: String, messages: List<LlmMessage>, maxTokens: Int = AutobotData.settings.llmMaxReplyTokens): LlmReply? {
+        val provider = current() ?: return null
+        if (!takeSlot()) {
+            dropped.incrementAndGet()
+            return null
+        }
+        return inFlight.withPermit {
+            val started = System.currentTimeMillis()
+            requests.incrementAndGet()
+            val reply = provider.chat(system, messages, maxTokens)
+            latencyMs.addAndGet(System.currentTimeMillis() - started)
+            if (reply == null) failures.incrementAndGet()
+            else {
+                inputTokens.addAndGet(reply.inputTokens.toLong())
+                outputTokens.addAndGet(reply.outputTokens.toLong())
+            }
+            reply
+        }
+    }
+
+    @Synchronized
+    private fun takeSlot(): Boolean {
+        val settings = AutobotData.settings
+        val now = System.currentTimeMillis()
+        if (LocalDate.now() != day) { day = LocalDate.now(); today = 0 }
+        while (recent.isNotEmpty() && recent.peekFirst() < now - 60_000L) recent.pollFirst()
+        if (recent.size >= settings.llmMaxRequestsPerMinute || today >= settings.llmMaxRequestsPerDay) return false
+        recent.addLast(now)
+        today++
+        return true
+    }
+
+    private fun current(): LlmProvider? {
+        if (!initialized) synchronized(this) {
+            if (!initialized) { provider = create(); initialized = true }
+        }
+        return provider
+    }
+
+    private fun create(): LlmProvider? {
+        val settings = AutobotData.settings
+        val kind = settings.llmProvider.trim().lowercase()
+        val timeout = Duration.ofSeconds(settings.llmTimeoutSeconds.toLong())
+        val key = System.getenv("LLM_API_KEY")?.takeIf { it.isNotBlank() } ?: System.getenv("OPENAI_API_KEY")?.takeIf { it.isNotBlank() }
+        val provider = when (kind) {
+            "", "off", "none" -> null
+            "openai" -> if (key == null) {
+                log("llmProvider is openai but OPENAI_API_KEY is not set (put it in llm.env next to docker-compose.yml), bots talk without the model")
+                null
+            } else OpenAiCompatibleProvider("openai", settings.llmBaseUrl.ifBlank { "https://api.openai.com/v1" }, key, settings.llmModel, settings.llmReasoningEffort, timeout)
+            // Ollama on the Docker host: http://host.docker.internal:11434/v1, no key, no reasoning_effort.
+            "ollama" -> OpenAiCompatibleProvider("ollama", settings.llmBaseUrl.ifBlank { "http://host.docker.internal:11434/v1" }, null, settings.llmModel, "", timeout)
+            // Any other vendor with an OpenAI-compatible API: llmBaseUrl, LLM_API_KEY and llmModel.
+            "compatible" -> if (settings.llmBaseUrl.isBlank()) { log("llmProvider is compatible but llmBaseUrl is empty"); null }
+                else OpenAiCompatibleProvider("compatible", settings.llmBaseUrl, key, settings.llmModel, settings.llmReasoningEffort, timeout)
+            else -> { log("unknown llmProvider '$kind' (off, openai, ollama, compatible)"); null }
+        }
+        log(if (provider == null) "off" else "on: ${provider.name}, model ${settings.llmModel}, " +
+                "up to ${settings.llmMaxRequestsPerMinute}/min and ${settings.llmMaxRequestsPerDay}/day")
+        return provider
+    }
+
+    fun log(message: String) {
+        if (AutobotData.settings.llmLog) println("Autobots llm: $message")
+    }
+
+    /** Every 10 minutes with the other summaries; counters restart after each. */
+    fun summary() {
+        if (current() == null) return
+        val count = requests.getAndSet(0)
+        val failed = failures.getAndSet(0)
+        val skipped = dropped.getAndSet(0)
+        val tokensIn = inputTokens.getAndSet(0)
+        val tokensOut = outputTokens.getAndSet(0)
+        val latency = latencyMs.getAndSet(0)
+        println("Autobots llm summary: requests $count, failed $failed, dropped by limits $skipped, tokens in $tokensIn out $tokensOut, " +
+                "avg ${if (count > 0) latency / count else 0} ms, today ${synchronized(this) { today }}/${AutobotData.settings.llmMaxRequestsPerDay}")
+    }
+}
