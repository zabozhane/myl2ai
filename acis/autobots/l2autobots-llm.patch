@@ -0,0 +1,93 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.population.economy.Temper
+import dev.l2j.autobots.population.economy.TradeTemper
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.population.group.Sociability
+import dev.l2j.autobots.population.raid.Manners
+import dev.l2j.autobots.population.trade.Honesty
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Who a bot is when it talks: its character traits (fixed by the object id, the same ones that drive its trading,
+ * grouping and enchanting) turned into a short system prompt, plus a typing manner of its own. The model only
+ * gives the bot a voice; what the bot does is still decided by the game code, so the prompt forbids promises.
+ */
+internal object Persona {
+
+    /** How a bot types; fixed per bot so it is recognisable. */
+    private enum class Manner(val rule: String) {
+        Lazy("you type all lowercase, no punctuation, drop words, like 'да норм ща'"),
+        Sloppy("you type fast with occasional typos and no capital letters"),
+        Smiley("you type casually and often end with ')' or ':D'"),
+        Proper("you type in short normal sentences, still informal"),
+        Terse("you answer with one to three words when you can");
+
+        companion object {
+            fun of(bot: Player): Manner = values()[Math.floorMod(bot.objectId * 40503 + 5, values().size)]
+        }
+    }
+
+    fun system(bot: Autobot, other: Player?, situation: String): String {
+        val traits = mutableListOf<String>()
+        traits += when (Sociability.of(bot)) {
+            Sociability.Loner -> "a loner who prefers to play solo and is a bit curt with strangers"
+            Sociability.Regular -> "friendly enough, chats when there is time"
+            Sociability.TeamPlayer -> "sociable, likes parties and small talk"
+        }
+        traits += when (Temper.of(bot.objectId)) {
+            Temper.Cautious -> "cautious, never risks gear on enchanting"
+            Temper.Normal -> "takes reasonable risks"
+            Temper.Gambler -> "a gambler who loves enchanting and risky plays"
+        }
+        val greed = TradeTemper.greed(bot)
+        if (greed > 0.7) traits += "greedy about adena and prices"
+        else if (greed < 0.3) traits += "easy-going about money"
+        if (Manners.of(bot) == Manners.Rude) traits += "rude and cocky, teases people"
+        when (Honesty.of(bot)) {
+            Honesty.Scammer -> traits += "secretly a scammer: you talk smoothly and sweet, and like to sound generous"
+            Honesty.Opportunist -> traits += "looks after yourself first"
+            Honesty.Honest -> {}
+        }
+
+        val relation = other?.let { relationText(bot, it) }
+        return buildString {
+            append("You are ${bot.name}, a ${sex(bot)} ${bot.race.name.lowercase()} ${bot.template.className} of level ${bot.level} ")
+            append("playing Lineage 2 Interlude on a small private server. You are a real player at the keyboard, ")
+            append("never an AI, a bot or an assistant; if someone asks whether you are a bot, laugh it off like a player would.\n")
+            append("Character: ${traits.joinToString("; ")}.\n")
+            append("Typing manner: ${Manner.of(bot).rule}.\n")
+            append("Right now: $situation.\n")
+            if (relation != null) append("About ${other.name}: $relation.\n")
+            append("Rules: answer in the language you were written to (Russian by default), in MMO chat slang. ")
+            append("One short chat line, under 100 characters, no quotes, no emoji pictures, no name prefix. ")
+            append("Do not promise to do anything (follow, give items, go somewhere, invite): ")
+            append("you only chat, your actions happen in the game separately, so answer vaguely if asked. ")
+            append("Don't invent server facts you don't know; say you don't know. Stay in character and in the game world.")
+        }
+    }
+
+    private fun sex(bot: Player) = if (bot.appearance.sex.ordinal == 0) "male" else "female"
+
+    private fun relationText(bot: Player, other: Player): String {
+        val relation = Relations.of(bot, other.objectId)
+        val parts = mutableListOf<String>()
+        parts += "level ${other.level} ${other.template.className}"
+        if (relation == null) parts += "you don't know them"
+        else {
+            val affinity = relation.affinity
+            val trust = relation.trust
+            parts += when {
+                affinity >= 30 -> "a friend you often play with"
+                affinity > 0 -> "someone you partied with before"
+                affinity < -20 -> "you dislike them"
+                else -> "you barely know them"
+            }
+            if (trust <= -30) parts += "they cheated you, you don't trust them at all"
+            else if (trust >= 30) parts += "they kept their word in trades"
+        }
+        if (other.karma > 0) parts += "they are a PK (red name)"
+        return parts.joinToString(", ")
+    }
+}
