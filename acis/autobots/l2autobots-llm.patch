@@ -0,0 +1,48 @@
+package dev.l2j.autobots.population.llm
+
+import dev.l2j.autobots.AutobotData
+
+/**
+ * Reads what a player meant when the keyword rules found nothing: the model rewrites free text ("может посидим, я
+ * пустой", "у тебя лук лишний есть?") into one of the short commands the game code already understands ("rest",
+ * "sell bow"), or says it is just talk. The command then goes through the same code as typed keywords, with all its
+ * checks; the model never acts by itself.
+ */
+internal object Understand {
+    enum class Channel(val commands: String) {
+        Whisper("""
+            sell <item in English> - they want to buy an item from you or ask if you have it (e.g. "sell bow", "sell armor")
+            lend me <item in English or adena amount like 5k> - they ask to borrow from you
+            lend you <item in English> - they offer to lend you their item
+            give back - they want back what they lent you
+            invite - they want to join your party
+            stay - they ask you to keep playing, not to log off yet
+        """.trimIndent()),
+        Party("""
+            assist me - they want the party to attack their target
+            rest - they want the party to sit and recover HP/MP
+            buff - they ask for buffs
+            raid - they suggest going for a raid boss
+            change spot - they want to hunt somewhere else
+            brb - they step away for a moment
+            bye - they are leaving the party
+            stay - they ask you to keep playing, not to log off yet
+        """.trimIndent());
+    }
+
+    private const val NONE = "NONE"
+
+    /** @return the command, or null when the line is just talk, the model is off for chat, or it failed. */
+    suspend fun command(text: String, channel: Channel): String? {
+        if (!AutobotData.settings.llmUnderstand || !Llm.near.available) return null
+        val system = "You map a Lineage 2 player's chat message to a game command. Commands:\n${channel.commands}\n" +
+                "Answer with one command exactly as written, filling <...> from the message (item names in English, short), " +
+                "or $NONE if the message is small talk, a question or anything else. Nothing more."
+        val reply = Llm.near.chat(system, listOf(LlmMessage("user", text.take(300))), 24, Llm.Purpose.Understand) ?: return null
+        val line = reply.text.lineSequence().firstOrNull()?.trim()?.trim('"', '.', '\'')?.lowercase() ?: return null
+        if (line.isEmpty() || line.uppercase() == NONE) return null
+        // Only a command from the list is passed on.
+        val verbs = channel.commands.lines().map { it.substringBefore(" -").substringBefore(" <").trim() }
+        return line.takeIf { l -> verbs.any { l == it || l.startsWith("$it ") } }?.take(80)
+    }
+}
