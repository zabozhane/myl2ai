+            dev.l2j.autobots.population.llm.Choice("M${i + 1}", "${m.name}: ${dev.l2j.autobots.population.llm.Persona.relationText(leader, m)}, " +
+                    "role ${Role.of(m.classId).name.lowercase()}${if (m !is Autobot) ", a real player you can see" else ""}", if (i == 0) 70 else 30 / (shown.size - 1))
+        }
+        CoScopes.generalScope.launch {
+            val key = dev.l2j.autobots.population.llm.Decisions.ask(leader, "kick",
+                    "You lead a party of ${party.membersCount}; there are too many of you for this spot and exp per person dropped, " +
+                            "so one member has to go. Who do you ask to leave?", choices)
+            val member = key?.removePrefix("M")?.toIntOrNull()?.let { shown.getOrNull(it - 1) } ?: first
+            if (party.leader === leader && member.party === party) sendAway(party, leader, member)
+        }
+    }
+
+    private fun sendAway(party: Party, leader: Autobot, member: Player) {
         leader.partySay(listOf("${member.name}, sorry, too many of us for this spot", "${member.name}, сорри, нас многовато, опыта мало",
                 "${member.name}, извини, сокращаемся, на всех не хватает", "${member.name} ty for party, we go smaller").random())
         party.removePartyMember(member, MessageType.EXPELLED)
