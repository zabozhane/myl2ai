diff --git a/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineWeaponTrip.kt b/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineWeaponTrip.kt
new file mode 100644
index 0000000..7b50127
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/offlinelife/OfflineWeaponTrip.kt
@@ -0,0 +1,107 @@
+package dev.l2j.autobots.offlinelife
+
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.HuntingSpots
+import dev.l2j.autobots.population.economy.*
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.launch
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.buylist.Product
+import net.sf.l2j.gameserver.model.itemcontainer.Inventory
+import net.sf.l2j.gameserver.model.location.Location
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Semaphore
+import java.util.logging.Logger
+
+/** A funded optional errand is prepared off the farm tick, while the character keeps hunting. */
+internal object OfflineWeaponTrip {
+    data class Plan(val owner: Player,val origin: Location,val home: Location,val level: Int,val weapon: Int,
+                    val shop: Shop,val product: Product,val supplies: Long,val fare: Int,val walk: NpcTravel.Walk,
+                    val createdAt: Long=System.currentTimeMillis())
+    private val plans=ConcurrentHashMap<Int,Plan>()
+    private val retryAt=ConcurrentHashMap<Int,Long>()
+    private val searches=Semaphore(1)
+    private val log=Logger.getLogger(OfflineWeaponTrip::class.java.name)
+
+    fun forget(id: Int) { plans.remove(id);retryAt.remove(id) }
+
+    fun ready(player: Player): Plan? {
+        val now=System.currentTimeMillis()
+        plans.remove(player.objectId)?.let { plan ->
+            if(plan.owner===player && now-plan.createdAt<60_000 && plan.level==player.level &&
+                    plan.weapon==(player.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)?.objectId?:0) &&
+                    distance(plan.origin,player.location())<=500) {
+                val costs=supplyCost(player,plan.home)
+                if(costs!=null) {
+                    val budget=budget(player,costs,plan.fare)
+                    val offer=OfflineEquipment.weaponPurchaseAt(player,budget,plan.home)
+                    if(offer!=null && offer.first.merchant===plan.shop.merchant && offer.second.itemId==plan.product.itemId) return plan.copy(supplies=costs)
+                }
+            }
+        }
+        if(now<(retryAt[player.objectId]?:0L) || !searches.tryAcquire()) return null
+        val request=now+60_000
+        retryAt[player.objectId]=request
+        CoScopes.generalScope.launch {
+            try {
+                project(player)?.let {
+                    if(OfflineFarmManager.isActive(player) && retryAt[player.objectId]==request) plans[player.objectId]=it
+                }
+            } catch(e: Exception) {
+                log.warning("Offline weapon planning failed for ${player.name} id=${player.objectId}: $e")
+            } finally { searches.release() }
+        }
+        return null
+    }
+
+    private fun budget(player: Player,costs: Long,fare: Int): Int =
+            (player.adena.toLong()-Errands.reserve(player)-costs-fare.coerceAtLeast(0)).coerceIn(0L,Int.MAX_VALUE.toLong()).toInt()
+
+    /** The normal supplies bought after the outward trip, including the scroll it consumes. */
+    private fun supplyCost(player: Player,home: Location): Long? {
+        val healing=Healing.count(player)
+        val heals=if(healing<3) {
+            val price=Gear.HEALING_POTIONS.mapNotNull { Market.findProductAt(it,home) }
+                    .map { Market.priceWithTax(it.first,it.second) }.filter { it>0 }.minOrNull() ?: return null
+            (10-healing.coerceAtLeast(0)).toLong()*price
+        } else 0L
+        val escapes=(Gear.count(player,Gear.SCROLL_OF_ESCAPE)-1).coerceAtLeast(0)
+        val scrolls=if(escapes<1) {
+            val offer=Market.findProductAt(Gear.SCROLL_OF_ESCAPE,home) ?: return null
+            val price=Market.priceWithTax(offer.first,offer.second)
+            if(price<=0) return null
+            price.toLong()*if(player.level<20) 1 else 2
+        } else 0L
+        val arrows=if(Gear.isArcher(player) && Gear.count(player,Gear.arrowId(player))<500) {
+            val offer=Market.findProductAt(Gear.arrowId(player),home) ?: return null
+            (1500-Gear.count(player,Gear.arrowId(player))).coerceAtLeast(0).toLong()*Market.priceWithTax(offer.first,offer.second)
+        } else 0L
+        val shots=if(Gear.canBuyShots(player) && Gear.count(player,Gear.shotId(player))<50) {
+            val offer=Market.findProductAt(Gear.shotId(player),home) ?: return null
+            (200-Gear.count(player,Gear.shotId(player))).coerceAtLeast(0).toLong()*Market.priceWithTax(offer.first,offer.second)
+        } else 0L
+        return heals+scrolls+arrows+shots
+    }
+
+    /** Cheap affordability first; a real NPC approach and a finite walking return must then be possible. */
+    internal fun project(player: Player): Plan? {
+        // The first dedicated gear errand covers novice weapons. Graded ammo changes remain a separate cycle.
+        if(player.level>=20) return null
+        val origin=player.location()
+        val home=MapRegionData.getInstance().getLocationToTeleport(player,MapRegionData.TeleportType.TOWN)
+        val level=player.level
+        val weapon=player.inventory.getPaperdollItem(Inventory.PAPERDOLL_RHAND)?.objectId?:0
+        val costs=supplyCost(player,home) ?: return null
+        val offer=OfflineEquipment.weaponPurchaseAt(player,budget(player,costs,0),home) ?: return null
+        val fare=if(HuntingSpots.nearArrival(player,home,emptySet(),20000).isEmpty())
+            HuntRecovery.planFrom(player,home,emptySet())?.exit?.price?:0 else 0
+        if(Market.priceWithTax(offer.first,offer.second)>budget(player,costs,fare)) return null
+        if(NpcTravel.plan(player,offer.first.merchant,home,8000)==null) return null
+        val walk=NpcTravel.toPoint(player,home,origin,60000) ?: return null
+        if(walk.length/player.moveSpeed.coerceAtLeast(30)*2000+15000>15*60_000) return null
+        if(Gear.count(player,Gear.SCROLL_OF_ESCAPE)==0 && dev.l2j.autobots.movement.TownWalk.plan(player,home,60000)==null) return null
+        return Plan(player,origin,home,level,weapon,offer.first,offer.second,costs,fare,walk)
+    }
+}
