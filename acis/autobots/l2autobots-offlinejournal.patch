+    // ---- Journal: what the character did on its own, reported to the owner on login. ----
+
+    /** One finished farm period as the report shows it: gains are precomputed from the snapshots. */
+    private class Period(val id: Long, val started: Long, val ended: Long,
+                         val startLevel: Int, val endLevel: Int, val expGain: Long, val spGain: Int,
+                         val adenaGain: Long, val kills: Int, val deaths: Int, val skills: Int,
+                         val spent: Long, val reason: String)
+
+    /** Opens a journal period for a character that just started its offline farm life. */
+    private fun openJournal(player: Player) {
+        val now = System.currentTimeMillis()
+        val session = runCatching {
+            var rowId = 0L
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement(
+                        "INSERT INTO character_offline_journal(obj_Id, started, start_level, exp_start, sp_start, adena_start) VALUES (?,?,?,?,?,?)",
+                        Statement.RETURN_GENERATED_KEYS).use { ps ->
+                    ps.setInt(1, player.objectId)
+                    ps.setLong(2, now)
+                    ps.setInt(3, player.level)
+                    ps.setLong(4, player.exp.toLong())
+                    ps.setInt(5, player.sp)
+                    ps.setLong(6, player.adena.toLong())
+                    ps.execute()
+                    ps.generatedKeys.use { rs -> if (rs.next()) rowId = rs.getLong(1) }
+                }
+            }
+            JournalSession(rowId, now, player.level, player.exp.toLong(), player.sp, player.adena.toLong(), lastFlushAt = now)
+        }.getOrElse {
+            LOGGER.warning("Offline farm journal open failed for ${player.name}: $it")
+            // rowId 0: the period runs in memory only, no DB writes are attempted for it.
+            JournalSession(0L, now, player.level, player.exp.toLong(), player.sp, player.adena.toLong(), lastFlushAt = now)
+        }
+        journal[player.objectId] = session
+    }
+
+    /** Writes the current snapshot into the journal row; close=true also ends the period. */
+    private fun flushJournal(player: Player, close: Boolean = false, reason: String = "") {
+        val session = journal[player.objectId] ?: return
+        if (session.rowId == 0L) return
+        runCatching {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                val sql = if (close)
+                    "UPDATE character_offline_journal SET end_level=?, exp_end=?, sp_end=?, adena_end=?," +
+                            " kills=?, deaths=?, skills_learned=?, adena_spent=?, ended=?, stop_reason=? WHERE id=?"
+                else
+                    "UPDATE character_offline_journal SET end_level=?, exp_end=?, sp_end=?, adena_end=?," +
+                            " kills=?, deaths=?, skills_learned=?, adena_spent=? WHERE id=?"
+                con.prepareStatement(sql).use { ps ->
+                    ps.setInt(1, player.level)
+                    ps.setLong(2, player.exp.toLong())
+                    ps.setInt(3, player.sp)
+                    ps.setLong(4, player.adena.toLong())
+                    ps.setInt(5, session.kills)
+                    ps.setInt(6, session.deaths)
+                    ps.setInt(7, session.skillsLearned)
+                    ps.setLong(8, session.adenaSpent)
+                    if (close) {
+                        ps.setLong(9, System.currentTimeMillis())
+                        ps.setString(10, reason)
+                        ps.setLong(11, session.rowId)
+                    } else {
+                        ps.setLong(9, session.rowId)
+                    }
+                    ps.execute()
+                }
+            }
+        }.onFailure { LOGGER.warning("Offline farm journal flush failed for ${player.name}: $it") }
+    }
