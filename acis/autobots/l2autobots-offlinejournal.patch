+CREATE TABLE IF NOT EXISTS character_offline_journal (
+  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
+  `obj_Id` INT UNSIGNED NOT NULL DEFAULT 0,
+  `started` BIGINT NOT NULL DEFAULT 0,
+  `ended` BIGINT NULL DEFAULT NULL,
+  `start_level` INT NOT NULL DEFAULT 0,
+  `end_level` INT NULL DEFAULT NULL,
+  `exp_start` BIGINT NOT NULL DEFAULT 0,
+  `exp_end` BIGINT NULL DEFAULT NULL,
+  `sp_start` INT NOT NULL DEFAULT 0,
+  `sp_end` INT NULL DEFAULT NULL,
+  `adena_start` BIGINT NOT NULL DEFAULT 0,
+  `adena_end` BIGINT NULL DEFAULT NULL,
+  `kills` INT NOT NULL DEFAULT 0,
+  `deaths` INT NOT NULL DEFAULT 0,
+  `skills_learned` INT NOT NULL DEFAULT 0,
+  `adena_spent` BIGINT NOT NULL DEFAULT 0,
+  `stop_reason` VARCHAR(32) NULL DEFAULT NULL,
+  `reported` TINYINT NOT NULL DEFAULT 0,
+  PRIMARY KEY (id),
+  KEY `idx_owner` (obj_Id)
+);
