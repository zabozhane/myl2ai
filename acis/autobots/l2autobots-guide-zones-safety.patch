diff --git a/src/main/kotlin/dev/l2j/autobots/population/GuideZones.kt b/src/main/kotlin/dev/l2j/autobots/population/GuideZones.kt
index 926dbeb..90dd2cf 100644
--- a/src/main/kotlin/dev/l2j/autobots/population/GuideZones.kt
+++ b/src/main/kotlin/dev/l2j/autobots/population/GuideZones.kt
@@ -63,5 +63,17 @@ internal object GuideZones {
         }
     }
 
-    fun bonus(player: Player, level: Int, spot: HuntingSpot): Double = if (recommends(player, level, spot.location)) BONUS else 1.0
+    /**
+     * The guides assume a geared player; a resident in starter gear is killed by aggressive monsters of its own
+     * level there (live: Kaboo orcs 10-12 killed elves 11-15 at Elven Forest). Only a spot whose aggressive
+     * monsters stay [SAFE_AGGRO_BELOW] levels under the hunter, and that is not an aggressive nest, is promoted.
+     */
+    fun bonus(player: Player, level: Int, spot: HuntingSpot): Double =
+            if (safeFor(level, spot) && recommends(player, level, spot.location)) BONUS else 1.0
+
+    private const val SAFE_AGGRO_BELOW = 3
+    private const val SAFE_AGGRO_CROWD = 2
+
+    fun safeFor(level: Int, spot: HuntingSpot): Boolean =
+            (spot.dangerLevel == 0 || spot.dangerLevel <= level - SAFE_AGGRO_BELOW) && spot.aggressiveCrowd <= SAFE_AGGRO_CROWD
 }
