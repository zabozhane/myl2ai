     private fun effectiveDistance(spot: HuntingSpot, bot: Player, level: Int, exits: List<TeleportLocation>): Double {
         val direct = distance(bot.location(), spot.location)
-        if (exits.isEmpty() || !GuideZones.recommends(bot, level, spot.location)) return direct
+        if (exits.isEmpty() || !GuideZones.safeFor(level, spot) || !GuideZones.recommends(bot, level, spot.location)) return direct
         val ride = exits.minOfOrNull { distance(it, spot.location) } ?: return direct
         return minOf(direct, ride + GUIDE_RIDE_COST)
     }
