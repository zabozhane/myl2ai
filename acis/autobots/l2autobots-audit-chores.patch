@@ -0,0 +1,92 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+import dev.l2j.autobots.population.RouteSafety
+import kotlin.math.*
+
+/** A route ends beside the NPC, not in its blocked counter/roof geodata cell. */
+internal object NpcTravel {
+    data class Walk(val points: List<Location>, val length: Double)
+
+    fun plan(player: Player,npc: Npc,origin: Location=player.location(),maxDistance: Int=12000): Walk? {
+        if (distance(origin,npc.location())>maxDistance) return null
+        val geo=GeoEngine.getInstance()
+        val candidates=listOfNotNull(Approach.pointNear(player,npc)) + listOf(60,100,130).flatMap { radius ->
+            (0 until 16).map { i ->
+                val a=2*Math.PI*i/16;val x=npc.x+(cos(a)*radius).toInt();val y=npc.y+(sin(a)*radius).toInt()
+                Location(x,y,geo.getHeight(x,y,npc.z).toInt())
+            }
+        }
+        val goals=candidates.filter { abs(it.z-npc.z)<=50 }.distinctBy { Triple(it.x,it.y,it.z) }.sortedBy { distance(origin,it) }.take(12)
+        for (point in goals) {
+            val path=segment(player,origin,point) ?: continue
+            return Walk(path,(listOf(origin)+path).zipWithNext().sumOf { distance(it.first,it.second) })
+        }
+        // The core's largest path buffer covers only a few thousand world units. Solve a longer
+        // walk as a bounded coarse search whose individual links use the real geodata pathfinder.
+        for(point in goals.take(3)) {
+            val route=coarse(player,origin,point,maxDistance) ?: continue
+            return Walk(route,(listOf(origin)+route).zipWithNext().sumOf { distance(it.first,it.second) })
+        }
+        return null
+    }
+
+    private fun segment(player: Player,from: Location,to: Location): List<Location>? {
+        val geo=GeoEngine.getInstance()
+        val path=if(geo.canMoveToTarget(from.x,from.y,from.z,to.x,to.y,to.z)) listOf(to)
+            else geo.findPath(from.x,from.y,from.z,to.x,to.y,to.z,true)?.toList().orEmpty().let { if(it.isEmpty()) it else it+to }
+        if(path.isEmpty()) return null
+        if((listOf(from)+path).zipWithNext().any { !RouteSafety.safeSegment(player,it.first,it.second) }) return null
+        return path
+    }
+
+    private data class Node(val x: Int,val y: Int,val at: Location,val route: List<Location>,val cost: Double)
+    private fun coarse(player: Player,from: Location,to: Location,maxDistance: Int): List<Location>? {
+        val queue=java.util.PriorityQueue<Node>(compareBy { it.cost+distance(it.at,to) })
+        val costs=mutableMapOf<Triple<Int,Int,Int>,Double>()
+        queue.add(Node(0,0,from,emptyList(),0.0))
+        val geo=GeoEngine.getInstance()
+        var expanded=0
+        while(queue.isNotEmpty() && expanded++<160) {
+            val node=queue.poll()
+            if(distance(node.at,to)<=2800) segment(player,node.at,to)?.let { return node.route+it }
+            for(dx in -1..1) for(dy in -1..1) {
+                if(dx==0 && dy==0) continue
+                val nx=node.x+dx;val ny=node.y+dy
+                val x=from.x+nx*800;val y=from.y+ny*800
+                val at=Location(x,y,geo.getHeight(x,y,node.at.z).toInt())
+                if(distance(from,at)>maxDistance || !RouteSafety.safeDestination(player,at)) continue
+                val key=Triple(nx,ny,Math.floorDiv(at.z,200))
+                val lower=node.cost+distance(node.at,at)
+                if(lower>=(costs[key]?:Double.MAX_VALUE)) continue
+                val link=segment(player,node.at,at) ?: continue
+                val cost=node.cost+(listOf(node.at)+link).zipWithNext().sumOf { distance(it.first,it.second) }
+                if(cost>maxDistance*2 || cost>=(costs[key]?:Double.MAX_VALUE)) continue
+                costs[key]=cost
+                queue.add(Node(nx,ny,at,node.route+link,cost))
+            }
+        }
+        return null
+    }
+
+    suspend fun reach(player: Player,npc: Npc,maxDistance: Int=12000): Boolean {
+        if(player.isDead) return false
+        if(player.isSitting) { player.standUp();delay(2700) }
+        if (!npc.isInsideRadius(player,Npc.INTERACTION_DISTANCE,true,false)) {
+            val route=plan(player,npc,maxDistance=maxDistance) ?: return false
+            for(point in route.points) {
+                var failed=false
+                WalkToSequence(player,point,20){failed=true}.definition()
+                if(failed || player.isDead) return false
+            }
+        }
+        return !player.isDead && npc.isInsideRadius(player,Npc.INTERACTION_DISTANCE,true,false)
+    }
+}
