diff --git a/src/main/kotlin/dev/l2j/autobots/population/skills/TrainerTravel.kt b/src/main/kotlin/dev/l2j/autobots/population/skills/TrainerTravel.kt
new file mode 100644
index 0000000..14b9619
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/skills/TrainerTravel.kt
@@ -0,0 +1,32 @@
+package dev.l2j.autobots.population.skills
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.economy.NpcTravel
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.data.xml.TeleportLocationData
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Folk
+import net.sf.l2j.gameserver.model.location.TeleportLocation
+
+/** Walking to a local guild is free; a paid ride is a last resort, and must leave a supply reserve. */
+internal object TrainerTravel {
+    data class Plan(val trainer: Folk,val walk: NpcTravel.Walk,val exit: TeleportLocation?=null)
+
+    fun select(player: Player,excluded: Set<Int> = emptySet()): Plan? {
+        val trainers=World.getInstance().objects.filterIsInstance<Folk>()
+                .filter { it.isVisible && it.template.canTeach(player.classId) && it.objectId !in excluded }
+                .sortedBy { distance(player,it) }
+        for(npc in trainers.filter { distance(player,it)<=12000 }.take(6)) {
+            NpcTravel.plan(player,npc)?.let { return Plan(npc,it) }
+        }
+        val budget=(player.adena-Errands.reserve(player)).coerceAtLeast(0)
+        return trainers.take(8).flatMap { npc ->
+            TeleportLocationData.getInstance().allTeleportLocations.asSequence()
+                    .filter { !it.isNoble && it.price<=budget && distance(it,npc.location())<6000 }
+                    .sortedBy { it.price+distance(it,npc.location())/10 }.take(2)
+                    .mapNotNull { exit -> NpcTravel.plan(player,npc,exit,6000)?.let { Plan(npc,it,exit) } }.toList()
+        }.minByOrNull { (it.exit?.price?:0)+it.walk.length/10 }
+    }
+}
