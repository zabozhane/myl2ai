@@ -0,0 +1,35 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.extensions.getCombatBehavior
+import dev.l2j.autobots.extensions.useItem
+import dev.l2j.autobots.utils.getHealthPercentage
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+
+/** Own potions only: start slow healing early, never stack healing-over-time effects. */
+internal object Healing {
+    private val usedAt=ConcurrentHashMap<Int,Long>()
+    private val effects=listOf(2031,2032,2037)
+    fun count(player: Player): Int = listOf(1060,1061,1539,1540).sumOf { Gear.count(player,it) }
+    fun product(player: Player): Int? = Gear.HEALING_POTIONS.mapNotNull { id ->
+        Market.findProduct(player,id)?.let { (shop,p) -> id to Market.priceWithTax(shop,p) }
+    }.filter { it.second<=player.adena }.minByOrNull { it.second }?.first
+        ?: Gear.HEALING_POTIONS.filter { Market.findProduct(player,it)!=null }.minByOrNull { Market.npcPrice(it)?:Int.MAX_VALUE }
+
+    fun use(player: Player) {
+        if(player !is Autobot || player.isDead) return // live auto-hunt uses the owner's own settings
+        val now=System.currentTimeMillis()
+        if(now-(usedAt[player.objectId]?:0L)<3000) return
+        val hp=player.getHealthPercentage()
+        val prefs=player.getCombatBehavior().combatPreferences
+        val quick=hp<30 && prefs.useQuickHealingPots && Gear.count(player,1540)>0
+        val id=if(quick) 1540 else {
+            if(hp>=60 || effects.any { player.getFirstEffect(it)!=null }) return
+            listOf(1539,1061,1060).firstOrNull { Gear.count(player,it)>0 && (it!=1539 || prefs.useGreaterHealingPots) } ?: return
+        }
+        usedAt[player.objectId]=now
+        player.useItem(id)
+        EconomyLog.note(player,"used healing item $id at ${hp.toInt()}% HP")
+    }
+}
