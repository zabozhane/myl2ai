+package dev.l2j.autobots.movement
+
+/** Progress along waypoints, independent of the moving flag or distance to the final destination. */
+internal class RouteProgress(private val startedAt: Long, private val budgetMs: Long) {
+    private var waypoint = -1
+    private var best = Double.MAX_VALUE
+    private var progressedAt = startedAt
+
+    fun observe(index: Int, remaining: Double, now: Long): String? {
+        if (now - startedAt >= budgetMs) return "journey_timeout"
+        if (index > waypoint) {
+            waypoint = index
+            best = remaining
+            progressedAt = now
+        } else if (remaining < best - 16.0) {
+            best = remaining
+            progressedAt = now
+        }
+        return if (now - progressedAt >= 20_000L) "no_progress" else null
+    }
+}
