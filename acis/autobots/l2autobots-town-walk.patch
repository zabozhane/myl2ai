+package dev.l2j.autobots.movement
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.economy.NpcTravel
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.data.manager.ZoneManager
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.zone.type.TownZone
+
+/** A missing escape scroll can mean a longer walk, never a blind move across the map. */
+internal object TownWalk {
+    const val MAX_DISTANCE=60000
+
+    fun plan(player: Player,destination: Location,maxDistance: Int=MAX_DISTANCE): NpcTravel.Walk? {
+        val origin=player.location()
+        val direct=distance(origin,destination)
+        if(direct>maxDistance || ZoneManager.getInstance().getZone(destination.x,destination.y,destination.z,TownZone::class.java)==null)
+            return null
+        val local=if(direct<=20000) NpcTravel.toPoint(player,origin,destination,minOf(maxDistance,20000)) else null
+        val route=local ?: NpcTravel.toPoint(player,origin,destination,maxDistance) ?: return null
+        return route.takeIf { it.length/player.moveSpeed.coerceAtLeast(30)*2000+15_000<=900_000 }
+    }
+}
