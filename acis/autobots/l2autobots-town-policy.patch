+package dev.l2j.autobots.movement
+
+/** Commute time is not productive hunting. Urgent supplies bypass the optional errand window. */
+internal object TownPolicy {
+    fun reason(heavy: Boolean,healing: Boolean,quest: Boolean,routine: Boolean,training: Boolean,
+               upgrade: Boolean,shots: Boolean,arrows: Boolean,sinceTownMs: Long,productiveMs: Long): String? {
+        if(heavy) return "weight"
+        if(healing) return "healing_stock"
+        if(sinceTownMs<15*60_000L) return null
+        if(training) return "training"
+        if(productiveMs<10*60_000L) return null
+        return when {
+            quest -> "quest_ready"
+            shots -> "shots"
+            arrows -> "arrows"
+            upgrade -> "equipment"
+            routine -> "routine_sale"
+            else -> null
+        }
+    }
+}
