+++ b/src/main/kotlin/dev/l2j/autobots/population/group/ClanPool.kt
@@ -0,0 +1,267 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.trade.Honesty
+import dev.l2j.autobots.population.trade.Loan
+import dev.l2j.autobots.population.trade.Promise
+import dev.l2j.autobots.population.trade.TradeWindow
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.launch
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.pledge.Clan
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Pooling adena in a clan (stage 4b). Once a day a clan picks a goal: the next kit piece of its strongest member
+ * online who can't afford it, or the next clan level (the leader pays the SP, the clan the adena). Members give a
+ * share of what they can spare through the trade window when they meet the recipient (in one town, or in one
+ * party), nothing is moved by hand. The recipient buys the piece on its next town trip; the leader levels the clan
+ * in town. A scamming leader may keep a level pool: the givers' liking and trust drop, and they leave.
+ * Gifts are logged in `autobot_clan_pool`.
+ */
+internal object ClanPool {
+    enum class Goal { Item, Level }
+
+    class Pool(val clanId: Int, val goal: Goal, val recipientId: Int, val itemId: Int, var need: Long, val started: Long) {
+        var collected = 0L
+        val givers = ConcurrentHashMap.newKeySet<Int>()
+    }
+
+    private const val POOL_EVERY_MS = 24 * 60 * 60 * 1000L
+    private const val NO_GOAL_RETRY_MS = 60 * 60 * 1000L
+    private const val POOL_LASTS_MS = 24 * 60 * 60 * 1000L
+    private const val MIN_GIFT = 100
+    private const val MEET_IN_TOWN = 2500
+    private const val MEET_NEARBY = 1500
+    private val LEVEL_SP = intArrayOf(30_000, 150_000)
+    private val LEVEL_ADENA = longArrayOf(650_000, 2_500_000)
+
+    private val pools = ConcurrentHashMap<Int, Pool>()
+    private val nextPool = ConcurrentHashMap<Int, Long>()
+    private val trading = ConcurrentHashMap.newKeySet<Int>()
+    private var tableReady = false
+    private var gifts = 0
+    private var given = 0L
+    private var bought = 0
+    private var levels = 0
+    private var kept = 0
+
+    private val enabled get() = AutobotData.settings.clanPoolEnabled && AutobotData.settings.socialTradeEnabled
+
+    fun active(clanId: Int): Pool? = pools[clanId]
+
+    /** Adena [bot] holds for its clan's level: kept out of its shopping (`Errands.reserve`). */
+    fun reserved(bot: Player): Int {
+        val pool = pools[bot.clanId] ?: return 0
+        return if (pool.goal == Goal.Level && pool.recipientId == bot.objectId) pool.collected.coerceAtMost(Int.MAX_VALUE.toLong()).toInt() else 0
+    }
+
+    fun forget(clanId: Int) {
+        pools.remove(clanId)
+        nextPool.remove(clanId)
+    }
+
+    fun summary() = "pools=${pools.size} gifts=$gifts given=$given funded=$bought levels=$levels kept=$kept"
+
+    fun tick(online: List<Autobot>) {
+        if (!enabled) return
+        val now = System.currentTimeMillis()
+        val byClan = online.filter { it.clanId != 0 && it.life != null }.groupBy { it.clanId }
+        for ((clanId, members) in byClan) {
+            val clan = members.first().clan ?: continue
+            if (!Clans.isBotClan(clan)) continue
+            val pool = pools[clanId]
+            if (pool == null) {
+                if (now >= (nextPool[clanId] ?: 0L)) start(clan, members, now)
+                continue
+            }
+            if (now - pool.started > POOL_LASTS_MS || clan.getClanMember(pool.recipientId) == null) {
+                finish(clan, pool, "expired with ${pool.collected}/${pool.need}")
+                continue
+            }
+            if (completeIfReady(clan, pool) || pool.collected >= pool.need) continue
+            val recipient = members.firstOrNull { it.objectId == pool.recipientId } ?: continue
+            for (giver in members) {
+                if (giver === recipient || giver.objectId in pool.givers || giver.objectId in trading || recipient.objectId in trading) continue
+                if (!meets(giver, recipient)) continue
+                val gift = share(giver, recipient, pool.need - pool.collected)
+                if (gift < MIN_GIFT) {
+                    pool.givers += giver.objectId
+                    continue
+                }
+                give(clan, pool, giver, recipient, gift)
+                break
+            }
+        }
+    }
+
+    /** The goal of the day: the clan level when the leader has the SP and the clan the money, else a kit piece. */
+    private fun start(clan: Clan, online: List<Autobot>, now: Long) {
+        // Nothing to pool for yet: look again in an hour, with other members online.
+        nextPool[clan.clanId] = now + NO_GOAL_RETRY_MS
+        if (online.size < 2) return
+        val leader = online.firstOrNull { it.objectId == clan.leaderId }
+        val reach = online.sumOf { spare(it) * percent(it, leader ?: it) / 100 }
+        if (leader != null && clan.level < LEVEL_SP.size && leader.sp >= LEVEL_SP[clan.level]) {
+            // A leader rich enough pays alone: a pool of nothing that completes on its next visit to town.
+            val need = (LEVEL_ADENA[clan.level] - leader.adena).coerceAtLeast(0)
+            if (need <= reach) {
+                open(clan, Pool(clan.clanId, Goal.Level, leader.objectId, 0, need, now), leader, "clan level ${clan.level + 1}")
+                return
+            }
+        }
+        // The strongest who can't afford its next piece and whom the clan can help.
+        for (bot in online.sortedByDescending { it.level }) {
+            val wish = Gear.wishes(bot).firstOrNull() ?: continue
+            val price = Market.npcPrice(wish.itemId)?.toLong() ?: continue
+            val need = price - Errands.spendable(bot)
+            val others = online.filter { it !== bot }.sumOf { spare(it) * percent(it, bot) / 100 }
+            if (need <= 0 || need > others) continue
+            val name = ItemTable.getInstance().getTemplate(wish.itemId)?.name ?: "item ${wish.itemId}"
+            open(clan, Pool(clan.clanId, Goal.Item, bot.objectId, wish.itemId, need, now), bot, name)
+            return
+        }
+    }
+
+    private fun open(clan: Clan, pool: Pool, recipient: Autobot, what: String) {
+        pools[clan.clanId] = pool
+        println("Autobots clans: ${clan.name} pools ${pool.need} adena for ${recipient.name}: $what")
+        val caller = clan.onlineMembers.filterIsInstance<Autobot>().firstOrNull { it.objectId == clan.leaderId } ?: recipient
+        ClanChat.poolCall(caller, recipient, pool.goal, what, pool.need)
+    }
+
+    /** What a member can give at all: its free adena, keeping what its own next piece costs. */
+    private fun spare(bot: Autobot): Long {
+        val own = Gear.wishes(bot).firstOrNull()?.let { Market.npcPrice(it.itemId) } ?: 0
+        return (Errands.spendable(bot) - own).toLong().coerceAtLeast(0)
+    }
+
+    /** Which part of it: by character and by how much it likes the recipient. */
+    private fun percent(giver: Player, recipient: Player): Long {
+        val base = when (Sociability.of(giver)) { Sociability.Loner -> 5; Sociability.Regular -> 10; Sociability.TeamPlayer -> 15 }
+        val liking = (Relations.affinity(giver, recipient) / 5).coerceIn(0, 10)
+        return (base + liking).toLong()
+    }
+
+    private fun share(giver: Autobot, recipient: Autobot, left: Long): Int =
+            minOf(spare(giver) * percent(giver, recipient) / 100, left, giver.adena.toLong()).toInt()
+
+    /** Close enough to trade: one party, a few steps apart, or both in the same town. */
+    private fun meets(a: Autobot, b: Autobot): Boolean {
+        if (!TradeWindow.canTrade(a) || !TradeWindow.canTrade(b) || a.isInCombat || b.isInCombat) return false
+        if (a.isInParty && a.party === b.party && distance(a, b) <= MEET_NEARBY) return true
+        if (distance(a, b) <= MEET_NEARBY) return true
+        return a.isInsideZone(ZoneId.TOWN) && b.isInsideZone(ZoneId.TOWN) && distance(a, b) <= MEET_IN_TOWN &&
+                MapRegionData.getInstance().getClosestTownName(a.x, a.y) == MapRegionData.getInstance().getClosestTownName(b.x, b.y)
+    }
+
+    private fun give(clan: Clan, pool: Pool, giver: Autobot, recipient: Autobot, gift: Int) {
+        trading += giver.objectId
+        trading += recipient.objectId
+        launchSafely {
+            try {
+                val adena = giver.inventory.adenaInstance ?: return@launchSafely
+                val outcome = TradeWindow.exchange(giver, recipient, listOf(adena to gift), emptyList(),
+                        listOf(Promise(Loan.ADENA, 0, gift)), maxDistance = MEET_IN_TOWN)
+                if (outcome != TradeWindow.Outcome.Done) return@launchSafely
+                pool.givers += giver.objectId
+                pool.collected += gift
+                gifts++
+                given += gift
+                Relations.adjust(recipient, giver.objectId, 5, 5)
+                Relations.adjust(giver, recipient.objectId, 2, 2)
+                log(clan, pool, giver, gift)
+                println("Autobots clans: ${giver.name} gave $gift to ${recipient.name} for ${clan.name}'s pool (${pool.collected}/${pool.need})")
+                ClanChat.gave(giver, recipient, gift)
+                if (pool.collected >= pool.need) completeIfReady(clan, pool)
+            } finally {
+                trading -= giver.objectId
+                trading -= recipient.objectId
+            }
+        }
+    }
+
+    /** Enough adena: the piece is bought on the next town trip, the clan level goes up in town. */
+    private fun completeIfReady(clan: Clan, pool: Pool): Boolean {
+        if (pool.collected < pool.need) return false
+        val recipient = clan.getClanMember(pool.recipientId)?.playerInstance as? Autobot ?: return false
+        when (pool.goal) {
+            Goal.Item -> {
+                bought++
+                ClanChat.thanks(recipient)
+                finish(clan, pool, "funded")
+            }
+            Goal.Level -> {
+                if (Honesty.of(recipient) == Honesty.Scammer) {
+                    // Keeps the money: everyone who gave remembers it.
+                    for (id in pool.givers) {
+                        val giver = clan.getClanMember(id)?.playerInstance as? Autobot ?: continue
+                        Relations.adjust(giver, recipient.objectId, -30, -40)
+                    }
+                    kept++
+                    finish(clan, pool, "kept by the leader")
+                    return true
+                }
+                val level = clan.level
+                val cost = LEVEL_ADENA.getOrNull(level) ?: return false.also { finish(clan, pool, "clan already level $level") }
+                // The leader's own adena moved since the call: the clan tops it up instead of failing at the master.
+                if (recipient.adena < cost) {
+                    pool.need = pool.collected + (cost - recipient.adena)
+                    return false
+                }
+                if (!recipient.isInsideZone(ZoneId.TOWN)) return false
+                if (!clan.levelUpClan(recipient)) {
+                    finish(clan, pool, "level up refused (sp ${recipient.sp}, adena ${recipient.adena})")
+                    return true
+                }
+                levels++
+                println("Autobots clans: ${clan.name} reached level ${level + 1}")
+                ClanChat.levelUp(recipient, level + 1)
+                finish(clan, pool, "clan level ${level + 1}")
+            }
+        }
+        return true
+    }
+
+    private fun finish(clan: Clan, pool: Pool, how: String) {
+        pools.remove(clan.clanId, pool)
+        nextPool[clan.clanId] = System.currentTimeMillis() + POOL_EVERY_MS
+        println("Autobots clans: ${clan.name} pool for ${clan.getClanMember(pool.recipientId)?.name ?: pool.recipientId} ended: $how")
+    }
+
+    private fun log(clan: Clan, pool: Pool, giver: Player, gift: Int) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                if (!tableReady) {
+                    con.createStatement().use {
+                        it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_clan_pool (id INT UNSIGNED NOT NULL AUTO_INCREMENT, clan_id INT UNSIGNED NOT NULL, " +
+                                "goal VARCHAR(8) NOT NULL, item_id INT NOT NULL, recipient_id INT UNSIGNED NOT NULL, giver_id INT UNSIGNED NOT NULL, " +
+                                "amount INT NOT NULL, at BIGINT NOT NULL, PRIMARY KEY(id), KEY clan(clan_id))")
+                    }
+                    tableReady = true
+                }
+                con.prepareStatement("INSERT INTO autobot_clan_pool (clan_id, goal, item_id, recipient_id, giver_id, amount, at) VALUES (?,?,?,?,?,?,?)").use { ps ->
+                    ps.setInt(1, clan.clanId)
+                    ps.setString(2, pool.goal.name)
+                    ps.setInt(3, pool.itemId)
+                    ps.setInt(4, pool.recipientId)
+                    ps.setInt(5, giver.objectId)
+                    ps.setInt(6, gift)
+                    ps.setLong(7, System.currentTimeMillis())
+                    ps.executeUpdate()
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+}
