+    /** How much [bot] wants into [recruiter]'s clan: liking and trust both ways, race, level, schedule, character. */
+    fun sympathy(recruiter: Player, bot: Player): Int {
+        val affinity = maxOf(Relations.affinity(bot, recruiter), Relations.affinity(recruiter, bot))
+        var score = affinity + Relations.trust(bot, recruiter.objectId) / 2
+        if (recruiter.race == bot.race) score += 10
+        val gap = abs(recruiter.level - bot.level)
+        if (gap <= 5) score += 10 else if (gap <= 10) score += 4
+        val a = PopulationManager.wakeHour(recruiter.objectId)
+        val b = PopulationManager.wakeHour(bot.objectId)
+        if (a != null && b != null && abs(a - b) <= 2) score += 8
+        score += when (Sociability.of(bot)) { Sociability.Loner -> -15; Sociability.Regular -> 3; Sociability.TeamPlayer -> 10 }
+        // A clan means a party and help; past 20 a lonely bot wants one more.
+        if (bot.level >= 20) score += 5
+        if (Relations.affinity(bot, recruiter) <= Relations.AVOID) score -= 50
+        return score
+    }
