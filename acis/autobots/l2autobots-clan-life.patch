+import kotlinx.coroutines.launch
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.sql.ClanTable
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.pledge.Clan
+import net.sf.l2j.gameserver.network.SystemMessageId
+import net.sf.l2j.gameserver.network.clientpackets.RequestJoinPledge
+import net.sf.l2j.gameserver.network.serverpackets.AskJoinPledge
+import net.sf.l2j.gameserver.network.serverpackets.SystemMessage
+import java.util.Collections
+import java.util.WeakHashMap
+
+/**
+ * Clan chat and clan talk with players (stage 4a). Clan events are lines of code, no model: founding, joining,
+ * leaving, a new leader, a pool and its gifts, a clan level. A player's line in clan chat gets an answer: a greeting,
+ * a party offer, where the members are when asked for help, otherwise one bot talks through [BotTalk]. A player can
+ * ask a bot clan to take them (a whisper to its leader or officer, or "ищу клан" in shout) and get the real
+ * AskJoinPledge window; a player's clan invite to a bot is answered like the client would.
+ */
+/**
+ * A coroutine in the shared scope that can't take the scope down: CoScopes.generalScope has a plain Job, so one
+ * uncaught exception in a child cancels it and with it the population tick.
+ */
+internal fun launchSafely(block: suspend kotlinx.coroutines.CoroutineScope.() -> Unit) = CoScopes.generalScope.launch {
+    try {
+        block()
+    } catch (e: kotlinx.coroutines.CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        e.printStackTrace()
+    }
+}
+
+internal object ClanChat {
+    enum class Line(val ru: List<String>, val en: List<String>) {
+        Hello(listOf("привет всем", "всем ку", "о/", "здарова"), listOf("hi all", "hey", "o/", "hello clan")),
+        Bye(listOf("всем пока, я ухожу из клана", "ну всё, я ухожу, удачи"), listOf("bye all, leaving the clan", "im out, gl all")),
+        Welcome(listOf("добро пожаловать, %s", "%s, привет, welcome", "у нас новенький: %s"), listOf("welcome %s", "welcome to the clan %s", "hi %s, welcome")),
+        Joined(listOf("привет!", "рад быть с вами", "всем привет, я новенький"), listOf("hi!", "glad to be here", "hi all, new here")),
+        NewLeader(listOf("лидер пропал, теперь клан веду я", "клан на мне теперь, лидер давно не заходит"), listOf("leader is gone, i lead now", "i took the clan, leader quit")),
+        PoolItem(listOf("скинемся %s на %s? не хватает %d", "давайте поможем %s с %s, нужно ещё %d"), listOf("lets chip in for %s, needs %s, %d short", "help %s get %s? %d short")),
+        PoolLevel(listOf("собираем на %s, нужно %d, кто сколько может", "скидываемся на %s, не хватает %d"), listOf("pooling for %s, %d needed", "chip in for %s, %d short")),
+        Gave(listOf("кинул %1${'$'}s %2${'$'}d", "держи %2${'$'}d, %1${'$'}s", "%1${'$'}s, скинул %2${'$'}d"), listOf("sent %1${'$'}s %2${'$'}d", "here %2${'$'}d, %1${'$'}s", "%1${'$'}s, gave %2${'$'}d")),
+        Thanks(listOf("спасибо всем, хватает!", "спс, клан, теперь куплю", "ура, спасибо всем"), listOf("ty all, got enough!", "thanks clan, buying it", "ty all")),
+        LevelUp(listOf("клан теперь %d уровня, спасибо всем!", "есть %d лвл клана!"), listOf("clan is level %d now, ty all!", "clan lvl %d!")),
+        Recruit(listOf("клан %s набирает, %d+ ур., пишите в пм", "набор в %s, %d+, кто хочет в дружный клан, пм", "%s ищет людей, %d+ ур, пм"),
+                listOf("%s recruiting, lvl %d+, pm", "clan %s is recruiting, %d+ pm me", "join %s, lvl %d+, pm")),
+        RecruitOffer(listOf("привет, иди к нам в %s, нас %d", "привет, у нас клан %s, %d чел, пойдёшь?"), listOf("hi, join %s? we are %d", "hi, clan %s, %d people, want in?")),
+        Inviting(listOf("кидаю инвайт", "лови приглашение", "ок, приглашаю"), listOf("sending invite", "ok, inviting", "invite sent")),
+        Full(listOf("сорри, клан забит", "мест нет пока"), listOf("sorry, clan is full", "no room now")),
+        NoPk(listOf("с пк не берём", "ты красный, сорри"), listOf("no pk, sorry", "you're red, no")),
+        TooLow(listOf("с %d уровня берём", "подкачайся до %d и пиши"), listOf("lvl %d+ only", "come back at %d")),
+        NotRecruiting(listOf("это к лидеру", "я не приглашаю, спроси лидера"), listOf("ask the leader", "i cant invite, ask the leader")),
+        PartyLead(listOf("иди к нам, мы у %s, кидаю пати", "го к нам, %s, инвайт"), listOf("join us near %s, inviting", "come to %s, sending party")),
+        PartyFree(listOf("я свободен, кидай пати", "могу, кидай инвайт"), listOf("im free, invite me", "sure, inv me")),
+        HelpComing(listOf("бегу", "иду, держись", "щас буду"), listOf("coming", "on my way", "omw")),
+        HelpFar(listOf("я у %s, далеко", "я далеко, у %s"), listOf("im near %s, far", "far away, near %s"));
+    }
+
+    private val HELLO = Regex("^(прив|привет|ку\\b|хай|здаро|всем привет|hi\\b|hello|hey|o/)", RegexOption.IGNORE_CASE)
+    private val PARTY = Regex("(пати|\\bпт\\b|го кач|кто кач|party|\\blfp\\b|\\blfg\\b|кто со мной)", RegexOption.IGNORE_CASE)
+    private val HELP = Regex("(помогит|хелп|спасит|убива|help|\\bpk\\b|пк напал)", RegexOption.IGNORE_CASE)
+    private val WANTS_CLAN = Regex("(клан|\\bкп\\b|вступ|возьм|прим[иу]|clan|join|\\+$|^\\+|^да$|^yes$|^го$|хочу)", RegexOption.IGNORE_CASE)
+    private val LOOKING_FOR_CLAN = Regex("(ищу (клан|кп)|возьм(ите|ет) (в )?клан|кто возьм[её]т в клан|\\blf clan\\b|looking for (a )?clan)", RegexOption.IGNORE_CASE)
+
+    private const val PLAYER_ACCEPT = 15
+    private const val OFFER_TTL_MS = 10 * 60_000L
+
+    /** player -> (recruiter, until) of a whispered clan offer. */
+    private val offers = Collections.synchronizedMap(WeakHashMap<Player, Pair<Int, Long>>())
+
+    /** The clan's language: the player's in it if there is one, else a trait of the clan. */
+    private fun russian(clan: Clan): Boolean {
+        // A player in the clan: the server's players speak Russian.
+        if (clan.onlineMembers.any { it.isLiveAudience() }) return true
+        return Math.floorMod(clan.clanId * 13, 100) < 70
+    }
+
+    private fun text(line: Line, russian: Boolean, vararg args: Any): String {
+        val template = (if (russian) line.ru else line.en).random()
+        return try { template.format(*args) } catch (e: java.util.IllegalFormatException) { template }
+    }
+
+    /** Says [line] in clan chat after a short typing pause. */
+    fun say(bot: Autobot, line: Line, vararg args: Any, pauseMs: Long = 0) {
+        val clan = bot.clan ?: return
+        val msg = text(line, russian(clan), *args)
+        if (pauseMs <= 0) {
+            bot.clanSay(msg)
+            return
+        }
+        launchSafely {
+            delay(pauseMs)
+            if (bot.isOnline && bot.clan === clan) bot.clanSay(msg)
+        }
+    }
+
+    private fun typing() = Rnd.get(2000, 6000).toLong()
+
+    fun welcome(recruiter: Autobot, newcomer: Player) {
+        say(recruiter, Line.Welcome, newcomer.name, pauseMs = typing())
+        if (newcomer is Autobot && Rnd.get(100) < 70) say(newcomer, Line.Joined, pauseMs = typing() + 4000)
+    }
+
+    fun recruitShout(bot: Autobot, clan: Clan) {
+        bot.shout(text(Line.Recruit, Rnd.get(100) < 70, clan.name, Clans.MIN_JOIN_LEVEL))
+    }
+
+    fun poolCall(caller: Autobot, recipient: Autobot, goal: ClanPool.Goal, what: String, need: Long) {
+        if (goal == ClanPool.Goal.Level) say(caller, Line.PoolLevel, what, need)
+        else say(caller, Line.PoolItem, recipient.name, what, need)
+    }
+
+    fun gave(giver: Autobot, recipient: Autobot, gift: Int) {
+        if (Rnd.get(100) < 60) say(giver, Line.Gave, recipient.name, gift, pauseMs = typing())
+    }
+
+    fun thanks(recipient: Autobot) = say(recipient, Line.Thanks, pauseMs = typing())
+
+    fun levelUp(leader: Autobot, level: Int) = say(leader, Line.LevelUp, level, pauseMs = typing())
+
+    /** A player's line in clan chat; bots of the clan online answer like clan mates. */
+    fun onClanChat(player: Player, text: String) {
+        if (player is Autobot) return
+        val clan = player.clan ?: return
+        val bots = clan.onlineMembers.filterIsInstance<Autobot>().filter { it.life != null && !it.isDead }
+        if (bots.isEmpty()) return
+        val ru = GroupChat.isRussian(text)
+        when {
+            HELP.containsMatchIn(text) -> {
+                bots.sortedBy { distance(it, player) }.take(2).forEachIndexed { i, bot ->
+                    val msg = if (distance(bot, player) <= 4000) text(Line.HelpComing, ru)
+                    else text(Line.HelpFar, ru, GroupFinder.placeName(bot))
+                    later(bot, msg, i)
+                }
+            }
+            PARTY.containsMatchIn(text) && !player.isInParty -> {
+                val led = bots.mapNotNull { it.party?.takeIf { p -> p.leader === it && p.membersCount < 9 && GroupFinder.judge(p, player) == null } }.firstOrNull()
+                if (led != null) {
+                    val leader = led.leader as Autobot
+                    later(leader, text(Line.PartyLead, ru, GroupFinder.placeName(leader)), 0)
+                    launchSafely {
+                        delay(Rnd.get(5000, 9000).toLong())
+                        if (!player.isInParty && player.isOnline && leader.party === led) GroupFinder.invitePlayer(leader, player)
+                    }
+                    return
+                }
+                bots.filter { !it.isInParty && kotlin.math.abs(it.level - player.level) <= 5 && Sociability.of(it) != Sociability.Loner }
+                        .shuffled().take(2).forEachIndexed { i, bot -> later(bot, text(Line.PartyFree, ru), i) }
+            }
+            HELLO.containsMatchIn(text.trim()) -> {
+                bots.filter { Rnd.get(100) < 40 }.shuffled().take(2).forEachIndexed { i, bot -> later(bot, text(Line.Hello, ru), i) }
+            }
+            else -> BotTalk.onClanChat(player, clan, bots, text)
+        }
+    }
+
+    private fun later(bot: Autobot, msg: String, order: Int) {
+        launchSafely {
+            delay(typing() + order * Rnd.get(2000, 5000))
+            if (bot.isOnline && bot.clan != null) bot.clanSay(msg)
+        }
+    }
+
+    /**
+     * A player in shout looking for a clan: a recruiter of a bot clan with room in the region whispers an offer.
+     */
+    fun onShout(player: Player, text: String, online: Collection<Autobot>) {
+        if (player is Autobot || player.clanId != 0 || !LOOKING_FOR_CLAN.containsMatchIn(text) || !AutobotData.settings.clansEnabled) return
+        val ru = GroupChat.isRussian(text)
+        val region = MapRegionData.getInstance().getMapRegion(player.x, player.y)
+        val recruiter = ClanTable.getInstance().clans.filter { Clans.isBotClan(it) && it.membersCount < it.getMaxNrOfMembers(0) }
+                .flatMap { Clans.recruiters(it) }
+                .filter { MapRegionData.getInstance().getMapRegion(it.x, it.y) == region }
+                .randomOrNull() ?: return
+        launchSafely {
+            delay(Rnd.get(8000, 30000).toLong())
+            val clan = recruiter.clan ?: return@launchSafely
+            if (player.clanId != 0 || !player.isOnline) return@launchSafely
+            offers[player] = recruiter.objectId to System.currentTimeMillis() + OFFER_TTL_MS
+            recruiter.tell(player.name, text(Line.RecruitOffer, ru, clan.name, clan.membersCount))
+        }
+    }
+
+    /**
+     * A whisper to a recruiter of a bot clan asking to join (or answering its offer). @return true if handled.
+     */
+    fun onWhisper(player: Player, bot: Autobot, text: String): Boolean {
+        if (player is Autobot || player.clanId != 0 || !AutobotData.settings.clansEnabled) return false
+        val clan = bot.clan ?: return false
+        if (!Clans.isBotClan(clan)) return false
+        val offered = offers[player]?.let { it.first == bot.objectId && System.currentTimeMillis() < it.second } == true
+        if (!offered && !WANTS_CLAN.containsMatchIn(text)) return false
+        if (!offered && !text.contains("клан", true) && !text.contains("clan", true) && !text.contains("кп", true)) return false
+        val ru = GroupChat.isRussian(text)
+        launchSafely {
+            delay(Rnd.get(3000, 8000).toLong())
+            val refusal = when {
+                bot.objectId != clan.leaderId && (bot.clanPrivileges and Clan.CP_CL_JOIN_CLAN) == 0 -> Line.NotRecruiting
+                clan.membersCount >= clan.getMaxNrOfMembers(0) -> Line.Full
+                player.karma > 0 -> Line.NoPk
+                player.level < Clans.MIN_JOIN_LEVEL -> Line.TooLow
+                Clans.sympathy(bot, player) < PLAYER_ACCEPT && !offered -> Line.Full
+                else -> null
+            }
+            if (refusal != null) {
+                bot.tell(player.name, text(refusal, ru, Clans.MIN_JOIN_LEVEL))
+                return@launchSafely
+            }
+            bot.tell(player.name, text(Line.Inviting, ru))
+            delay(Rnd.get(1000, 3000).toLong())
+            invitePlayer(bot, player)
+        }
+        return true
+    }
+
+    /** The real clan invite window, the same steps as RequestJoinPledge; the core handles the player's answer. */
+    private fun invitePlayer(bot: Autobot, player: Player) {
+        val clan = bot.clan ?: return
+        if (!clan.checkClanJoinCondition(bot, player, 0)) return
+        if (!bot.request.setRequest(player, RequestJoinPledge())) return
+        player.sendPacket(SystemMessage.getSystemMessage(SystemMessageId.S1_HAS_INVITED_YOU_TO_JOIN_THE_CLAN_S2).addCharName(bot).addString(clan.name))
+        player.sendPacket(AskJoinPledge(bot.objectId, clan.name))
+        println("Autobots clans: ${bot.name} invited player ${player.name} to ${clan.name}")
+    }
+
+    /**
+     * A player's clan invites a bot (RequestJoinPledge already sent the window): the bot weighs it like an invite
+     * from a bot clan and answers after a pause, joining through the core's checks or saying no.
+     */
+    fun onInvite(requestor: Player, bot: Autobot) {
+        val clan = requestor.clan ?: return
+        if (bot.life == null) return
+        launchSafely {
+            delay(Rnd.get(3000, 8000).toLong())
+            if (bot.request.partner !== requestor) return@launchSafely
+            val score = Clans.sympathy(requestor, bot)
+            val accept = score >= PLAYER_ACCEPT + Rnd.get(20) && bot.clanId == 0
+            if (accept && Clans.join(clan, requestor, bot)) {
+                println("Autobots clans: ${bot.name} joined player ${requestor.name}'s clan ${clan.name} (score $score)")
