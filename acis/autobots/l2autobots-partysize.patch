diff --git a/src/main/kotlin/dev/l2j/autobots/population/group/PartySize.kt b/src/main/kotlin/dev/l2j/autobots/population/group/PartySize.kt
new file mode 100644
index 0000000..b3ec243
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/PartySize.kt
@@ -0,0 +1,131 @@
+package dev.l2j.autobots.population.group
+
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.group.Party
+
+/**
+ * How many people a bot-led party wants, from its kind's minimum up to [MAX]. A party starts at the size it was formed
+ * with and weighs what a member earns, experience and adena per minute, over [WINDOW_MS] at a time with the same people
+ * at the same spot. It keeps a size that pays, tries one more when nobody died and the last step up didn't cost it,
+ * and lets one go when a member earns clearly less than at the size below, or when the spot stops feeding this many.
+ */
+internal object PartySize {
+    const val MAX = 9
+    private const val WINDOW_MS = 10 * 60_000L
+    /** Earnings measured at another size are compared for this long, then the party tries again. */
+    private const val RECORD_TTL_MS = 40 * 60_000L
+    /** The leader went further than this: another spot, earnings start over. */
+    private const val SAME_SPOT = 3000.0
+    /** A member earning less than this share of what it earned with one fewer person: one fewer is better. */
+    private const val WORSE = 0.85
+    /** Earnings at the same size fell below this share of the last window: the spot runs out of monsters for so many. */
+    private const val DEPLETED = 0.7
+    private const val TRY_BIGGER_PERCENT = 50
+
+    enum class Change { Shrink, Grow }
+
+    /** A member's earnings per minute at one size. */
+    private class Sample(val exp: Double, val adena: Double, val at: Long)
+
+    private class Tracker {
+        var startedAt = 0L
+        var x = 0
+        var y = 0
+        var members = emptySet<Int>()
+        val exp = HashMap<Int, Long>()
+        val adena = HashMap<Int, Long>()
+        var died = false
+        val records = HashMap<Int, Sample>()
+        var last: Sample? = null
+    }
+
+    private val trackers = java.util.Collections.synchronizedMap(java.util.WeakHashMap<Party, Tracker>())
+
+    fun target(party: Party): Int = PartyPlan.state(party).let { if (it.targetSize > 0) it.targetSize else it.kind.wantedSize }
+
+    private fun min(party: Party) = PartyPlan.state(party).kind.minSize
+
+    /** Earnings per member at the current size, for the summary. */
+    fun describe(party: Party): String {
+        val last = trackers[party]?.last ?: return ""
+        return " exp/min ${last.exp.toLong()} adena/min ${last.adena.toLong()}"
+    }
+
+    /** Called every tick for a party a bot leads. @return a change of size the party agreed on, if any. */
+    fun update(party: Party, now: Long): Change? {
+        val leader = party.leader ?: return null
+        val state = PartyPlan.state(party)
+        if (state.targetSize == 0) state.targetSize = party.membersCount.coerceIn(min(party), MAX)
+        val tracker = trackers.getOrPut(party) { Tracker() }
+        val ids = party.members.map { it.objectId }.toSet()
+        if (tracker.startedAt == 0L || Math.hypot((leader.x - tracker.x).toDouble(), (leader.y - tracker.y).toDouble()) > SAME_SPOT) {
+            tracker.records.clear()
+            tracker.last = null
+            restart(tracker, party, now)
+            return null
+        }
+        // Earnings are compared size by size: anyone joining or leaving starts the window again.
+        if (ids != tracker.members) {
+            restart(tracker, party, now)
+            return null
+        }
+        if (party.members.any { it.isDead }) tracker.died = true
+        if (now - tracker.startedAt < WINDOW_MS) return null
+
+        val size = ids.size
+        val sample = measure(tracker, party, now)
+        tracker.records.values.removeIf { now - it.at > RECORD_TTL_MS }
+        val smaller = tracker.records[size - 1]
+        val bigger = tracker.records[size + 1]
+        val previous = tracker.records[size]
+        tracker.records[size] = sample
+        tracker.last = sample
+        val died = tracker.died
+        restart(tracker, party, now)
+
+        val change = when {
+            size > min(party) && smaller != null && ratio(sample, smaller) < WORSE -> Change.Shrink
+            size > min(party) && smaller == null && previous != null && ratio(sample, previous) < DEPLETED -> Change.Shrink
+            size < MAX && size >= state.targetSize && !died && (smaller == null || ratio(sample, smaller) >= 1.0) &&
+                    (bigger == null || ratio(bigger, sample) >= 1.0) && Rnd.get(100) < TRY_BIGGER_PERCENT -> Change.Grow
+            else -> null
+        }
+        when (change) {
+            Change.Shrink -> state.targetSize = size - 1
+            Change.Grow -> state.targetSize = size + 1
+            null -> if (state.targetSize > size && bigger != null && ratio(bigger, sample) < 1.0) state.targetSize = size
+        }
+        return change
+    }
+
+    private fun restart(tracker: Tracker, party: Party, now: Long) {
+        val leader = party.leader
+        tracker.startedAt = now
+        tracker.x = leader.x
+        tracker.y = leader.y
+        tracker.members = party.members.map { it.objectId }.toSet()
+        tracker.exp.clear()
+        tracker.adena.clear()
+        for (member in party.members) {
+            tracker.exp[member.objectId] = member.exp
+            tracker.adena[member.objectId] = member.adena.toLong()
+        }
+        tracker.died = false
+    }
+
+    /** What a member earned per minute; a death's lost experience or a purchase counts as nothing earned, not a loss. */
+    private fun measure(tracker: Tracker, party: Party, now: Long): Sample {
+        val members: List<Player> = party.members
+        val minutes = (now - tracker.startedAt) / 60_000.0
+        val exp = members.sumOf { (it.exp - (tracker.exp[it.objectId] ?: it.exp)).coerceAtLeast(0) }
+        val adena = members.sumOf { (it.adena - (tracker.adena[it.objectId] ?: it.adena.toLong())).coerceAtLeast(0) }
+        return Sample(exp / members.size / minutes, adena / members.size / minutes, now)
+    }
+
+    /** How [a] compares to [b]: the average of the experience and adena ratios, over what [b] earned at all. */
+    private fun ratio(a: Sample, b: Sample): Double {
+        val parts = listOfNotNull(if (b.exp > 0) a.exp / b.exp else null, if (b.adena > 0) a.adena / b.adena else null)
+        return if (parts.isEmpty()) 1.0 else parts.average()
+    }
+}
