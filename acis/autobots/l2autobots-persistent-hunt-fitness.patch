diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/FitnessStore.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/FitnessStore.kt
new file mode 100644
index 0000000..d33516a
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/FitnessStore.kt
@@ -0,0 +1,33 @@
+package dev.l2j.autobots.population.economy
+
+import net.sf.l2j.L2DatabaseFactory
+import java.util.logging.Logger
+
+internal data class FitnessState(val mode: String,val since: Long,val lastDeath: Long,val deaths: List<Long>)
+
+/** Survival decisions only: no levels, rewards, equipment or resources are stored here. */
+internal object FitnessStore {
+    private val logger=Logger.getLogger(FitnessStore::class.java.name)
+    fun initialize() {
+        L2DatabaseFactory.getInstance().connection.use { c -> c.createStatement().use {
+            it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_fitness (obj_Id INT UNSIGNED NOT NULL, mode VARCHAR(16) NOT NULL, mode_since BIGINT NOT NULL, last_death BIGINT NOT NULL, deaths VARCHAR(128) NOT NULL, PRIMARY KEY(obj_Id))")
+        } }
+    }
+    fun load(id: Int): FitnessState? = runCatching {
+        L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("SELECT mode,mode_since,last_death,deaths FROM autobot_fitness WHERE obj_Id=?").use {
+                it.setInt(1,id)
+                it.executeQuery().use { r -> if(!r.next()) null else FitnessState(r.getString(1),r.getLong(2),r.getLong(3),
+                        r.getString(4).split(',').mapNotNull { value -> value.toLongOrNull() }) }
+            }
+        }
+    }.getOrElse { logger.warning("Fitness read failed for $id: $it");null }
+    fun save(id: Int,state: FitnessState) {
+        runCatching { L2DatabaseFactory.getInstance().connection.use { c ->
+            c.prepareStatement("INSERT INTO autobot_fitness(obj_Id,mode,mode_since,last_death,deaths) VALUES(?,?,?,?,?) ON DUPLICATE KEY UPDATE mode=VALUES(mode),mode_since=VALUES(mode_since),last_death=VALUES(last_death),deaths=VALUES(deaths)").use {
+                it.setInt(1,id);it.setString(2,state.mode);it.setLong(3,state.since);it.setLong(4,state.lastDeath)
+                it.setString(5,state.deaths.joinToString(","));it.executeUpdate()
+            }
+        } }.onFailure { logger.warning("Fitness write failed for $id: $it") }
+    }
+}
