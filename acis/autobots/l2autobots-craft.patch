+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/craft/Sourcing.kt
@@ -0,0 +1,129 @@
+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.economy.Chatter
+import dev.l2j.autobots.population.economy.EconomyLog
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.Wish
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.Recipe
+
+/** One way to get an item, with what it costs the bot in adena. */
+internal sealed class Route(val cost: Long) {
+    class Npc(cost: Long) : Route(cost)
+    class Store(cost: Long) : Route(cost)
+    /** [cash] is what the bot actually pays: the fee and the materials it lacks; [cost] also counts its own materials. */
+    class Order(cost: Long, val cash: Long, val owner: Player, val recipe: Recipe) : Route(cost)
+    class OwnCraft(cost: Long) : Route(cost)
+}
+
+/**
+ * How a bot gets the next piece of its kit: from a town shop, a private store, a workshop order with its own
+ * materials, its own craft, or not at all for now (it keeps hunting and may find it). The cheapest affordable
+ * route wins; every choice is logged with the alternatives.
+ */
+internal object Sourcing {
+    fun routes(bot: Autobot, itemId: Int): List<Route> {
+        val routes = mutableListOf<Route>()
+        Market.findProduct(bot, itemId)?.let { (shop, product) -> routes += Route.Npc(Market.priceWithTax(shop, product).toLong()) }
+        Market.sellOffers(bot, itemId).firstOrNull()?.let { routes += Route.Store(it.tradeItem.price.toLong()) }
+        if (!CraftBook.enabled) return routes
+        for (recipe in CraftBook.forProduct(itemId)) {
+            if (bot.dwarvenRecipeBook.contains(recipe) && recipe.level <= CraftBook.skillLevel(bot)) {
+                CraftPlanner.craftCost(bot, recipe)?.let { routes += Route.OwnCraft(it / recipe.product.value) }
+            }
+            for ((owner, fee) in CraftPlanner.workshopsFor(bot, recipe)) {
+                // Materials already in the bag are paid for: they cost what an NPC would have paid for them.
+                val cost = CraftPlanner.craftCost(bot, recipe, fee) ?: continue
+                routes += Route.Order(cost / recipe.product.value, fee + missingCost(bot, recipe), owner, recipe)
+                break
+            }
+        }
+        return routes
+    }
+
+    /** The most a bot pays in a private store for [itemId]: a workshop order or a shop must not be cheaper. */
+    fun storeLimit(bot: Autobot, itemId: Int, default: Int): Int {
+        val order = routes(bot, itemId).filterIsInstance<Route.Order>().minOfOrNull { it.cost } ?: return default
+        return minOf(default.toLong(), order).toInt()
+    }
+
+    fun describe(routes: List<Route>): String = routes.joinToString { route ->
+        val kind = when (route) {
+            is Route.Npc -> "npc"
+            is Route.Store -> "store"
+            is Route.Order -> "order@${route.owner.name}"
+            is Route.OwnCraft -> "own craft"
+        }
+        "$kind ${route.cost}"
+    }
+
+    /**
+     * Orders the next kit pieces from workshops in town when that is the cheapest way and the bot can pay for the
+     * fee and the missing materials. Missing materials are bought in stores first.
+     */
+    suspend fun orderCheapest(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        val allowedGrade = Gear.gradeFor(bot.level).id
+        var orders = 0
+        // Any kit piece, not just the first: a bot with the parts for its shield orders it while saving for the sword.
+        for (wish in Gear.wishes(bot)) {
+            if (orders >= ORDERS_PER_TRIP) return
+            // The grade penalty: nobody pays for gear they can't use well.
+            if (wish.template.crystalType.id > allowedGrade) continue
+            val routes = routes(bot, wish.itemId)
+            val best = routes.minByOrNull { it.cost } as? Route.Order ?: continue
+            if (best.cash > Errands.spendable(bot)) {
+                EconomyLog.skip(bot, "can't afford ${wish.template.name} by any route (${describe(routes)})")
+                continue
+            }
+            if (!buyMissing(bot, best.recipe, walkTo)) continue
+            if (!walkTo(best.owner)) continue
+            EconomyLog.note(bot, "chose order for ${wish.template.name}: ${describe(routes)}")
+            orders++
+            if (Workshop.order(bot, best.owner, best.recipe)) equipOrdered(bot, wish)
+        }
+    }
+
+    /** Adena to buy the materials of [recipe] the bot lacks, at the best price in town (0 when it has them all). */
+    private fun missingCost(bot: Autobot, recipe: Recipe): Long = recipe.materials.sumOf { material ->
+        val missing = (material.value - Gear.count(bot, material.id)).coerceAtLeast(0)
+        if (missing == 0) 0L else missing.toLong() * (CraftPlanner.buyPrice(bot, material.id) ?: 0)
+    }
+
+    private suspend fun buyMissing(bot: Autobot, recipe: Recipe, walkTo: suspend (Player) -> Boolean): Boolean {
+        for (material in recipe.materials) {
+            var missing = material.value - Gear.count(bot, material.id)
+            for (offer in Market.sellOffers(bot, material.id)) {
+                if (missing <= 0) break
+                val count = minOf(missing, offer.tradeItem.count)
+                if (offer.tradeItem.price.toLong() * count > Errands.spendable(bot) || !walkTo(offer.owner)) return false
+                if (Market.buyFromStore(bot, offer, count)) missing -= count
+            }
+            if (missing > 0) {
+                val (shop, product) = Market.findProduct(bot, material.id) ?: return false
+                if (!Market.buyFromNpc(bot, shop, product, missing)) return false
+            }
+        }
+        return true
+    }
+
+    private fun equipOrdered(bot: Autobot, wish: Wish) {
+        val item = bot.inventory.getItemsByItemId(wish.itemId).firstOrNull { !it.isEquipped } ?: return
+        Gear.equip(bot, item)
+        Chatter.maybeSay(bot, Chatter.BOUGHT_UPGRADE, item.itemName)
+    }
+
+    /**
+     * Materials and parts a bot keeps for the recipes of its next kit pieces, so it can bring them to a workshop:
+     * a player who found a Broadsword Blade doesn't sell it while saving for a Broadsword.
+     */
+    fun inputsForWishes(bot: Autobot): Set<Int> {
+        if (!CraftBook.enabled) return emptySet()
+        return Gear.wishes(bot).flatMap { wish -> CraftBook.forProduct(wish.itemId).flatMap { recipe -> recipe.materials.map { it.id } } }.toSet()
+    }
+
+    private const val ORDERS_PER_TRIP = 2
+}
