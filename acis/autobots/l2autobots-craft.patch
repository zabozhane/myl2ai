+package dev.l2j.autobots.population.economy.craft
+
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.data.xml.RecipeData
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * The recipe book of a population bot, in `autobots_recipebook`: the core's `character_recipebook` is purged at
+ * startup of every id not in `characters`, which bots aren't. Loaded at login, saved on change and on logout.
+ */
+internal object RecipeBookDao {
+    private const val SELECT = "SELECT recipeId FROM autobots_recipebook WHERE charId=?"
+    private const val DELETE = "DELETE FROM autobots_recipebook WHERE charId=?"
+    private const val INSERT = "INSERT INTO autobots_recipebook (charId, recipeId) VALUES (?,?)"
+
+    fun load(bot: Player) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement(SELECT).use { ps ->
+                    ps.setInt(1, bot.objectId)
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) {
+                            val recipe = RecipeData.getInstance().getRecipeList(rs.getInt("recipeId")) ?: continue
+                            if (recipe.isDwarven) bot.registerDwarvenRecipeList(recipe) else bot.registerCommonRecipeList(recipe)
+                        }
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots economy: couldn't load the recipe book of ${bot.name}: $e")
+        }
+    }
+
+    fun save(bot: Player) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement(DELETE).use { ps ->
+                    ps.setInt(1, bot.objectId)
+                    ps.execute()
+                }
+                con.prepareStatement(INSERT).use { ps ->
+                    for (recipe in bot.dwarvenRecipeBook + bot.commonRecipeBook) {
+                        ps.setInt(1, bot.objectId)
+                        ps.setInt(2, recipe.id)
+                        ps.addBatch()
+                    }
+                    ps.executeBatch()
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots economy: couldn't save the recipe book of ${bot.name}: $e")
+        }
+    }
+}
