@@ -0,0 +1,153 @@
+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotsManager
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.Recipe
+
+/**
+ * The crafter's arithmetic: what a craft costs with the materials at hand and the prices in town, what it earns,
+ * what is in demand among the bots online, and what to buy for the next crafts.
+ */
+internal object CraftPlanner {
+    /** How many crafts of a good recipe a crafter stocks materials for. */
+    private const val CRAFTS_TO_STOCK = 3
+    private const val RECIPES_TO_STOCK = 4
+    private const val DEMAND_REFRESH_MS = 60_000L
+
+    @Volatile private var demandAt = 0L
+    @Volatile private var demandCache: Map<Int, Int> = emptyMap()
+
+    /**
+     * Items the population online is looking for, with how many bots want each: the next pieces of their kits and
+     * the shots for their weapons. Refreshed once a minute; this is what any player would learn from trade chat.
+     */
+    fun demand(): Map<Int, Int> {
+        val now = System.currentTimeMillis()
+        if (now - demandAt < DEMAND_REFRESH_MS) return demandCache
+        val wanted = HashMap<Int, Int>()
+        for (bot in AutobotsManager.activeBots.values) {
+            if (bot.life == null || !bot.isOnline) continue
+            Gear.wishes(bot).forEach { wanted.merge(it.itemId, 1, Int::plus) }
+            wanted.merge(Gear.shotId(bot), 1, Int::plus)
+        }
+        demandCache = wanted
+        demandAt = now
+        return wanted
+    }
+
+    /** What the crafter gives up by using a piece it owns: what an NPC would pay for it. */
+    fun ownValue(itemId: Int): Int = Market.npcSellPrice(itemId)
+
+    /** The cheapest price of one piece in town (shop or private store), or null if nobody here sells it. */
+    fun buyPrice(bot: Player, itemId: Int): Int? {
+        val shop = Market.findProduct(bot, itemId)?.let { (shop, product) -> Market.priceWithTax(shop, product) }
+        val store = Market.sellOffers(bot, itemId).firstOrNull()?.tradeItem?.price
+        return listOfNotNull(shop, store).minOrNull()
+    }
+
+    /**
+     * Expected cost of one successful craft: owned materials at what an NPC pays, missing ones at the best price in
+     * town, divided by the success chance (a failure burns the materials). Null when a missing material isn't sold here.
+     */
+    fun craftCost(bot: Player, recipe: Recipe, fee: Int = 0): Long? {
+        var cost = fee.toLong()
+        for (material in recipe.materials) {
+            val have = Gear.count(bot, material.id).coerceAtMost(material.value)
+            val missing = material.value - have
+            cost += have.toLong() * ownValue(material.id)
+            if (missing > 0) cost += missing.toLong() * (buyPrice(bot, material.id) ?: return null)
+        }
+        return cost * 100 / recipe.successRate.coerceAtLeast(1)
+    }
+
+    /** What a craft earns: the product's market value minus the expected cost; null when it can't be made here. */
+    fun margin(bot: Player, recipe: Recipe): Long? {
+        val cost = craftCost(bot, recipe) ?: return null
+        return CraftBook.productValue(recipe.product.id).toLong() * recipe.product.value - cost
+    }
+
+    /** Value of the product with the materials valued at what NPCs pay: the margin a crafter could hope for at best. */
+    fun potential(recipe: Recipe): Long {
+        val materials = recipe.materials.sumOf { it.value.toLong() * ownValue(it.id) }
+        return CraftBook.productValue(recipe.product.id).toLong() * recipe.product.value * recipe.successRate / 100 - materials
+    }
+
+    fun knownRecipes(bot: Player): List<Recipe> = bot.dwarvenRecipeBook.filter { it.level <= CraftBook.skillLevel(bot) }
+
+    /** Known recipes worth making, best first: in demand, then by potential margin. */
+    fun ranked(bot: Player): List<Recipe> {
+        val demand = demand()
+        return knownRecipes(bot)
+                .filter { potential(it) > 0 || (demand[it.product.id] ?: 0) > 0 }
+                .sortedWith(compareByDescending<Recipe> { demand[it.product.id] ?: 0 }.thenByDescending { potential(it) })
+    }
+
+    /** True when a known recipe consumes [itemId], directly or through a known intermediate recipe. */
+    fun usesInput(bot: Player, itemId: Int): Boolean = knownRecipes(bot).any { recipe -> recipe.materials.any { it.id == itemId } }
+
+    /**
+     * Materials the crafter lacks for the next few crafts of its best recipes, with counts: what its buy store bids on
+     * and what spoilers go looking for.
+     */
+    fun shoppingList(bot: Player): Map<Int, Int> {
+        val wanted = HashMap<Int, Int>()
+        for (recipe in ranked(bot).take(RECIPES_TO_STOCK)) {
+            for (material in recipe.materials) {
+                val need = material.value * CRAFTS_TO_STOCK - Gear.count(bot, material.id)
+                // A material a known recipe makes is crafted, not bought, when its own inputs are at hand.
+                if (need > 0 && knownRecipes(bot).none { it.product.id == material.id && hasMaterials(bot, it) }) wanted.merge(material.id, need, Int::plus)
+            }
+        }
+        return wanted
+    }
+
+    /** Recipes in demand the crafter could learn now and doesn't know: worth a bid in its buy store. */
+    fun wantedRecipes(bot: Player): List<Int> {
+        val skill = CraftBook.skillLevel(bot)
+        if (bot.dwarvenRecipeBook.size >= bot.dwarfRecipeLimit) return emptyList()
+        return demand().keys.asSequence()
+                .flatMap { CraftBook.forProduct(it).asSequence() }
+                .filter { it.level <= skill && !bot.hasRecipeList(it.id) && potential(it) > 0 }
+                .map { it.recipeId }
+                .distinct()
+                .take(3)
+                .toList()
+    }
+
+    fun hasMaterials(bot: Player, recipe: Recipe, crafts: Int = 1): Boolean =
+            recipe.materials.all { Gear.count(bot, it.id) >= it.value * crafts }
+
+    /** Weight of one craft's product: it must fit the bag before the craft is started. */
+    fun productWeight(recipe: Recipe): Int = (ItemTable.getInstance().getTemplate(recipe.product.id)?.weight ?: 0) * recipe.product.value
+
+    /** Workshops around [bot] that make [recipe], cheapest fee first. */
+    fun workshopsFor(bot: Player, recipe: Recipe): List<Pair<Player, Int>> = Market.storesNear(bot)
+            .filter { it.storeType == StoreType.MANUFACTURE && it.createList != null }
+            .mapNotNull { owner -> owner.createList.list.firstOrNull { it.id == recipe.id }?.let { owner to it.value } }
+            .sortedBy { it.second }
+
+    /** Items the crafting population wants: crafters' shopping lists plus whatever buy stores around the world bid on. */
+    fun wantedMaterials(): Set<Int> {
+        val now = System.currentTimeMillis()
+        if (now - wantedAt < DEMAND_REFRESH_MS) return wantedCache
+        val wanted = HashSet<Int>()
+        for (bot in AutobotsManager.activeBots.values) {
+            if (bot.life == null || !bot.isOnline) continue
+            if (CraftBook.isCrafter(bot)) wanted += shoppingList(bot).keys
+            if (bot.storeType == StoreType.BUY) wanted += bot.buyList.items.map { it.item.itemId }.filter { CraftBook.isInput(it) }
+        }
+        wantedCache = wanted
+        wantedAt = now
+        return wanted
+    }
+
+    @Volatile private var wantedAt = 0L
+    @Volatile private var wantedCache: Set<Int> = emptySet()
+
+    fun isPopulationCrafter(bot: Autobot): Boolean = bot.life != null && CraftBook.isCrafter(bot)
+}
