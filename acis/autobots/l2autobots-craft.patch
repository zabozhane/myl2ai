@@ -0,0 +1,82 @@
+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.population.economy.Deal
+import dev.l2j.autobots.population.economy.EconomyLog
+import dev.l2j.autobots.population.economy.Gear
+import net.sf.l2j.commons.math.MathUtil
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.craft.ManufactureItem
+import net.sf.l2j.gameserver.model.craft.ManufactureList
+import net.sf.l2j.gameserver.model.craft.RecipeItemMaker
+import net.sf.l2j.gameserver.model.item.Recipe
+import net.sf.l2j.gameserver.network.serverpackets.RecipeShopMsg
+
+/**
+ * Dwarven Manufacture: the crafter sells its work, the customer brings the materials and pays a fee. Opening one is
+ * what `RequestRecipeShopListSet` does; ordering mirrors `RequestRecipeShopMakeItem`.
+ */
+internal object Workshop {
+    private const val MAX_RECIPES = 20
+    private const val MAX_TITLE = 29
+
+    /** Fee as a share of the product value, fixed per crafter and recipe so the price list doesn't jump around. */
+    fun fee(bot: Player, recipe: Recipe): Int {
+        val share = 0.05 + 0.10 * (Math.floorMod(bot.objectId * 7919 + recipe.id * 104729, 1000) / 1000.0)
+        return (CraftBook.productValue(recipe.product.id).toLong() * recipe.product.value * share).toInt().coerceAtLeast(1)
+    }
+
+    /** Recipes worth offering: something bots want, or a product worth more than a token fee. */
+    fun offer(bot: Autobot): List<Recipe> {
+        val demand = CraftPlanner.demand()
+        return CraftPlanner.knownRecipes(bot)
+                .filter { (demand[it.product.id] ?: 0) > 0 || fee(bot, it) >= MIN_FEE }
+                .sortedWith(compareByDescending<Recipe> { demand[it.product.id] ?: 0 }.thenByDescending { CraftBook.productValue(it.product.id) })
+                .take(MAX_RECIPES)
+    }
+
+    fun open(bot: Autobot): Boolean {
+        val recipes = offer(bot)
+        if (recipes.isEmpty()) return false
+        val list = ManufactureList()
+        recipes.forEach { list.add(ManufactureItem(it.id, fee(bot, it))) }
+        val first = ItemTable.getInstance().getTemplate(recipes.first().product.id).name
+        val title = if (recipes.size > 1) "Craft $first and more" else "Craft $first"
+        list.storeName = title.take(MAX_TITLE)
+        bot.createList = list
+
+        bot.sitDown()
+        bot.storeType = StoreType.MANUFACTURE
+        bot.broadcastUserInfo()
+        bot.broadcastPacket(RecipeShopMsg(bot))
+        EconomyLog.log(bot, Deal.Workshop, "opened workshop: " + recipes.joinToString { "${ItemTable.getInstance().getTemplate(it.product.id).name} @${fee(bot, it)}" })
+        return true
+    }
+
+    /**
+     * Orders one craft from [owner]'s workshop with the customer's own materials. Same checks as the client request;
+     * the maker takes the fee and the materials and hands over the product on success.
+     * @return true if the product was made.
+     */
+    fun order(customer: Autobot, owner: Player, recipe: Recipe): Boolean {
+        if (owner.storeType != StoreType.MANUFACTURE || customer.isInStoreMode) return false
+        if (customer.isCrafting || owner.isCrafting || owner.isInCombat || customer.isInCombat) return false
+        if (!MathUtil.checkIfInRange(150, customer, owner, true)) return false
+        if (!owner.dwarvenRecipeBook.contains(recipe)) return false
+        val fee = owner.createList?.list?.firstOrNull { it.id == recipe.id }?.value ?: return false
+
+        val productId = recipe.product.id
+        val before = Gear.count(customer, productId)
+        val maker = RecipeItemMaker(owner, recipe, customer)
+        if (!maker._isValid) return false
+        maker.run()
+        val made = Gear.count(customer, productId) - before
+        val name = ItemTable.getInstance().getTemplate(productId).name
+        EconomyLog.log(customer, Deal.CraftOrder, (if (made > 0) "ordered ${made}x $name" else "order of $name failed") + " from workshop of ${owner.name} for $fee")
+        return made > 0
+    }
+
+    private const val MIN_FEE = 500
+}
