+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.economy.Market
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.xml.RecipeData
+import net.sf.l2j.gameserver.enums.actors.ClassId
+import net.sf.l2j.gameserver.model.L2Skill
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.Recipe
+
+/**
+ * The dwarven recipes of `recipes.xml`, indexed the ways bots ask about them: what makes an item, which items are
+ * crafting inputs, which item is a recipe. Common craft (food, fishing) is left out.
+ */
+internal object CraftBook {
+    // recipes.xml ids run from 1 to under a thousand; RecipeData has no list getter.
+    private const val MAX_RECIPE_ID = 5000
+
+    /** Player level at which Create Item reaches a level, from the dwarf skill trees (Artisan 20-36, Warsmith 43-70). */
+    private val PLAYER_LEVEL_FOR_SKILL = intArrayOf(0, 5, 20, 28, 36, 43, 49, 55, 62, 70)
+
+    val recipes: List<Recipe> by lazy {
+        (1..MAX_RECIPE_ID).mapNotNull { RecipeData.getInstance().getRecipeList(it) }
+                .filter { it.isDwarven && ItemTable.getInstance().getTemplate(it.product.id) != null }
+                .also { println("Autobots economy: ${it.size} dwarven recipes indexed.") }
+    }
+
+    private val byProduct: Map<Int, List<Recipe>> by lazy { recipes.groupBy { it.product.id } }
+    private val byRecipeItem: Map<Int, Recipe> by lazy { recipes.associateBy { it.recipeId } }
+    private val inputs: Set<Int> by lazy { recipes.flatMap { recipe -> recipe.materials.map { it.id } }.toSet() }
+
+    fun forProduct(itemId: Int): List<Recipe> = byProduct[itemId].orEmpty()
+
+    fun byRecipeItem(itemId: Int): Recipe? = byRecipeItem[itemId]
+
+    fun isRecipeItem(itemId: Int): Boolean = itemId in byRecipeItem
+
+    /** A material, key part, crystal or gemstone some recipe consumes. */
+    fun isInput(itemId: Int): Boolean = itemId in inputs
+
+    fun isCraftGoods(itemId: Int): Boolean = isInput(itemId) || isRecipeItem(itemId)
+
+    val enabled: Boolean get() = AutobotData.settings.economyEnabled && AutobotData.settings.craftEnabled
+
+    fun skillLevel(bot: Player): Int = bot.getSkillLevel(L2Skill.SKILL_CREATE_DWARVEN)
+
+    fun playerLevelFor(recipeLevel: Int): Int = PLAYER_LEVEL_FOR_SKILL.getOrElse(recipeLevel) { Int.MAX_VALUE }
+
+    /** Artisan line: the dwarves who make crafting their trade. */
+    fun isCrafter(bot: Player): Boolean = enabled && skillLevel(bot) > 0 && bot.classId.equalsOrChildOf(ClassId.ARTISAN)
+
+    /** Scavenger line: spoilers who supply the crafters. */
+    fun isSupplier(bot: Player): Boolean = enabled && bot.classId.equalsOrChildOf(ClassId.SCAVENGER)
+
+    /** Any dwarf from level 5 crafts No-grade recipes; the Artisan line goes further. */
+    fun canCraft(bot: Player): Boolean = enabled && skillLevel(bot) > 0
+
+    /** What one piece of a product is worth on the market: the shop price if shops sell it, otherwise its reference price. */
+    fun productValue(itemId: Int): Int = Market.fairValue(itemId)
+}
