+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.WantedLoot
+import dev.l2j.autobots.population.economy.Gear
+
+/**
+ * Who farms on purpose and for what. Like a chronotype, it's a trait derived from the object id: half of the
+ * spoilers go where monsters give the materials crafters are short of, a fifth of other hunters go where the parts
+ * of their next kit piece drop; everyone else just hunts by level and sells what falls.
+ */
+internal object Prospecting {
+    private const val TARGETED_SPOILER_PERCENT = 50
+    private const val TARGETED_HUNTER_PERCENT = 20
+
+    private fun trait(bot: Autobot): Int = Math.floorMod(bot.objectId * 131 + 17, 100)
+
+    fun wantedLoot(bot: Autobot): WantedLoot? {
+        if (!CraftBook.enabled) return null
+        if (CraftBook.isSupplier(bot)) {
+            if (trait(bot) >= TARGETED_SPOILER_PERCENT) return null
+            return WantedLoot(CraftPlanner.wantedMaterials(), spoil = true).takeIf { it.items.isNotEmpty() }
+        }
+        if (trait(bot) >= TARGETED_HUNTER_PERCENT) return null
+        // Parts and patterns for the next kit piece, minus those already in the bag in full.
+        val needed = Gear.wishes(bot).take(1)
+                .flatMap { wish -> CraftBook.forProduct(wish.itemId).flatMap { it.materials } }
+                .filter { Gear.count(bot, it.id) < it.value }
+                .map { it.id }
+                .toSet()
+        return WantedLoot(needed, spoil = false).takeIf { it.items.isNotEmpty() }
+    }
+}
