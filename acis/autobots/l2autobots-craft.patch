+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import kotlinx.coroutines.delay
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.enums.items.EtcItemType
+import net.sf.l2j.gameserver.handler.ItemHandler
+import net.sf.l2j.gameserver.model.craft.RecipeItemMaker
+import net.sf.l2j.gameserver.model.item.Recipe
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * A dwarf's work in town: learn the recipes it carries, buy the materials it lacks, then craft what earns money.
+ * Every step goes through the code a client request would run: the `Recipes` item handler and `RecipeItemMaker`.
+ */
+internal object Crafter {
+    private const val MAX_CRAFTS_PER_VISIT = 40
+    private const val MAX_MP_WAIT_SECONDS = 90
+    /** Craft goods a bot keeps may weigh up to this share of its limit; the rest goes to the market. */
+    const val STOCK_WEIGHT_PERCENT = 25
+    /** A recipe a few levels out of reach is kept for later, like a player saving it for the next skill level. */
+    private const val KEEP_RECIPE_LEVELS_AHEAD = 5
+
+    // What each crafter paid per piece of what it made: its sell store never goes below that.
+    private val costs = ConcurrentHashMap<Int, MutableMap<Int, Int>>()
+
+    fun costFloor(bot: Autobot, itemId: Int): Int = costs[bot.objectId]?.get(itemId) ?: 0
+
+    suspend fun work(bot: Autobot) {
+        if (!CraftBook.canCraft(bot) || bot.isInStoreMode) return
+        learnRecipes(bot)
+        if (CraftBook.isCrafter(bot)) {
+            buyMaterials(bot)
+        }
+        craft(bot)
+    }
+
+    /** Recipe items the bot carries that it can't learn yet but will soon: kept instead of sold. */
+    fun recipesToKeep(bot: Autobot): List<Int> {
+        if (!CraftBook.isCrafter(bot)) return emptyList()
+        return bot.inventory.items.mapNotNull { item ->
+            val recipe = CraftBook.byRecipeItem(item.itemId) ?: return@mapNotNull null
+            item.itemId.takeIf { !bot.hasRecipeList(recipe.id) && CraftBook.playerLevelFor(recipe.level) - bot.level <= KEEP_RECIPE_LEVELS_AHEAD }
+        }
+    }
+
+    private fun learnRecipes(bot: Autobot) {
+        for (item in bot.inventory.items.filter { it.item.itemType == EtcItemType.RECIPE }) {
+            val recipe = CraftBook.byRecipeItem(item.itemId) ?: continue
+            if (bot.hasRecipeList(recipe.id) || recipe.level > CraftBook.skillLevel(bot)) continue
+            if (bot.dwarvenRecipeBook.size >= bot.dwarfRecipeLimit) return
+            val handler = ItemHandler.getInstance().getHandler(item.etcItem) ?: continue
+            handler.useItem(bot, item, false)
+            if (bot.hasRecipeList(recipe.id)) {
+                EconomyLog.log(bot, Deal.RecipeLearn, "learned ${item.itemName} (book ${bot.dwarvenRecipeBook.size}/${bot.dwarfRecipeLimit})")
+                RecipeBookDao.save(bot)
+            }
+        }
+    }
+
+    /** Buys missing materials in town where the price still leaves the craft profitable. */
+    private fun buyMaterials(bot: Autobot) {
+        for ((itemId, need) in CraftPlanner.shoppingList(bot)) {
+            var left = need
+            val value = CraftBook.productValue(itemId)
+            // Private stores first, at no more than the market value.
+            for (offer in Market.sellOffers(bot, itemId).filter { it.tradeItem.price <= value }) {
+                if (left <= 0) break
+                val count = minOf(left, offer.tradeItem.count, Errands.spendable(bot) / offer.tradeItem.price.coerceAtLeast(1))
+                if (count <= 0 || !fits(bot, itemId, count)) break
+                if (Market.buyFromStore(bot, offer, count)) left -= count
+            }
+            if (left <= 0) continue
+            // Then a town shop if one sells it (Soul Ore is the only material they do).
+            val (shop, product) = Market.findProduct(bot, itemId) ?: continue
+            val price = Market.priceWithTax(shop, product).coerceAtLeast(1)
+            val count = minOf(left, Errands.spendable(bot) / 2 / price)
+            if (count > 0 && fits(bot, itemId, count)) Market.buyFromNpc(bot, shop, product, count)
+        }
+    }
+
+    private fun fits(bot: Autobot, itemId: Int, count: Int): Boolean {
+        val weight = (ItemTable.getInstance().getTemplate(itemId)?.weight ?: 0).toLong() * count
+        return weight <= Int.MAX_VALUE && bot.inventory.validateWeight(weight.toInt()) && bot.inventory.validateCapacityByItemId(itemId)
+    }
+
+    /**
+     * Crafts while materials and MP last: intermediates a better recipe is short of, then the best recipe that earns
+     * money or that some bot online wants. Waits sitting for MP like a player does.
+     */
+    private suspend fun craft(bot: Autobot) {
+        var crafts = 0
+        while (crafts < MAX_CRAFTS_PER_VISIT && !bot.isDead && !bot.isInStoreMode) {
+            val recipe = nextCraft(bot) ?: return
+            if (bot.currentMp < recipe.mpCost && !waitForMp(bot, recipe.mpCost)) return
+            if (!makeOne(bot, recipe)) return
+            crafts++
+            delay(Rnd.get(1500, 3500).toLong())
+        }
+    }
+
+    private fun nextCraft(bot: Autobot): Recipe? {
+        val demand = CraftPlanner.demand()
+        val ranked = CraftPlanner.ranked(bot)
+        for (recipe in ranked) {
+            // Don't flood the market: stop at a few pieces of gear nobody asks for, keep going on shots and materials.
+            val stock = Gear.count(bot, recipe.product.id)
+            val wanted = demand[recipe.product.id] ?: 0
+            val product = ItemTable.getInstance().getTemplate(recipe.product.id) ?: continue
+            if (!product.isStackable && stock >= maxOf(1, wanted)) continue
+            if (CraftPlanner.hasMaterials(bot, recipe)) {
+                if ((CraftPlanner.margin(bot, recipe) ?: 0) > 0 || wanted > 0) return recipe.takeIf { fitsProduct(bot, it) }
+                continue
+            }
+            // Short of a material a known recipe makes from what is at hand: make that first.
+            for (material in recipe.materials.filter { Gear.count(bot, it.id) < it.value }) {
+                val intermediate = CraftPlanner.knownRecipes(bot).firstOrNull { it.product.id == material.id && CraftPlanner.hasMaterials(bot, it) }
+                if (intermediate != null && fitsProduct(bot, intermediate)) return intermediate
+            }
+        }
+        return null
+    }
+
+    private fun fitsProduct(bot: Autobot, recipe: Recipe): Boolean =
+            bot.inventory.validateWeight(CraftPlanner.productWeight(recipe)) && bot.inventory.validateCapacityByItemId(recipe.product.id)
+
+    private suspend fun waitForMp(bot: Autobot, mp: Int): Boolean {
+        if (bot.maxMp < mp) return false
+        if (!bot.isSitting) bot.sitDown()
+        repeat(MAX_MP_WAIT_SECONDS) {
+            delay(1000)
+            if (bot.isDead || bot.isInCombat) return false
+            if (bot.currentMp >= mp) {
+                bot.standUp()
+                return true
+            }
+        }
+        bot.standUp()
+        return false
+    }
+
+    /** One craft on the bot itself, through the same maker the client's RequestRecipeItemMakeSelf uses. */
+    private fun makeOne(bot: Autobot, recipe: Recipe): Boolean {
+        if (bot.isCrafting || bot.isInStoreMode) return false
+        val productId = recipe.product.id
+        val cost = CraftPlanner.craftCost(bot, recipe) ?: 0
+        val before = Gear.count(bot, productId)
+        val maker = RecipeItemMaker(bot, recipe, bot)
+        if (!maker._isValid) {
+            bot.isCrafting = false
+            return false
+        }
+        maker.run()
+        val made = Gear.count(bot, productId) - before
+        val name = ItemTable.getInstance().getTemplate(productId).name
+        if (made > 0) {
+            costs.computeIfAbsent(bot.objectId) { ConcurrentHashMap() }[productId] = (cost / made).toInt().coerceAtLeast(1)
+            EconomyLog.log(bot, Deal.Craft, "crafted ${made}x $name (cost $cost, worth ${CraftBook.productValue(productId).toLong() * made})")
+            if (!ItemTable.getInstance().getTemplate(productId).isStackable) Chatter.maybeSay(bot, Chatter.CRAFT_SUCCESS, name)
+        } else {
+            EconomyLog.log(bot, Deal.CraftFail, "failed to craft $name (${recipe.successRate}%), lost materials worth $cost")
+            Chatter.maybeSay(bot, Chatter.CRAFT_FAIL, name)
+        }
+        return true
+    }
+}
