+-- Recipe books of autobots. The core's character_recipebook is cleaned on startup of every charId missing from
+-- `characters`, and bots live in `autobots`, so their books are kept here.
+CREATE TABLE IF NOT EXISTS `autobots_recipebook` (
+  `charId` INT UNSIGNED NOT NULL DEFAULT 0,
+  `recipeId` SMALLINT NOT NULL DEFAULT 0,
+  PRIMARY KEY (`charId`,`recipeId`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
