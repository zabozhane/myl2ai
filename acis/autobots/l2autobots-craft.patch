+package dev.l2j.autobots.population.economy.craft
+
+import dev.l2j.autobots.Autobot
+import net.sf.l2j.gameserver.model.actor.Player
+
+/**
+ * Craft goods a bot holds on to instead of selling: a crafter keeps the inputs of its known recipes and the recipes
+ * it will soon learn, anyone keeps the parts of its next kit piece. All of it within [Crafter.STOCK_WEIGHT_PERCENT]
+ * of the weight limit, heaviest stacks given up first; there is no warehouse yet.
+ */
+internal object CraftStock {
+    fun keep(bot: Player): Set<Int> {
+        if (bot !is Autobot || bot.life == null || !CraftBook.enabled) return emptySet()
+        val wanted = HashSet(Sourcing.inputsForWishes(bot))
+        if (CraftBook.canCraft(bot)) {
+            CraftPlanner.knownRecipes(bot).forEach { recipe -> recipe.materials.forEach { wanted += it.id } }
+            wanted += Crafter.recipesToKeep(bot)
+        }
+        if (wanted.isEmpty()) return wanted
+
+        val budget = bot.maxLoad.toLong() * Crafter.STOCK_WEIGHT_PERCENT / 100
+        var used = 0L
+        val kept = HashSet<Int>()
+        for (item in bot.inventory.items.filter { it.itemId in wanted && !it.isEquipped }.sortedBy { it.item.weight.toLong() * it.count }) {
+            val weight = item.item.weight.toLong() * item.count
+            if (used + weight > budget) break
+            used += weight
+            kept += item.itemId
+        }
+        return kept
+    }
+}
