@@ -0,0 +1,401 @@
+package dev.l2j.autobots.population.merchant
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.AutobotsManager
+import dev.l2j.autobots.CoScopes
+import dev.l2j.autobots.population.SessionPlan
+import dev.l2j.autobots.population.economy.Chatter
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.MarketBook
+import dev.l2j.autobots.population.economy.StoreKeeper
+import dev.l2j.autobots.population.economy.TradeTemper
+import dev.l2j.autobots.population.economy.craft.CraftBook
+import dev.l2j.autobots.population.economy.craft.CraftPlanner
+import dev.l2j.autobots.utils.Klock
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.enums.actors.StoreType
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.network.serverpackets.PrivateStoreMsgBuy
+import net.sf.l2j.gameserver.network.serverpackets.PrivateStoreMsgSell
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/** A merchant's trade, fixed for life by the object id like the rest of its character. */
+internal enum class MerchantRole {
+    None,
+    /** Bids on materials and recipes below the market and sells them on to crafters. */
+    Collector,
+    /** Buys what other stores sell too cheap and puts it up again at the market price. */
+    Reseller,
+    /** A dwarf crafter: also takes orders for things nobody can get in town (CraftOrders). */
+    Crafter
+}
+
+/** What other stages may listen to (rumors, stage 7): orders kept and broken, a big resale. */
+internal object MerchantEvents {
+    enum class Kind { OrderDone, OrderScam, OrderFailed, BigFlip }
+
+    fun interface Listener {
+        fun on(kind: Kind, merchant: Player?, merchantName: String, other: String, what: String, adena: Long)
+    }
+
+    val listeners = CopyOnWriteArrayList<Listener>()
+
+    fun fire(kind: Kind, merchant: Player?, merchantName: String, other: String, what: String, adena: Long) {
+        listeners.forEach {
+            try {
+                it.on(kind, merchant, merchantName, other, what, adena)
+            } catch (e: Exception) {
+                e.printStackTrace()
+            }
+        }
+    }
+}
+
+/**
+ * Bots that live off trading. A trader (session style, `SessionPlan.Style.Trader`) of level 20+ that is not a dwarf
+ * crafter is a collector or a reseller; crafters take orders. Their goods have a cost: what they paid for them, which
+ * their stores never go below. Goods are kept out of the usual surplus (no NPC sale) while the bag is light and for
+ * three days at most, then they are ordinary loot again.
+ */
+internal object Merchants {
+    const val MIN_LEVEL = 20
+    private const val COLLECTOR_MIN_SHARE = 0.55
+    private const val COLLECTOR_MAX_SHARE = 0.75
+    private const val COLLECTOR_BUDGET = 0.6
+    private const val COLLECTOR_MARKUP = 1.15
+    private const val RESELL_BELOW = 0.7
+    private const val RESELLER_MARKUP = 1.2
+    private const val RESELLER_BUDGET = 0.5
+    private const val RESELLER_BUYS = 3
+    private const val MIN_FLIP_VALUE = 1000
+    private const val MIN_FLIP_PROFIT = 500
+    private const val BIG_FLIP = 100_000L
+    private const val MIN_FLIP_BUDGET = 50_000
+    private const val STOCK_KEEP_MS = 3 * 24 * 3600_000L
+    private const val STOCK_MAX_LOAD = 50
+    private const val MAX_STACK_BID = 50
+    private const val MAX_TITLE = 29
+    private const val SUMMARY_MS = 600_000L
+    private const val SHOP_CAP = 0.95
+
+    val enabled get() = AutobotData.settings.economyEnabled && AutobotData.settings.merchantsEnabled
+
+    /** What one piece of a merchant's goods cost it, and since when it holds them. */
+    class Stock(var count: Int, var cost: Int, val since: Long)
+
+    private val stock = ConcurrentHashMap<Int, ConcurrentHashMap<Int, Stock>>()
+    /** A buy store a collector opened: inventory counts and bids at opening, to learn what it bought. */
+    private class BuyStore(val before: Map<Int, Int>, val bids: Map<Int, Int>)
+    private val buyStores = ConcurrentHashMap<Int, BuyStore>()
+
+    private val bought = AtomicInteger()
+    private val boughtAdena = AtomicLong()
+    private val sold = AtomicInteger()
+    private val profit = AtomicLong()
+    private val flips = AtomicInteger()
+
+    init {
+        Klock.start("merchants", SUMMARY_MS, SUMMARY_MS, CoScopes.generalScope) {
+            if (enabled) {
+                MerchantRep.save()
+                CraftOrders.expire()
+                summary()
+            }
+        }
+        MerchantRep.ensureLoaded()
+        CraftOrders.load()
+    }
+
+    fun botById(objectId: Int): Autobot? = net.sf.l2j.gameserver.model.World.getInstance().getPlayer(objectId) as? Autobot
+
+    fun role(bot: Player): MerchantRole {
+        if (!enabled || bot !is Autobot || bot.life == null || bot.level < MIN_LEVEL) return MerchantRole.None
+        if (CraftBook.isCrafter(bot)) return MerchantRole.Crafter
+        if (SessionPlan.baseStyleOf(bot.objectId) != SessionPlan.Style.Trader) return MerchantRole.None
+        return if (Math.floorMod(bot.objectId * 31 + 5, 2) == 0) MerchantRole.Collector else MerchantRole.Reseller
+    }
+
+    fun log(message: String) {
+        if (AutobotData.settings.merchantLog) println("Autobots merchants: $message")
+    }
+
+    fun log(bot: Player, message: String) = log("${bot.name} id=${bot.objectId} (lv ${bot.level}, ${role(bot)}, rep ${"%.1f".format(MerchantRep.score(bot))}): $message")
+
+    // ---------------------------------------------------------------- goods
+
+    private fun goodsOf(bot: Player): ConcurrentHashMap<Int, Stock> = stock.computeIfAbsent(bot.objectId) { ConcurrentHashMap() }
+
+    private fun addStock(bot: Player, itemId: Int, count: Int, cost: Int) {
+        val goods = goodsOf(bot)
+        val old = goods[itemId]
+        if (old == null) goods[itemId] = Stock(count, cost, System.currentTimeMillis())
+        else {
+            old.cost = ((old.cost.toLong() * old.count + cost.toLong() * count) / (old.count + count)).toInt()
+            old.count += count
+        }
+    }
+
+    /** Goods still held: what is left in the bag, while it is light and the goods are fresh. */
+    private fun liveStock(bot: Player): Map<Int, Stock> {
+        val goods = stock[bot.objectId] ?: return emptyMap()
+        val now = System.currentTimeMillis()
+        goods.entries.removeIf { (itemId, s) ->
+            s.count = minOf(s.count, Gear.count(bot, itemId))
+            s.count <= 0 || now - s.since > STOCK_KEEP_MS
+        }
+        if (Errands.loadPercent(bot) >= STOCK_MAX_LOAD) return emptyMap()
+        return goods
+    }
+
+    /** Item ids the usual surplus must leave alone: a merchant's goods and an order made for a customer. */
+    fun keep(bot: Player): Set<Int> {
+        if (!enabled) return emptySet()
+        return liveStock(bot).keys + CraftOrders.reservedFor(bot)
+    }
+
+    fun hasBusiness(bot: Autobot): Boolean = when (role(bot)) {
+        MerchantRole.Collector -> liveStock(bot).isNotEmpty() || collectorBids(bot).isNotEmpty()
+        // A reseller with money goes looking for bargains even with nothing to sell.
+        MerchantRole.Reseller -> liveStock(bot).isNotEmpty() || Errands.spendable(bot) >= MIN_FLIP_BUDGET
+        else -> false
+    }
+
+    // ---------------------------------------------------------------- stores
+
+    /** Opens a merchant's store in town. @return true if one was opened; false lets the usual stores try. */
+    fun openStore(bot: Autobot): Boolean {
+        val role = role(bot)
+        if (role != MerchantRole.Collector && role != MerchantRole.Reseller) return false
+        settleBuyStore(bot)
+        if (openSellStore(bot, role)) return true
+        return role == MerchantRole.Collector && openBuyStore(bot)
+    }
+
+    /** What a collector bids on: materials crafters look for and things bots want that no shop sells. */
+    private fun collectorBids(bot: Autobot): Map<Int, Int> {
+        val wanted = LinkedHashSet<Int>()
+        wanted += CraftPlanner.wantedMaterials()
+        wanted += CraftPlanner.demand().entries.sortedByDescending { it.value }.map { it.key }.filter { Market.npcPrice(it) == null }
+        val greed = TradeTemper.greed(bot)
+        val share = COLLECTOR_MAX_SHARE - (COLLECTOR_MAX_SHARE - COLLECTOR_MIN_SHARE) * greed
+        val bids = LinkedHashMap<Int, Int>()
+        for (itemId in wanted) {
+            val template = ItemTable.getInstance().getTemplate(itemId) ?: continue
+            if (!template.isTradable || template.isQuestItem) continue
+            val bid = (MarketBook.value(itemId) * share).toInt()
+            // Never worse for the seller than the shop: that's why anyone would come.
+            if (bid <= Market.npcSellPrice(itemId)) continue
+            bids[itemId] = bid
+        }
+        return bids
+    }
+
+    private fun openBuyStore(bot: Autobot): Boolean {
+        var budget = (Errands.spendable(bot) * COLLECTOR_BUDGET).toLong()
+        val list = bot.buyList
+        list.clear()
+        val bids = HashMap<Int, Int>()
+        for ((itemId, bid) in collectorBids(bot)) {
+            if (list.items.size >= bot.privateBuyStoreLimit) break
+            val template = ItemTable.getInstance().getTemplate(itemId) ?: continue
+            val count = if (template.isStackable) (budget / bid).coerceAtMost(MAX_STACK_BID.toLong()).toInt() else if (budget >= bid) 1 else 0
+            if (count <= 0) continue
+            list.addItemByItemId(itemId, count, bid)
+            bids[itemId] = bid
+            budget -= bid.toLong() * count
+        }
+        if (list.items.isEmpty()) return false
+        list.title = title("WTB mats:", list.items.first().item.name)
+        buyStores[bot.objectId] = BuyStore(bids.keys.associateWith { Gear.count(bot, it) }, bids)
+        bot.sitDown()
+        bot.storeType = StoreType.BUY
+        bot.broadcastUserInfo()
+        bot.broadcastPacket(PrivateStoreMsgBuy(bot))
+        log(bot, "opened buy store: " + list.items.joinToString { "${it.count}x ${it.item.name} @${it.price}" })
+        advertise(bot, "WTB mats ${list.items.take(3).joinToString { it.item.name }}, better than NPC")
+        return true
+    }
+
+    /** Sells its goods: never below what they cost plus the markup, around the market price otherwise. */
+    private fun openSellStore(bot: Autobot, role: MerchantRole): Boolean {
+        val goods = liveStock(bot)
+        if (goods.isEmpty()) return false
+        val greed = TradeTemper.greed(bot)
+        val list = bot.sellList
+        list.clear()
+        list.isPackaged = false
+        for ((itemId, s) in goods.entries.sortedByDescending { (id, s) -> MarketBook.value(id).toLong() * s.count }) {
+            if (list.items.size >= bot.privateSellStoreLimit) break
+            val item = bot.inventory.getItemByItemId(itemId)?.takeIf { !it.isEquipped && it.isTradable } ?: continue
+            val price = askingPrice(role, greed, itemId, s.cost)
+            list.addItem(item.objectId, minOf(s.count, item.count), price)
+        }
+        if (list.items.isEmpty()) return false
+        list.title = title("WTS", list.items.first().item.name)
+        bot.sitDown()
+        bot.storeType = StoreType.SELL
+        bot.broadcastUserInfo()
+        bot.broadcastPacket(PrivateStoreMsgSell(bot))
+        log(bot, "opened sell store: " + list.items.joinToString { "${it.count}x ${it.item.name} @${it.price} (cost ${goods[it.item.itemId]?.cost})" })
+        val first = list.items.first()
+        advertise(bot, "WTS ${first.item.name} ${first.price}a" + if (list.items.size > 1) " and more" else "")
+        return true
+    }
+
+    fun askingPrice(role: MerchantRole, greed: Double, itemId: Int, cost: Int): Int {
+        val value = MarketBook.value(itemId)
+        val (share, markup) = if (role == MerchantRole.Reseller) (1.0 + 0.15 * greed) to RESELLER_MARKUP else (0.95 + 0.15 * greed) to COLLECTOR_MARKUP
+        val price = maxOf((value * share).toInt(), (cost * markup).toInt(), Market.npcSellPrice(itemId) + 1)
+        // What a town shop sells nobody buys in a store for more than the shop asks.
+        val shop = Market.npcPrice(itemId) ?: return price
+        return minOf(price, (shop * SHOP_CAP).toInt())
+    }
+
+    /** A collector's buy store closed or ran out: what came in since it opened is now stock at the bid paid. */
+    private fun settleBuyStore(bot: Autobot) {
+        val store = buyStores.remove(bot.objectId) ?: return
+        for ((itemId, before) in store.before) {
+            val got = Gear.count(bot, itemId) - before
+            if (got <= 0) continue
+            val bid = store.bids[itemId] ?: continue
+            addStock(bot, itemId, got, bid)
+            bought.addAndGet(got)
+            boughtAdena.addAndGet(bid.toLong() * got)
+            log(bot, "bought ${got}x ${ItemTable.getInstance().getTemplate(itemId)?.name} in its buy store @$bid")
+        }
+    }
+
+    /** Called when any population store closes, before its lists are cleared. */
+    fun onStoreClosed(bot: Autobot) {
+        if (!enabled) return
+        if (bot.storeType == StoreType.BUY || buyStores.containsKey(bot.objectId)) settleBuyStore(bot)
+    }
+
+    /**
+     * A sale the market book saw in a store: merchants who sell at a fair price and buy at a decent one earn a
+     * name for it, overpricing costs some of it.
+     */
+    fun onStoreSale(ownerId: Int, itemId: Int, unitPrice: Int, count: Int, buyStore: Boolean) {
+        if (!enabled) return
+        val owner = Merchants.botById(ownerId) ?: return
+        val role = role(owner)
+        if (role == MerchantRole.None) return
+        val value = MarketBook.value(itemId).coerceAtLeast(1)
+        if (buyStore) {
+            if (unitPrice >= value * 0.6) MerchantRep.deal(ownerId, 0.3, 3.0)
+            return
+        }
+        when {
+            unitPrice <= value * 1.1 -> MerchantRep.deal(ownerId, 0.5, 5.0)
+            unitPrice > value * 1.4 -> MerchantRep.deal(ownerId, -0.5, 0.0)
+            else -> MerchantRep.deal(ownerId, 0.0, 0.0)
+        }
+        val s = stock[ownerId]?.get(itemId) ?: return
+        sold.addAndGet(count)
+        profit.addAndGet((unitPrice - s.cost).toLong() * count)
+        s.count -= count
+    }
+
+    // ---------------------------------------------------------------- in town
+
+    /**
+     * A merchant's round in town, between the usual errands: a collector sells its goods to crafters' buy stores that
+     * pay over its cost, a reseller buys what sells too cheap around. Customers and crafters settle their orders.
+     */
+    suspend fun inTown(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        if (!enabled || bot.isInStoreMode) return
+        when (role(bot)) {
+            MerchantRole.Collector -> sellToBuyStores(bot, walkTo)
+            MerchantRole.Reseller -> {
+                sellToBuyStores(bot, walkTo)
+                flip(bot, walkTo)
+            }
+            else -> {}
+        }
+        CraftOrders.inTown(bot, walkTo)
+    }
+
+    private suspend fun sellToBuyStores(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        for ((itemId, s) in liveStock(bot).entries.toList()) {
+            val offer = Market.buyOffers(bot, itemId).firstOrNull { it.owner !== bot && it.tradeItem.price >= s.cost * COLLECTOR_MARKUP } ?: continue
+            if (!walkTo(offer.owner)) continue
+            val item = bot.inventory.getItemByItemId(itemId)?.takeIf { !it.isEquipped } ?: continue
+            val count = minOf(s.count, item.count, offer.tradeItem.count)
+            if (count <= 0 || !Market.sellToStore(bot, offer, item, count)) continue
+            s.count -= count
+            sold.addAndGet(count)
+            profit.addAndGet((offer.tradeItem.price - s.cost).toLong() * count)
+            log(bot, "sold ${count}x ${item.itemName} to the buy store of ${offer.owner.name} @${offer.tradeItem.price} (cost ${s.cost})")
+        }
+    }
+
+    /** Buys what stores around sell well under the market: a novice's mistake or a price cut after days unsold. */
+    private suspend fun flip(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        var budget = (Errands.spendable(bot) * RESELLER_BUDGET).toLong()
+        var buys = 0
+        val greed = TradeTemper.greed(bot)
+        val bargains = Market.storesNear(bot)
+                .filter { it.storeType == StoreType.SELL && role(it) != MerchantRole.Reseller }
+                .flatMap { owner -> owner.sellList.items.map { dev.l2j.autobots.population.economy.StoreOffer(owner, it) } }
+                .mapNotNull { offer ->
+                    val itemId = offer.tradeItem.item.itemId
+                    val value = MarketBook.value(itemId)
+                    val price = offer.tradeItem.price
+                    if (value < MIN_FLIP_VALUE || price > value * RESELL_BELOW || price <= Market.npcSellPrice(itemId) || !offer.tradeItem.item.isTradable) null
+                    else {
+                        val gain = askingPrice(MerchantRole.Reseller, greed, itemId, price) - price
+                        if (gain < MIN_FLIP_PROFIT) null else offer to gain
+                    }
+                }
+                .sortedByDescending { (offer, gain) -> gain.toLong() * offer.tradeItem.count }
+        if (AutobotData.settings.merchantLog) log(bot, "looks for bargains: ${bargains.size} found, budget $budget")
+        for ((offer, gain) in bargains) {
+            if (buys >= RESELLER_BUYS) break
+            val price = offer.tradeItem.price
+            val count = minOf(offer.tradeItem.count.toLong(), budget / price.coerceAtLeast(1)).toInt()
+            if (count <= 0) continue
+            if (!walkTo(offer.owner)) continue
+            val itemId = offer.tradeItem.item.itemId
+            if (!Market.buyFromStore(bot, offer, count)) continue
+            buys++
+            budget -= price.toLong() * count
+            addStock(bot, itemId, count, price)
+            bought.addAndGet(count)
+            boughtAdena.addAndGet(price.toLong() * count)
+            flips.incrementAndGet()
+            log(bot, "bought ${count}x ${offer.tradeItem.item.name} from ${offer.owner.name} @$price to resell (market ${MarketBook.value(itemId)}, +$gain each)")
+            if (gain.toLong() * count >= BIG_FLIP)
+                MerchantEvents.fire(MerchantEvents.Kind.BigFlip, bot, bot.name, offer.owner.name, offer.tradeItem.item.name, gain.toLong() * count)
+        }
+    }
+
+    // ---------------------------------------------------------------- talk
+
+    fun advertise(bot: Autobot, text: String) {
+        val rep = MerchantRep.of(bot.objectId)
+        val tag = if (rep.score >= MerchantRep.TRUSTED) (if (rep.ordersDone > 0) ", trusted, ${rep.ordersDone} orders done" else ", trusted") else ""
+        Chatter.advertise(bot, "$text$tag, ${MapRegionData.getInstance().getClosestTownName(bot.x, bot.y)}")
+    }
+
+    private fun title(kind: String, first: String): String = "$kind $first".take(MAX_TITLE)
+
+    private fun summary() {
+        if (!AutobotData.settings.merchantLog) return
+        val online = AutobotsManager.activeBots.values.filter { it.isOnline && it.life != null }
+        val roles = online.groupingBy { role(it) }.eachCount()
+        val merchants = online.filter { role(it) != MerchantRole.None }
+        val stores = merchants.count { it.isInStoreMode }
+        val held = merchants.sumOf { m -> liveStock(m).values.sumOf { it.count } }
+        println("Autobots merchants summary: collectors=${roles[MerchantRole.Collector] ?: 0} resellers=${roles[MerchantRole.Reseller] ?: 0} " +
+                "crafters=${roles[MerchantRole.Crafter] ?: 0} stores=$stores held=$held bought=${bought.getAndSet(0)} boughtAdena=${boughtAdena.getAndSet(0)} " +
+                "sold=${sold.getAndSet(0)} profit=${profit.getAndSet(0)} flips=${flips.getAndSet(0)} ${CraftOrders.summary()} " +
+                "avgRep=${"%.1f".format(MerchantRep.average(merchants.map { it.objectId }))}")
+    }
+}
