+package dev.l2j.autobots.population.merchant
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.AutobotsManager
+import dev.l2j.autobots.population.economy.Chatter
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.population.economy.MarketBook
+import dev.l2j.autobots.population.economy.StoreKeeper
+import dev.l2j.autobots.population.economy.TradeTemper
+import dev.l2j.autobots.population.economy.craft.CraftBook
+import dev.l2j.autobots.population.economy.craft.CraftPlanner
+import dev.l2j.autobots.population.economy.craft.Crafter
+import dev.l2j.autobots.population.group.Relations
+import dev.l2j.autobots.population.trade.Honesty
+import dev.l2j.autobots.population.trade.Loan
+import dev.l2j.autobots.population.trade.Loans
+import dev.l2j.autobots.population.trade.Promise
+import dev.l2j.autobots.population.trade.SocialTrade
+import dev.l2j.autobots.population.trade.TradeWindow
+import kotlinx.coroutines.delay
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.ItemTable
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.item.Recipe
+import java.sql.Statement
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicInteger
+
+/** A craft ordered from a dwarf: paid [deposit] up front, the rest of [price] on delivery. */
+internal class CraftOrder(val id: Int, val crafterId: Int, val customerId: Int, val itemId: Int, val recipeId: Int, val price: Long,
+                          val deposit: Long, val created: Long, val due: Long, @Volatile var state: State) {
+    enum class State { Open, Ready, Done, Refunded, Lost, Scam }
+
+    val isActive get() = state == State.Open || state == State.Ready
+    val itemName: String get() = ItemTable.getInstance().getTemplate(itemId)?.name ?: "item $itemId"
+}
+
+/**
+ * Crafting to order: a bot that can't get the next piece of its kit in town (no shop, no store, no materials for a
+ * workshop) asks a crafter around who knows the recipe. The crafter quotes the market value, a bit less from an
+ * easy-going one, takes 30% up front and finds the materials itself; the bot pays the rest when it picks the piece up.
+ * Scammers take the deposit and never craft; opportunists take their time. Stored in `autobot_craft_orders`.
+ */
+internal object CraftOrders {
+    private const val DEPOSIT_SHARE = 0.3
+    private const val MAX_OPEN_PER_CRAFTER = 3
+    private const val WISHES_TO_CONSIDER = 3
+    private const val MATERIAL_OVERPAY = 1.3
+    /** An opportunist starts on the order only after this share of the term. */
+    private const val OPPORTUNIST_DELAY = 0.6
+    private const val HOUR_MS = 3600_000L
+
+    private val orders = CopyOnWriteArrayList<CraftOrder>()
+    @Volatile private var loaded = false
+
+    private val placed = AtomicInteger()
+    private val done = AtomicInteger()
+    private val lateCount = AtomicInteger()
+    private val failed = AtomicInteger()
+    private val scams = AtomicInteger()
+
+    private val termMs get() = AutobotData.settings.craftOrderHours.coerceAtLeast(1) * HOUR_MS
+    /** Past the term, how long a deposit may still come back before everyone calls it lost. */
+    private val graceMs get() = termMs * 4 / 3
+
+    fun all(): List<CraftOrder> = orders
+
+    private fun ofCrafter(bot: Player) = orders.filter { it.crafterId == bot.objectId && it.isActive }
+    private fun ofCustomer(bot: Player) = orders.filter { it.customerId == bot.objectId && it.isActive }
+
+    /** Products a crafter holds for its customers: not for sale. */
+    fun reservedFor(bot: Player): Set<Int> = orders.filter { it.crafterId == bot.objectId && it.state == CraftOrder.State.Ready }.map { it.itemId }.toSet()
+
+    private fun recipeOf(order: CraftOrder): Recipe? = CraftBook.forProduct(order.itemId).firstOrNull { it.id == order.recipeId }
+
+    /** Materials a crafter still lacks for the orders it works on: first in its shopping list and its buy store. */
+    fun materialsFor(bot: Player): Map<Int, Int> {
+        if (!Merchants.enabled) return emptyMap()
+        val wanted = HashMap<Int, Int>()
+        for (order in ofCrafter(bot).filter { it.state == CraftOrder.State.Open && worksOn(bot, it) }) {
+            val recipe = recipeOf(order) ?: continue
+            for ((id, need) in missing(bot, recipe)) wanted.merge(id, need, Int::plus)
+        }
+        return wanted
+    }
+
+    /** What is missing for one craft, materials a known recipe makes from what is at hand taken as their own inputs. */
+    private fun missing(bot: Player, recipe: Recipe): Map<Int, Int> {
+        val result = HashMap<Int, Int>()
+        for (material in recipe.materials) {
+            val need = material.value - Gear.count(bot, material.id)
+            if (need <= 0) continue
+            val sub = CraftPlanner.knownRecipes(bot).firstOrNull { it.product.id == material.id }
+            if (sub != null && sub.product.value > 0) {
+                val crafts = (need + sub.product.value - 1) / sub.product.value
+                for (m in sub.materials) {
+                    val n = m.value * crafts - Gear.count(bot, m.id)
+                    if (n > 0) result.merge(m.id, n, Int::plus)
+                }
+            } else result.merge(material.id, need, Int::plus)
+        }
+        return result
+    }
+
+    private fun worksOn(bot: Player, order: CraftOrder): Boolean = when (Honesty.of(bot)) {
+        Honesty.Scammer -> false
+        Honesty.Opportunist -> System.currentTimeMillis() >= order.created + ((order.due - order.created) * OPPORTUNIST_DELAY).toLong()
+        Honesty.Honest -> true
+    }
+
+    // ---------------------------------------------------------------- the crafter's side
+
+    /** In town, before its own crafts: buys what its orders lack and crafts them. Called from `Crafter.work`. */
+    suspend fun work(bot: Autobot) {
+        if (!Merchants.enabled || bot.isInStoreMode) return
+        for (order in ofCrafter(bot)) {
+            if (order.state != CraftOrder.State.Open || !worksOn(bot, order)) continue
+            val recipe = recipeOf(order) ?: continue
+            if (hasProduct(bot, order)) {
+                ready(bot, order)
+                continue
+            }
+            buyMaterials(bot, recipe)
+            // Intermediates first (braided hemp, cokes...), then the piece itself; a failure burns the materials, the
+            // crafter tries again on its next visit.
+            repeat(4) {
+                if (hasProduct(bot, order) || bot.isDead || bot.isInStoreMode) return@repeat
+                val next = if (CraftPlanner.hasMaterials(bot, recipe)) recipe
+                else recipe.materials.filter { Gear.count(bot, it.id) < it.value }
+                        .firstNotNullOfOrNull { m -> CraftPlanner.knownRecipes(bot).firstOrNull { it.product.id == m.id && CraftPlanner.hasMaterials(bot, it) } }
+                        ?: return@repeat
+                if (bot.currentMp < next.mpCost && !Crafter.waitForMp(bot, next.mpCost)) return@repeat
+                if (!Crafter.makeOne(bot, next)) return@repeat
+                delay(Rnd.get(1500, 3000).toLong())
+            }
+            if (hasProduct(bot, order)) ready(bot, order)
+        }
+    }
+
+    private fun hasProduct(bot: Player, order: CraftOrder): Boolean =
+            bot.inventory.getItemsByItemId(order.itemId).any { !it.isEquipped } &&
+                    // Two orders of one item need two pieces.
+                    bot.inventory.getItemsByItemId(order.itemId).count { !it.isEquipped } > orders.count { it.crafterId == bot.objectId && it.itemId == order.itemId && it.state == CraftOrder.State.Ready }
+
+    private fun ready(bot: Autobot, order: CraftOrder) {
+        order.state = CraftOrder.State.Ready
+        save(order)
+        Merchants.log(bot, "order #${order.id} ${order.itemName} for ${nameOf(order.customerId)} is ready")
+        Merchants.botById(order.customerId)?.let { customer -> if (Rnd.get(100) < 50) bot.tell(customer.name, "${order.itemName} done, come pick it up") }
+    }
+
+    private suspend fun buyMaterials(bot: Autobot, recipe: Recipe) {
+        for ((itemId, need) in missing(bot, recipe)) {
+            var left = need
+            val most = (CraftBook.productValue(itemId) * MATERIAL_OVERPAY).toInt().coerceAtLeast(1)
+            for (offer in Market.sellOffers(bot, itemId).filter { it.tradeItem.price <= most }) {
+                if (left <= 0) break
+                val count = minOf(left, offer.tradeItem.count, Errands.spendable(bot) / offer.tradeItem.price.coerceAtLeast(1))
+                if (count <= 0) break
+                if (Market.buyFromStore(bot, offer, count)) left -= count
+            }
+            if (left <= 0) continue
+            val (shop, product) = Market.findProduct(bot, itemId) ?: continue
+            val count = minOf(left, Errands.spendable(bot) / Market.priceWithTax(shop, product).coerceAtLeast(1))
+            if (count > 0) Market.buyFromNpc(bot, shop, product, count)
+        }
+    }
+
+    // ---------------------------------------------------------------- the customer's side
+
+    /** In town: picks up what is ready, asks for a deposit back, or orders the next piece of its kit. */
+    suspend fun inTown(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        if (!Merchants.enabled || bot.level < Merchants.MIN_LEVEL) return
+        if (!loaded) load()
+        for (order in ofCustomer(bot)) settle(bot, order, walkTo)
+        if (ofCustomer(bot).isEmpty()) place(bot, walkTo)
+    }
+
+    private fun crafterNear(bot: Player, order: CraftOrder): Autobot? {
+        val crafter = Merchants.botById(order.crafterId) ?: return null
+        return crafter.takeIf { it.isOnline && !it.isDead && dev.l2j.autobots.utils.distance(bot, it) <= Market.STORE_RADIUS }
+    }
+
+    private suspend fun settle(bot: Autobot, order: CraftOrder, walkTo: suspend (Player) -> Boolean) {
+        val now = System.currentTimeMillis()
+        val crafter = crafterNear(bot, order)
+        val overdue = now > order.due
+        when {
+            order.state == CraftOrder.State.Ready && crafter != null -> deliver(bot, crafter, order, overdue, walkTo)
+            overdue && Honesty.of(order.crafterId) == Honesty.Scammer -> scammed(bot, order)
+            overdue && crafter != null && order.state == CraftOrder.State.Open -> refund(bot, crafter, order, walkTo)
+        }
+    }
+
+    /** Crafters standing up for a customer, until when: their trading segment doesn't reopen the store meanwhile. */
+    private val busy = java.util.concurrent.ConcurrentHashMap<Int, Long>()
+    private const val BUSY_MS = 90_000L
+
+    fun isBusy(bot: Player): Boolean = (busy[bot.objectId] ?: 0L) > System.currentTimeMillis()
+
+    private suspend fun meet(bot: Autobot, crafter: Autobot, walkTo: suspend (Player) -> Boolean): Boolean {
+        // Customers find a crafter behind its store or idling in town, like players do; one on its way somewhere may be
+        // gone by the time they get there.
+        val idle = crafter.isInsideZone(net.sf.l2j.gameserver.enums.ZoneId.TOWN) && !crafter.isMoving && !crafter.isInCombat && crafter.activeSequence == null
+        if (!(crafter.isInStoreMode || idle) || crafter.isCrafting || crafter.activeTradeList != null || isBusy(crafter)) return false
+        if (!walkTo(crafter)) return false
+        // A crafter behind its store stands up for the deal; its trading segment opens the store again afterwards.
+        busy[crafter.objectId] = System.currentTimeMillis() + BUSY_MS
+        if (crafter.isInStoreMode) {
+            StoreKeeper.close(crafter)
+            delay(1500)
+        }
+        return true
+    }
+
+    private fun release(crafter: Player) {
+        busy.remove(crafter.objectId)
+    }
+
+    private suspend fun deliver(bot: Autobot, crafter: Autobot, order: CraftOrder, late: Boolean, walkTo: suspend (Player) -> Boolean) {
+        val rest = (order.price - order.deposit).toInt()
+        if (bot.adena < rest) {
+            Merchants.log(bot, "can't pay the rest $rest for order #${order.id} ${order.itemName} yet")
+            return
+        }
+        val item = crafter.inventory.getItemsByItemId(order.itemId).firstOrNull { !it.isEquipped } ?: run {
+            // Sold or lost after all: back to work.
+            order.state = CraftOrder.State.Open
+            save(order)
+            return
+        }
+        if (!meet(bot, crafter, walkTo)) return
+        val adena = bot.inventory.adenaInstance ?: return
+        val outcome = TradeWindow.exchange(bot, crafter, listOf(adena to rest), listOf(item to 1), listOf(Promise(Loan.ADENA, 0, rest)), maxDistance = Market.STORE_RADIUS)
+        release(crafter)
+        if (outcome != TradeWindow.Outcome.Done) {
+            Merchants.log(bot, "pick-up of order #${order.id} from ${crafter.name} failed: $outcome")
+            return
+        }
+        order.state = CraftOrder.State.Done
+        save(order)
+        MerchantRep.order(crafter.objectId, if (late) MerchantRep.Order.Late else MerchantRep.Order.OnTime)
+        Relations.adjust(bot, crafter.objectId, if (late) 2 else 5, 3)
+        Relations.adjust(crafter, bot.objectId, 3, 3)
+        MarketBook.recordSale(order.itemId, order.price.toInt(), 1)
+        (if (late) lateCount else done).incrementAndGet()
+        Merchants.log(bot, "picked up order #${order.id} ${order.itemName} from ${crafter.name}, paid ${order.price} in all" + if (late) " (late)" else "")
+        MerchantEvents.fire(MerchantEvents.Kind.OrderDone, crafter, crafter.name, bot.name, order.itemName, order.price)
+        bot.inventory.getItemsByItemId(order.itemId).firstOrNull { !it.isEquipped }?.let {
+            Gear.equip(bot, it)
+            Chatter.maybeSay(bot, Chatter.BOUGHT_UPGRADE, it.itemName)
+        }
+    }
+
+    private suspend fun refund(bot: Autobot, crafter: Autobot, order: CraftOrder, walkTo: suspend (Player) -> Boolean) {
+        if (!meet(bot, crafter, walkTo)) return
+        val adena = crafter.inventory.adenaInstance
+        val deposit = order.deposit.toInt()
+        val back = adena != null && adena.count >= deposit &&
+                TradeWindow.exchange(crafter, bot, listOf(adena to deposit), emptyList(), listOf(Promise(Loan.ADENA, 0, deposit)), maxDistance = Market.STORE_RADIUS) == TradeWindow.Outcome.Done
+        release(crafter)
+        if (!back) {
+            Merchants.log(bot, "${crafter.name} couldn't give back the deposit of order #${order.id} yet")
+            return
+        }
+        order.state = CraftOrder.State.Refunded
+        save(order)
+        MerchantRep.order(crafter.objectId, MerchantRep.Order.Refunded)
+        failed.incrementAndGet()
+        Merchants.log(bot, "got the deposit $deposit of order #${order.id} ${order.itemName} back from ${crafter.name}: not made in time")
+        MerchantEvents.fire(MerchantEvents.Kind.OrderFailed, crafter, crafter.name, bot.name, order.itemName, order.deposit)
+    }
+
+    private fun scammed(customer: Player, order: CraftOrder) {
+        order.state = CraftOrder.State.Scam
+        save(order)
+        val name = nameOf(order.crafterId)
+        MerchantRep.order(order.crafterId, MerchantRep.Order.Scam)
+        scams.incrementAndGet()
+        Merchants.log(customer, "order #${order.id} ${order.itemName}: $name kept the deposit ${order.deposit} and made nothing")
+        SocialTrade.scammed(customer, order.crafterId, name, "${order.itemName} order (${order.deposit}a up front)")
+        MerchantEvents.fire(MerchantEvents.Kind.OrderScam, Merchants.botById(order.crafterId), name, customer.name, order.itemName, order.deposit)
+    }
+
+    /** The bot can't get its next piece any other way: finds a crafter around who makes it and orders it. */
+    private suspend fun place(bot: Autobot, walkTo: suspend (Player) -> Boolean) {
+        val allowedGrade = Gear.gradeFor(bot.level).id
+        for (wish in Gear.wishes(bot).take(WISHES_TO_CONSIDER)) {
+            if (wish.template.crystalType.id > allowedGrade || Market.npcPrice(wish.itemId) != null) continue
+            val recipes = CraftBook.forProduct(wish.itemId)
+            if (recipes.isEmpty()) continue
+            // A store, a workshop or its own craft it can afford: the usual errands take care of it.
+            val routes = dev.l2j.autobots.population.economy.craft.Sourcing.routes(bot, wish.itemId)
+            if (routes.any { it.cost <= Errands.spendable(bot) }) continue
+            val offers = crafters(bot, recipes).map { (crafter, recipe) -> Triple(crafter, recipe, quote(crafter, wish.itemId)) }
+                    .filter { (_, _, price) -> price in 1..Errands.spendable(bot).toLong() }
+                    // Reputation counts as much as the price: a stranger has to be quite a bit cheaper.
+                    .sortedBy { (crafter, _, price) -> price / (0.5 + MerchantRep.score(crafter) / 100) }
+            val (crafter, recipe, price) = offers.firstOrNull() ?: continue
+            if (order(bot, crafter, recipe, wish.itemId, price, walkTo)) return
+        }
+    }
+
+    private fun crafters(bot: Autobot, recipes: List<Recipe>): List<Pair<Autobot, Recipe>> =
+            bot.getKnownTypeInRadius(Autobot::class.java, Market.STORE_RADIUS)
+                    .filter { it !== bot && it.isOnline && !it.isDead && Merchants.role(it) == MerchantRole.Crafter }
+                    .filter { ofCrafter(it).size < MAX_OPEN_PER_CRAFTER && MerchantRep.score(it) >= MerchantRep.MIN_FOR_ORDERS }
+                    .filter { Relations.trust(bot, it.objectId) > Relations.AVOID }
+                    .mapNotNull { crafter -> recipes.firstOrNull { crafter.dwarvenRecipeBook.contains(it) && it.level <= CraftBook.skillLevel(crafter) }?.let { crafter to it } }
+
+    /** What a crafter asks for a piece: its market value, somewhat less from an easy-going one. */
+    fun quote(crafter: Player, itemId: Int): Long = (MarketBook.value(itemId) * (0.85 + 0.15 * TradeTemper.greed(crafter))).toLong()
+
+    private suspend fun order(bot: Autobot, crafter: Autobot, recipe: Recipe, itemId: Int, price: Long, walkTo: suspend (Player) -> Boolean): Boolean {
+        val deposit = (price * DEPOSIT_SHARE).toLong().coerceAtLeast(1)
+        if (!meet(bot, crafter, walkTo)) return false
+        val adena = bot.inventory.adenaInstance ?: return false
+        val name = ItemTable.getInstance().getTemplate(itemId)?.name ?: return false
+        bot.tell(crafter.name, "can you make $name? ${deposit}a up front")
+        delay(Rnd.get(1500, 4000).toLong())
+        val outcome = TradeWindow.exchange(bot, crafter, listOf(adena to deposit.toInt()), emptyList(), listOf(Promise(Loan.ADENA, 0, deposit.toInt())), maxDistance = Market.STORE_RADIUS)
+        release(crafter)
+        if (outcome != TradeWindow.Outcome.Done) {
+            Merchants.log(bot, "order of $name from ${crafter.name} failed: $outcome")
+            return false
+        }
+        val now = System.currentTimeMillis()
+        val order = insert(CraftOrder(0, crafter.objectId, bot.objectId, itemId, recipe.id, price, deposit, now, now + termMs, CraftOrder.State.Open)) ?: return false
+        orders += order
+        placed.incrementAndGet()
+        crafter.tell(bot.name, "ok, ${price}a in all, give me a couple of days")
+        Merchants.log(bot, "ordered #${order.id} $name from ${crafter.name} (rep ${"%.1f".format(MerchantRep.score(crafter))}, ${Honesty.of(crafter)}) for $price, paid $deposit up front")
+        return true
+    }
+
+    // ---------------------------------------------------------------- upkeep
+
+    /** Every 10 minutes: deposits nobody gave back in time are lost; a scammer's customer online complains. */
+    fun expire() {
+        val now = System.currentTimeMillis()
+        for (order in orders.filter { it.isActive && now > it.due }) {
+            val scammer = Honesty.of(order.crafterId) == Honesty.Scammer
+            val customer = Merchants.botById(order.customerId)?.takeIf { it.isOnline }
+            when {
+                scammer && customer != null -> scammed(customer, order)
+                now > order.due + graceMs -> {
+                    order.state = if (scammer) CraftOrder.State.Scam else CraftOrder.State.Lost
+                    save(order)
+                    MerchantRep.order(order.crafterId, if (scammer) MerchantRep.Order.Scam else MerchantRep.Order.Lost)
+                    (if (scammer) scams else failed).incrementAndGet()
+                    Merchants.log("order #${order.id} ${order.itemName} of ${nameOf(order.customerId)} from ${nameOf(order.crafterId)}: deposit ${order.deposit} lost")
+                    MerchantEvents.fire(if (scammer) MerchantEvents.Kind.OrderScam else MerchantEvents.Kind.OrderFailed,
+                            Merchants.botById(order.crafterId), nameOf(order.crafterId), nameOf(order.customerId), order.itemName, order.deposit)
+                }
+            }
+        }
+        orders.removeIf { !it.isActive }
+    }
+
+    fun summary(): String {
+        val active = orders.filter { it.isActive }
+        return "orders open=${active.count { it.state == CraftOrder.State.Open }} ready=${active.count { it.state == CraftOrder.State.Ready }} " +
+                "placed=${placed.getAndSet(0)} done=${done.getAndSet(0)} late=${lateCount.getAndSet(0)} failed=${failed.getAndSet(0)} scams=${scams.getAndSet(0)}"
+    }
+
+    private fun nameOf(objectId: Int): String = Merchants.botById(objectId)?.name ?: Loans.nameOf(objectId) ?: "id $objectId"
+
+    // ---------------------------------------------------------------- storage
+
+    @Synchronized
+    fun load() {
+        if (loaded) return
+        loaded = true
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.createStatement().use {
+                    it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_craft_orders (id INT UNSIGNED NOT NULL AUTO_INCREMENT, crafter_id INT UNSIGNED NOT NULL, " +
+                            "customer_id INT UNSIGNED NOT NULL, item_id INT NOT NULL, recipe_id INT NOT NULL, price BIGINT NOT NULL, deposit BIGINT NOT NULL, " +
+                            "created BIGINT NOT NULL, due BIGINT NOT NULL, state VARCHAR(8) NOT NULL, PRIMARY KEY(id), KEY(state))")
+                }
+                con.prepareStatement("SELECT id, crafter_id, customer_id, item_id, recipe_id, price, deposit, created, due, state FROM autobot_craft_orders WHERE state IN ('Open','Ready')").use { ps ->
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) orders += CraftOrder(rs.getInt(1), rs.getInt(2), rs.getInt(3), rs.getInt(4), rs.getInt(5), rs.getLong(6), rs.getLong(7),
+                                rs.getLong(8), rs.getLong(9), CraftOrder.State.valueOf(rs.getString(10)))
+                    }
+                }
+            }
+            Merchants.log("loaded ${orders.size} open craft orders")
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    private fun insert(order: CraftOrder): CraftOrder? {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("INSERT INTO autobot_craft_orders (crafter_id, customer_id, item_id, recipe_id, price, deposit, created, due, state) VALUES (?,?,?,?,?,?,?,?,?)",
+                        Statement.RETURN_GENERATED_KEYS).use { ps ->
+                    ps.setInt(1, order.crafterId); ps.setInt(2, order.customerId); ps.setInt(3, order.itemId); ps.setInt(4, order.recipeId)
+                    ps.setLong(5, order.price); ps.setLong(6, order.deposit); ps.setLong(7, order.created); ps.setLong(8, order.due); ps.setString(9, order.state.name)
+                    ps.executeUpdate()
+                    ps.generatedKeys.use { keys ->
+                        if (keys.next()) return CraftOrder(keys.getInt(1), order.crafterId, order.customerId, order.itemId, order.recipeId, order.price,
+                                order.deposit, order.created, order.due, order.state)
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+        return null
+    }
+
+    private fun save(order: CraftOrder) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("UPDATE autobot_craft_orders SET state=? WHERE id=?").use { ps ->
+                    ps.setString(1, order.state.name); ps.setInt(2, order.id); ps.executeUpdate()
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+}
