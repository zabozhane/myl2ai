+++ b/src/main/kotlin/dev/l2j/autobots/population/merchant/MerchantRep.kt
@@ -0,0 +1,147 @@
+package dev.l2j.autobots.population.merchant
+
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.model.actor.Player
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.math.pow
+
+/**
+ * What the town says about a merchant, 0 to 100: fair prices and orders kept raise it, overpricing, broken orders and
+ * scams lower it. Unlike the private trust between two characters (`Relations.trust`), everybody knows it. It drifts
+ * back to [NEUTRAL] by 5% of the gap a day, so an old story fades. Stored in `autobot_merchant_rep`.
+ */
+internal object MerchantRep {
+    const val NEUTRAL = 50.0
+    /** Below this nobody orders from a crafter. */
+    const val MIN_FOR_ORDERS = 30.0
+    const val TRUSTED = 70.0
+    const val SHADY = 25.0
+    private const val DAY_MS = 24 * 3600_000L
+    private const val DAILY_DRIFT = 0.95
+
+    class Rep(var score: Double = NEUTRAL, var deals: Int = 0, var ordersDone: Int = 0, var ordersFailed: Int = 0, var scams: Int = 0,
+              var updated: Long = System.currentTimeMillis()) {
+        var dirty = false
+        // Small gains from everyday deals are capped per day: a store can't farm reputation.
+        var dayStart = 0L
+        var dayGain = 0.0
+    }
+
+    private val reps = ConcurrentHashMap<Int, Rep>()
+    @Volatile private var loaded = false
+
+    fun of(objectId: Int): Rep {
+        if (!loaded) load()
+        val rep = reps.computeIfAbsent(objectId) { Rep() }
+        drift(rep)
+        return rep
+    }
+
+    fun ensureLoaded() {
+        if (!loaded) load()
+    }
+
+    fun score(player: Player): Double = of(player.objectId).score
+
+    private fun drift(rep: Rep) {
+        val now = System.currentTimeMillis()
+        val days = (now - rep.updated).toDouble() / DAY_MS
+        if (days < 0.01) return
+        rep.score = NEUTRAL + (rep.score - NEUTRAL) * DAILY_DRIFT.pow(days)
+        rep.updated = now
+        rep.dirty = true
+    }
+
+    /** An everyday deal: [points] count only up to [dailyCap] a day in total. */
+    fun deal(objectId: Int, points: Double, dailyCap: Double) {
+        val rep = of(objectId)
+        val now = System.currentTimeMillis()
+        if (now - rep.dayStart > DAY_MS) {
+            rep.dayStart = now
+            rep.dayGain = 0.0
+        }
+        rep.deals++
+        val applied = if (points > 0) points.coerceAtMost(dailyCap - rep.dayGain).coerceAtLeast(0.0) else points
+        if (points > 0) rep.dayGain += applied
+        change(rep, applied)
+    }
+
+    enum class Order(val points: Double) { OnTime(5.0), Late(2.0), Refunded(-5.0), Lost(-8.0), Scam(-25.0) }
+
+    fun order(objectId: Int, outcome: Order) {
+        val rep = of(objectId)
+        when (outcome) {
+            Order.OnTime, Order.Late -> rep.ordersDone++
+            Order.Refunded, Order.Lost -> rep.ordersFailed++
+            Order.Scam -> rep.scams++
+        }
+        change(rep, outcome.points)
+        // Rare and worth keeping: stored right away, not with the ten-minute batch.
+        save()
+    }
+
+    private fun change(rep: Rep, points: Double) {
+        rep.score = (rep.score + points).coerceIn(0.0, 100.0)
+        rep.updated = System.currentTimeMillis()
+        rep.dirty = true
+    }
+
+    /**
+     * The most a buyer pays in [owner]'s store against its own [limit]: a bit more at a trusted merchant, a good deal
+     * less at a shady one. Characters nobody talks about (players, bots that never traded) get the limit as it is.
+     */
+    fun limitFor(owner: Player, limit: Int): Int {
+        if (!Merchants.enabled) return limit
+        val rep = reps[owner.objectId] ?: return limit
+        return when {
+            rep.score >= TRUSTED -> (limit * 1.05).toInt()
+            rep.score < SHADY -> (limit * 0.85).toInt()
+            else -> limit
+        }
+    }
+
+    fun average(ids: Collection<Int>): Double = ids.mapNotNull { reps[it]?.score }.takeIf { it.isNotEmpty() }?.average() ?: NEUTRAL
+
+    @Synchronized
+    private fun load() {
+        if (loaded) return
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.createStatement().use {
+                    it.executeUpdate("CREATE TABLE IF NOT EXISTS autobot_merchant_rep (bot_id INT UNSIGNED NOT NULL, score DOUBLE NOT NULL, " +
+                            "deals INT NOT NULL, orders_done INT NOT NULL, orders_failed INT NOT NULL, scams INT NOT NULL, updated BIGINT NOT NULL, PRIMARY KEY(bot_id))")
+                }
+                con.prepareStatement("SELECT bot_id, score, deals, orders_done, orders_failed, scams, updated FROM autobot_merchant_rep").use { ps ->
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) reps[rs.getInt(1)] = Rep(rs.getDouble(2), rs.getInt(3), rs.getInt(4), rs.getInt(5), rs.getInt(6), rs.getLong(7))
+                    }
+                }
+            }
+            Merchants.log("loaded ${reps.size} reputations")
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+        loaded = true
+    }
+
+    fun save() {
+        if (!loaded) return
+        val dirty = reps.entries.filter { it.value.dirty }
+        if (dirty.isEmpty()) return
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("REPLACE INTO autobot_merchant_rep (bot_id, score, deals, orders_done, orders_failed, scams, updated) VALUES (?,?,?,?,?,?,?)").use { ps ->
+                    for ((id, r) in dirty) {
+                        r.dirty = false
+                        ps.setInt(1, id); ps.setDouble(2, r.score); ps.setInt(3, r.deals); ps.setInt(4, r.ordersDone)
+                        ps.setInt(5, r.ordersFailed); ps.setInt(6, r.scams); ps.setLong(7, r.updated)
+                        ps.addBatch()
+                    }
+                    ps.executeBatch()
+                }
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+}
