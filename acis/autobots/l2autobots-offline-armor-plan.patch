+    /**
+     * The best armor or jewelry upgrade the town's ordinary merchants sell, judged by the real defence it adds
+     * over the worn piece per adena, never by price alone. [affordable] is false when only dearer goals exist.
+     */
+    fun armorPlan(player: Player,budget: Int): Pair<ArmorPlan?,ArmorPlan?> {
+        val plans=dev.l2j.autobots.population.economy.Market.shopsNear(player).flatMap { shop -> shop.products.values.map { shop to it } }
+                .filter { (_,product) -> product.item.type2==Item.TYPE2_SHIELD_ARMOR || product.item.type2==Item.TYPE2_ACCESSORY }
+                .mapNotNull { (shop,product) ->
+                    // A detached value object for stat calculation: never registered, saved or added to an inventory.
+                    val candidate=ItemInstance(0,product.itemId)
+                    if(!eligible(player,candidate) || !fits(player,candidate)) return@mapNotNull null
+                    val slot=slot(player,candidate)
+                    val worn=player.inventory.getPaperdollItem(slot)
+                    if(worn!=null && (worn.enchantLevel>0 || worn.isAugmented)) return@mapNotNull null
+                    // A piece already carried is equipped by equip(); buying a second one is a duplicate.
+                    if(player.inventory.getItemByItemId(product.itemId)!=null) return@mapNotNull null
+                    val gain=score(player,candidate)-(worn?.let { score(player,it) } ?: 0.0)
+                    val price=dev.l2j.autobots.population.economy.Market.priceWithTax(shop,product)
+                    if(gain<MIN_ARMOR_GAIN || price<=0) null else ArmorPlan(slot,shop,product,worn,gain,price)
+                }
+        val affordable=plans.filter { it.price<=budget }.maxByOrNull { it.gain/it.price }
+        val goal=plans.filter { it.price>budget }.minByOrNull { it.price }
+        return affordable to goal
+    }
