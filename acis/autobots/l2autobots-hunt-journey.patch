--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/movement/HuntJourney.kt
@@ -0,0 +1,27 @@
+package dev.l2j.autobots.movement
+
+/** One finite attempt to resume productive hunting, across changing targets and travel legs. */
+internal class HuntJourney(private val budgetMs: Long=900_000L,private val cooldownMs: Long=60_000L) {
+    private var startedAt=-1L
+    @Volatile var retryAt=0L
+        private set
+
+    init { require(budgetMs>0 && cooldownMs>0) }
+
+    /** Absolute deadline; zero means try local combat or wait, rather than start another journey. */
+    @Synchronized fun deadline(now: Long): Long {
+        if(retryAt>0) {
+            if(now<retryAt) return 0L
+            reset()
+        }
+        if(startedAt<0) startedAt=now
+        if(now-startedAt>=budgetMs) {
+            retryAt=now+cooldownMs
+            return 0L
+        }
+        return startedAt+budgetMs
+    }
+
+    /** Real XP or a completed change of purpose (town chores/new session), never mere activation. */
+    @Synchronized fun reset() { startedAt=-1L;retryAt=0L }
+}
