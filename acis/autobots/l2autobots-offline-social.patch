+import kotlinx.coroutines.*
+import net.sf.l2j.gameserver.enums.IntentionType
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.group.Party
+import net.sf.l2j.gameserver.enums.MessageType
+import java.util.concurrent.ConcurrentHashMap
+
+/** The same Player object keeps its inventory/quests. It is never replaced with a population Autobot. */
+internal object OfflineLife {
+    private val runners=ConcurrentHashMap<Int,QuestRunner>()
+    private val parties=ConcurrentHashMap<Int,PartyBehavior>()
+    private val jobs=ConcurrentHashMap<Int,Job>()
+    private val prey=ConcurrentHashMap<Int,Set<Int>>()
+    private val checked=ConcurrentHashMap<Int,Long>()
+    private val retryQuest=ConcurrentHashMap<Int,Long>()
+    private val retryJoin=ConcurrentHashMap<Int,Long>()
+    fun targets(player: Player): Set<Int>? = prey[player.objectId]
+    fun setTargets(player: Player,ids: Set<Int>?) { if(ids==null) prey.remove(player.objectId) else prey[player.objectId]=ids }
+    fun owns(player: Player): Boolean = jobs.containsKey(player.objectId) || player.isInParty ||
+            runners[player.objectId]?.let { professionReady(player,it) }==true
+    private fun professionReady(player: Player,runner: QuestRunner): Boolean =
+            System.currentTimeMillis()>=(retryQuest[player.objectId]?:0L) && runner.professionBusiness()
+
+    fun allowsTarget(player: Player,target: Monster): Boolean {
+        if(target.isRaidRelated) return false
+        val party=player.party ?: return true
+        if(target.target===player) return true
+        return party.members.any { it!==player && !it.isDead && distance(player,it)<PartyPlan.RANGE &&
+                (target.target===it || (it.target===target && it.isInCombat)) }
+    }
+
+    fun validParty(player: Player): Boolean {
+        if(!AutobotData.settings.groupsEnabled) return false
+        val party=player.party ?: return false
+        val leader=party.leader as? Autobot ?: return false
+        return leader!==player && leader.life!=null && leader.controller==null && leader.isOnline &&
+                party.members.all { it===player || (it is Autobot && it.life!=null && it.controller==null && it.karma==0) } &&
+                PartyPlan.state(party).raid==null
+    }
+
+    fun join(player: Player,leader: Autobot): Boolean {
+        if(!AutobotData.settings.groupsEnabled || !OfflineFarmManager.activityAvailable(player) || jobs.containsKey(player.objectId) || player.isInParty || player.isDead ||
+                player.isUnderAttack() || player.isAttackingNow || player.isCastingNow || player.classId.level()==0 && player.level>=18) return false
+        val party=leader.party ?: return false
+        if(party.leader!==leader || leader.life==null || leader.controller!=null || leader.isDead || !leader.isOnline ||
+                StaticParties.groupOf(leader.objectId)!=null || party.membersCount>=PartySize.target(party).coerceIn(3,9) ||
+                distance(player,leader)>3000 || kotlin.math.abs(leader.level-player.level)>5 || PartyPlan.state(party).raid!=null ||
+                party.members.any { it !is Autobot || it.life==null || it.controller!=null || it.karma>0 || kotlin.math.abs(it.level-player.level)>5 }) return false
+        player.getActiveSequence()?.cancellationToken?.cancelLambda?.invoke()
+        party.addPartyMember(player)
+        if(player.party!==party) return false
+        AutofarmManager.stopFarm(player,"joined a bot party")
+        AutofarmManager.prepareOfflineBehavior(player)
+        prey.remove(player.objectId)
+        OfflineFarmManager.recordEvent(player,"PartyJoined","leader=${leader.name} id=${leader.objectId}")
+        return true
+    }
+
+    fun onInvite(requestor: Player,player: Player) {
+        // A human can neither move the offline character nor make it a leader through an invitation.
+        val accept=requestor is Autobot && join(player,requestor)
+        PartyInvites.answer(player,requestor,accept)
+    }
+
+    fun leave(player: Player,reason: String) {
+        player.party?.removePartyMember(player,MessageType.LEFT)
+        player.getActiveSequence()?.cancellationToken?.cancelLambda?.invoke()
+        prey.remove(player.objectId)
+        parties.remove(player.objectId)
+        retryJoin[player.objectId]=System.currentTimeMillis()+30*60_000L
+        println("Offline life: ${player.name} id=${player.objectId} left party: $reason")
+    }
+
+    /** Invoked only when no town chore or route owns the character; one structured action at a time. */
+    fun schedule(player: Player): Boolean {
+        if(!OfflineFarmManager.activityAvailable(player) || player.isDead) return false
+        val id=player.objectId
+        if(jobs.containsKey(id)) return true
+        val runner=runners.getOrPut(id){QuestRunner(player)}
+        val now=System.currentTimeMillis()
+        if(!player.isInParty && now-(checked[id]?:0L)>=30_000L && now>=(retryJoin[id]?:0L) && !professionReady(player,runner)) {
+            checked[id]=now
+            World.getInstance().players.filterIsInstance<Autobot>().filter { it.isInParty && it.party.leader===it }
+                    .sortedBy { distance(player,it) }.firstOrNull { join(player,it) }
+        }
+        if(!player.isInParty && !professionReady(player,runner)) return false
+        val job=CoScopes.onUpdateScope.launch(start=CoroutineStart.LAZY) {
+            try {
+                AutofarmManager.stopFarm(player,"offline party or profession quest")
+                AutofarmManager.prepareOfflineBehavior(player)
+                if(player.isInParty) {
+                    if(!validParty(player)) { leave(player,"party is no longer bot-led"); return@launch }
+                    if(player.party.leader===player) { leave(player,"offline characters never lead"); return@launch }
+                    if(!player.isUnderAttack() && !player.isAttackingNow && !player.isCastingNow &&
+                            (Errands.loadPercent(player)>=45 || runner.repeatReady() || player.classId.level()==0 && player.level>=19 ||
+                                    Healing.count(player)==0 && (Market.healingPriceAtHome(player)?:Int.MAX_VALUE)<=player.adena)) {
+                        leave(player,"town errands or profession");return@launch
+                    }
+                    AutofarmManager.useOfflinePotions(player)
+                    parties.getOrPut(id){PartyBehavior(player)}.onUpdate()
+                } else {
+                    AutofarmManager.useOfflinePotions(player)
+                    runner.onUpdate()
+                }
+            } catch(e: CancellationException) { throw e }
+            catch(e: Exception) {
+                println("Offline life: ${player.name} id=$id action failed: $e")
+                retryQuest[id]=System.currentTimeMillis()+5*60_000L
+                runner.onLogout()
+            } finally {
+                try {
+                    if(OfflineFarmManager.isActive(player) && !player.isDead && !player.isInParty && !professionReady(player,runner))
+                        OfflineFarmManager.resumeHunting(player)
+                } finally { jobs.remove(id,coroutineContext[Job]) }
+            }
+        }
+        if(jobs.putIfAbsent(id,job)==null) job.start() else job.cancel()
+        return true
+    }
+
+    /** Cancel and join before storage: no delayed dialog, movement or class change can write after handoff. */
+    fun stop(player: Player) {
+        player.getActiveSequence()?.cancellationToken?.cancelLambda?.invoke()
+        jobs.remove(player.objectId)?.let { runBlocking { it.cancelAndJoin() } }
+        if(player.isInParty) leave(player,"owner login, death or restart")
+        player.abortAttack();player.abortCast();player.stopMove(null);player.target=null
+        runners.remove(player.objectId)?.onLogout()
+        parties.remove(player.objectId);prey.remove(player.objectId);checked.remove(player.objectId);retryJoin.remove(player.objectId);retryQuest.remove(player.objectId)
+        AutofarmManager.clearOfflinePotions(player)
+    }
+}
