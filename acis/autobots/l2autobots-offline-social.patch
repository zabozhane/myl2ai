--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/group/StaticParties.kt
@@ -0,0 +1,133 @@
+package dev.l2j.autobots.population.group
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.population.DailySchedule
+import dev.l2j.autobots.population.isUnderAttack
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.gameserver.model.group.Party
+import java.time.ZonedDateTime
+import java.util.concurrent.ConcurrentHashMap
+
+/** A persistent circle of actual friends. Membership survives logout; only the live Party is transient. */
+internal object StaticParties {
+    data class Group(val id: Int,val leader: Int,val created: Long,val members: List<Int>)
+    private val groups=ConcurrentHashMap<Int,Group>()
+    private val membership=ConcurrentHashMap<Int,Int>()
+    private val retry=ConcurrentHashMap<Int,Long>()
+    private val schedules=ConcurrentHashMap<Int,DailySchedule>()
+    private var consideredAt=0L
+    fun groupOf(id: Int): Int? = membership[id]
+    fun same(a: Int,b: Int): Boolean = groupOf(a)?.let { it==groupOf(b) }?:false
+    fun all(): List<Group> = groups.values.sortedBy { it.id }
+    private fun schedule(group: Int): DailySchedule = schedules.getOrPut(group) {
+        val s=AutobotData.settings
+        DailySchedule(group,s.populationSleepHours,s.populationMinSessions..s.populationMaxSessions,s.populationMinSessionMinutes..s.populationMaxSessionMinutes)
+    }
+    fun minutesLeft(id: Int,now: ZonedDateTime): Int = if(!AutobotData.settings.groupsEnabled || !AutobotData.settings.groupFinderEnabled) 0 else groupOf(id)?.let { schedule(it).minutesLeft(now) }?:0
+    fun isPlaying(id: Int,now: ZonedDateTime): Boolean = if(!AutobotData.settings.groupsEnabled || !AutobotData.settings.groupFinderEnabled) false else groupOf(id)?.let { schedule(it).isPlaying(now) }?:false
+    fun reserved(id: Int): Boolean = isPlaying(id,ZonedDateTime.now(java.time.ZoneId.of(AutobotData.settings.populationTimeZone))) && System.currentTimeMillis()>=(retry[id]?:0L)
+    fun isStatic(party: Party): Boolean = groupOf(party.leader.objectId)?.let { group ->
+        party.members.all { it is Autobot && groupOf(it.objectId)==group }
+    }?:false
+    fun failed(id: Int) { retry[id]=System.currentTimeMillis()+30*60_000L }
+
+    fun load() {
+        val loaded=mutableListOf<Group>()
+        L2DatabaseFactory.getInstance().connection.use { con ->
+            con.prepareStatement("SELECT s.id,s.leader_id,s.created,m.bot_id FROM autobot_statics s JOIN autobot_static_members m ON m.static_id=s.id JOIN autobots b ON b.obj_Id=m.bot_id ORDER BY s.id,m.bot_id").use { ps ->
+                ps.executeQuery().use { rs ->
+                    val rows=linkedMapOf<Int,MutableList<Int>>()
+                    val headers=mutableMapOf<Int,Pair<Int,Long>>()
+                    while(rs.next()) { val id=rs.getInt(1);headers[id]=rs.getInt(2) to rs.getLong(3);rows.getOrPut(id){mutableListOf()}.add(rs.getInt(4)) }
+                    rows.forEach { (id,members) -> val h=headers.getValue(id);loaded+=Group(id,h.first,h.second,members) }
+                }
+            }
+        }
+        groups.clear();membership.clear();schedules.clear()
+        loaded.forEach { groups[it.id]=it;it.members.forEach { member -> membership[member]=it.id } }
+        println("Autobots statics: loaded ${groups.size} groups, ${membership.size} members")
+    }
+
+    /** Existing party mates only, with mutual liking and actual shared playtime; no friendship is minted here. */
+    @Synchronized fun create(candidates: List<Autobot>): Group? {
+        val members=candidates.distinctBy { it.objectId }.take(9)
+        if(members.size<3 || members.any { groupOf(it.objectId)!=null } || members.maxOf { it.level }-members.minOf { it.level }>5) return null
+        val leader=members.first()
+        if(leader.party==null || members.any { it.party!==leader.party }) return null
+        if(members.drop(1).any { other ->
+            val a=Relations.of(leader,other.objectId);val b=Relations.of(other,leader.objectId)
+            a==null || b==null || a.affinity<30 || b.affinity<30 || a.minutesTogether<120 || b.minutesTogether<120
+        }) return null
+        val group=Group(leader.objectId,leader.objectId,System.currentTimeMillis(),members.map { it.objectId })
+        L2DatabaseFactory.getInstance().connection.use { con ->
+            con.autoCommit=false
+            try {
+                con.prepareStatement("INSERT INTO autobot_statics(id,leader_id,created) VALUES(?,?,?)").use { ps ->
+                    ps.setInt(1,group.id);ps.setInt(2,group.leader);ps.setLong(3,group.created);ps.executeUpdate()
+                }
+                con.prepareStatement("INSERT INTO autobot_static_members(bot_id,static_id) VALUES(?,?)").use { ps ->
+                    group.members.forEach { ps.setInt(1,it);ps.setInt(2,group.id);ps.addBatch() };ps.executeBatch()
+                }
+                con.commit()
+            } catch(e: Exception) { con.rollback();throw e }
+        }
+        groups[group.id]=group;group.members.forEach { membership[it]=group.id }
+        println("Autobots statics: founded id=${group.id} members=${group.members.joinToString()}")
+        return group
+    }
+
+    fun tick(online: List<Autobot>,now: ZonedDateTime=ZonedDateTime.now(java.time.ZoneId.of(AutobotData.settings.populationTimeZone))) {
+        if(!AutobotData.settings.groupsEnabled || !AutobotData.settings.groupFinderEnabled) return
+        val time=System.currentTimeMillis()
+        if(time-consideredAt>=5*60_000L) {
+            consideredAt=time
+            online.filter { it.isInParty && it.party.leader===it }.forEach { leader ->
+                val friends=leader.party.members.filterIsInstance<Autobot>().filter { other ->
+                    other.life!=null && groupOf(other.objectId)==null && (other===leader ||
+                            (Relations.of(leader,other.objectId)?.let { it.affinity>=30 && it.minutesTogether>=120 }==true &&
+                             Relations.of(other,leader.objectId)?.let { it.affinity>=30 && it.minutesTogether>=120 }==true))
+                }
+                if(leader in friends && groupOf(leader.objectId)==null) create(listOf(leader)+friends.filter { it!==leader })
+            }
+        }
+        val byId=online.associateBy { it.objectId }
+        for(group in groups.values) {
+            if(!schedule(group.id).isPlaying(now)) continue
+            val ready=group.members.mapNotNull { byId[it] }.filter { it.isOnline && !it.isDead && !it.isInStoreMode &&
+                    it.controller==null && it.life?.quests?.isActive!=true && !it.isUnderAttack() && !it.isCastingNow && !it.isAttackingNow && time>=(retry[it.objectId]?:0L) }
+            // A shared appointment takes priority over casual bot groups, but never interrupts combat or a player-led party.
+            if(ready.size>=3 && ready.maxOf { it.level }-ready.minOf { it.level }<=5) ready.forEach { member ->
+                val old=member.party
+                if(old!=null && !isStatic(old) && PartyPlan.state(old).raid==null &&
+                        old.members.all { it is Autobot && it.controller==null && !it.isInCombat }) {
+                    member.cancelSequence()
+                    old.removePartyMember(member,net.sf.l2j.gameserver.enums.MessageType.LEFT)
+                }
+            }
+            val existing=ready.mapNotNull { it.party }.firstOrNull { isStatic(it) }
+            if(existing!=null) {
+                ready.filter { !it.isInParty && existing.membersCount<9 && (existing.members.map { member -> member.level }+it.level).let { levels -> levels.maxOrNull()!!-levels.minOrNull()!!<=5 } }.forEach {
+                    it.cancelSequence();existing.addPartyMember(it)
+                }
+                PartyPlan.state(existing).apply { breakUpAt=null;targetSize=group.members.size.coerceIn(3,9) }
+                continue
+            }
+            val free=ready.filter { !it.isInParty }
+            val leader=free.firstOrNull { it.objectId==group.leader } ?: free.firstOrNull() ?: continue
+            val companions=mutableListOf<Autobot>()
+            for(candidate in free.filter { it!==leader }.sortedBy { kotlin.math.abs(it.level-leader.level) }) {
+                val levels=(companions+leader+candidate).map { it.level }
+                if(levels.maxOrNull()!!-levels.minOrNull()!!<=5) companions+=candidate
+            }
+            if(companions.size<2) continue
+            val roles=(companions+leader).map { Role.of(it.classId) }
+            val kind=if(free.size>=5 && Role.Healer in roles && Role.Tank in roles && leader.level>=20) PartyKind.Full else PartyKind.Casual
+            GroupFinder.form(leader,companions,kind)
+            leader.party?.let { PartyPlan.state(it).apply { breakUpAt=null;targetSize=group.members.size.coerceIn(3,9) } }
+            println("Autobots statics: assembled id=${group.id} leader=${leader.objectId} size=${leader.party?.membersCount?:0}")
+        }
+    }
+
+    fun summary() { println("Autobots statics summary: groups=${groups.size} members=${membership.size}") }
+}
