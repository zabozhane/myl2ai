diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
index 1e58189..9bdf3b0 100644
--- a/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
@@ -50,6 +50,26 @@ internal object Market {
     /** Market value of one piece: the shop price if shops sell it, otherwise the reference price. */
     fun fairValue(itemId: Int): Int = npcPrice(itemId) ?: ItemTable.getInstance().getTemplate(itemId)?.referencePrice ?: 0
 
+    /** Every item the world's shops sell, lazily. */
+    private val soldItems: List<net.sf.l2j.gameserver.model.item.kind.Item> by lazy {
+        npcPrices.keys.mapNotNull { ItemTable.getInstance().getTemplate(it) }
+    }
+
+    /**
+     * The kit asks for [itemId], but no shop in the world sells it (a GM-shop piece like the Bone Club): the best
+     * piece the shops do sell for the same slot, of the same kind and no higher grade, and not above [maxPrice].
+     * Returns 0 when shops have nothing fitting either.
+     */
+    fun bestAlternative(itemId: Int, maxPrice: Int): Int {
+        val target = ItemTable.getInstance().getTemplate(itemId) ?: return 0
+        val fitting = soldItems.filter { it.bodyPart == target.bodyPart && it.crystalType.id <= target.crystalType.id && it.referencePrice <= maxPrice }
+        if (target is net.sf.l2j.gameserver.model.item.kind.Weapon) {
+            val sameType = fitting.filter { it.itemType == target.itemType }
+            return (sameType.ifEmpty { fitting.filter { it is net.sf.l2j.gameserver.model.item.kind.Weapon } }).maxByOrNull { it.referencePrice }?.itemId ?: 0
+        }
+        return fitting.filter { it is net.sf.l2j.gameserver.model.item.kind.Armor }.maxByOrNull { it.referencePrice }?.itemId ?: 0
+    }
+
     fun shopsNear(bot: Player): List<Shop> = shops.filter { distance(bot, it.merchant) <= TOWN_RADIUS }
 
     /** The closest shop in town that sells [itemId], with the product. */
