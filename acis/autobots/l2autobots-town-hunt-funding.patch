+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/Market.kt
@@ -138,6 +138,19 @@ internal object Market {
         return earned
     }
 
+    /** A bounded sale for a specific expense; the actor must really reach the merchant. */
+    fun sellPartToNpc(bot: Player,shop: Shop,item: ItemInstance,count: Int): Int {
+        if(count<=0 || count>item.count || !item.isSellable || item.isEquipped || item.ownerId!=bot.objectId ||
+                item.referencePrice<2 || !shop.merchant.isVisible ||
+                !shop.merchant.isInsideRadius(bot,net.sf.l2j.gameserver.model.actor.Npc.INTERACTION_DISTANCE,true,false)) return 0
+        val earned=item.referencePrice/2L*count
+        if(earned<=0 || earned>Int.MAX_VALUE-bot.adena.toLong()) return 0
+        if(bot.inventory.destroyItem("Sell",item.objectId,count,bot,shop.merchant)==null) return 0
+        bot.addAdena("Sell",earned.toInt(),shop.merchant,false)
+        EconomyLog.log(bot,Deal.NpcSell,"sold $count x ${item.itemName} to NPC for $earned to fund hunting travel")
+        return earned.toInt()
+    }
+
     /** Private stores around the bot, other than its own. */
     fun storesNear(bot: Player): List<Player> = bot.getKnownTypeInRadius(Player::class.java, STORE_RADIUS)
             .filter { it !== bot && it.isOnline && !it.isDead }
