diff --git a/src/main/kotlin/dev/l2j/autobots/population/economy/HuntFunding.kt b/src/main/kotlin/dev/l2j/autobots/population/economy/HuntFunding.kt
new file mode 100644
index 0000000..9cdf500
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/economy/HuntFunding.kt
@@ -0,0 +1,82 @@
+package dev.l2j.autobots.population.economy
+
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.Sequence
+import dev.l2j.autobots.extensions.getActiveSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.offlinelife.HuntRecovery
+import dev.l2j.autobots.population.isUnderAttack
+import dev.l2j.autobots.utils.CancellationToken
+import net.sf.l2j.gameserver.enums.ZoneId
+import net.sf.l2j.gameserver.model.item.instance.ItemInstance
+
+/** Sell only unprotected owned surplus, only when it really funds a complete paid hunting route. */
+internal object HuntFunding {
+    data class Sale(val objectId: Int,val count: Int,val value: Int)
+    data class Plan(val sales: List<Sale>,val fare: Int,val destination: net.sf.l2j.gameserver.model.location.Location)
+
+    private fun prepared(bot: Autobot): Boolean = bot.isInsideZone(ZoneId.TOWN) && !bot.isDead && !bot.isInParty &&
+            !bot.isUnderAttack() && Healing.count(bot)>=10 && Gear.count(bot,Gear.SCROLL_OF_ESCAPE)>0
+    private fun goods(bot: Autobot): List<ItemInstance> = Gear.surplus(bot).filter { it.isSellable && it.referencePrice>=2 }
+    private fun proceeds(item: ItemInstance): Long = item.referencePrice/2L*item.count
+    private fun budget(bot: Autobot,cash: Long): Int = (if(Errands.usesNoviceTravelBudget(bot)) cash else cash-Errands.reserve(bot))
+            .coerceIn(0L,Int.MAX_VALUE.toLong()).toInt()
+
+    fun plan(bot: Autobot,excluded: Set<Long>): Plan? {
+        if(!prepared(bot)) return null
+        val available=goods(bot)
+        if(available.isEmpty()) return null
+        val maxCash=(bot.adena.toLong()+available.sumOf { proceeds(it) }).coerceAtMost(Int.MAX_VALUE.toLong())
+        val ride=HuntRecovery.planWithBudget(bot,bot.location(),excluded,budget(bot,maxCash)) ?: return null
+        val fare=GatekeeperTravel.price(ride.exit)
+        val required=fare.toLong()+(if(Errands.usesNoviceTravelBudget(bot)) 0 else Errands.reserve(bot))-bot.adena
+        if(required<=0) return null
+        // Prefer a single partial stack with the least unnecessary sale value.
+        val one=available.mapNotNull { item ->
+            val unit=item.referencePrice/2
+            val count=(required+unit-1)/unit
+            if(count>item.count || count>Int.MAX_VALUE || count*unit>Int.MAX_VALUE) null
+            else listOf(Sale(item.objectId,count.toInt(),(count*unit).toInt()))
+        }.minWithOrNull(compareBy<List<Sale>>({ it.sumOf { sale -> sale.value.toLong() } },{ it.sumOf { sale -> sale.count.toLong() } }))
+        val sales=one ?: run {
+            var left=required
+            val selected=mutableListOf<Sale>()
+            for(item in available.sortedBy { it.referencePrice }) {
+                val unit=item.referencePrice/2
+                val count=minOf(item.count.toLong(),(left+unit-1)/unit).coerceAtMost(Int.MAX_VALUE.toLong())
+                if(count>0 && count*unit<=Int.MAX_VALUE) {
+                    selected.add(Sale(item.objectId,count.toInt(),(count*unit).toInt()));left-=count*unit
+                }
+                if(left<=0) break
+            }
+            if(left>0) return null
+            selected
+        }
+        return Plan(sales,fare,ride.walk.points.last())
+    }
+
+    internal class SaleSequence(override val bot: Autobot,private val plan: Plan,private val excluded: Set<Long>): Sequence {
+        override var cancellationToken: CancellationToken?=null
+        var earned=0
+            private set
+        private fun active() = bot.getActiveSequence()===this && bot.isOnline && !bot.isDead && bot.controller==null &&
+                !bot.isInStoreMode && !bot.isUnderAttack()
+        override suspend fun definition() {
+            if(!active() || !prepared(bot)) return
+            val shop=Market.closestShop(bot) ?: return
+            EconomyLog.note(bot,"funds hunting travel fare=${plan.fare} to=${plan.destination.x},${plan.destination.y},${plan.destination.z} from owned surplus")
+            if(!NpcTravel.reach(bot,shop.merchant,8000) || !active() || !prepared(bot)) return
+            val currentPlan=HuntFunding.plan(bot,excluded) ?: return
+            val live=goods(bot).associateBy { it.objectId }
+            // Requote current prices, required quantity and protection before committing any sale.
+            if(currentPlan.sales.any { sale -> live[sale.objectId]?.let { it.count<sale.count || it.referencePrice/2L*sale.count!=sale.value.toLong() } != false }) return
+            for(sale in currentPlan.sales) {
+                if(!active()) return
+                val item=goods(bot).firstOrNull { it.objectId==sale.objectId } ?: return
+                val paid=Market.sellPartToNpc(bot,shop,item,sale.count)
+                if(paid<=0) return
+                earned+=paid
+            }
+        }
+    }
+}
