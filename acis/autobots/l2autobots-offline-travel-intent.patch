@@ -0,0 +1,78 @@
+package dev.l2j.autobots.offlinelife
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import net.sf.l2j.L2DatabaseFactory
+import java.util.logging.Logger
+
+/** Persist purpose, not obsolete geodata waypoints. A resumed trip replans from the stored player position. */
+internal data class OfflineTravelState(val trip: String,val x: Int,val y: Int,val z: Int,
+        val trainerId: Int,val thenHunt: Boolean,val spotX: Int,val spotY: Int,val spotZ: Int,
+        val radius: Int,val hopped: Boolean,val spotKey: Long?,val finalApproach: Boolean,
+        val startedAt: Long,val deadlineAt: Long,val journeyStart: Long,val journeyRetry: Long,
+        val excluded: Set<Long>)
+
+internal object OfflineTravelStore {
+    private val logger=Logger.getLogger(OfflineTravelStore::class.java.name)
+    private val json=ObjectMapper()
+
+    fun initialize() {
+        L2DatabaseFactory.getInstance().connection.use { connection ->
+            connection.createStatement().use { it.executeUpdate("CREATE TABLE IF NOT EXISTS character_offline_travel (obj_Id INT UNSIGNED NOT NULL, intent TEXT NOT NULL, updated BIGINT NOT NULL, PRIMARY KEY(obj_Id))") }
+        }
+    }
+
+    fun save(id: Int,state: OfflineTravelState) {
+        runCatching {
+            val payload=json.writeValueAsString(mapOf("version" to 1,"trip" to state.trip,
+                    "x" to state.x,"y" to state.y,"z" to state.z,"trainer" to state.trainerId,
+                    "thenHunt" to state.thenHunt,"spotX" to state.spotX,"spotY" to state.spotY,"spotZ" to state.spotZ,
+                    "radius" to state.radius,"hopped" to state.hopped,"spotKey" to state.spotKey,
+                    "finalApproach" to state.finalApproach,"startedAt" to state.startedAt,"deadlineAt" to state.deadlineAt,
+                    "journeyStart" to state.journeyStart,"journeyRetry" to state.journeyRetry,
+                    "excluded" to state.excluded.sorted().take(512)))
+            L2DatabaseFactory.getInstance().connection.use { connection ->
+                connection.prepareStatement("INSERT INTO character_offline_travel(obj_Id,intent,updated) VALUES(?,?,?) ON DUPLICATE KEY UPDATE intent=VALUES(intent),updated=VALUES(updated)").use {
+                    it.setInt(1,id);it.setString(2,payload);it.setLong(3,System.currentTimeMillis());it.executeUpdate()
+                }
+            }
+        }.onFailure { logger.warning("Offline travel write failed for $id: $it") }
+    }
+
+    fun load(id: Int): OfflineTravelState? = runCatching {
+        L2DatabaseFactory.getInstance().connection.use { connection ->
+            connection.prepareStatement("SELECT intent FROM character_offline_travel WHERE obj_Id=?").use { query ->
+                query.setInt(1,id)
+                query.executeQuery().use records@ { rows ->
+                    if(!rows.next()) return@records null
+                    val p=json.readTree(rows.getString(1))
+                    require(p.path("version").asInt()==1 && p.path("radius").asInt() in 1..2000)
+                    val start=p.path("startedAt").asLong()
+                    val deadline=p.path("deadlineAt").asLong()
+                    require(start>=0 && (deadline==0L || deadline in start..(start+900_000L)))
+                    OfflineTravelState(p.path("trip").asText(),p.path("x").asInt(),p.path("y").asInt(),p.path("z").asInt(),
+                            p.path("trainer").asInt(),p.path("thenHunt").asBoolean(),
+                            p.path("spotX").asInt(),p.path("spotY").asInt(),p.path("spotZ").asInt(),
+                            p.path("radius").asInt(),p.path("hopped").asBoolean(),
+                            p.path("spotKey").takeUnless { it.isMissingNode || it.isNull }?.asLong(),
+                            p.path("finalApproach").asBoolean(),start,deadline,
+                            p.path("journeyStart").asLong(-1),p.path("journeyRetry").asLong(),
+                            p.path("excluded").take(512).map { it.asLong() }.toSet())
+                }
+            }
+        }
+    }.getOrElse {
+        logger.warning("Offline travel read failed for $id; discarded: $it")
+        clear(id)
+        null
+    }
+
+    fun clear(id: Int) {
+        runCatching {
+            L2DatabaseFactory.getInstance().connection.use { connection ->
+                connection.prepareStatement("DELETE FROM character_offline_travel WHERE obj_Id=?").use {
+                    it.setInt(1,id);it.executeUpdate()
+                }
+            }
+        }.onFailure { logger.warning("Offline travel delete failed for $id: $it") }
+    }
+}
