+        val pack = bot.getKnownTypeInRadius(Monster::class.java, ATTACKER_RADIUS)
+                .count { !it.isDead && it.target === bot && it.npcId == killer.npcId }
+        if (deaths.size < PREY_DEATHS_TO_AVOID && pack < 2) return
+        avoidedPrey[killer.npcId] = now + PREY_AVOID_MS
+        val keys = HuntingSpots.keysWithNpcNear(bot.location(), killer.npcId, PREY_SPOT_RADIUS)
