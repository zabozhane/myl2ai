+     * leaves that monster alone for an hour and moves off the spots around the place of death.
+     */
+    private fun rememberPreyDeath(killer: Monster) {
+        if (killer.isRaidRelated || RaidPlanner.isRaiding(bot)) return
+        val now = System.currentTimeMillis()
+        val deaths = preyDeaths.getOrPut(killer.npcId) { ArrayDeque() }
