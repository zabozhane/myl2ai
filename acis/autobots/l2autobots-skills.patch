diff --git a/src/main/kotlin/dev/l2j/autobots/population/skills/SkillLearner.kt b/src/main/kotlin/dev/l2j/autobots/population/skills/SkillLearner.kt
new file mode 100644
index 0000000..d531e01
--- /dev/null
+++ b/src/main/kotlin/dev/l2j/autobots/population/skills/SkillLearner.kt
@@ -0,0 +1,176 @@
+package dev.l2j.autobots.population.skills
+
+import dev.l2j.autobots.AutobotData
+import dev.l2j.autobots.Autobot
+import dev.l2j.autobots.behaviors.sequences.WalkToSequence
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.population.economy.Errands
+import dev.l2j.autobots.population.economy.Gear
+import dev.l2j.autobots.population.economy.Market
+import dev.l2j.autobots.utils.distance
+import kotlinx.coroutines.delay
+import net.sf.l2j.L2DatabaseFactory
+import net.sf.l2j.commons.random.Rnd
+import net.sf.l2j.gameserver.data.SkillTable
+import net.sf.l2j.gameserver.data.xml.SpellbookData
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Npc
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Folk
+import net.sf.l2j.gameserver.model.holder.skillnode.GeneralSkillNode
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Skills the way players get them: a population bot learns at a trainer of its class, paying SP and handing in the
+ * spellbook where Interlude asks for one (SpellbookData, SpBookNeeded). Books are bought in town shops or from
+ * private stores, or kept when they drop; nothing is given. Skills that cost nothing (autoGet: Lucky, Expertise,
+ * common craft) still come with the level, as they do for players.
+ */
+internal object SkillLearner {
+    private const val TRAINER_RADIUS = 8000
+    // A book is kept from the moment it drops until the skill is this many levels away.
+    private const val KEEP_BOOKS_LEVELS_AHEAD = 10
+
+    private val trainers: List<Folk> by lazy {
+        World.getInstance().objects.filterIsInstance<Folk>().also { println("Autobots skills: ${it.size} folk NPCs indexed.") }
+    }
+
+    /** Next skill levels the bot has reached, cheapest level requirement first. */
+    fun lessons(bot: Player): List<GeneralSkillNode> = bot.availableSkills.sortedWith(compareBy({ it.minLvl }, { it.correctedCost }))
+
+    fun bookFor(node: GeneralSkillNode): Int = SpellbookData.getInstance().getBookForSkill(node.id, node.value)
+
+    /** Spellbooks the bot will need for its class: kept out of sales, wanted in buy stores. */
+    fun neededBooks(bot: Player): Set<Int> = bot.template.skills.asSequence()
+            .filter { it.cost != 0 && it.minLvl <= bot.level + KEEP_BOOKS_LEVELS_AHEAD && bot.getSkillLevel(it.id) < it.value }
+            .map { bookFor(it) }
+            .filter { it > 0 }
+            .toSet()
+
+    /** Books the bot needs now and has no copy of, for a buy store when no town shop sells them. */
+    fun missingBooks(bot: Player): List<Int> = lessons(bot).map { bookFor(it) }.filter { it > 0 && Gear.count(bot, it) == 0 }.distinct()
+
+    /** A lesson the bot can take on its next town visit: enough SP, and the book in the bag or on a shop shelf. */
+    fun hasLessons(bot: Autobot): Boolean = bot.learnsSkills && lessons(bot).any { node ->
+        val book = bookFor(node)
+        bot.sp >= node.correctedCost && (book == 0 || Gear.count(bot, book) > 0 || (Market.npcPrice(book) ?: Int.MAX_VALUE) <= Errands.spendable(bot))
+    }
+
+    /** One visit: buy the missing books the bot can afford, walk to a trainer of its class, learn all it can pay for. */
+    suspend fun learn(bot: Autobot) {
+        if (!bot.learnsSkills || bot.isDead) return
+        val affordable = lessons(bot).filter { bot.sp >= it.correctedCost }
+        if (affordable.isEmpty()) return
+
+        for (book in affordable.map { bookFor(it) }.filter { it > 0 && Gear.count(bot, it) == 0 }.distinct()) buyBook(bot, book)
+
+        val learnable = affordable.filter { bookFor(it).let { book -> book == 0 || Gear.count(bot, book) > 0 } }
+        if (learnable.isEmpty()) return
+        val trainer = trainers.filter { it.isVisible && it.template.canTeach(bot.classId) && distance(bot, it) <= TRAINER_RADIUS }
+                .minByOrNull { distance(bot, it) } ?: return
+        if (!walkTo(bot, trainer)) return
+
+        // Learning a level can open the next one (Power Strike 1, then 2...): go on while SP lasts.
+        var learned = 0
+        do {
+            val next = lessons(bot).firstOrNull { node ->
+                val book = bookFor(node)
+                bot.sp >= node.correctedCost && (book == 0 || Gear.count(bot, book) > 0)
+            } ?: break
+            if (!acquire(bot, trainer, next)) break
+            learned++
+            delay(Rnd.get(600, 1500).toLong())
+        } while (learned < MAX_LESSONS_PER_VISIT)
+    }
+
+    /** Mirrors RequestAcquireSkill for general skills: level order, template, SP, spellbook, then the skill is stored. */
+    private fun acquire(bot: Autobot, trainer: Folk, node: GeneralSkillNode): Boolean {
+        if (!trainer.template.canTeach(bot.classId) || distance(bot, trainer) > Npc.INTERACTION_DISTANCE * 1.5) return false
+        if (bot.getSkillLevel(node.id) != node.value - 1) return false
+        val gsn = bot.template.findSkill(node.id, node.value) ?: return false
+        val skill = SkillTable.getInstance().getInfo(node.id, node.value) ?: return false
+        if (bot.sp < gsn.correctedCost) return false
+
+        val book = bookFor(gsn)
+        if (book > 0 && !bot.destroyItemByItemId("SkillLearn", book, 1, trainer, false)) return false
+        bot.removeExpAndSp(0, gsn.correctedCost)
+        bot.addSkill(skill, true, true)
+        bot.sendSkillList()
+        SkillLog.log(bot, "learned ${skill.name} ${node.value} from ${trainer.name} for ${gsn.correctedCost} SP${if (book > 0) " and a spellbook" else ""}")
+        return true
+    }
+
+    /** From a town shop if one sells it, otherwise from a private store at a fair price. */
+    private suspend fun buyBook(bot: Autobot, book: Int) {
+        val inShop = Market.findProduct(bot, book)
+        if (inShop != null) {
+            val (shop, product) = inShop
+            if (Market.priceWithTax(shop, product) > Errands.spendable(bot) || !walkTo(bot, shop.merchant)) return
+            if (Market.buyFromNpc(bot, shop, product, 1)) SkillLog.count(SkillLog.BOOKS)
+            return
+        }
+        val limit = (Market.fairValue(book) * 1.5).toInt()
+        val offer = Market.sellOffers(bot, book).firstOrNull { it.tradeItem.price in 1..minOf(limit, Errands.spendable(bot)) } ?: return
+        if (!walkTo(bot, offer.owner)) return
+        if (Market.buyFromStore(bot, offer, 1)) SkillLog.count(SkillLog.BOOKS)
+    }
+
+    private suspend fun walkTo(bot: Autobot, target: net.sf.l2j.gameserver.model.actor.Creature): Boolean {
+        if (bot.isDead) return false
+        if (bot.isSitting) bot.standUp()
+        if (distance(bot, target) > Npc.INTERACTION_DISTANCE) {
+            WalkToSequence(bot, target.location(), Npc.INTERACTION_DISTANCE - 50) {}.definition()
+        }
+        if (distance(bot, target) > Npc.INTERACTION_DISTANCE * 1.5) return false
+        bot.target = target
+        delay(Rnd.get(2000, 5000).toLong())
+        return !bot.isDead
+    }
+
+    /**
+     * Skills the bot learned before, as Player.restoreSkills reads them: population bots no longer get every skill
+     * on login, so what they paid for has to come back from character_skills.
+     */
+    fun restoreLearned(bot: Player) {
+        try {
+            L2DatabaseFactory.getInstance().connection.use { con ->
+                con.prepareStatement("SELECT skill_id,skill_level FROM character_skills WHERE char_obj_id=? AND class_index=?").use { ps ->
+                    ps.setInt(1, bot.objectId)
+                    ps.setInt(2, bot.classIndex)
+                    ps.executeQuery().use { rs ->
+                        while (rs.next()) SkillTable.getInstance().getInfo(rs.getInt("skill_id"), rs.getInt("skill_level"))?.let { bot.addSkill(it, false) }
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            println("Autobots skills: couldn't restore skills of ${bot.name}: $e")
+        }
+    }
+
+    private const val MAX_LESSONS_PER_VISIT = 40
+}
+
+/** Skill learning counted for the periodic summary. */
+internal object SkillLog {
+    const val LEARNED = "learned"
+    const val BOOKS = "booksBought"
+    private val counts = ConcurrentHashMap<String, AtomicInteger>()
+
+    fun count(kind: String) {
+        counts.computeIfAbsent(kind) { AtomicInteger() }.incrementAndGet()
+    }
+
+    fun log(bot: Player, message: String) {
+        count(LEARNED)
+        if (AutobotData.settings.questLog) println("Autobots skills: ${bot.name} (lv ${bot.level} ${bot.classId}): $message")
+    }
+
+    fun summary(bots: Collection<Autobot>) {
+        val learners = bots.filter { it.learnsSkills }
+        val waiting = learners.count { SkillLearner.lessons(it).isNotEmpty() }
+        val sp = if (learners.isEmpty()) 0 else learners.sumOf { it.sp.toLong() } / learners.size
+        println("Autobots skill summary: learned=${counts[LEARNED]?.getAndSet(0) ?: 0} booksBought=${counts[BOOKS]?.getAndSet(0) ?: 0} " +
+                "withLessonsPending=$waiting avgSp=$sp")
+    }
+}
