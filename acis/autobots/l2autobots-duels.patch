@@ -0,0 +1,85 @@
+package dev.l2j.autobots.population.duel
+
+import dev.l2j.autobots.extensions.location
+import dev.l2j.autobots.utils.distance
+import net.sf.l2j.gameserver.data.manager.ZoneManager
+import net.sf.l2j.gameserver.data.xml.MapRegionData
+import net.sf.l2j.gameserver.geoengine.GeoEngine
+import net.sf.l2j.gameserver.model.World
+import net.sf.l2j.gameserver.model.actor.Player
+import net.sf.l2j.gameserver.model.actor.instance.Monster
+import net.sf.l2j.gameserver.model.location.Location
+import net.sf.l2j.gameserver.model.zone.ZoneType
+import net.sf.l2j.gameserver.model.zone.type.*
+import java.util.Optional
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.math.cos
+import kotlin.math.sin
+
+/**
+ * The duel ground of a town: the core forbids duels in peace, PvP and siege zones, so players meet just outside the
+ * town. For each town (its respawn point) the nearest point outside every such zone, with some margin and no aggressive
+ * monsters around, is searched once along 8 rays and kept. A town without one has no duels.
+ */
+internal object DuelGrounds {
+    private const val STEP = 150
+    private const val MAX_RAY = 5000
+    private const val MARGIN = 400
+    private const val AGGRO_RADIUS = 1500.0
+
+    /** Town name -> its ground. A town has many respawn points; the first one seen is where the search starts. */
+    private val grounds = ConcurrentHashMap<String, Optional<Location>>()
+
+    /** The duel ground of the town the bot would return to, or null when that town has none. */
+    fun of(bot: Player): Location? {
+        val town = MapRegionData.getInstance().getLocationToTeleport(bot, MapRegionData.TeleportType.TOWN) ?: return null
+        return of(town)
+    }
+
+    fun of(town: Location): Location? =
+            grounds.computeIfAbsent(MapRegionData.getInstance().getClosestTownName(town.x, town.y)) { Optional.ofNullable(find(it, town)) }.orElse(null)
+
+    /** The ground the bot stands at, if it is at one (within [radius]). */
+    fun near(bot: Player, radius: Int): Location? =
+            grounds.values.mapNotNull { it.orElse(null) }.firstOrNull { distance(bot.location(), it) <= radius && kotlin.math.abs(bot.z - it.z) < 400 }
+
+    private fun find(name: String, town: Location): Location? {
+        val geo = GeoEngine.getInstance()
+        val monsters = World.getInstance().objects.filterIsInstance<Monster>()
+                .filter { it.isAggressive && distance(it.spawnLocation(), town) < MAX_RAY + MARGIN + AGGRO_RADIUS }
+        var best: Location? = null
+        var bestDistance = Double.MAX_VALUE
+        for (dir in 0 until 8) {
+            val angle = dir * Math.PI / 4
+            var step = STEP
+            while (step <= MAX_RAY) {
+                val x = town.x + (cos(angle) * step).toInt()
+                val y = town.y + (sin(angle) * step).toInt()
+                if (allowed(x, y, geo.getHeight(x, y, town.z).toInt())) {
+                    val gx = town.x + (cos(angle) * (step + MARGIN)).toInt()
+                    val gy = town.y + (sin(angle) * (step + MARGIN)).toInt()
+                    val ground = Location(gx, gy, geo.getHeight(gx, gy, town.z).toInt())
+                    if (allowed(ground.x, ground.y, ground.z) && monsters.none { distance(it.spawnLocation(), ground) < AGGRO_RADIUS } &&
+                            step + MARGIN < bestDistance) {
+                        best = ground
+                        bestDistance = (step + MARGIN).toDouble()
+                    }
+                    break
+                }
+                step += STEP
+            }
+        }
+        println("Autobots duels: duel ground of $name (from ${town.x},${town.y},${town.z}): " +
+                (best?.let { "${it.x},${it.y},${it.z} (${bestDistance.toInt()} away)" } ?: "none"))
+        return best
+    }
+
+    private fun Monster.spawnLocation(): Location = spawn?.loc?.let { Location(it.x, it.y, it.z) } ?: Location(x, y, z)
+
+    /** Outside every zone where a duel is forbidden or cancelled, or where standing around is a bad idea. */
+    private fun allowed(x: Int, y: Int, z: Int): Boolean = ZoneManager.getInstance().getZones(x, y, z).none { forbidden(it) }
+
+    private fun forbidden(zone: ZoneType) = zone is TownZone || zone is PeaceZone || zone is ArenaZone || zone is OlympiadStadiumZone ||
+            zone is SiegeZone || zone is CastleZone || zone is ClanHallZone || zone is WaterZone || zone is BossZone ||
+            zone is DerbyTrackZone || zone is JailZone || zone is DamageZone || zone is SwampZone
+}
