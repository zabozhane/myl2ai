 private const val GREY_ATTACKER_LEVELS = 15
+private const val GREY_HIT_RANGE = 300
+private const val GREY_HURT_SHARE = 0.8
 
 /**
  * A monster that has the bot as its target but neither sees it nor can walk to it (a skeleton on the cave floor below
  * a ledge path) is no attack: counting it froze quest walks above the Cave of Trials for the whole session.
  */
 private fun Player.canReach(monster: Monster): Boolean {
-    // Far weaker monsters are no attack either: the bot's own targeting skips them as grey, and a Crypt Horror
-    // (15) behind a hump held a level 39 shaman for nine minutes without a scratch. A player walks on.
-    if (monster.level + GREY_ATTACKER_LEVELS <= level) return false
+    // Far weaker monsters are no attack either while they don't hurt: a Crypt Horror (15) behind a hump held a level
+    // 39 shaman for nine minutes without a scratch, and a player walks on. Once they close in or the bot bleeds they
+    // count again: a pack of 11-13 skeletons (12-19) killed two priests of 39 on the Martankus path, ignored.
+    if (monster.level + GREY_ATTACKER_LEVELS <= level &&
+            (currentHp >= maxHp * GREY_HURT_SHARE && !isInsideRadius(monster, GREY_HIT_RANGE, true, false))) return false
     if (kotlin.math.abs(monster.z - z) < 200) return true
     val geo = net.sf.l2j.gameserver.geoengine.GeoEngine.getInstance()
     return geo.canSeeTarget(monster, this) || geo.canMoveToTarget(monster.x, monster.y, monster.z, x, y, z)
