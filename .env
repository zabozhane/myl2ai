# aCis revision to build. Revision and JDK go together: 381-406 -> JDK 11, >406 -> JDK 21.
# Commits are from the official repository https://gitlab.com/Tryskell/acis_public
#   382: 452cd109c3bce48416f74bba4daa8c3cf5dfc0a0 (JDK 11)
#   409: 55ff8a4ec7e186d9816cd549246b4cf1f59c9f12 (JDK 21)
ACIS_REVISION=382
ACIS_COMMIT=452cd109c3bce48416f74bba4daa8c3cf5dfc0a0
JDK_VERSION=11

# L2Autobots (https://github.com/Elfocrash/L2Autobots), written for aCis 382; acis/autobots/*.patch target this pair.
AUTOBOTS_COMMIT=f990c61df25e94c08ea6c36c5e230928a36ce0fc

# Local-only credentials: the database port is not published outside the Docker network.
MARIADB_ROOT_PASSWORD=l2ai-root
LOGIN_DB_NAME=l2_login
LOGIN_DB_USER=l2_login
LOGIN_DB_PASSWORD=l2ai-login
GAME_DB_NAME=l2_game
GAME_DB_USER=l2_game
GAME_DB_PASSWORD=l2ai-game

# The address the login server gives to the client for the game server.
GAME_PUBLIC_HOST=127.0.0.1

LOGIN_JAVA_OPTS=-Xmx64m
GAME_JAVA_OPTS=-Xms1g -Xmx5g
